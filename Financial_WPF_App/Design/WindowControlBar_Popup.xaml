<UserControl x:Class="Financial_WPF_App.WindowControlBar_Popup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Background="#FFDCDDDE" d:DesignHeight="15" d:DesignWidth="120"
             >
    <!--<DockPanel MouseDown="TitleBar_MouseDown">-->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- Minimize Button -->
        <Button HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="15" Grid.Column="0" Click="Minimize_Click"  Background="{StaticResource ButtonImageMinimize}" BorderBrush="{x:Null}" Foreground="{x:Null}" Margin="0,0,20,0" />
        <!-- Close Button -->
        <Button VerticalAlignment="Center" x:Name="Close" Width="13" Height="14" Grid.Column="2" BorderBrush="{x:Null}" Foreground="{x:Null}" FontWeight="Normal" Background="{StaticResource ButtonImageClose}" Click="Close_Click" Margin="0,0,30,0"/>
    </StackPanel>
    <!--</DockPanel>-->
</UserControl>
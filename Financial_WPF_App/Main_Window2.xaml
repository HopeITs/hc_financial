<Fluent:RibbonWindow 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:Fluent="clr-namespace:Fluent;assembly=Fluent"  
    xmlns:local="clr-namespace:Financial_WPF_App" 
    xmlns:dragablz="http://dragablz.net/winfx/xaml/dragablz"
    xmlns:Themes="clr-namespace:Dragablz.Themes;assembly=Dragablz" 
    xmlns:Converters="clr-namespace:Dragablz.Converters;assembly=Dragablz" 
    xmlns:controlzex="urn:controlzex" xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Name="Main_Window2"  
    x:Class="Financial_WPF_App.Main_Window_2" mc:Ignorable="d" 
    Title="" Height="720" Width="1280" WindowState="Maximized"
    FontFamily="Arial Bold" FontSize="12" Icon="Logo.ico" Closing="Main_Window2_Closing" Closed="Main_Window2_Closed" >

    <Fluent:RibbonWindow.Resources>

        <Themes:BrushToRadialGradientBrushConverter x:Key="BrushToRadialGradientBrushConverter"/>
        <!--<ImageBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabControl.Background" Stretch="Fill" ImageSource="/Images/MainForm/MainForm Ribbon.png"/>-->
        <!--<ImageBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabControl.TitleBackground.Background" Stretch="Fill" ImageSource="/Images/MainForm/Header_cut.png"/>-->
        <ImageBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabControl.Content.Background" Stretch="Fill" ImageSource="/Images/MainForm/Header_cut.png"/>
        <ImageBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabControl.TabsGrid.Background" Stretch="Fill" ImageSource="/Images/MainForm/MainForm Tab Header.png"/>

        <Style x:Key="Ribbon_Style" TargetType="{x:Type Fluent:Ribbon}">
            <Setter Property="FontFamily" Value="Arial Light" />
            <Setter Property="Foreground" Value="{DynamicResource HopeGrey}" />
        </Style>
        <Style x:Key="RibbonTab_Style" TargetType="{x:Type Fluent:RibbonTabItem}">
            <Setter Property="Foreground" Value="{DynamicResource HopeBlue4}" />
            <Setter Property="Background" Value="{DynamicResource HopeGrey}" />
            <Setter Property="Width" Value="150" />
            <Setter Property="FontFamily" Value="GE SS Two Bold" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Fluent:RibbonTabItem}">
                        <Border
                            x:Name="Border"
                            Margin="2,0"
                            BorderBrush="{DynamicResource HopeBlue4}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="10,10,0,0"
                            Background="{DynamicResource HopeGrey}">
                            <ContentPresenter
                                x:Name="ContentSite"
                                Margin="10,2" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" >
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" >
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontFamily" Value="Arial Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter  TargetName="Border" Property="Background" >
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource Color_HopeBlue3}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" >
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontFamily" Value="Arial Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonButton_Style" TargetType="{x:Type Fluent:Button}" >
            <Setter Property="Height" Value="auto" />
            <Setter Property="Width" Value="60" />
            <Setter Property="Margin" Value="0,7,0,-10.4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>


        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.Selected.Foreground" Color="{DynamicResource Color_HopeBlue4}" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.Selected.Background" Color="{DynamicResource Color_HopeGrey}" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.ActiveTabBackground" Color="{DynamicResource Color_HopeBlue4}" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItem.ActiveTabForeground" Color="{DynamicResource Color_HopeGrey}" />


        <Style TargetType="{x:Type dragablz:TabablzControl}" x:Key="TabablzControlStyle"  BasedOn="{StaticResource MaterialDesignTabablzControlStyle}">
            <Setter Property="ClosingItemCallback" Value="{Binding ClosingTabItemHandler}" />
        </Style>
    </Fluent:RibbonWindow.Resources>

    <Grid x:Name="main_grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />

            <RowDefinition Height="auto" />
            <RowDefinition Height="40"  />
            <RowDefinition/>
            <!--<RowDefinition Height="35"/>-->
        </Grid.RowDefinitions>

        <DockPanel>
            <DockPanel.Background>
                <ImageBrush ImageSource="Images/MainForm/MainForm Tab Header.png"/>
            </DockPanel.Background>
            <Label x:Name="Username_lable" Content="UserName" VerticalContentAlignment="Center" VerticalAlignment="Center" 
                   FontSize="22" FontFamily="Digital-7">
                <Label.Foreground>
                    <SolidColorBrush Color="{DynamicResource Color_HopeBlue3}"/>
                </Label.Foreground>
            </Label>

            <Button x:Name="Profile_btn" ToolTip="Login"
                    HorizontalAlignment="Left" Padding="5"
                    VerticalAlignment="Center" Width="45" Height="40" 
                    BorderBrush="{x:Null}" Foreground="{x:Null}" 
                    Click="Profile_btn_Click"   
                    HorizontalContentAlignment="Left" >
                <Button.Background>
                    <ImageBrush ImageSource="Images/Buttons/user.png"/>
                </Button.Background>
            </Button>

            <Button  x:Name="Online_Button" ToolTip="Online/Offline database"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Width="45" Height="40"
                    BorderBrush="{x:Null}" Foreground="{x:Null}" 
                    Click="Online_Button_Click" Margin="0,0,0,0" 
                    HorizontalContentAlignment="Left">
                <Button.Background>
                    <ImageBrush ImageSource="Images/Buttons/online.png"/>
                </Button.Background>
            </Button>

            <Button x:Name="Notification_Button" ToolTip="Notification"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Width="45" Height="40" 
                    BorderBrush="{x:Null}" Foreground="{x:Null}" 
                    Click="Notification_Button_Click" Margin="0,0,0,0" 
                    HorizontalContentAlignment="Left">
                <Button.Background>
                    <ImageBrush ImageSource="Images/Buttons/notification.png"/>
                </Button.Background>
                <Ellipse Fill="#FFBC0000" Width="10" Height="10" 
                         VerticalAlignment="Top" HorizontalAlignment="Right"
                         Margin="0,22,0,0" IsEnabled="False"  />
            </Button>
        </DockPanel>

        <!--controlzex:KeyboardNavigationEx.AlwaysShowFocusVisual="True"-->
        <Grid Grid.Row="2" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="619*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Expander_col" Width="20*" />
                <ColumnDefinition x:Name="Grid_col" Width="80*" />
            </Grid.ColumnDefinitions>
            <dragablz:TabablzControl x:Name="main_tabControl"  Style="{StaticResource TabablzControlStyle}"
                                 Margin="0,30,1,0" Width="auto" 
                                 ShowDefaultCloseButton="True"
                                 AdjacentHeaderItemOffset="10" 
                                 FlowDirection="RightToLeft" 
                                 FontFamily="Myriad Arabic" FontSize="20" FontWeight="Bold"
                                 EmptyHeaderSizingHint="PreviousTab" Grid.Column="1" Grid.RowSpan="2">


                <TabItem IsSelected="True">
                    <TabItem.Header>
                        <TextBlock Text="Home">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </TabItem.Header>
                    <Image Source="Images/MainForm/Home_Background2.jpg" Stretch="Fill" />
                </TabItem>
            </dragablz:TabablzControl>

            <Expander x:Name="myExpander" Grid.Column="0" IsExpanded="True"
            ExpandDirection="Left" 
            Expanded="myExpander_Expanded" Collapsed="myExpander_Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="#FF30323E" Margin="0,30,0,0" Grid.RowSpan="2">
                <Grid Margin="0,10,-38,0"  >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45" />
                        <RowDefinition Height="100*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*" />
                    </Grid.ColumnDefinitions>
                    <TreeView x:Name="MyTreeView" 
                              PreviewMouseRightButtonDown="MyTreeView_PreviewMouseRightButtonDown"
    
                              FontFamily="Myriad Arabic" FontSize="20" FontWeight="Bold"
                              Margin="0,0,0,10" Grid.Row="1">

                              
                         <TreeView.ContextMenu>
                        <ContextMenu Name="cm">
                            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                                <MenuItem.Icon>
                                    <Image Source="/Cashing;component/Images/refresh32.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                        </TreeView.ContextMenu>

                    </TreeView>
                </Grid>
            </Expander>
            <syncfusion:MenuAdv x:Name="MainMenu" Grid.ColumnSpan="2" BorderBrush="{x:Null}" Background="#FFFAFAFA" FontFamily="Myriad Arabic" FontSize="20" Height="31" VerticalAlignment="Center">
                <syncfusion:MenuItemAdv x:Name="AddNew_MenuItem" Header="Create New">
                    <syncfusion:MenuItemAdv Header="Donor" Click="Donor_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="City" Click="City_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Project" Click="Project_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Center" Click="Subproject_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Budget" Click="Budget_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Currency denominations" Click="Denominations_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Users" Click="User_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Approval Limits" Click="Approval_Limits_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Lines Lifetime" Click="Lines_Lifetime_MenuItemAdv_Click"/>

                </syncfusion:MenuItemAdv>
                <syncfusion:MenuItemAdv x:Name="Employee_MenuItem" Header="Volunteers">
                    <syncfusion:MenuItemAdv Header="Volunteers" Click="Employee_MenuItemAdv_Click" />
                    <syncfusion:MenuItemAdv Header="Monthly Salaries" Click="Monthly_Salaries_MenuItemAdv_Click" />
                </syncfusion:MenuItemAdv>
                <syncfusion:MenuItemAdv x:Name="Reports_MenuItem" Header="Reports">
                    <syncfusion:MenuItemAdv Header="Expenses Report" Click="Lines_Report_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Cash Balances" Click="Cash_Balances_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="All Budget Lines Report" Click="All_Budget_Lines_Report_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Revenue/Exchange Report" Click="Revenue_Exchange_Report_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Fixed Assets Report" Click="Fixed_Assets_Report_MenuItemAdv_Click"/>
                </syncfusion:MenuItemAdv>
                
                <syncfusion:MenuItemAdv x:Name="Approval_MenuItem" Header="Approval"/>

                <syncfusion:MenuItemAdv x:Name="Accountiing_Entries_MenuItem" Header="Accountiing Entries">
                    <syncfusion:MenuItemAdv Header="Single Entry" Click="Single_Entry_MenuItemAdv_Click"/>
                    <syncfusion:MenuItemAdv Header="Multi Entry (From Excel)" Click="Multi_Entry_MenuItemAdv_Click"/>
                </syncfusion:MenuItemAdv>

                <syncfusion:MenuItemAdv x:Name="Log_MenuItem" Header="Log" Click="Log_MenuItemAdv_Click"/>

            </syncfusion:MenuAdv>
        </Grid>

    </Grid>







<Window 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:local="clr-namespace:Financial_WPF_App" 
    xmlns:dragablz="http://dragablz.net/winfx/xaml/dragablz"
    xmlns:Themes="clr-namespace:Dragablz.Themes;assembly=Dragablz" 
    xmlns:Converters="clr-namespace:Dragablz.Converters;assembly=Dragablz"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:controlzex="urn:controlzex"
    x:Name="Main_Window2"  
    x:Class="Financial_WPF_App.Main_Window_2" mc:Ignorable="d"
    Title="" Height="720" Width="1280" WindowState="Maximized" SizeToContent="Manual" ResizeMode="CanResize"
    FontSize="12" Icon="Logo.ico" Closing="Main_Window2_Closing" Closed="Main_Window2_Closed" AllowsTransparency="True" WindowStyle="None" Background="Transparent" Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Converter Instance -->
        <local:TreeViewItemHeaderContainsWordConverter x:Key="HeaderWordConverter"/>
        <!-- Define the MenuIcons class as a static resource -->
        <local:MenuIcon x:Key="MenuIcon1" IconPath="/Images/MainForm/create_new.png" HoverIconPath="/Images/MainForm/create_new_hover.png" />
        <local:MenuIcon x:Key="MenuIcon2" IconPath="/Images/MainForm/volunteers.png" HoverIconPath="/Images/MainForm/volunteers_hover.png" />
        <local:MenuIcon x:Key="MenuIcon3" IconPath="/Images/MainForm/reports.png" HoverIconPath="/Images/MainForm/reports_hover.png" />
        <local:MenuIcon x:Key="MenuIcon4" IconPath="/Images/MainForm/approval.png" HoverIconPath="/Images/MainForm/approval_hover.png" />
        <local:MenuIcon x:Key="MenuIcon5" IconPath="/Images/MainForm/accountentries.png" HoverIconPath="/Images/MainForm/accountentries_hover.png" />
        <local:MenuIcon x:Key="MenuIcon6" IconPath="/Images/MainForm/log.png" HoverIconPath="/Images/MainForm/log_hover.png" />

        <!-- Custom Style for SubMenuItem -->
        <Style x:Key="SubMenuItemStyle" TargetType="{x:Type MenuItem}">
            <!-- Default Properties -->
            <Setter Property="FontFamily" Value="Rubik" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource DarkGray}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <!-- Main Content -->
                            <Border x:Name="Border" Padding="20,10,20,10"
                            Background="{TemplateBinding Background}" >
                                <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          ContentSource="Header" />
                            </Border>
                        </Grid>

                        <!-- Triggers for Hover and Selection -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFDCDDDE" />
                                <Setter Property="FontWeight" Value="DemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource GreenBlue}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource GreenBlue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Style for MenuItem -->
        <Style x:Key="MenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SubMenuItemStyle}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <!-- Main Content -->
                            <StackPanel  Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                <!-- Icon -->
                                <Image x:Name="IconImage" 
                               Source="{Binding IconPath}" 
                               Width="24" Height="24" 
                               Margin="5,0,5,0" 
                               VerticalAlignment="Top" />

                                <!-- Header -->
                                <TextBlock x:Name="MenuHeader"
                                   Text="{TemplateBinding Header}" 
                                   FontFamily="Rubik" FontSize="13.5"
                                   VerticalAlignment="Bottom" 
                                   Foreground="{DynamicResource DarkGray}" 
                                   FontWeight="Medium" />

                                <!-- Dropdown Arrow -->
                                <Image x:Name="ArrowImage" 
                               Source="/Images/Icons/dropdownarrow.png" 
                               Width="8" Height="8" 
                               Margin="5,0,0,5" 
                               VerticalAlignment="Bottom" />
                            </StackPanel>

                            <!-- Submenu Popup -->
                            <Popup IsOpen="{TemplateBinding IsSubmenuOpen}" VerticalOffset="5"
                           Placement="Bottom" 
                           PlacementTarget="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" 
                           AllowsTransparency="True" PopupAnimation="Fade"
                           Focusable="False" HorizontalOffset="20">
                                <Grid Background="#F0FFFFFF" Margin="5" Width="240">
                                    <Grid.Effect>
                                        <DropShadowEffect  BlurRadius="6" ShadowDepth="1" Opacity=".3" Color="{StaticResource Color_MidGray}" />
                                    </Grid.Effect>
                                    <Border Background="Transparent" CornerRadius="{StaticResource CornerRadius}">
                                        <StackPanel>
                                            <ItemsPresenter />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <!-- Triggers -->
                        <ControlTemplate.Triggers>
                            <!-- MouseOver -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuHeader" Property="Foreground" Value="{StaticResource GreenBlue}" />
                                <Setter TargetName="IconImage" Property="Source" Value="{Binding HoverIconPath}" />
                                <Setter TargetName="ArrowImage" Property="Source" Value="/Images/Icons/dropdownarrow_hover.png" />
                            </Trigger>

                            <!-- Submenu Open -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ArrowImage" Property="Source" Value="/Images/Icons/dropdownarrow_hover.png" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Custom Style for MenuItem Without Submenu -->
        <Style x:Key="MenuItemStyle1" TargetType="{x:Type MenuItem}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SubMenuItemStyle}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <!-- Main Content -->
                            <StackPanel  Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                <!-- Icon -->
                                <Image x:Name="IconImage" 
                       Source="{Binding IconPath}" 
                       Width="24" Height="24" 
                       Margin="5,0,5,0" 
                       VerticalAlignment="Top" />

                                <!-- Header -->
                                <TextBlock x:Name="MenuHeader"
                           Text="{TemplateBinding Header}" 
                           FontFamily="Rubik" FontSize="13.5"
                           VerticalAlignment="Bottom" 
                           Foreground="{DynamicResource DarkGray}" 
                           FontWeight="Medium" />
                            </StackPanel>
                        </Grid>

                        <!-- Triggers -->
                        <ControlTemplate.Triggers>
                            <!-- MouseOver -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuHeader" Property="Foreground" Value="{StaticResource GreenBlue}" />
                                <Setter TargetName="IconImage" Property="Source" Value="{Binding HoverIconPath}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ButtonHoverStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsEnabled="True" AutomationProperties.IsOffscreenBehavior="Default"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover Trigger -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{Binding Tag, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Override TabControlExt Style -->
        <Style TargetType="{x:Type syncfusion:TabControlExt}">
            <Setter Property="TabItemSelectedForeground" Value="{x:Null}" />
        </Style>
        <Style TargetType="{x:Type syncfusion:TabItemExt}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource LightGray1}"/>
            <Setter Property="Foreground" Value="{StaticResource DarkGray}"/>
            <Setter Property="Padding" Value="8,5,58,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AllowPin" Value="True"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="ShowPin" Value="True"/>
        </Style>

        <!-- Override TreeViewItem Style -->
        <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Stroke" Color="{StaticResource Color_DarkGray}"/>
        <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Fill" Color="{StaticResource Color_DarkGray}"/>
        <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Stroke" Color="{StaticResource Color_DarkGray}"/>
        <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Fill" Color="{StaticResource Color_DarkGray}"/>
        <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.Stroke" Color="#FF262626"/>
        <SolidColorBrush x:Key="TreeViewItem.TreeArrow.Static.Checked.Fill" Color="#FF595959"/>
        <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Checked.Stroke" Color="{StaticResource Color_DarkGray}"/>
        <SolidColorBrush x:Key="TreeViewItem.TreeArrow.MouseOver.Checked.Fill" Color="{StaticResource Color_DarkGray}"/>
        <PathGeometry x:Key="TreeArrow" Figures="M0,0 L0,6 L6,0 z"/>
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="Transparent" Height="16" Padding="5,5,5,5" Width="16">
                            <Path x:Name="ExpandPath" Data="{StaticResource TreeArrow}" Fill="{Binding Header, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource HeaderWordConverter}, ConverterParameter='Micro Projects|Budget|Exchange|Cash|Personal|Default'}" Stroke="{Binding Header, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource HeaderWordConverter}, ConverterParameter='Micro Projects|Budget|Exchange|Cash|Personal|Default'}">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="135" CenterX="3" CenterY="3"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="RenderTransform" TargetName="ExpandPath">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="3" CenterY="3"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Fill" TargetName="ExpandPath" Value="{Binding Header, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource HeaderWordConverter}, ConverterParameter='Micro Projects|Budget|Exchange|Cash|Personal|Default'}"/>
                                <Setter Property="Stroke" TargetName="ExpandPath" Value="{Binding Header, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource HeaderWordConverter}, ConverterParameter='Micro Projects|Budget|Exchange|Cash|Personal|Default'}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Stroke" TargetName="ExpandPath" Value="{StaticResource TreeViewItem.TreeArrow.MouseOver.Stroke}"/>
                                <Setter Property="Fill" TargetName="ExpandPath" Value="{StaticResource TreeViewItem.TreeArrow.MouseOver.Fill}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Stroke" TargetName="ExpandPath" Value="{StaticResource TreeViewItem.TreeArrow.MouseOver.Checked.Stroke}"/>
                                <Setter Property="Fill" TargetName="ExpandPath" Value="{StaticResource TreeViewItem.TreeArrow.MouseOver.Checked.Fill}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TreeViewItemFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="5,0,5,0" />
            <Setter Property="Foreground" Value="{StaticResource DarkGray}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource TreeViewItemFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <!-- Header -->
                                <RowDefinition Height="1" />
                                <!-- Separator Line -->
                                <RowDefinition />
                                <!-- Items -->
                            </Grid.RowDefinitions>

                            <!-- Header Content -->
                            <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="0"
                            SnapsToDevicePixels="True"
                            Grid.Row="0">
                                <DockPanel>
                                    <ToggleButton x:Name="Expander"
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource ExpandCollapseToggleStyle}" />
                                    <ContentPresenter x:Name="PART_Header"
                                              ContentSource="Header"
                                              Margin="6,6,6,6"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </DockPanel>
                            </Border>

                            <!-- Separator Line -->
                            <Border Grid.Row="1"
                            Background="{StaticResource LightGray2}"
                            Height="1"
                            HorizontalAlignment="Stretch" />

                            <!-- Items Presenter -->
                            <ItemsPresenter x:Name="ItemsHost"
                                    Grid.Row="2" />
                        </Grid>

                        <!-- Triggers -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="false">
                                <Setter Property="Visibility" TargetName="ItemsHost" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="false">
                                <Setter Property="Visibility" TargetName="Expander" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background"
                                Value="{StaticResource LightGray2}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource LightGray2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground"
                                Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid Background="White">
        <!-- Content Over Background -->
        <Grid  x:Name="main_grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="30*" />
                <RowDefinition Height="600*" />
                <RowDefinition Height="40*"  />
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Margin="0,0,0,-12">
                <local:WindowControlBar x:Name="ControlBar" HorizontalAlignment="Right"/>
            </DockPanel>


            <Grid Grid.Row="1" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="419*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="Expander_col" Width="20*" />
                    <ColumnDefinition x:Name="Grid_col" Width="80*" />
                </Grid.ColumnDefinitions>

                <!-- Main Content Border -->

                <syncfusion:TabControlExt Grid.Row="1" Grid.Column="1" SelectionChanged="TabControl_SelectionChanged"  x:Name="main_tabControl"
                        BorderThickness="0,0,0,0" CloseButtonType="Both" CloseTabOnMiddleClick="True" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Rubik" CloseMode="Delete" EnableLabelEdit="False" mah:HeaderedControlHelper.HeaderFontFamily="Rubik" TabPanelBackground="{StaticResource LightGray1}" TabItemSelectedBorderBrush="{x:Null}" TabItemHoverBorderBrush="{x:Null}" BorderBrush="Black" TabItemHoverForeground="Gray" Margin="0,19,30,20" TabItemSelectedBackground="{StaticResource LightGray1}" Panel.ZIndex="-2" TabItemSelectedForeground="{x:Null}" TabClosing="main_tabControl_TabClosing">
                    <syncfusion:TabControlExt.Background>
                        <ImageBrush ImageSource="/Images/MainForm/Home_Background2_new.png" Stretch="UniformToFill">
                            <ImageBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.05" ScaleY="1.05"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </ImageBrush.RelativeTransform>
                        </ImageBrush>
                    </syncfusion:TabControlExt.Background>
                    <syncfusion:TabControlExt.TabItemHoverBackground>
                        <SolidColorBrush Color="{DynamicResource Color_LightGray1}"/>
                    </syncfusion:TabControlExt.TabItemHoverBackground>
                    <syncfusion:TabControlExt.DragMarkerColor>
                        <SolidColorBrush Color="{DynamicResource Color_DarkGray}"/>
                    </syncfusion:TabControlExt.DragMarkerColor>
                </syncfusion:TabControlExt>

                <Grid Grid.ColumnSpan="2"  Background="#FFDCDDDE" Height="47" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <!-- Menu -->
                        <RowDefinition Height="*" />
                        <!-- Remaining Space -->
                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>
                    <Grid  Grid.Row="0"  Grid.ColumnSpan="2" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <!-- First column: Fixed width, remains static -->
                            <ColumnDefinition Width="200" MinWidth="100"/>
                            <!-- Second column: Proportional width, adapts to the available space -->
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <!-- Third column: Proportional width but smaller than the second column -->
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                        </Grid.ColumnDefinitions>
                        <!-- Logo -->
                        <Image Grid.Column="0" Source="/Images/MainForm/navlogo.png" Height="39" VerticalAlignment="Top"/>

                        <Menu Grid.Column="1" x:Name="MainMenu"  BorderBrush="{x:Null}"  Background="#FFDCDDDE" Margin="0,0,29,0">
                            <!-- Parent MenuItem with Submenus -->
                            <MenuItem x:Name="AddNew_MenuItem" Header="Create New" Style="{StaticResource MenuItemStyle}" DataContext="{Binding Source={StaticResource MenuIcon1}}">

                                <MenuItem Header="Donor" Click="Donor_MenuItemAdv_Click"/>
                                <MenuItem Header="City" Click="City_MenuItemAdv_Click"/>
                                <MenuItem Header="Project" Click="Project_MenuItemAdv_Click"/>
                                <MenuItem Header="Center" Click="Subproject_MenuItemAdv_Click"/>
                                <MenuItem Header="Budget" Click="Budget_MenuItemAdv_Click"/>
                                <MenuItem Header="Currency denominations" Click="Denominations_MenuItemAdv_Click"/>
                                <MenuItem Header="Users" Click="User_MenuItemAdv_Click"/>
                                <MenuItem Header="Approval Limits" Click="Approval_Limits_MenuItemAdv_Click"/>
                                <MenuItem Header="Lines Lifetime" Click="Lines_Lifetime_MenuItemAdv_Click"/>
                            </MenuItem>
                            <!-- MenuItem with Submenu (Employee) -->
                            <MenuItem x:Name="Employee_MenuItem" Header="Volunteers" Style="{StaticResource MenuItemStyle}" DataContext="{Binding Source={StaticResource MenuIcon2}}" VerticalAlignment="Bottom">
                                <MenuItem Header="Volunteers" Click="Employee_MenuItemAdv_Click"/>
                                <MenuItem Header="Monthly Salaries" Click="Monthly_Salaries_MenuItemAdv_Click"/>
                            </MenuItem>

                            <!-- MenuItem with Submenu (Reports) -->
                            <MenuItem x:Name="Reports_MenuItem" Header="Reports" Style="{StaticResource MenuItemStyle}" DataContext="{Binding Source={StaticResource MenuIcon3}}">
                                <MenuItem Header="Expenses Report" Click="Lines_Report_MenuItemAdv_Click" VerticalAlignment="Bottom"/>
                                <MenuItem Header="Cash Balances" Click="Cash_Balances_MenuItemAdv_Click"/>
                                <MenuItem Header="All Budget Lines Report" Click="All_Budget_Lines_Report_MenuItemAdv_Click"/>
                                <MenuItem Header="Revenue/Exchange Report" Click="Revenue_Exchange_Report_MenuItemAdv_Click"/>
                                <MenuItem Header="Fixed Assets Report" Click="Fixed_Assets_Report_MenuItemAdv_Click"/>
                            </MenuItem>

                            <MenuItem x:Name="Approval_MenuItem" Header="Approval" Style="{StaticResource MenuItemStyle}" DataContext="{Binding Source={StaticResource MenuIcon4}}" VerticalAlignment="Bottom"/>
                            <!-- MenuItem with Submenu (Accounting Entries) -->
                            <MenuItem x:Name="Accounting_Entries_MenuItem" Header="Accounting Entries" Style="{StaticResource MenuItemStyle}" DataContext="{Binding Source={StaticResource MenuIcon5}}" VerticalAlignment="Bottom">
                                <MenuItem Header="Single Entry" Click="Single_Entry_MenuItemAdv_Click"/>
                                <MenuItem Header="Multi Entry (From Excel)" Click="Multi_Entry_MenuItemAdv_Click"/>
                                <MenuItem Header="Multi Attachments (From Excel)" Click="MenuItemAdv_Click"/>
                            </MenuItem>

                            <!-- Regular MenuItem -->
                            <MenuItem x:Name="Log_MenuItem" Header="Log" Click="Log_MenuItemAdv_Click" Style="{StaticResource MenuItemStyle1}" DataContext="{Binding Source={StaticResource MenuIcon6}}" VerticalAlignment="Bottom"/>
                        </Menu>
                        <!-- Add a Grid for user-related controls -->
                        <Grid Grid.Column="2" FlowDirection="RightToLeft" Margin="0,0,140,0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <!--<ColumnDefinition Width="Auto" />-->
                            </Grid.ColumnDefinitions>

                            <!-- Notification Button -->
                            <!--<Grid Grid.Column="3" VerticalAlignment="Center">
                                <Button x:Name="Notification_Button" ToolTip="Notification"
     Width="30" BorderBrush="{x:Null}" Click="Notification_Button_Click" Height="30" FontFamily="Rubik" FontSize="14">
                                    <Button.Background>
                                        <ImageBrush ImageSource="/Images/Buttons/notification.png" Stretch="Uniform" />
                                    </Button.Background>
                                </Button>-->
                            <!-- Notification Badge -->
                            <!--<Ellipse Fill="#FFBC0000" Width="10" Height="10"
      VerticalAlignment="Top" HorizontalAlignment="Right"
      Margin="30,-5,0,0" IsEnabled="False" />-->
                            <!--</Grid>-->
                            <!-- Username Label -->
                            <Label x:Name="Username_label" Content="UserName" 
Grid.Column="0" FontFamily="Rubik" VerticalAlignment="Bottom">
                                <Label.Style>
                                    <Style TargetType="{x:Type Label}">
                                        <Setter Property="Foreground" Value="{DynamicResource GreenBlue}" />
                                    </Style>
                                </Label.Style>
                            </Label>

                            <!-- Profile Button -->
                            <Button x:Name="Profile_btn" ToolTip="Login" Grid.Column="1" Style="{DynamicResource ButtonHoverStyle}" Tag="/images/Buttons/user_hover.png" Cursor="Hand"
                                Width="25" Height="25" RenderTransformOrigin="0.5,0.5" BorderBrush="{x:Null}" Click="Profile_btn_Click" Margin="0,0,7,0">
                                <Button.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform />
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Button.RenderTransform>
                                <Button.Background>
                                    <ImageBrush ImageSource="/images/Buttons/user.png" Stretch="Uniform" />
                                </Button.Background>
                            </Button>

                            <!-- Online/Offline Button -->

                            <Button x:Name="Online_Button" ToolTip="Online/Offline Database" Grid.Column="2"
                                Cursor="Arrow" Width="25" Height="28" BorderBrush="{x:Null}" Margin="0,0,7,0">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/online.png" Stretch="Uniform" />
                                </Button.Background>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <Expander x:Name="myExpander" Grid.Column="0" IsExpanded="True"
                            ExpandDirection="Left" Loaded="myExpander_Loaded"
                            Expanded="myExpander_Expanded" Collapsed="myExpander_Collapsed" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Foreground="#FF30323E"  Background="White" Grid.Row="1" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="10" Margin="0,20,0,20"
                Grid.RowSpan="2"
                Background="White" Padding="5,5,5,5" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity=".3" Color="{StaticResource Color_MidGray}" />
                            </Border.Effect>
                            <TreeView ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource {x:Type TreeViewItem}}" x:Name="MyTreeView" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      PreviewMouseRightButtonDown="MyTreeView_PreviewMouseRightButtonDown"
                      FontFamily="Rubik" FontSize="14" Foreground="{StaticResource MidGray}"
                      Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="-5,0,0,0" Padding="3">
                 
                                <TreeView.ContextMenu>
                                    <ContextMenu x:Name="cm">
                                        <ContextMenu.Resources>
                                            <Style TargetType="{x:Type Border}" BasedOn="{StaticResource BorderStyle}" />
                                        </ContextMenu.Resources>
                                        <MenuItem Header="Refresh" Click="Refresh_Click">
                                            <MenuItem.Icon>
                                                <Image Source="/Cashing;component/Images/refresh32.png" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>
                        </Border>
                    </Grid>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</Window>

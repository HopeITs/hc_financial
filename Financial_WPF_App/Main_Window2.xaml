<Window 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:Fluent="clr-namespace:Fluent;assembly=Fluent"  
    xmlns:local="clr-namespace:Financial_WPF_App" 
    xmlns:dragablz="http://dragablz.net/winfx/xaml/dragablz"
    xmlns:Themes="clr-namespace:Dragablz.Themes;assembly=Dragablz" 
    xmlns:Converters="clr-namespace:Dragablz.Converters;assembly=Dragablz" 

    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    x:Name="Main_Window2"  
    x:Class="Financial_WPF_App.Main_Window_2" mc:Ignorable="d" 
    Title="" Height="720" Width="1280" WindowState="Maximized" ResizeMode="CanResize"
    FontSize="12" Icon="Logo.ico" Closing="Main_Window2_Closing" Closed="Main_Window2_Closed" AllowsTransparency="True" WindowStyle="None" >

    <Grid>

        <!-- Content Over Background -->
        <Grid  x:Name="main_grid" Grid.Row="0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />

                <RowDefinition Height="auto" />
                <RowDefinition Height="40"  />
                <RowDefinition/>
                <!--<RowDefinition Height="35"/>-->
            </Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <DockPanel Background="#FFDCDDDE" Grid.Row="0" MouseDown="TitleBar_MouseDown">
                <Label x:Name="Username_lable" Content="UserName" VerticalContentAlignment="Center" VerticalAlignment="Center" 
                   FontSize="14" Foreground="{DynamicResource GreenBlue}">
                </Label>

                <Button x:Name="Profile_btn" ToolTip="Login"
                    HorizontalAlignment="Left" Padding="5"
                    VerticalAlignment="Center" Width="45" Height="40" 
                    BorderBrush="{x:Null}" Foreground="{x:Null}" 
                    Click="Profile_btn_Click"   
                    HorizontalContentAlignment="Left" >
                    <Button.Background>
                        <ImageBrush ImageSource="Images/Buttons/user.png"/>
                    </Button.Background>
                </Button>

                <Button  x:Name="Online_Button" ToolTip="Online/Offline database"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Width="45" Height="40"
                    BorderBrush="{x:Null}" Foreground="{x:Null}" 
                    Click="Online_Button_Click" Margin="0,0,0,0" 
                    HorizontalContentAlignment="Left">
                    <Button.Background>
                        <ImageBrush ImageSource="Images/Buttons/online.png"/>
                    </Button.Background>
                </Button>

                <Button x:Name="Notification_Button" ToolTip="Notification"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Width="45" Height="40" 
                    BorderBrush="{x:Null}" Foreground="{x:Null}" 
                    Click="Notification_Button_Click" Margin="0,0,0,0" 
                    HorizontalContentAlignment="Left">
                    <Button.Background>
                        <ImageBrush ImageSource="Images/Buttons/notification.png"/>
                    </Button.Background>
                    <Ellipse Fill="#FFBC0000" Width="10" Height="10" 
                         VerticalAlignment="Top" HorizontalAlignment="Right"
                         Margin="0,22,0,0" IsEnabled="False"  />
                </Button>
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="Auto">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,16,1,0" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Minimize Button -->
                        <Button Width="15" Height="15" Grid.Column="0" Click="Minimize_Click"  Background="{StaticResource ButtonImageMinimize}" BorderBrush="{x:Null}" Foreground="{x:Null}" VerticalAlignment="Center" Margin="0,0,20,0" HorizontalAlignment="Right" />
                        <!-- Resize Button -->
                        <Button Width="15" Grid.Column="1" Click="Resize_Click" BorderBrush="{x:Null}" Foreground="{x:Null}" Height="15" VerticalAlignment="Center"
        HorizontalAlignment="Right" Margin="0,0,20,0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource ButtonImageRestore}" />
                                    <!-- Override the ControlTemplate to remove hover effect -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- Change to Restore Icon when the window is maximized -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                                            <Setter Property="Background" Value="{StaticResource ButtonImageMaximize}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Close Button -->
                        <Button x:Name="Close" Width="15" Height="15" Grid.Column="2" BorderBrush="{x:Null}" Foreground="{x:Null}" FontWeight="Normal" Background="{StaticResource ButtonImageClose}" Click="Close_Click" VerticalAlignment="Center"  HorizontalAlignment="Right" Margin="0,0,20,0"/>

                    </Grid>
                </Grid>
            </DockPanel>

            <!--controlzex:KeyboardNavigationEx.AlwaysShowFocusVisual="True"-->
            <Grid Grid.Row="2" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="619*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="Expander_col" Width="20*" />
                    <ColumnDefinition x:Name="Grid_col" Width="80*" />
                </Grid.ColumnDefinitions>
                <dragablz:TabablzControl x:Name="main_tabControl"  
                                 Margin="0,30,1,0" Width="auto" 
                                 ShowDefaultCloseButton="True"
                                 AdjacentHeaderItemOffset="10" 
                                 FlowDirection="RightToLeft" 
                                 FontFamily="Myriad Arabic" FontSize="20" FontWeight="Bold"
                                 EmptyHeaderSizingHint="PreviousTab" Grid.Column="1" Grid.RowSpan="2">


                    <TabItem IsSelected="True">
                        <TabItem.Header>
                            <TextBlock Text="Home">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </TabItem.Header>
                        <Image Source="Images/MainForm/Home_Background2.jpg" Stretch="Fill" />
                    </TabItem>
                </dragablz:TabablzControl>

                <Expander x:Name="myExpander" Grid.Column="0" IsExpanded="True"
            ExpandDirection="Left" 
            Expanded="myExpander_Expanded" Collapsed="myExpander_Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="#FF30323E" Margin="0,30,0,0" Grid.RowSpan="2">
                    <Grid Margin="0,10,-38,0"  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*" />
                        </Grid.ColumnDefinitions>
                        <TreeView x:Name="MyTreeView" 
                              PreviewMouseRightButtonDown="MyTreeView_PreviewMouseRightButtonDown"
    
                              FontFamily="Myriad Arabic" FontSize="20" FontWeight="Bold"
                              Margin="0,0,0,10" Grid.Row="1">


                            <TreeView.ContextMenu>
                                <ContextMenu Name="cm">
                                    <MenuItem Header="Refresh" Click = "Refresh_Click" >
                                        <MenuItem.Icon>
                                            <Image Source="/Cashing;component/Images/refresh32.png" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </TreeView.ContextMenu>

                        </TreeView>
                    </Grid>
                </Expander>
                <syncfusion:MenuAdv x:Name="MainMenu" Grid.ColumnSpan="2" BorderBrush="{x:Null}" Background="#FFFAFAFA" FontFamily="Myriad Arabic" FontSize="20" Height="31" VerticalAlignment="Center">
                    <syncfusion:MenuItemAdv x:Name="AddNew_MenuItem" Header="Create New">
                        <syncfusion:MenuItemAdv Header="Donor" Click="Donor_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="City" Click="City_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Project" Click="Project_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Center" Click="Subproject_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Budget" Click="Budget_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Currency denominations" Click="Denominations_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Users" Click="User_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Approval Limits" Click="Approval_Limits_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Lines Lifetime" Click="Lines_Lifetime_MenuItemAdv_Click"/>

                    </syncfusion:MenuItemAdv>
                    <syncfusion:MenuItemAdv x:Name="Employee_MenuItem" Header="Volunteers">
                        <syncfusion:MenuItemAdv Header="Volunteers" Click="Employee_MenuItemAdv_Click" />
                        <syncfusion:MenuItemAdv Header="Monthly Salaries" Click="Monthly_Salaries_MenuItemAdv_Click" />
                    </syncfusion:MenuItemAdv>
                    <syncfusion:MenuItemAdv x:Name="Reports_MenuItem" Header="Reports">
                        <syncfusion:MenuItemAdv Header="Expenses Report" Click="Lines_Report_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Cash Balances" Click="Cash_Balances_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="All Budget Lines Report" Click="All_Budget_Lines_Report_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Revenue/Exchange Report" Click="Revenue_Exchange_Report_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Fixed Assets Report" Click="Fixed_Assets_Report_MenuItemAdv_Click"/>
                    </syncfusion:MenuItemAdv>

                    <syncfusion:MenuItemAdv x:Name="Approval_MenuItem" Header="Approval"/>

                    <syncfusion:MenuItemAdv x:Name="Accounting_Entries_MenuItem" Header="Accounting Entries">
                        <syncfusion:MenuItemAdv Header="Single Entry" Click="Single_Entry_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Multi Entry (From Excel)" Click="Multi_Entry_MenuItemAdv_Click"/>
                        <syncfusion:MenuItemAdv Header="Multi Attachments (From Excel)" Click="MenuItemAdv_Click"/>

                    </syncfusion:MenuItemAdv>

                    <syncfusion:MenuItemAdv x:Name="Log_MenuItem" Header="Log" Click="Log_MenuItemAdv_Click"/>

                </syncfusion:MenuAdv>
            </Grid>

        </Grid>
    </Grid>

</Window>

    <Window.Resources>
        <!-- Define the MenuIcons class as a static resource -->
        <local:MenuIcon x:Key="MenuIcon1" IconPath="/Images/MainForm/create_new.png" HoverIconPath="/Images/MainForm/create_new_hover.png" />
        <local:MenuIcon x:Key="MenuIcon2" IconPath="/Images/MainForm/volunteers.png" HoverIconPath="/Images/MainForm/volunteers_hover.png" />
        <local:MenuIcon x:Key="MenuIcon3" IconPath="/Images/MainForm/reports.png" HoverIconPath="/Images/MainForm/reports_hover.png" />
        <local:MenuIcon x:Key="MenuIcon4" IconPath="/Images/MainForm/approval.png" HoverIconPath="/Images/MainForm/approval_hover.png" />
        <local:MenuIcon x:Key="MenuIcon5" IconPath="/Images/MainForm/accountentries.png" HoverIconPath="/Images/MainForm/accountentries_hover.png" />
        <local:MenuIcon x:Key="MenuIcon6" IconPath="/Images/MainForm/log.png" HoverIconPath="/Images/MainForm/log_hover.png" />

        <!-- Custom Style for SubMenuItem -->
        <Style x:Key="SubMenuItemStyle" TargetType="{x:Type MenuItem}">
            <!-- Default Properties -->
            <Setter Property="FontFamily" Value="Rubik" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource DarkGray}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <!-- Main Content -->
                            <Border x:Name="Border" Padding="20,10,20,10"
                            Background="{TemplateBinding Background}" >
                                <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          ContentSource="Header" />
                            </Border>
                        </Grid>

                        <!-- Triggers for Hover and Selection -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFDCDDDE" />
                                <Setter Property="FontWeight" Value="DemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource GreenBlue}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource GreenBlue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Style for MenuItem -->
        <Style x:Key="MenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SubMenuItemStyle}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <!-- Main Content -->
                            <StackPanel  Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                <!-- Icon -->
                                <Image x:Name="IconImage" 
                               Source="{Binding IconPath}" 
                               Width="24" Height="24" 
                               Margin="5,0,5,0" 
                               VerticalAlignment="Top" />

                                <!-- Header -->
                                <TextBlock x:Name="MenuHeader"
                                   Text="{TemplateBinding Header}" 
                                   FontFamily="Rubik" FontSize="13.5"
                                   VerticalAlignment="Bottom" 
                                   Foreground="{DynamicResource DarkGray}" 
                                   FontWeight="Medium" />

                                <!-- Dropdown Arrow -->
                                <Image x:Name="ArrowImage" 
                               Source="/Images/Icons/dropdownarrow.png" 
                               Width="8" Height="8" 
                               Margin="5,0,0,5" 
                               VerticalAlignment="Bottom" />
                            </StackPanel>

                            <!-- Submenu Popup -->
                            <Popup IsOpen="{TemplateBinding IsSubmenuOpen}" VerticalOffset="5"
                           Placement="Bottom" 
                           PlacementTarget="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}" 
                           AllowsTransparency="True" PopupAnimation="Fade"
                           Focusable="False" HorizontalOffset="20">
                                <Grid Background="#F0FFFFFF" Margin="5" Width="240">
                                    <Grid.Effect>
                                        <DropShadowEffect  BlurRadius="6" ShadowDepth="1" Opacity=".3" Color="{StaticResource Color_MidGray}" />
                                    </Grid.Effect>
                                    <Border Background="Transparent" CornerRadius="{StaticResource CornerRadius}">
                                        <StackPanel>
                                            <ItemsPresenter />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <!-- Triggers -->
                        <ControlTemplate.Triggers>
                            <!-- MouseOver -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuHeader" Property="Foreground" Value="{StaticResource GreenBlue}" />
                                <Setter TargetName="IconImage" Property="Source" Value="{Binding HoverIconPath}" />
                                <Setter TargetName="ArrowImage" Property="Source" Value="/Images/Icons/dropdownarrow_hover.png" />
                            </Trigger>

                            <!-- Submenu Open -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ArrowImage" Property="Source" Value="/Images/Icons/dropdownarrow_hover.png" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Custom Style for MenuItem Without Submenu -->
        <Style x:Key="MenuItemStyle1" TargetType="{x:Type MenuItem}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SubMenuItemStyle}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">

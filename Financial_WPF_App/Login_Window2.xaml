                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsEnabled="True" AutomationProperties.IsOffscreenBehavior="Default"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover Trigger -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowStyle" TargetType="{x:Type Window}">
            <Setter Property="Foreground" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="ResizeMode" Value="NoResize"></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Label" BasedOn="{x:Null}">
            <Setter Property="FontFamily" Value="Digital-7" />
        </Style>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="WEB_Butten">
            <BeginStoryboard x:Name="WEB_Click_BeginStoryboard" Storyboard="{StaticResource WEB Click}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Power_On}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Login_Butten">
            <BeginStoryboard x:Name="Login_Click_Animation_BeginStoryboard1" Storyboard="{StaticResource Login_Click_Animation}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Remember_Me_Butten">
            <BeginStoryboard x:Name="Remember_Me_Pressed_BeginStoryboard1" Storyboard="{StaticResource Remember_Me_Pressed}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Remember_Me_Butten">
            <StopStoryboard BeginStoryboardName="Remember_Me_Pressed_BeginStoryboard1"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Remember_Me_Butten_Copy">
            <BeginStoryboard x:Name="Remembe_me_unpressed_BeginStoryboard1" Storyboard="{StaticResource Remembe_me_unpressed}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Online_Butten">
            <BeginStoryboard x:Name="Online_Pressed_BeginStoryboard1" Storyboard="{StaticResource Online_Pressed}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Online_Butten">
            <PauseStoryboard BeginStoryboardName="Online_Pressed_BeginStoryboard1"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Online_Butten_Copy">
            <BeginStoryboard x:Name="Online_Unpressed_BeginStoryboard1" Storyboard="{StaticResource Online_Unpressed}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Online_Butten_Copy">
            <PauseStoryboard BeginStoryboardName="Online_Unpressed_BeginStoryboard1"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Online_Butten">
            <BeginStoryboard x:Name="Online_Working_Loop_BeginStoryboard1" Storyboard="{StaticResource Online_Working_Loop}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Shutdown_btn">
            <BeginStoryboard x:Name="Shutdown_Pressed_BeginStoryboard" Storyboard="{StaticResource Shutdown_Pressed}"/>
        </EventTrigger>
    </Window.Triggers>
    <Grid MouseDown="TitleBar_MouseDown">
        <!-- Main Layout -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <!-- Background Image -->
            <Image Source="/Images/Login/Cover.png" Stretch="Uniform" />
            <!-- Buttons Over Image -->
            <Rectangle x:Name="WEB_RED" HorizontalAlignment="Left" Height="12" Margin="332,358,0,0" VerticalAlignment="Top" Width="23">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="/Images/Login/Asset 58.png"/>
                </Rectangle.Fill>
            </Rectangle>
            <Button x:Name="WEB_Butten" Content="" Margin="331,357,309,329" BorderBrush="{x:Null}" Click="WEB_Butten_Click" Style="{DynamicResource ButtonHoverStyle}" RenderTransformOrigin="0.5,0.5" ToolTip="Our Website" Cursor="Hand" Tag="/Images/Login/Asset 58.png">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/WEB.png"/>
                </Button.Background>
            </Button>
            <Rectangle x:Name="rectangle" Margin="94,306,370,309" StrokeThickness="0"/>
            <Label x:Name="Welcome" Content="Server-Error" Margin="94,306,372,311" Foreground="#FF17778D" RenderTransformOrigin="0.5,0.5" FontSize="25" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Visibility="Collapsed">
                <Label.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Label.RenderTransform>
                <Label.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Digital-7" FontSize="32" />
                    </DataTemplate>
                </Label.ContentTemplate>
            </Label>
            <Label x:Name="Login__Please" HorizontalAlignment="Left" Height="83" Margin="94,306,0,0" VerticalAlignment="Top" Width="199" RenderTransformOrigin="0.5,0.5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Label.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Label.RenderTransform>

                <Label x:Name="Power_On" Content="POWER ON" HorizontalAlignment="Center" Height="83" VerticalAlignment="Top" Width="199" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#FF17778D">
                    <Label.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Digital-7" FontSize="35" />
                        </DataTemplate>
                    </Label.ContentTemplate>
                </Label>
                <Label.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Digital-7" FontSize="33" />
                    </DataTemplate>
                </Label.ContentTemplate>
            </Label>
            <Label x:Name="Usr_or_pw_inc" Content="Login Please" Margin="94,306,372,311" RenderTransformOrigin="0.5,0.5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FF17778D" Visibility="Collapsed">
                <Label.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Label.RenderTransform>
                <Label.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Digital-7" FontSize="25"/>
                    </DataTemplate>
                </Label.ContentTemplate>
            </Label>
            <Label x:Name="Power_on" Content="Power-on" Height="83" Margin="94,306,372,311" Width="199" FontSize="35" Foreground="#FF17778D" Visibility="Collapsed">
                <Label.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Digital-7"/>
                    </DataTemplate>
                </Label.ContentTemplate>
            </Label>
            <Button x:Name="Shutdown_btn_Copy" Content="" Margin="357,357,283,311" BorderBrush="{x:Null}" Height="32"   Click="Close_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/power2.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Shutdown_btn" Content="" Margin="357,357,283,311" BorderBrush="{x:Null}"  Click="Shutdown_btn_Click" ToolTip="Shut Down" Cursor="Hand" Width="25" Height="32" Style="{DynamicResource ButtonHoverStyle}">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/power.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Online_Butten_Copy" Content="Button" Margin="331,371,309,311" BorderBrush="{x:Null}" Foreground="{x:Null}" Style="{DynamicResource ButtonToggleStyle}" ToolTip="Online Database" Cursor="Hand" Width="25">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/Online.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Online_Butten" Margin="331,371,309,311" BorderBrush="{x:Null}" Foreground="{x:Null}" Style="{DynamicResource ButtonToggleStyle}" Click="Online_Butten_Click"  ToolTip="Offline Database" Cursor="Hand" d:IsHidden="True">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/Online2.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Remember_Me_Butten_Copy" Content="" Margin="305,357,335,311" BorderBrush="{x:Null}" Foreground="{x:Null}" Style="{DynamicResource ButtonToggleStyle}" Click="Remember_Me_Butten_Copy_Click" ToolTip="Remember Me" Cursor="Hand">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/Remember.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Remember_Me_Butten" Content="" Margin="305,357,335,311" BorderBrush="{x:Null}" Foreground="{x:Null}" Style="{DynamicResource ButtonToggleStyle}" Click="Remember_Me_Butten_Click" RenderTransformOrigin="0.5,0.5" ToolTip="Remember Me" Cursor="Hand" Width="25" Height="32">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/Remember2.png"/>
                </Button.Background>
            </Button>

            <CheckBox x:Name="Remember_checkBox_Copy" Content="Remember Me" HorizontalAlignment="Left" Margin="-145,806.605,0,0" VerticalAlignment="Top" OpacityMask="Black" RenderTransformOrigin="0.5,0.5">
                <CheckBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </CheckBox.RenderTransform>
            </CheckBox>
            <CheckBox x:Name="checkBox_Copy" Content="Online" HorizontalAlignment="Left" Margin="-145,786.506,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                <CheckBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </CheckBox.RenderTransform>
            </CheckBox>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Controls row -->
                <RowDefinition Height="*" />
                <!-- Main content row -->
            </Grid.RowDefinitions>
            <Grid Margin="632,16,13,436" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!--<ColumnDefinition Width="*" />-->
                </Grid.ColumnDefinitions>

                <!-- Minimize Button -->
                <Button Width="15" Height="15" Grid.Column="0" Click="Minimize_Click"  BorderBrush="{x:Null}" Foreground="{x:Null}" Background="{StaticResource ButtonImageMinimize}"></Button>
                <!-- Close Button -->
                <!--<Button x:Name="Close" Width="15" Height="15" Grid.Column="1" Click="Close_Click" BorderBrush="{x:Null}" Foreground="{x:Null}" FontWeight="Normal" Grid.ColumnSpan="2" Background="{StaticResource ButtonImageClose}"/>-->

            </Grid>
            <!-- Logo -->
            <Image Source="/Images/Login/App Logo.ico" Margin="121,149,121,141" />


            <!-- Main content -->
            <!--Username-->
            <Border Style="{StaticResource BorderStyle}"
                Margin="164,350,164,72"  Effect="{StaticResource ShadowEffect}">
                <Grid>
                    <!-- Placeholder Text -->
                    <TextBlock x:Name="Text" Text="Username" Style="{StaticResource PlaceholderTextStyle}"
                  
                   Margin="15,0,0,0" FontSize="16" Width="310">
                    </TextBlock>

                    <!-- Input TextBox -->
                    <TextBox x:Name="username_txt" TabIndex="1" Style="{StaticResource TextBoxStyle}"
                        FontSize="16"  Margin="15,0,0,0"></TextBox>
                </Grid>
            </Border>
            <!--Password-->
            <Border Style="{StaticResource BorderStyle}" Margin="164,416,164,6" Effect="{StaticResource ShadowEffect}">
                <Grid>
                    <!-- Placeholder Text -->
                    <TextBlock x:Name="Password" Text="Password" Margin="15,0,0,0" FontSize="16"  Width="313" Style="{StaticResource PlaceholderPasswordStyle}"></TextBlock>


                    <!-- PasswordBox -->
                    <PasswordBox  x:Name="password_txt1" TabIndex="2" 
                    Style="{StaticResource PasswordBoxStyle}"
                     FontSize="16" PasswordChar="*"
                     PasswordChanged="OnPasswordChange" Margin="15,0,0,0">
                    </PasswordBox>
                </Grid>
            </Border>

            <Button x:Name="Login_Butten" Content="Login"  IsDefault="True" Margin="426,7,163,187"
                    RenderTransformOrigin="0.5,0.5" Style="{StaticResource ButtonStyle}" 
                    Click="Login_Butten_Click_1" Grid.Row="1" FontSize="17">
            </Button>
        </Grid>
    </Grid>
</Window>

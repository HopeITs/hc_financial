                        <Image.OpacityMask>
                            <ImageBrush ImageSource="/Images/Buttons/close.png"/>
                        </Image.OpacityMask>
                    </Image>
                </Button>
            </Grid>
            <!-- Logo -->
            <Image Source="/Images/Login/App Logo.ico" Margin="121,149,121,141" />


            <!-- Main content -->
            <!--Username-->
            <Border CornerRadius="5" Background="White" BorderBrush="#939598" BorderThickness=".5" 
        Margin="164,350,164,72" Height="50" Effect="{StaticResource ShadowEffect}">
                <Grid>
                    <!-- Placeholder Text -->
                    <TextBlock x:Name="UsernamePlaceholder" Text="Username" 
                   VerticalAlignment="Center" HorizontalAlignment="Left" 
                   Margin="15,0,0,0" FontSize="16" Foreground="#939598" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=username_txt}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=username_txt}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=username_txt}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Input TextBox -->
                    <TextBox x:Name="username_txt" Background="Transparent" BorderThickness="0" TabIndex="1"
                 VerticalContentAlignment="Center" FontSize="16" Foreground="#939598" Margin="15,0,0,0" SelectionTextBrush="White" SelectionBrush="#FF17778D">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" 
                            BorderThickness="0" 
                            Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" 
                                      HorizontalScrollBarVisibility="Hidden" 
                                      VerticalScrollBarVisibility="Hidden" />
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <!--Password-->
            <Border CornerRadius="5" Background="White" BorderBrush="#DCDDDE" BorderThickness="1"
        Margin="164,416,164,6" Effect="{StaticResource ShadowEffect}">
                <Grid>
                    <!-- Placeholder Text -->
                    <TextBlock x:Name="Password" Text="Password" 
VerticalAlignment="Center" 
Margin="15,0,0,0" FontSize="16" Foreground="#939598" IsHitTestVisible="False" HorizontalAlignment="Left" Width="310">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Password, ElementName=password_txt1}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Password, ElementName=password_txt1}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Password, ElementName=password_txt1}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>


                    <!-- PasswordBox -->
                    <PasswordBox x:Name="password_txt1" TabIndex="2" FocusVisualStyle="{x:Null}" BorderThickness="0"
                     Background="Transparent" BorderBrush="{x:Null}" 
                     FontFamily="Digital-7" FontSize="16" Foreground="#939598" PasswordChar="*" 
                     VerticalContentAlignment="Center"
                     PasswordChanged="OnPasswordChange" Margin="15,0,0,0" SelectionBrush="#FF17778D" SelectionTextBrush="White">
                        <PasswordBox.Template>
                            <ControlTemplate TargetType="PasswordBox">
                                <Border Background="{TemplateBinding Background}" 
    BorderThickness="0" 
    Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" 
              HorizontalScrollBarVisibility="Hidden" 
              VerticalScrollBarVisibility="Hidden" />
                                </Border>
                            </ControlTemplate>
                        </PasswordBox.Template>
                    </PasswordBox>
                </Grid>
            </Border>

            <Button x:Name="Login_Butten" Content="Login"  IsDefault="True" Margin="426,7,163,187" BorderBrush="{x:Null}"
         RenderTransformOrigin="0.5,0.5" 
        Click="Login_Butten_Click_1" ToolTip="Login" Cursor="Hand" BorderThickness="0" Grid.Row="1" Background="#FF17778D" Foreground="#FFF1F2F2" FontSize="17">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="5" Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>

        <Style x:Key="ButtonToggleStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsEnabled="True" AutomationProperties.IsOffscreenBehavior="Default"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <ImageBrush ImageSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ButtonHoverStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsEnabled="True" AutomationProperties.IsOffscreenBehavior="Default"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover Trigger -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowStyle" TargetType="{x:Type Window}">
            <Setter Property="Foreground" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="ResizeMode" Value="NoResize"></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Label" BasedOn="{x:Null}">
            <Setter Property="FontFamily" Value="Digital-7" />
        </Style>
    </Window.Resources>


    <Window.Triggers>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="WEB_Butten">
            <BeginStoryboard x:Name="WEB_Click_BeginStoryboard" Storyboard="{StaticResource WEB Click}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Power_On}"/>
        </EventTrigger>

 



        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Remember_Me_Butten">
            <BeginStoryboard x:Name="Remember_Me_Pressed_BeginStoryboard1" Storyboard="{StaticResource Remember_Me_Pressed}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Remember_Me_Butten">
            <StopStoryboard BeginStoryboardName="Remember_Me_Pressed_BeginStoryboard1"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Remember_Me_Butten_Copy">
            <BeginStoryboard x:Name="Remembe_me_unpressed_BeginStoryboard1" Storyboard="{StaticResource Remembe_me_unpressed}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Online_Butten">
            <BeginStoryboard x:Name="Online_Pressed_BeginStoryboard1" Storyboard="{StaticResource Online_Pressed}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Online_Butten">
            <PauseStoryboard BeginStoryboardName="Online_Pressed_BeginStoryboard1"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Online_Butten_Copy">
            <BeginStoryboard x:Name="Online_Unpressed_BeginStoryboard1" Storyboard="{StaticResource Online_Unpressed}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Online_Butten_Copy">
            <PauseStoryboard BeginStoryboardName="Online_Unpressed_BeginStoryboard1"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Online_Butten">
            <BeginStoryboard x:Name="Online_Working_Loop_BeginStoryboard1" Storyboard="{StaticResource Online_Working_Loop}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="Shutdown_btn">
            <BeginStoryboard x:Name="Shutdown_Pressed_BeginStoryboard" Storyboard="{StaticResource Shutdown_Pressed}"/>
        </EventTrigger>
    </Window.Triggers>


    <Grid MouseDown="TitleBar_MouseDown">
        <!-- Main Layout -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <!-- Background Image -->
            <Image Source="/Images/Login/Cover.png" Stretch="UniformToFill" />
            <!-- Buttons Over Image -->
            <Rectangle x:Name="WEB_RED" HorizontalAlignment="Left" Height="12" Margin="332,358,0,0" VerticalAlignment="Top" Width="23">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="/Images/Login/Asset 58.png"/>
                </Rectangle.Fill>
            </Rectangle>
            <Button x:Name="WEB_Butten" Content="" Margin="331,357,309,329" BorderBrush="{x:Null}" Click="WEB_Butten_Click" Style="{DynamicResource ButtonHoverStyle}" RenderTransformOrigin="0.5,0.5" ToolTip="Our Website" Cursor="Hand" Tag="/Images/Login/Asset 58.png">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/WEB.png"/>
                </Button.Background>
            </Button>
            <Rectangle x:Name="rectangle" Margin="94,306,370,309" StrokeThickness="0"/>
            <Button x:Name="Shutdown_btn_Copy" Content="" Margin="357,357,283,311" BorderBrush="{x:Null}" Height="32"   Click="Close_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/power2.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Shutdown_btn" Content="" Margin="357,357,283,311" BorderBrush="{x:Null}"  Click="Shutdown_btn_Click" ToolTip="Shut Down" Cursor="Hand" Width="25" Height="32" Style="{DynamicResource ButtonHoverStyle}">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/power.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Online_Butten_Copy" Content="Button" Margin="331,371,309,311" BorderBrush="{x:Null}" Foreground="{x:Null}" Style="{DynamicResource ButtonToggleStyle}" Click="Online_Butten_Click" ToolTip="Online Database" Cursor="Hand" Width="25" Height="23">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/Online.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Online_Butten" Margin="331,371,309,311" BorderBrush="{x:Null}" Foreground="{x:Null}" Style="{DynamicResource ButtonToggleStyle}" Click="Online_Butten_Click"  ToolTip="Offline Database" Cursor="Hand" d:IsHidden="True">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/Online2.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Remember_Me_Butten_Copy" Content="" Margin="305,357,335,311" BorderBrush="{x:Null}" Foreground="{x:Null}" Style="{DynamicResource ButtonToggleStyle}" Click="Remember_Me_Butten_Copy_Click" ToolTip="Remember Me" Cursor="Hand">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/Remember.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="Remember_Me_Butten" Content="" Margin="357,320,118,148" BorderBrush="{x:Null}" Foreground="{x:Null}" Style="{DynamicResource ButtonToggleStyle}" Click="Remember_Me_Butten_Click" RenderTransformOrigin="0.5,0.5" ToolTip="Remember Me" Cursor="Hand" Width="25" Height="32">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Login/Remember2.png"/>
                </Button.Background>
            </Button>

            <CheckBox x:Name="Remember_checkBox_Copy" Content="Remember Me" HorizontalAlignment="Left" Margin="-145,806.605,0,0" VerticalAlignment="Top" OpacityMask="Black" RenderTransformOrigin="0.5,0.5">
                <CheckBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </CheckBox.RenderTransform>
            </CheckBox>
            <CheckBox x:Name="checkBox_Copy" Content="Online" HorizontalAlignment="Left" Margin="-145,786.506,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                <CheckBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </CheckBox.RenderTransform>
            </CheckBox>
            <Grid Margin="94,306,372,311">
                <Label x:Name="Welcome" Content="Welcome" FontSize="22" Foreground="#FF17778D" Height="83"  Width="199" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" RenderTransformOrigin="0.5,0.5" Padding="5,5,5,31">
                    <Label.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Label.RenderTransform>
                    <Label.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Digital-7"/>
                        </DataTemplate>
                    </Label.ContentTemplate>
                </Label>
                <Label x:Name="Power_On" Content="POWER ON" FontSize="22" HorizontalAlignment="Center" Height="83" VerticalAlignment="Center" Width="200" VerticalContentAlignment="Center" Foreground="#FF17778D" RenderTransformOrigin="0.5,0.5" HorizontalContentAlignment="Center" Padding="5,5,5,5">
                    <Label.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Digital-7"/>
                        </DataTemplate>
                    </Label.ContentTemplate>
                </Label>
                <Label x:Name="Login__Please" FontSize="22" Height="83"  Width="199" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Please Login" Foreground="#FF17778D" RenderTransformOrigin="0.5,0.5" Padding="5,31,5,5">
                    <Label.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Label.RenderTransform>
                    <Label.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Digital-7"/>
                        </DataTemplate>
                    </Label.ContentTemplate>
                </Label>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- Controls row -->
                <RowDefinition Height="*" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <!-- Main content row -->
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <!-- Minimize Button -->
                <Button Width="15" Height="15" Grid.Column="0" Click="Minimize_Click"  BorderBrush="{x:Null}" Foreground="{x:Null}" Background="{StaticResource ButtonImageMinimize}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,15,15,0"></Button>
                <!-- Close Button -->
                <!--<Button x:Name="Close" Width="15" Height="15" Grid.Column="1" Click="Close_Click" BorderBrush="{x:Null}" Foreground="{x:Null}" FontWeight="Normal" Grid.ColumnSpan="2" Background="{StaticResource ButtonImageClose}"/>-->
            </Grid>
            <!-- Logo -->
                <Image Grid.Row="1" Source="/Images/Login/App Logo.ico" Width="267"/>
            


                <!--Username-->
            <Border Style="{StaticResource BorderStyle}" Grid.Row="2" Effect="{StaticResource ShadowEffect}" Height="40" Width="250">
                <TextBox x:Name="username_txt" TabIndex="1" Tag="Username" Style="{StaticResource TextBoxStyle}"/>
            </Border>
            
                <!--Password-->
            <Border Margin="0,15,0,0" Style="{StaticResource BorderStyle}"  Grid.Row="3" Effect="{StaticResource ShadowEffect}" Height="40"  Width="250">
                <Grid>
                    <!-- Placeholder Text -->
                    <TextBlock x:Name="Password" Text="Password" FontSize="16" Style="{StaticResource PlaceholderPasswordStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Center"></TextBlock>
                    <!-- PasswordBox -->
                    <PasswordBox  x:Name="password_txt1" TabIndex="2" 
        Style="{StaticResource PasswordBoxStyle}"
         FontSize="16" PasswordChar="*"
         PasswordChanged="OnPasswordChange" Height="40">
                    </PasswordBox>
                </Grid>
            </Border>
            <Grid Grid.Row="4" Width="250" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="Login_Butten" Grid.Column="1" Content="Login"  IsDefault="True" Height="30"
        RenderTransformOrigin="0.5,0.5" Style="{StaticResource ButtonColoredStyle}" 
        Grid.Row="1" FontSize="17" Click="Login_Butten_Click" VerticalAlignment="Center" HorizontalAlignment="Right" Width="70">
                </Button>
            </Grid>


            <Label x:Name="Version_Label" Content="Version" Style="{StaticResource Version_Label}"  Grid.Row="5" HorizontalContentAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:System="clr-namespace:System;assembly=mscorlib" 
        mc:Ignorable="d" Height="700" Width="1330" 
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True"
        KeyDown="LoginWindow_KeyDown" AllowsTransparency="True" Icon="Logo.ico" 
        Style="{DynamicResource WindowStyle}">

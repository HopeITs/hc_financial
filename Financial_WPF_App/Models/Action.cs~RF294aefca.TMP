using MySql.Data.MySqlClient;
using System;
using System.Data;
using System.Data.SqlTypes;

namespace Financial_WPF_App.Models
{
    public class Action
    {
        public Action()
        {

        }

        public DataTable Select(string Action_ID, string Till_IDs, string SubProject_ID
            , string AType, string Till_Type, string date, bool showClosed)
        {
            string query = @"SELECT action.`ID` as 'ID' , `ActionNumber`, tilltypes.`Name`, `Amount`
, IFNULL((select a.Amount from action a left join actiontype on a.atype_id = actiontype.id where actiontype.shortname = 'I' and a.ID = action.ID),0) as 'Income'
, IFNULL((select a.Amount from action a left join actiontype on a.atype_id = actiontype.id where actiontype.shortname = 'O' and a.ID = action.ID),0) as 'Outcome'
, IFNULL((select a.Amount from action a left join actiontype on a.atype_id = actiontype.id where actiontype.shortname = 'R' and a.ID = action.ID),0) as 'Returned'
, IFNULL((select a.Amount from action a left join actiontype on a.atype_id = actiontype.id where actiontype.shortname = 'E' and a.ID = action.ID),0) as 'Expand'
, `MicroProject_ID`
, (select CONCAT(`FirstName`,' ',`LastName`) from beneficiary  JOIN account on beneficiary.Account_ID = account.ID
                where beneficiary.MicroProject_ID = action.MicroProject_ID ) as 'Name'
, action.`Date`, action.`Note` 
, `Rate`, `Exchanged`
, (case `IsReceipt` when 0 then 'إيصال' when 1 then 'فاتورة' else '' end) as 'IsReceipt' 
, `ReceiptNote`
, (select Name from rate where ID = action.Rate_ID) as 'AvgRate' ,`USD_Value`
, `Line_ID`, `IncomeType_ID`, `OutcomePlace_ID`
, `Rate_ID`, `Till_ID`, `ObserveTill_ID`, till.`Account_ID`
, fiscalbond.ID as 'FiscalBond_ID' ,fiscalbond.Name as 'FiscalBond'
, created_at

 FROM `action` 
 LEFT join `till` on action.Till_ID = till.ID
 LEFT join `tilltypes` on tilltypes.ID = till.Type_ID
 LEFT join `account` on account.ID = till.Account_ID
 Left join `fiscalbond` on fiscalbond.Account_ID = account.ID ";

            string condition = " where 1 ";


            if (Action_ID != "")
            {
                condition += " and action.ID in (@Action_ID)";
            }
            if (Till_IDs != "")
            {
                condition += " and Till_ID in (@Till_IDs)";
            }
            if (SubProject_ID != "-1" && SubProject_ID != "")
            {
                condition += " and account.SubProject_ID = @SubProject_ID";
            }
            if (AType != "")
            {
                condition += " and account.Name like '%@AType%'";
            }
            if (date != "")
            {
                condition += " and DATE(created_at) = @date ";
            }
            if (Till_Type != "")
            {
                condition += " and tilltypes.Name like Till_Type ";
            }

            if (!showClosed) condition += " and account.IsClosed = 0 ";

            query += condition;

            DataTable dt = new DataTable();
            if (Login.BuildConnection())
            {
                MySqlCommand sc = new MySqlCommand();

                sc.Parameters.AddWithValue("@Action_ID", Action_ID);
                sc.Parameters.AddWithValue("@Till_IDs", Till_IDs);
                sc.Parameters.AddWithValue("@SubProject_ID", SubProject_ID);
                sc.Parameters.AddWithValue("@AType", AType);
                sc.Parameters.AddWithValue("@Till_Type", Till_Type);
                sc.Parameters.AddWithValue("@date", date);

                sc.CommandText = query;
                sc.Connection = Login.MyConn;

                MySqlDataAdapter da = new MySqlDataAdapter(sc);
                da.Fill(dt);
                Login.MyConn.Close();
            }
            return dt;
        }

        public DataTable Select_Sums(string Till_IDs, string date)
        {
            //check user from database
            string sub_condition = " WHERE action.Till_ID in (@Till_IDs) ";
            if (date != "")
            {
                sub_condition += " and action.Date = @date ";
            }

            string query = @"SELECT  
   (SELECT IFNULL(sum(`Amount`),0) FROM action left join actiontype on action.atype_id = actiontype.id" + sub_condition + " and actiontype.shortname like 'I') as 'SumI' " +
", (SELECT IFNULL(sum(`Amount`),0) FROM action left join actiontype on action.atype_id = actiontype.id" + sub_condition + " and actiontype.shortname like 'O') as 'SumO' " +
", (SELECT IFNULL(sum(`Amount`),0) FROM action left join actiontype on action.atype_id = actiontype.id" + sub_condition + " and actiontype.shortname like 'R') as 'SumR' " +
", (SELECT IFNULL(sum(`Amount`),0) FROM action left join actiontype on action.atype_id = actiontype.id" + sub_condition + " and actiontype.shortname like 'E') as 'SumE' " +

",( (SELECT IFNULL(sum(`Amount`),0) FROM action left join actiontype on action.atype_id = actiontype.id" + sub_condition + " and actiontype.shortname like 'I')" +
" - (SELECT IFNULL(sum(`Amount`),0) FROM action left join actiontype on action.atype_id = actiontype.id" + sub_condition + " and actiontype.shortname like 'O')" +
" + (SELECT IFNULL(sum(`Amount`),0) FROM action left join actiontype on action.atype_id = actiontype.id" + sub_condition + " and actiontype.shortname like 'R') ) as 'CashNet'" +

",( (SELECT IFNULL(sum(`Amount`),0) FROM action left join actiontype on action.atype_id = actiontype.id" + sub_condition + " and actiontype.shortname like 'I')" +
" - (SELECT IFNULL(sum(`Amount`),0) FROM action left join actiontype on action.atype_id = actiontype.id" + sub_condition + " and actiontype.shortname like 'E') ) as 'Net'" +
" FROM till ";

            string condition = " where 1 ";
            if (Till_IDs != "" && Till_IDs != "-1")
            {
                condition += " and ID in (@Till_IDs)";
            }
            query += condition;

            DataTable dt = new DataTable();
            if (Login.BuildConnection())
            {
                MySqlCommand sc = new MySqlCommand();

                sc.Parameters.AddWithValue("@Till_IDs", Till_IDs);
                sc.Parameters.AddWithValue("@date", date);

                sc.CommandText = query;
                sc.Connection = Login.MyConn;
                sc.CommandTimeout = 21600;

                MySqlDataAdapter da = new MySqlDataAdapter(sc);
                da.Fill(dt);
                Login.MyConn.Close();
            }
            return dt;
        }

        public void Insert(int Till_ID, int ObserveTill_ID, string ActionNumber, string AType, Double Amount, Double Rate, Double Exchanged
            , string Date, string Note, int IsReceipt, string ReceiptNote, int Rate_ID, Double USD_Value
            , int MicroProject_ID, int Line_ID, int IncomeType_ID, int OutcomePlace_ID)
        {
            if (Login.BuildConnection())
            {
                string date = DateTime.Now.ToString("yyyy/MM/dd hh:mm:ss");

                string query = @"INSERT INTO `action`(`Till_ID`,`ObserveTill_ID`, `ActionNumber`, `AType`, `Amount`, `Rate`, `Exchanged`
, `Date`, `Note`, `IsReceipt`, `ReceiptNote`, `Rate_ID`, `USD_Value`
, `MicroProject_ID`, `Line_ID`, `IncomeType_ID`, `OutcomePlace_ID`, created_at, updated_at)  VALUES ("
                + Till_ID + ","
                + (ObserveTill_ID == -1 ? SqlInt32.Null : ObserveTill_ID) + ",N'"
                + ActionNumber + "',N'"
                + AType + "',"
                + Amount + ","
                + Rate + ","
                + Exchanged + ","
                + (Date == "NULL" ? Date : ("'" + Date + "'")) + ",N'"
                + Note + "',"
                + IsReceipt + ",'"
                + ReceiptNote + "',"
                + (Rate_ID == -1 ? SqlInt32.Null : Rate_ID) + ","
                + USD_Value + ","
                + (MicroProject_ID == -1 ? SqlInt32.Null : MicroProject_ID) + ","
                + (Line_ID == -1 ? SqlInt32.Null : Line_ID) + ","
                + (IncomeType_ID == -1 ? SqlInt32.Null : IncomeType_ID) + ","
                + (OutcomePlace_ID == -1 ? SqlInt32.Null : OutcomePlace_ID) + ","
                + "'" + date + "'" + ","
                + "'" + date + "'"
                + ")";

                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    sc.ExecuteNonQuery();
                    Login.MyConn.Close();
                }
            }
        }

        public void Update(int ID, int Till_ID, int ObserveTill_ID, string ActionNumber, string AType, Double Amount, Double Rate, Double Exchanged
            , string Date, string Note, int IsReceipt, string ReceiptNote, int Rate_ID, Double USD_Value
            , int MicroProject_ID, int Line_ID, int IncomeType_ID, int OutcomePlace_ID)
        {
            if (Login.BuildConnection())
            {
                string query = "UPDATE `action` SET " +
                    " ObserveTill_ID = " + (ObserveTill_ID == -1 ? SqlInt32.Null : ObserveTill_ID) +
                    " ,`AType`= N'" + AType + "'" +
                    " ,`Amount`= " + Amount + " " +
                    " ,`Rate`= " + Rate + " " +
                    " ,`Exchanged`= " + Exchanged + " " +
                    " ,`Date`= " + (Date == "NULL" ? Date : ("'" + Date + "'")) +
                    " ,`Note`= N'" + Note + "'" +
                    " ,`IsReceipt` = " + IsReceipt +
                    " ,`ReceiptNote`= N'" + ReceiptNote + "'" +
                    " ,`Rate_ID`= " + (Rate_ID == -1 ? SqlInt32.Null : Rate_ID) + " " +
                    " ,`USD_Value`= " + USD_Value + " " +
                    " ,`MicroProject_ID`= " + (MicroProject_ID == -1 ? SqlInt32.Null : MicroProject_ID) + " " +
                    " ,`Line_ID`= " + (Line_ID == -1 ? SqlInt32.Null : Line_ID) + " " +
                    " ,`IncomeType_ID`= " + (IncomeType_ID == -1 ? SqlInt32.Null : IncomeType_ID) + " " +
                    " ,`OutcomePlace_ID`= " + (OutcomePlace_ID == -1 ? SqlInt32.Null : OutcomePlace_ID) + " " +
                    " ,`updated_at` = '" + DateTime.Now.ToString("dd/MM/yyyy hh:mm:ss") + "'";

                string condition = " where 1 ";

                if (ID != -1) condition += " and ID = " + ID;
                if (Till_ID != -1) condition += " and Till_ID = " + Till_ID;
                if (ActionNumber != "") condition += " and ActionNumber = N'" + ActionNumber + "'";

                query += condition;
                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    sc.ExecuteNonQuery();
                    Login.MyConn.Close();
                }
            }
        }

        public void Delete(int ID)
        {
            if (Login.BuildConnection())
            {
                string query = "DELETE FROM `action` WHERE ID = " + ID;
                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    sc.ExecuteNonQuery();
                    Login.MyConn.Close();
                }
            }
        }

        public int Get_Last_ID()
        {
            if (Login.BuildConnection())
            {
                string query = "select MAX(ID) from `action`";
                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    var n = 0;
                    int.TryParse(sc.ExecuteScalar().ToString(), out n);
                    Login.MyConn.Close();
                    return n;
                }
            }
            else
            {
                return -1;
            }
        }

        public void Update_usdValues(int Rate_ID)
        {
            if (Login.BuildConnection())
            {
                string query = "UPDATE `action` SET " +
                    " `USD_Value`= `Amount` / (select Value from rate where ID = action.Rate_ID limit 1) ";
                string condition = " where AType like 'E' and `Rate_ID`= " + Rate_ID;
                query += condition;
                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    sc.ExecuteNonQuery();
                    Login.MyConn.Close();
                }
            }
        }


    }
}

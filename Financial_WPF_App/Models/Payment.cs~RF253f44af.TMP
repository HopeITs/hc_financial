using MySql.Data.MySqlClient;
using System;
using System.Data;

namespace Financial_WPF_App.Models
{
    public class Payment
    {
        public DataTable Select(string Beneficiary_ID)
        {
            string query = @"SELECT `ID`, `Amount`, `DueDate`, `IsPaid`, `Beneficiary_ID` FROM `payment`";

            string condition = "";
            if (Beneficiary_ID != "") condition += " where Beneficiary_ID = " + Beneficiary_ID;
            query += condition;

            DataTable dt = new DataTable();
            if (Login.BuildConnection())
            {
                MySqlDataAdapter da = new MySqlDataAdapter(query, Login.MyConn);
                da.Fill(dt);
                Login.MyConn.Close();
            }
            return dt;
        }

        public bool ReGenerate_allPayments(Double Amount, string BeginDate, int numOfPayments, int Beneficiary_ID)
        {
            if (Login.BuildConnection())
            {
                string query = "DELETE FROM `payment` WHERE Beneficiary_ID = " + Beneficiary_ID
                    + " and DueDate >= '" + BeginDate + "';";
                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    sc.ExecuteNonQuery();
                }

                //لازم ننقص عدد الدفعات المتبقية ولم تنحذف ونولد دفعات جديدة بعدها
                var n = 0;
                query = "select count(*) FROM `payment` WHERE Beneficiary_ID = " + Beneficiary_ID;
                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    int.TryParse(sc.ExecuteScalar().ToString(), out n);
                }

                numOfPayments -= n;
                DateTime date = Convert.ToDateTime(BeginDate);
                query = "";
                if (numOfPayments > 0)
                {
                    for (int i = 1; i <= numOfPayments; i++)
                    {
                        query += "INSERT INTO `payment`(`Amount`, `DueDate`, `IsPaid`, `Beneficiary_ID`) VALUES ("
                        + Amount + ",'" + date.ToString("yyyy/MM/dd") + "','No'," + Beneficiary_ID + ");";

                        date = date.AddMonths(1);
                    }

                    using (var sc = new MySqlCommand(query, Login.MyConn))
                    {
                        sc.ExecuteNonQuery();
                        Login.MyConn.Close();
                    }
                    return true;
                }
                else
                    return false;
            }
            else return false;
        }

        public void Insert(Double Amount, string DueDate, string IsPaid, int Beneficiary_ID)
        {
            if (Login.BuildConnection())
            {
                string query = @"INSERT INTO `payment`(`Amount`, `DueDate`, `IsPaid`, `Beneficiary_ID`) VALUES ("
                + Amount + ",'" + DueDate + "','" + IsPaid + "'," + Beneficiary_ID + ")";

                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    sc.ExecuteNonQuery();
                    Login.MyConn.Close();
                }
            }
        }

        public void Update(int ID, Double Amount, string DueDate, string IsPaid, int Beneficiary_ID)
        {
            if (Login.BuildConnection())
            {
                string query = "UPDATE `payment` SET " +
                    "  `Amount`= " + Amount +
                    " ,`DueDate`= " + (DueDate == "NULL" ? DueDate : ("'" + DueDate + "'")) +
                    " ,`IsPaid`= N'" + IsPaid + "'" +
                    " ,`Beneficiary_ID` = " + Beneficiary_ID +

                    " WHERE ID = " + ID;
                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    sc.ExecuteNonQuery();
                    Login.MyConn.Close();
                }
            }
        }

        public void Delete(int ID)
        {
            if (Login.BuildConnection())
            {
                string query = "DELETE FROM `payment` WHERE ID = " + ID;
                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    sc.ExecuteNonQuery();
                    Login.MyConn.Close();
                }
            }
        }


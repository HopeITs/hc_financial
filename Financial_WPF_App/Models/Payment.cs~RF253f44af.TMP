        public int Get_Last_ID()
        {
            if (Login.BuildConnection())
            {
                string query = "select MAX(ID) from `payment`";
                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    var n = 0;
                    int.TryParse(sc.ExecuteScalar().ToString(), out n);
                    Login.MyConn.Close();
                    return n;
                }
            }
            else
            {
                return -1;
            }
        }

        public int Select_PaidPaymentsCount(string SubProject_ID, string MicroProject_ID)
        {
            //////////////////////////////////////
            // subProject //
            // account //
            // till //
            // action (income) //
            string query = @"SELECT count(action.ID) 
 FROM `account` left join till on account.ID = till.Account_ID left join tilltypes on tilltypes.id = till.type_id
 left JOIN action on action.Till_ID = till.ID 

 WHERE account.SubProject_ID = " + SubProject_ID +
 " and action.MicroProject_ID =" + MicroProject_ID +
 " and tilltypes.Name = 'pay' and action.AType = 'I'";

            if (Login.BuildConnection())
            {
                using (var sc = new MySqlCommand(query, Login.MyConn))
                {
                    var n = 0;
                    int.TryParse(sc.ExecuteScalar().ToString(), out n);
                    Login.MyConn.Close();
                    return n;
                }
            }
            else
            {
                return -1;
            }
        }
    }

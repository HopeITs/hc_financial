                <Setter Property="CalendarStyle" Value="{StaticResource CustomCalendarStyle}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LightGray1}"/>
                <Setter Property="Margin" Value="1,0,1,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Grid>
                                <!-- Border for Background -->
                                <Border x:Name="PART_Border" Background="{TemplateBinding Background}" Padding="5">
                                    <DatePickerTextBox x:Name="PART_TextBox"
                                           Style="{StaticResource CustomDatePickerTextBoxStyle}"
                                           Padding="8,0,0,0"
                                           VerticalContentAlignment="Center" HorizontalAlignment="Left"/>
                                </Border>


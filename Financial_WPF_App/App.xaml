                            <Setter Property="Foreground" Value="{StaticResource DarkGray}"/>
                            <Setter Property="Margin" Value="0,5,0,5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">

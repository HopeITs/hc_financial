<Application x:Class="Financial_WPF_App.App" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"    
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"    
             xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"  
             xmlns:converters="clr-namespace:Financial_WPF_App.Views"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:uc ="clr-namespace:Financial_WPF_App.Controls"
             xmlns:helper="clr-namespace:Financial_WPF_App.helper"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:design="clr-namespace:Financial_WPF_App.Design"
             StartupUri="Main_Window2.xaml">
    
    <Application.Resources>
        
        <ResourceDictionary>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <!--<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />-->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <!--<ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Lime.xaml" />-->

                <!-- MahApps.Metro resource dictionaries. Make sure that all file names are Case Sensitive! -->
                <!--
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                -->
                <!-- Theme setting -->
                <!--
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />-->

                <!-- primary color -->
                <ResourceDictionary>
                    <!-- include your primary palette -->
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/MaterialDesignColor.Indigo.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <!-- secondary colour -->
                <ResourceDictionary>
                    <!-- include your secondary pallette -->
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/MaterialDesignColor.Yellow.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>

                <!-- Include the Dragablz Material Design style -->
                <ResourceDictionary Source="pack://application:,,,/Dragablz;component/Themes/materialdesign.xaml"/>
              
                <!--<ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/Dragablz;component/Themes/MahApps.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>-->
                <!-- Include the Fluent Library for RIBBON -->

                
            </ResourceDictionary.MergedDictionaries>

            <design:TextToVisibilityConverter x:Key="TextToVisibilityConverter"/>
            <!--New Style-->
           
            <!-- Global font for TextBlock -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Rubik" />
            </Style>

             <!--Global font for TextBox--> 
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="Rubik" />
            </Style>

             <!--Global font for PasswordBox--> 
            <Style TargetType="PasswordBox">
                <Setter Property="FontFamily" Value="Rubik" />
            </Style>


             <!--Global font for Label--> 
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="Rubik" />
            </Style>

            <SolidColorBrush x:Key="White" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="HopeRed" Color="#BE1F24"/>
            <SolidColorBrush x:Key="Orange" Color="#F99D1C"/>
            <SolidColorBrush x:Key="PastelGreen" Color="#7d9885"/>
            <SolidColorBrush x:Key="PastelDarkBlue" Color="#074063"/>
            <SolidColorBrush x:Key="DarkgrayishViolet" Color="#826F89"/>
            <SolidColorBrush x:Key="GreenBlue" Color="#17778D"/>
            <SolidColorBrush x:Key="DarkGray" Color="#6E6F72"/>
            <SolidColorBrush x:Key="MidGray" Color="#939598"/>
            <SolidColorBrush x:Key="LightGray1" Color="#DCDDDE"/>
            <SolidColorBrush x:Key="LightGray2" Color="#F1F2F2"/>
            <SolidColorBrush x:Key="RowSelectionColor" Color="#A2C8D1"/>

            <Color x:Key="Color_HopeRed" >#BE1F24</Color>
            <Color x:Key="Color_Orange" >#F99D1C</Color>
            <Color x:Key="Color_PastelGreen" >#7d9885</Color>
            <Color x:Key="Color_PastelDarkBlue" >#074063</Color>
            <Color x:Key="Color_DarkgrayishViolet" >#826F89</Color>
            <Color x:Key="Color_GreenBlue" >#17778D</Color>
            <Color x:Key="Color_DarkGray" >#6E6F72</Color>
            <Color x:Key="Color_MidGray" >#939598</Color>
            <Color x:Key="Color_LightGray1" >#DCDDDE</Color>
            <Color x:Key="Color_LightGray2" >#F1F2F2</Color>

            <CornerRadius x:Key="CornerRadius">5</CornerRadius>

            <DropShadowEffect x:Key="ShadowEffect" BlurRadius="7" ShadowDepth="1" Opacity=".3" Color="{StaticResource Color_DarkGray}" />


            <Style x:Key="Version_Label" TargetType="Label">
                <Setter Property="FontFamily" Value="Rubik"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MidGray}"/>
            </Style>
            
            
            <Style x:Key="BorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadius}"/>
                <Setter Property="Background" Value="{StaticResource White}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DarkGray}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
            </Style>
            <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="{StaticResource MidGray}"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <!-- Show placeholder when the TextBox is empty -->
                    <DataTrigger Binding="{Binding Text, ElementName=username_txt}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!-- Show placeholder when the TextBox has a null value -->
                    <DataTrigger Binding="{Binding Text, ElementName=username_txt}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PlaceholderPasswordStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="{StaticResource MidGray}"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <!-- Show placeholder for PasswordBox when empty -->
                    <DataTrigger Binding="{Binding Password, ElementName=password_txt1}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!-- Show placeholder for PasswordBox when null -->
                    <DataTrigger Binding="{Binding Password, ElementName=password_txt1}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="50"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource MidGray}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource GreenBlue}"/>
                <Setter Property="SelectionTextBrush" Value="{StaticResource White}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- PasswordBox Style -->
            <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Height" Value="50"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource MidGray}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource GreenBlue}"/>
                <Setter Property="SelectionTextBrush" Value="{StaticResource White}"/>
                <Setter Property="PasswordChar" Value="*" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Global Button Style -->
            <Style x:Key="ButtonStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontFamily" Value="Rubik" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource LightGray2}" />
                <Setter Property="Background" Value="{StaticResource GreenBlue}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" 
                            CornerRadius="{StaticResource CornerRadius}" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#FF1A8BA1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#FF14576B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="ButtonColoredStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="Height" Value="27" />
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="1,0,1,0"/>
                <Setter Property="Foreground" Value="{StaticResource White}" />
                <Setter Property="Background" Value="{StaticResource GreenBlue}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" 
                                CornerRadius="{StaticResource CornerRadius}" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!--<Setter TargetName="Border" Property="Background" Value="{StaticResource HopeRed}" />-->
                                    <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ImageBrush x:Key="ButtonImageClose"  ImageSource="/Images/Buttons/close.png" Stretch="Uniform"></ImageBrush>
            <ImageBrush x:Key="ButtonImageMaximize"  ImageSource="/Images/Buttons/resize-restore.png" Stretch="Uniform"></ImageBrush>
            <ImageBrush x:Key="ButtonImageRestore"  ImageSource="/Images/Buttons/resize-restore1.png" Stretch="Uniform"></ImageBrush>
            <ImageBrush x:Key="ButtonImageMinimize"  ImageSource="/Images/Buttons/minimize.png" Stretch="Uniform"></ImageBrush>

            <!--Window Style-->
            <Style x:Key="WindowStyle" TargetType="{x:Type Window}">
                <Setter Property="Foreground" Value="{x:Null}"/>
                <Setter Property="WindowStyle" Value="None"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ResizeMode" Value="NoResize"/>
            </Style>

            <Style x:Key="WindowPopupStyle" TargetType="{x:Type Window}" BasedOn="{StaticResource WindowStyle}">
                <Setter Property="Width" Value="1000"/>
                <Setter Property="Height" Value="550"/>
            </Style>
            <Style x:Key="smallWindowPopupStyle" TargetType="{x:Type Window}" BasedOn="{StaticResource WindowStyle}">
                <Setter Property="Width" Value="500"/>
                <Setter Property="Height" Value="500"/>
            </Style>

            <!-- tell Dragablz tab control to use the Material Design theme -->
            <Style TargetType="{x:Type dragablz:TabablzControl}" 
                   BasedOn="{StaticResource MaterialDesignTabablzControlStyle}" >
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"></Setter>
            </Style>

            <!--Global Style for StackPanel in Accounts-->
            <Style x:Key="SolidStackPanelStyle" TargetType="StackPanel">
                <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
            </Style>
            <Style x:Key="MainBorderWrapPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                <Setter Property="Padding" Value="0,5,50,5"></Setter>
                <Setter Property="BorderBrush" Value="{StaticResource MidGray}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Background" Value="{StaticResource LightGray1}"/>
            </Style>
            <Style x:Key="statistic_textBlockStyle" TargetType="{x:Type TextBlock}" >
                <Setter Property="Label.FontSize" Value="14" />
                <Setter Property="Label.FontFamily" Value="RubiK" />
                <Setter Property="Label.FontWeight" Value="SemiBold" />
                <Setter Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource Color_GreenBlue}"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="TextBlock.HorizontalAlignment" Value="Left" />
                <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
                <Setter Property="TextBlock.TextAlignment" Value="Center" />
                <Setter Property="TextBlock.Margin" Value="3,3,3,3" />
                <Setter Property="TextBlock.Padding" Value="5,0,5,0" />
                <Setter Property="TextBlock.TextWrapping" Value="WrapWithOverflow" />
            </Style>

            <Style x:Key="BorderStackPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource White}"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
                <Setter Property="Width" Value="Auto"></Setter>
                <Setter Property="Margin" Value="0,2,0,1.909"></Setter>
            </Style>

            <Style x:Key="statistic_lableStyle" TargetType="{x:Type Label}"  >
                <Setter Property="Label.FontSize" Value="14" />
                <Setter Property="Label.FontWeight" Value="Medium" />
                <Setter Property="Label.FontFamily" Value="Rubik" />
                <Setter Property="Foreground" Value="{StaticResource DarkGray}"/>
                <Setter Property="Label.FlowDirection" Value="LeftToRight" />
                <Setter Property="Label.HorizontalContentAlignment" Value="Left" />
                <Setter Property="Label.VerticalAlignment" Value="Center" />
                <Setter Property="Label.VerticalContentAlignment" Value="Center" />
                <Setter Property="Label.Margin" Value="10,0,1,0" />
                <!-- DISABLED STYLE TRIGGER -->
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource LightGray1}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TabControlStyle" TargetType="{x:Type TabControl}">
                <Setter Property="Margin" Value="1,0,0,0"></Setter>
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource LightGray2}" />
                <Setter Property="FontFamily" Value="Rubik" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="tabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="FontFamily" Value="Rubik" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource MidGray}" />
                <Setter Property="Background" Value="{DynamicResource LightGray2}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <!-- Custom ControlTemplate -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <!-- Full Tab Background -->
                                <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0.5"
                                    Padding="10,5"
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter x:Name="ContentSite"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <!-- Bottom Border Only (Initially Hidden) -->
                                <Border x:Name="BottomBorder"
                                        Height="2"
                                        Background="{StaticResource HopeRed}"
                                        VerticalAlignment="Bottom"
                                        Visibility="Collapsed"/>
                            </Grid>

                            <!-- Triggers for Selected State -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource LightGray1}"/>
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource LightGray1}"/>
                                    <Setter TargetName="BottomBorder" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="{StaticResource HopeRed}"/>
                                    <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <PathGeometry x:Key="TreeArrow" Figures="M0,0 L0,6 L6,0 z"/>
            <Style x:Key="ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border Background="Transparent" Height="18" Padding="5,5,5,5" Width="18">
                                <Path x:Name="ExpandPath" Data="{StaticResource TreeArrow}" Fill="{StaticResource DarkGray}" Stroke="{StaticResource DarkGray}">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-45" CenterX="3" CenterY="3"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <!--<Setter Property="RenderTransform" TargetName="ExpandPath">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterX="3" CenterY="3"/>
                                        </Setter.Value>
                                    </Setter>-->
                                    <Setter Property="Fill" TargetName="ExpandPath" Value="{StaticResource DarkGray}"/>
                                    <Setter Property="Stroke" TargetName="ExpandPath" Value="{StaticResource DarkGray}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Stroke" TargetName="ExpandPath" Value="{StaticResource DarkGray}"/>
                                    <Setter Property="Fill" TargetName="ExpandPath" Value="{StaticResource DarkGray}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Stroke" TargetName="ExpandPath" Value="{StaticResource DarkGray}"/>
                                    <Setter Property="Fill" TargetName="ExpandPath" Value="{StaticResource DarkGray}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccountExpander" TargetType="{x:Type Expander}">
                <Setter Property="IsExpanded" Value="False"/>
                <Setter Property="Background" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{StaticResource DarkGray}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Expander}">
                            <Grid>
                                <!-- Outer border containing header and content -->
                                <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource LightGray2}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Effect="{StaticResource ShadowEffect}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Header row -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Content row -->
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <!-- Header Content (if any) -->
                                        <ContentPresenter x:Name="HeaderContent"
                                        Grid.Row="0"
                                        ContentSource="Header"
                                        Margin="6" />
                                        <!-- Expander Content -->
                                        <ContentPresenter x:Name="ExpanderContent"
                                        Grid.Row="1"
                                        ContentSource="Content"
                                        Margin="6" />
                                    </Grid>
                                </Border>

                                <!-- Overlay Toggle Button: vertically centered in the entire Expander -->
                                <ToggleButton x:Name="ExpanderToggleButton"
                          Width="16"
                          Height="16"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          Margin="6,0,0,0"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                          Style="{StaticResource ExpandCollapseToggleStyle}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FloatingExpanderlableStyle" TargetType="Label">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="-5,0,1,0"/>
                <Setter Property="Foreground" Value="{StaticResource DarkGray}"/>
                <Setter Property="FontFamily" Value="Rubik"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource LightGray1}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FloatingBoxesStyle" TargetType="Control">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="1,0,1,0"/>
                <Setter Property="Foreground" Value="{StaticResource DarkGray}"/>
                <Setter Property="FontFamily" Value="Rubik"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LightGray1}"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="Padding" Value="20,2,2,2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="30"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="{StaticResource LightGray1}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource LightGray1}"/>
                        
                    </Trigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="HoverBoxesStyle" BasedOn="{StaticResource FloatingBoxesStyle}" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{StaticResource LightGray1}" 
                                    BorderBrush="{StaticResource LightGray1}"
                                    BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource LightGray2}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Background" Value="white" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MidGray}"/>
                                    <Setter TargetName="Border" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="Border" Property="Opacity" Value=".6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- TextBox-Specific Style -->
            <Style x:Key="FloatingTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FloatingBoxesStyle}">
                <Setter Property="SelectionBrush" Value="{StaticResource LightGray2}"/>
                <Setter Property="SelectionTextBrush" Value="{StaticResource LightGray2}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <!-- Background Border -->
                                <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"/>

                                <!-- Placeholder Text -->
                                <TextBlock x:Name="PlaceholderText"
                               Text="{TemplateBinding Tag}"
                               Foreground="{StaticResource MidGray}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource  TextToVisibilityConverter}}"
                               IsHitTestVisible="False"/>

                                <!-- Actual TextBox Content -->
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,0,0"/>

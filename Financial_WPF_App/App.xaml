            <!-- Global Combobox CheckBox Style -->
            <Style TargetType="CheckBox" x:Key="CheckBoxStyle">
                <Setter Property="Foreground" Value="{StaticResource DarkGray}" />
                <Setter Property="Padding" Value="15,2,2,2" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="Rubik" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource MidGray}" />
                <!-- Custom CheckBox Template -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <!-- CheckMark Box -->
                                <Border x:Name="CheckMarkBorder" Background="{TemplateBinding Background}"
                            Width="12" Height="12"
                            BorderThickness="1"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"/>

                                <!-- CheckMark Icon -->
                                <Path x:Name="CheckMark"
                          Data="M2,6 L5,9 L10,3"
                          Stroke="{StaticResource MidGray}"
                          StrokeThickness="1.5"
                          Visibility="Collapsed"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"/>

                                <!-- CheckBox Label -->
                                <ContentPresenter
                                      VerticalAlignment="Center"
                                      Margin="20,0,0,0"
                                      TextBlock.Foreground="{TemplateBinding Foreground}" />
                            </Grid>

                            <!-- Triggers for CheckBox states -->
                            <ControlTemplate.Triggers>
                                <!-- When Checked, Show CheckMark -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                </Trigger>

                                <!-- Hover Effect: Keep Background the Same -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource LightGray2}"/>
                                </Trigger>

                                <!-- Disabled State -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="CheckMarkBorder" Property="BorderBrush" Value="{StaticResource MidGray}" />
                                    <Setter TargetName="CheckMark" Property="Stroke" Value="{StaticResource DarkGray}" />
                                    <Setter Property="Foreground" Value="{StaticResource MidGray}" />
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

           





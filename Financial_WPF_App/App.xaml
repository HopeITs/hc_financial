                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Width="12" Height="12"
                                        Margin="5,0" Content="">
                                    <Button.Background>
                                        <ImageBrush ImageSource="/Images/Buttons/calendar.png"/>
                                    </Button.Background>

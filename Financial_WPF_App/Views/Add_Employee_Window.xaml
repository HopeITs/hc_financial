<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Class="Financial_WPF_App.Views.Add_Employee_Window"
        mc:Ignorable="d" Tag="Add Employee Window" Width="760"
        Title="Add_Employee_Window" Style="{StaticResource WindowPopupStyle}" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid Margin="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="355*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0" Grid.ColumnSpan="5">
                <local:WindowControlBar_Popup x:Name="ControlBar"/>
            </DockPanel>

            <Label Style="{DynamicResource statistic_lableStyle}" Content="Employee:"   Grid.Column="0" Grid.Row="1"  />

            <TextBox Grid.Column="1" x:Name="FName_txtBox" TextWrapping="Wrap"  VerticalContentAlignment="Center" TabIndex="3" Grid.Row="1" Style="{StaticResource FloatingTextBoxStyle}" Tag="First Name"/>
            <TextBox Grid.Column="2" x:Name="FaName_txtBox" TextWrapping="Wrap"  VerticalContentAlignment="Center"  TabIndex="4"  Grid.Row="1" Style="{StaticResource FloatingTextBoxStyle}" Tag="Father Name"/>
            <TextBox x:Name="LName_txtBox" TextWrapping="Wrap"  VerticalContentAlignment="Center"  TabIndex="5" Grid.Column="3" Grid.Row="1" Style="{StaticResource FloatingTextBoxStyle}" Tag="Last Name"/>





            <Label x:Name="Subproject_label" Style="{DynamicResource statistic_lableStyle}" Content="Center:" Grid.Row="2" Grid.Column="0" />
            <Grid  Grid.Row="2" Grid.Column="1" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Subproject_comboBox" TabIndex="3" Style="{StaticResource FloatingComboboxStyle}" Grid.Column="0"
        DisplayMemberPath="Name" SelectedValuePath="ID" />
                <Button x:Name="Subproject_clear_btn"  Click="Subproject_clear_btn_Click"  Style="{StaticResource DeleteButtonStyle}" Grid.Column="1" Width="25" Height="30">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </Grid>
            <Label x:Name="Line_label" Style="{DynamicResource statistic_lableStyle}" Content="Position:" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Right"  />
            <Grid   Grid.Column="3" Grid.Row="2" Height="30" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Line_comboBox" TabIndex="3" Style="{StaticResource FloatingComboboxStyle}" Grid.Column="0"
        DisplayMemberPath="Line" SelectedValuePath="line_ID" />
                <Button x:Name="Line_clear_btn" Style="{StaticResource DeleteButtonStyle}" Click="Line_clear_btn_Click" Grid.Column="1" Height="30">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </Grid>
            <Label x:Name="BeginDate_lable" Style="{DynamicResource statistic_lableStyle}" Grid.Row="3"  Content="Start date:" />
            <Label x:Name="EndDate_label" Style="{DynamicResource statistic_lableStyle}" Content="End date:" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" />
            <DatePicker x:Name="BeginDate_datepicker"   TabIndex="11" Grid.Row="3" Grid.Column="1" Height="30"
     />
            <DatePicker x:Name="EndDate_datepicker"  TabIndex="11" Grid.Row="3" Grid.Column="3" Height="30"/>
            <Button Style="{DynamicResource AddButtonStyle}" ToolTip="Insert" ToolTipService.InitialShowDelay="100"
    x:Name="Add_btn" TabIndex="15"  Click="Add_btn_Click" Grid.Row="3" Grid.Column="4" HorizontalAlignment="Stretch" Margin="2,0,5,0" VerticalAlignment="Stretch"  >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/NewEntry.png"/>
                </Button.Background>
            </Button>
            <Button  Style="{DynamicResource ButtonColoredStyle}" x:Name="Save_btn"  TabIndex="20" Content="Save" Grid.Row="5" Grid.Column="0" 
Click="Save_btn_Click" 
HorizontalContentAlignment="Center" 
VerticalContentAlignment="Center"  />

            <syncfusion:SfDataGrid x:Name="EmployeeDataGrid"                                         
            Style="{DynamicResource SfDataGrid_body}"
            HeaderStyle="{DynamicResource SfDataGrid_header}"
            RowStyle="{DynamicResource SfDataGrid_RowStyle}"
            AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" 
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  AllowFiltering="False" ShowGroupDropArea="False"
             Grid.Row="4" NavigationMode="Cell" CurrentCellBorderBrush="{StaticResource LightGray2}" CurrentCellBorderThickness="2" Grid.ColumnSpan="9" Margin="2,5,5,5">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn x:Name="Subproject_DataGridColumn" HeaderText="Center"  MappingName="SubprojectName" />
                    <syncfusion:GridTextColumn x:Name="Line_DataGridColumn" HeaderText="Position"  MappingName="LineName" />
                    <syncfusion:GridDateTimeColumn x:Name="BeginDate_DataGridColumn" HeaderText="Start date" MappingName="BeginDate"
                    CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   AllowEditing="True"/>
                    <syncfusion:GridDateTimeColumn x:Name="EndDate_DataGridColumn" HeaderText="End date" MappingName="EndDate"
                    CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"  AllowEditing="True" />

                    <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn" HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="Subproject_DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Grid>
    </Grid>
</Window>

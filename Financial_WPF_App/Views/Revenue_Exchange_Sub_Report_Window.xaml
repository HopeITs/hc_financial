<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.Revenue_Exchange_Sub_Report_Window"
        mc:Ignorable="d"
        Title="Revenue_Exchange_Sub_Report_Window" Width="1280" Height="620" FontFamily="Myriad Arabic" FontSize="18" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu x:Name="cm">
                <MenuItem Header="Refresh Till" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" FlowDirection="RightToLeft">
            <StackPanel.Background>
                <ImageBrush ImageSource="/Images/MainForm/MainForm Tab Header.png"/>
            </StackPanel.Background>
            <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
            <Border BorderThickness="1" CornerRadius="7" Padding="0" 
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" Margin="0,2,0,1.909" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"  />
            </Border>
            <Label x:Name="Income_Label" Content="Income:" Style="{DynamicResource statistic_lableStyle}" Margin="0,3,5,2.909" />
            <Border BorderThickness="1" CornerRadius="7" Padding="0" 
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" Margin="0,2,0,1.909" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="Income_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="Income_textBlock_SizeChanged"  />
            </Border>
            <Label x:Name="Exchange_Label" Content="Exchanged:" Style="{DynamicResource statistic_lableStyle}" Margin="0,3,5,2.909" />
            <Border x:Name="Exchange_Border" BorderThickness="1" CornerRadius="7" Padding="0" 
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" Margin="0,2,0,1.909" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="Exchange_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchange_textBlock_SizeChanged" />
            </Border>

            <Label x:Name="Exchpand_Label" Content="Expenses:" Style="{DynamicResource statistic_lableStyle}" />
            <Border x:Name="Exchpand_Border" BorderThickness="1" CornerRadius="7" Padding="0" 
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="Exchpand_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchpand_textBlock_SizeChanged" />
            </Border>

            <Label x:Name="Net_lable" Content="Balance:" Style="{DynamicResource statistic_lableStyle}" />
            <Border x:Name="Net_Border" BorderThickness="1" CornerRadius="7" Padding="0" 
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="Net_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Net_textBlock_SizeChanged" />
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,0,0,1">
            <StackPanel.Background>
                <ImageBrush ImageSource="/Images/MainForm/MainForm Tab Header.png"/>
            </StackPanel.Background>
            <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
            <Border BorderThickness="1" CornerRadius="7" Padding="0" 
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" Margin="0,2,0,1.909" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"  />
            </Border>
            <Label x:Name="Income_Label1" Content="Income:" Style="{DynamicResource statistic_lableStyle}" Margin="0,3,5,2.909" />
            <Border BorderThickness="1" CornerRadius="7" Padding="0" 
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" Margin="0,2,0,1.909" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="Income_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="Income_textBlock_SizeChanged"  />
            </Border>
            <Label x:Name="Exchange_Label1" Content="Exchanged:" Style="{DynamicResource statistic_lableStyle}" Margin="0,3,5,2.909" />
            <Border x:Name="Exchange_Border1" BorderThickness="1" CornerRadius="7" Padding="0" 
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" Margin="0,2,0,1.909" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="Exchange_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchange_textBlock_SizeChanged" />
            </Border>

            <Label x:Name="Exchpand_Label1" Content="Expenses:" Style="{DynamicResource statistic_lableStyle}" />
            <Border x:Name="Exchpand_Border1" BorderThickness="1" CornerRadius="7" Padding="0" 
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="Exchpand_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchpand_textBlock_SizeChanged" />
            </Border>
            <Label x:Name="Net_lable1" Content="Balance:" Style="{DynamicResource statistic_lableStyle}" />
            <Border x:Name="Net_Border1" BorderThickness="1" CornerRadius="7" Padding="0" 
                Width="auto" Height="30"  >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="Net_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Net_textBlock_SizeChanged" />
            </Border>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,2,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Expander_col" Width="30*" />
                <ColumnDefinition x:Name="Grid_col" Width="70*" />
            </Grid.ColumnDefinitions>
            <syncfusion:SfDataGrid x:Name="myDataGrid"                                            
                Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" 
                TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"
                GroupSummaryRowStyle="{DynamicResource GroupSummaryRowStyle}"
                SelectionChanged="myDataGrid_SelectionChanged" 
                Loaded="myDataGrid_Loaded" 
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                Margin="2,4,2,4" Grid.Row="1" FilterChanged="myDataGrid_FilterChanged" Grid.ColumnSpan="2" >

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn x:Name="City_DataGridColumn" MappingName="City_Name" HeaderText="City"/>
                    <syncfusion:GridTextColumn x:Name="Project_DataGridColumn" MappingName="Project_Name" HeaderText="Project"/>
                    <syncfusion:GridTextColumn x:Name="Subproject_DataGridColumn" MappingName="Subproject_Name" HeaderText="Subproject"/>
                    <syncfusion:GridTextColumn x:Name="Account_DataGridColumn" MappingName="Account_Name" HeaderText="Account"/>


                    <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" MappingName="ID" HeaderText="Operation ID"/>
                    <syncfusion:GridNumericColumn  x:Name="Income_DataGridColumn" HeaderText="Income"  MappingName="Income" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  x:Name="Exchange_DataGridColumn" HeaderText="Exchange"  MappingName="Exchange" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  x:Name="Expand_DataGridColumn" HeaderText="Expenses"  MappingName="Expand" 
                     NumberDecimalDigits="2"
                     NumberDecimalSeparator="."
                     NumberGroupSizes="3"
                     NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  x:Name="Balance_DataGridColumn" HeaderText="Balance"  MappingName="Balance" 
                     NumberDecimalDigits="2"
                     NumberDecimalSeparator="."
                     NumberGroupSizes="3"
                     NumberGroupSeparator=","/>
                    <syncfusion:GridDateTimeColumn x:Name="Action_DataGridColumn" HeaderText="Operation Date" MappingName="ActionDate"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                    <syncfusion:GridTextColumn x:Name="ActionMonth_DataGridColumn" MappingName="ActionMonth" HeaderText="Action Month"/>
                    <syncfusion:GridTextColumn x:Name="ActionYear_DataGridColumn" MappingName="ActionYear" HeaderText="Action Year"/>

                    <syncfusion:GridTextColumn x:Name="Donor_DataGridColumn" HeaderText="Donor"  MappingName="Donor" />

                    <syncfusion:GridNumericColumn x:Name="Rate_DataGridColumn" HeaderText="Rate" MappingName="Rate"
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn x:Name="Exchanged_DataGridColumn" HeaderText="Exchanged" MappingName="Exchanged"     
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>

                    <syncfusion:GridTextColumn x:Name="Note_DataGridColumn" HeaderText="Description (Ar)"  MappingName="Note"  />
                    <syncfusion:GridTextColumn x:Name="E_Note_DataGridColumn" HeaderText="Description (Eng)"  MappingName="E_Note"  />
                    <syncfusion:GridTextColumn x:Name="AvgRateName_DataGridColumn" HeaderText="Original Avg Rate group"  MappingName="AvgRateName"  />
                    <syncfusion:GridNumericColumn x:Name="AvgRate_DataGridColumn" HeaderText="Original Avg Rate amount" MappingName="AvgRateValue"
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn x:Name="USD_Value_DataGridColumn" HeaderText="Value" MappingName="USD_Value" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                    <syncfusion:GridTextColumn x:Name="ObserveAccount_DataGridColumn" HeaderText="Corresponding account" MappingName="ObserveAccount"/>
                    <syncfusion:GridTextColumn x:Name="ObserveTill_DataGridColumn" HeaderText="Corresponding till" MappingName="ObserveTill" />
                    <syncfusion:GridTextColumn x:Name="ObserveAcctionID_DataGridColumn" HeaderText="Corresponding Operation ID" MappingName="ObserveAcion_ID" />
                    <syncfusion:GridTextColumn x:Name="ExAccount_DataGridColumn" HeaderText="Exchange account" MappingName="ExchangeAcc_Name"/>
                    <syncfusion:GridDateTimeColumn x:Name="created_at_DataGridColumn" HeaderText="Date Created" MappingName="created_at" 
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"  />
                    <syncfusion:GridDateTimeColumn x:Name="updated_at_DataGridColumn" HeaderText="Modification Date" MappingName="updated_at"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                    <syncfusion:GridDateTimeColumn x:Name="approved_at_DataGridColumn" HeaderText="Confirmation Date" MappingName="approved_at"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                </syncfusion:SfDataGrid.Columns>
                <syncfusion:SfDataGrid.GroupSummaryRows>
                    <syncfusion:GridSummaryRow ShowSummaryInRow="False" TitleColumnCount="1"  Title="Total:">
                        <syncfusion:GridSummaryRow.SummaryColumns>
                            <syncfusion:GridSummaryColumn Name="Total_I"                                                      
                                     Format="'{Sum:N2}'"
                                     MappingName="Income"
                                     SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Ex"                                                      
                                     Format="'{Sum:N2}'"
                                     MappingName="Exchange"
                                     SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_E"                                                      
                                     Format="'{Sum:N2}'"
                                     MappingName="Expand"
                                     SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Balance"                                                      
                                Format="'{Sum:N2}'"
                                MappingName="Balance"
                                SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Exchanged"                                                      
                                     Format="'{Sum:N2}'"
                                     MappingName="Exchanged"
                                     SummaryType="DoubleAggregate" />
                        </syncfusion:GridSummaryRow.SummaryColumns>
                    </syncfusion:GridSummaryRow>
                </syncfusion:SfDataGrid.GroupSummaryRows>

                <syncfusion:SfDataGrid.TableSummaryRows>
                    <syncfusion:GridTableSummaryRow ShowSummaryInRow="False" TitleColumnCount="1" Position="Bottom"
                                     Title="Total:">
                        <syncfusion:GridSummaryRow.SummaryColumns>
                            <syncfusion:GridSummaryColumn Name="Total_I"                                                      
                                        Format="'{Sum:N2}'"
                                        MappingName="Income"
                                        SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_E"                                                      
                                              Format="'{Sum:N2}'"
                                              MappingName="Expand"
                                              SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Ex"                                                      
                                              Format="'{Sum:N2}'"
                                              MappingName="Exchange"
                                              SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Balance"                                                      
                                        Format="'{Sum:N2}'"
                                        MappingName="Balance"
                                        SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Exchanged"                                                      
                                              Format="'{Sum:N2}'"
                                              MappingName="Exchanged"
                                              SummaryType="DoubleAggregate" />
                        </syncfusion:GridSummaryRow.SummaryColumns>
                    </syncfusion:GridTableSummaryRow>
                </syncfusion:SfDataGrid.TableSummaryRows>
            </syncfusion:SfDataGrid>
            <Grid Margin="2,1,2,1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto" MinWidth="90" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="107"/>
                    <ColumnDefinition Width="86*" />
                    <ColumnDefinition Width="55*"/>
                </Grid.ColumnDefinitions>
                <Menu
                    x:Name="ShowHideMenu" Margin="10,1,12,2">
                    <Menu.Background
        >
                        <ImageBrush
                />
                    </Menu.Background>
                    <MenuItem
                        Width="28" StaysOpenOnClick="True" Header="" Height="40">
                        <MenuItem.Background
        >
                            <ImageBrush
                                ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"
                />
                        </MenuItem.Background>
                        <MenuItem
                            StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="White"
                />
                        <MenuItem
                            StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="White"
                />
                        <Separator
                            Background="Black"
                />
                        <MenuItem
                            Background="White" Click="ShowAll_MenuItem_Click" Header="ShowAll"
                />
                    </MenuItem>
                </Menu>
                <Button
                    TabIndex="5" Style="{DynamicResource Export_Style}" x:Name="Export_btn" Margin="12,8,12,10" Grid.Column="1" Command="Helper:Commands.ExportToExcel" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RenderTransformOrigin="0.536,0.355"
                />
            </Grid>
        </Grid>
    </Grid>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.Revenue_Exchange_Sub_Report_Window"
        mc:Ignorable="d"
        Title="Revenue_Exchange_Sub_Report_Window" Width="1280" Height="620" FontSize="18" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu x:Name="cm">
                <MenuItem Header="Refresh" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="233*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
            <WrapPanel Orientation="Horizontal">
                <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"  />
                </Border>
                <Label x:Name="Income_Label" Content="Income:" Style="{DynamicResource statistic_lableStyle}"/>
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Income_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="Income_textBlock_SizeChanged"  />
                </Border>
                <Label x:Name="Incomeusd_Label" Content="Income(USD):" Style="{DynamicResource statistic_lableStyle}"/>
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Incomeusd_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="Income_textBlock_SizeChanged"  />
                </Border>
                <Label x:Name="Exchange_Label" Content="Exchanged:" Style="{DynamicResource statistic_lableStyle}"/>
                <Border x:Name="Exchange_Border" Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Exchange_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchange_textBlock_SizeChanged" />
                </Border>

                <Label x:Name="Exchpand_Label" Content="Transfer:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Exchpand_Border" Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Exchpand_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchpand_textBlock_SizeChanged" />
                </Border>

                <Label x:Name="Net_lable" Content="Balance:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Net_Border" Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Net_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Net_textBlock_SizeChanged" />
                </Border>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource MainBorderWrapPanelStyle}">
            <WrapPanel  Orientation="Horizontal" Margin="0,0,0,1">
                <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                <Border Style="{StaticResource BorderStackPanelStyle}" >
                    <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"  />
                </Border>
                <Label x:Name="Income_Label1" Content="Income:" Style="{DynamicResource statistic_lableStyle}"/>
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Income_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="Income_textBlock_SizeChanged"  />
                </Border>
                <Label x:Name="Incomeusd_Label1" Content="Income(USD):" Style="{DynamicResource statistic_lableStyle}"/>
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Incomeusd_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="Income_textBlock_SizeChanged"  />
                </Border>
                <Label x:Name="Exchange_Label1" Content="Exchanged:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Exchange_Border1" Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Exchange_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchange_textBlock_SizeChanged" />
                </Border>

                <Label x:Name="Exchpand_Label1" Content="Transfer:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Exchpand_Border1" Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Exchpand_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchpand_textBlock_SizeChanged" />
                </Border>
                <Label x:Name="Net_lable1" Content="Balance:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Net_Border1"  Style="{StaticResource BorderStackPanelStyle}"   >
                    <TextBlock x:Name="Net_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Net_textBlock_SizeChanged" />
                </Border>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,5,0,0" Grid.ColumnSpan="2" >
            <DockPanel  LastChildFill="True" Background="{StaticResource LightGray1}" Height="40">
                <WrapPanel Orientation="Horizontal" Width="Auto">
                    <Menu x:Name="ShowHideMenu" Margin="5,2,5,2">
                        <Menu.Resources>
                            <!-- Custom Menu Style -->
                            <Style TargetType="Menu">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Menu">
                                            <Border Background="{TemplateBinding Background}" Padding="0">
                                                <ItemsPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Custom MenuItem Style -->
                            <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
                                <Setter Property="FontFamily" Value="Rubik"/>
                                <Setter Property="FontSize" Value="13.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource DarkGray}"/>
                                <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Grid>
                                                <!-- Main Item -->
                                                <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="10,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <!-- Arrow Column -->
                                                        </Grid.ColumnDefinitions>

                                                        <ContentPresenter Grid.Column="0" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Center" 
        ContentSource="Header"/>

                                                        <!-- Submenu Arrow -->
                                                        <Path x:Name="Arrow"
       Grid.Column="1"
       Data="M 0 0 L 6 4 L 0 8 Z" 
       Fill="{DynamicResource DarkGray}"
       VerticalAlignment="Center"
       Margin="5,0,0,0"
       Visibility="Collapsed"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Submenu Popup -->
                                                <Popup x:Name="Popup"
Placement="Bottom"
PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
IsOpen="{TemplateBinding IsSubmenuOpen}"
AllowsTransparency="True"
Focusable="False"
PopupAnimation="Fade">
                                                    <Border Background="White" CornerRadius="5" BorderBrush="{StaticResource LightGray1}" BorderThickness="1">
                                                        <StackPanel>
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>

                                            <!-- Triggers -->
                                            <ControlTemplate.Triggers>
                                                <!-- Show Arrow Only if the MenuItem has sub-items (is a submenu) -->
                                                <Trigger Property="HasItems" Value="True">
                                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                                </Trigger>

                                                <!-- Submenu Hover Effect -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <!--<Setter TargetName="Border" Property="Background" Value="transparent"/>-->
                                                    <!--<Setter Property="Foreground" Value="{DynamicResource LightGray1}"/>-->
                                                </Trigger>

                                                <!-- Submenu Open Effect -->
                                                <Trigger Property="IsSubmenuOpen" Value="True">
                                                    <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
                                                </Trigger>

                                                <!-- Disabled Effect -->
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource MidGray}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </Menu.Resources>
                        <!-- MenuItems with Custom Style -->
                        <MenuItem Width="20" Height="20" StaysOpenOnClick="True" Header=""  Style="{StaticResource CustomMenuItemStyle}" Margin="6,9,0,0" ToolTip="Show/Hide Columns" ToolTipService.InitialShowDelay="100">
                            <MenuItem.Background>
                                <ImageBrush ImageSource="/Images/Buttons/showHide.png" Stretch="Uniform"/>
                            </MenuItem.Background>
                            <!-- Submenu Items (Will Keep Hover Effect) -->
                            <MenuItem StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                            <MenuItem StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                            <MenuItem Background="{StaticResource LightGray1}" Click="ShowAll_MenuItem_Click" Header="ShowAll" Style="{StaticResource CustomMenuItemStyle}"/>
                        </MenuItem>
                    </Menu>
                    <StackPanel x:Name="ExportToExcel_StackPanel" RenderTransformOrigin="0.5,0.5" Width="31">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" Command="local:Commands.ExportToExcel"  Width="30" Height="25" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,10,1,1">
                            <Button.Background>
                                <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png" Stretch="Uniform"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>

                    <Label x:Name="Year_Label" Style="{DynamicResource statistic_lableStyle}" Content="Year:" Margin="18,2,1,2" VerticalAlignment="Center" HorizontalContentAlignment="Right"/>
                    <ComboBox Style="{DynamicResource ActionComboboxStyle}" x:Name="Year_comboBox" TabIndex="18"
                              SelectionChanged="Year_comboBox_SelectionChanged"
                              Margin="3,0,2,0" VerticalAlignment="Center" Width="100" Height="30"/>

                    <Label x:Name="From_Label" Style="{DynamicResource statistic_lableStyle}" Content="From:" Margin="14,2,1,2" VerticalAlignment="Center" HorizontalContentAlignment="Right"/>
                    <DatePicker Style="{StaticResource DatePickerActionBar}" x:Name="FromDate_datepicker" Margin="3,0,2,0" VerticalAlignment="Center" Width="150" Height="30"
                                SelectedDateChanged="Date_Changed"/>

                    <Label x:Name="To_Label" Style="{DynamicResource statistic_lableStyle}" Content="To:" Margin="14,2,1,2" VerticalAlignment="Center" HorizontalContentAlignment="Right"/>
                    <DatePicker Style="{StaticResource DatePickerActionBar}" x:Name="ToDate_datepicker" Margin="3,0,2,0" VerticalAlignment="Center" Width="150" Height="30"
                                SelectedDateChanged="Date_Changed"/>

                    <Button ToolTip="Show the selected period" ToolTipService.InitialShowDelay="100"
                            Style="{DynamicResource AddButtonStyle}"
                            x:Name="Go_btn" TabIndex="20" Click="Go_btn_Click" Margin="10,0,0,0" VerticalAlignment="Center" Height="25" Width="44" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/Apply_blue.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </WrapPanel>
                <StackPanel x:Name="Panel1" Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,5,0">
                    <TextBox Style="{DynamicResource TextBoxActionStyle}" TextChanged="Search_txtBox_TextChanged" x:Name="Search_txtBox" TextWrapping="Wrap" TabIndex="10"/>
                </StackPanel>
            </DockPanel>
        </Grid>

            <syncfusion:SfDataGrid x:Name="myDataGrid"                                            
                Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" 
                TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"
                GroupSummaryRowStyle="{DynamicResource GroupSummaryRowStyle}"
                SelectionChanged="myDataGrid_SelectionChanged" 
                Loaded="myDataGrid_Loaded" 
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                Grid.Row="3" FilterChanged="myDataGrid_FilterChanged" Grid.ColumnSpan="2" Margin="2,5,5,5" >

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn x:Name="City_DataGridColumn" MappingName="City_Name" HeaderText="City"/>
                    <syncfusion:GridTextColumn x:Name="Project_DataGridColumn" MappingName="Project_Name" HeaderText="Program"/>
                    <syncfusion:GridTextColumn x:Name="Subproject_DataGridColumn" MappingName="Subproject_Name" HeaderText="Project"/>
                    <syncfusion:GridTextColumn x:Name="Account_DataGridColumn" MappingName="Account_Name" HeaderText="Account"/>


                    <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" MappingName="ID" HeaderText="Operation ID"/>
                    <syncfusion:GridNumericColumn  x:Name="Income_DataGridColumn" HeaderText="Income"  MappingName="Income" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  x:Name="Incomeusd_DataGridColumn" HeaderText="Income(USD)"  MappingName="Incomeusd" 
           NumberDecimalDigits="2"
           NumberDecimalSeparator="."
           NumberGroupSizes="3" 
           NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  x:Name="Exchange_DataGridColumn" HeaderText="Exchange"  MappingName="Exchange" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  x:Name="Transfer_DataGridColumn" HeaderText="Transfer"  MappingName="Outcome"
                       NumberDecimalDigits="2"
                       NumberDecimalSeparator="."
                       NumberGroupSizes="3" 
                       NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  x:Name="Expand_DataGridColumn" HeaderText="Expenses"  MappingName="Expand" 
                     NumberDecimalDigits="2"
                     NumberDecimalSeparator="."
                     NumberGroupSizes="3"
                     NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  x:Name="Balance_DataGridColumn" HeaderText="Balance"  MappingName="Balance" 
                     NumberDecimalDigits="2"
                     NumberDecimalSeparator="."
                     NumberGroupSizes="3"
                     NumberGroupSeparator=","/>
                    <syncfusion:GridDateTimeColumn x:Name="Action_DataGridColumn" HeaderText="Operation Date" MappingName="ActionDate"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                    <syncfusion:GridTextColumn x:Name="ActionMonth_DataGridColumn" MappingName="ActionMonth" HeaderText="Action Month"/>
                    <syncfusion:GridTextColumn x:Name="ActionYear_DataGridColumn" MappingName="ActionYear" HeaderText="Action Year"/>

                    <syncfusion:GridTextColumn x:Name="Donor_DataGridColumn" HeaderText="Donor"  MappingName="Donor" />

                    <syncfusion:GridNumericColumn x:Name="Rate_DataGridColumn" HeaderText="Rate" MappingName="Rate"
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn x:Name="Exchanged_DataGridColumn" HeaderText="Exchanged" MappingName="Exchanged"     
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>

                    <syncfusion:GridTextColumn x:Name="Note_DataGridColumn" HeaderText="Description (Ar)"  MappingName="Note"  />
                    <syncfusion:GridTextColumn x:Name="E_Note_DataGridColumn" HeaderText="Description (Eng)"  MappingName="E_Note"  />
                    <syncfusion:GridTextColumn x:Name="AvgRateName_DataGridColumn" HeaderText="Original Avg Rate group"  MappingName="AvgRateName"  />
                    <syncfusion:GridNumericColumn x:Name="AvgRate_DataGridColumn" HeaderText="Original Avg Rate amount" MappingName="AvgRateValue"
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn x:Name="USD_Value_DataGridColumn" HeaderText="Value" MappingName="USD_Value" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                    <syncfusion:GridTextColumn x:Name="ObserveAccount_DataGridColumn" HeaderText="Corresponding account" MappingName="ObserveAccount"/>
                    <syncfusion:GridTextColumn x:Name="ObserveTill_DataGridColumn" HeaderText="Corresponding till" MappingName="ObserveTill" />
                    <syncfusion:GridTextColumn x:Name="ObserveAcctionID_DataGridColumn" HeaderText="Corresponding Operation ID" MappingName="ObserveAcion_ID" />
                    <syncfusion:GridTextColumn x:Name="ExAccount_DataGridColumn" HeaderText="Exchange account" MappingName="ExchangeAcc_Name"/>
                    <syncfusion:GridDateTimeColumn x:Name="created_at_DataGridColumn" HeaderText="Date Created" MappingName="created_at" 
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"  />
                    <syncfusion:GridDateTimeColumn x:Name="updated_at_DataGridColumn" HeaderText="Modification Date" MappingName="updated_at"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                    <syncfusion:GridDateTimeColumn x:Name="approved_at_DataGridColumn" HeaderText="Confirmation Date" MappingName="approved_at"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                </syncfusion:SfDataGrid.Columns>
                <syncfusion:SfDataGrid.GroupSummaryRows>
                    <syncfusion:GridSummaryRow ShowSummaryInRow="False" TitleColumnCount="1"  Title="Total:">
                        <syncfusion:GridSummaryRow.SummaryColumns>
                            <syncfusion:GridSummaryColumn Name="Total_I"                                                      
                                     Format="'{Sum:N2}'"
                                     MappingName="Income"
                                     SummaryType="DoubleAggregate" />
                        <syncfusion:GridSummaryColumn Name="Total_I_USD"                                                      
                                     Format="'{Sum:N2}'"
                                     MappingName="Incomeusd"
                                     SummaryType="DoubleAggregate" />
                        <syncfusion:GridSummaryColumn Name="Total_Ex"                                                      
                                     Format="'{Sum:N2}'"
                                     MappingName="Exchange"
                                     SummaryType="DoubleAggregate" />
                        <syncfusion:GridSummaryColumn Name="Total_O"                                                      
             Format="'{Sum:N2}'"
             MappingName="Outcome"
             SummaryType="DoubleAggregate" />
                        <syncfusion:GridSummaryColumn Name="Total_E"                                                      
                                     Format="'{Sum:N2}'"
                                     MappingName="Expand"
                                     SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Balance"                                                      
                                Format="'{Sum:N2}'"
                                MappingName="Balance"
                                SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Exchanged"                                                      
                                     Format="'{Sum:N2}'"
                                     MappingName="Exchanged"
                                     SummaryType="DoubleAggregate" />
                        </syncfusion:GridSummaryRow.SummaryColumns>
                    </syncfusion:GridSummaryRow>
                </syncfusion:SfDataGrid.GroupSummaryRows>

                <syncfusion:SfDataGrid.TableSummaryRows>
                    <syncfusion:GridTableSummaryRow ShowSummaryInRow="False" TitleColumnCount="1" Position="Bottom"
                                     Title="Total:">
                        <syncfusion:GridSummaryRow.SummaryColumns>
                            <syncfusion:GridSummaryColumn Name="Total_I"                                                      
                                        Format="'{Sum:N2}'"
                                        MappingName="Income"
                                        SummaryType="DoubleAggregate" />
                        <syncfusion:GridSummaryColumn Name="Total_I_USD"                                                      
                                        Format="'{Sum:N2}'"
                                        MappingName="Incomeusd"
                                        SummaryType="DoubleAggregate" />
                        <syncfusion:GridSummaryColumn Name="Total_E"                                                      
                                              Format="'{Sum:N2}'"
                                              MappingName="Expand"
                                              SummaryType="DoubleAggregate" />
                        <syncfusion:GridSummaryColumn Name="Total_O"                                                      
Format="'{Sum:N2}'"
MappingName="Outcome"
SummaryType="DoubleAggregate" />
                        <syncfusion:GridSummaryColumn Name="Total_Ex"                                                      
                                              Format="'{Sum:N2}'"
                                              MappingName="Exchange"
                                              SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Balance"                                                      
                                        Format="'{Sum:N2}'"
                                        MappingName="Balance"
                                        SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Exchanged"                                                      
                                              Format="'{Sum:N2}'"
                                              MappingName="Exchanged"
                                              SummaryType="DoubleAggregate" />
                        </syncfusion:GridSummaryRow.SummaryColumns>
                    </syncfusion:GridTableSummaryRow>
                </syncfusion:SfDataGrid.TableSummaryRows>
            </syncfusion:SfDataGrid>
        
    </Grid>
</Window>

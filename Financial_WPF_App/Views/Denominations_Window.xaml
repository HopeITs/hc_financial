<Window x:Class="Financial_WPF_App.Views.Denominations_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        mc:Ignorable="d"
        Title="Denominations_Window" Height="480" Width="400" KeyDown="Window_KeyDown" Closing="Window_Closing" WindowStartupLocation="CenterScreen">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="90*" />
                <RowDefinition Height="10*" />
            </Grid.RowDefinitions>

         <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="2"                                            
         Style="{DynamicResource SfDataGrid_body}"
         HeaderStyle="{DynamicResource SfDataGrid_header}"
         RowStyle="{DynamicResource SfDataGrid_RowStyle}"
         AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"      
         NavigationMode="Cell" CurrentCellBorderBrush="{StaticResource LightGray2}" CurrentCellBorderThickness="2"
         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowGroupDropArea ="False"
         Margin="1,1,1,5"  AllowFiltering="False" CurrentCellEndEdit="myDataGrid_CurrentCellEndEdit" AddNewRowPosition="Bottom" ItemsSourceChanged="myDataGrid_ItemsSourceChanged">

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" HeaderText="#"  MappingName="ID" IsHidden="True"/>

                    <syncfusion:GridNumericColumn  x:Name="Denominations_DataGridColumn" HeaderText="Denominations"  MappingName="name" AllowEditing="True"
                                           NumberDecimalDigits="0" NumberGroupSizes="3" NumberGroupSeparator=","/>
                    <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn"  HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
             
            </syncfusion:SfDataGrid>

            <Grid Grid.Column="0" Grid.Row="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="1"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50*" />
                </Grid.RowDefinitions>
                <Button Grid.Column="0" Style="{DynamicResource SaveButton_Style}" 
                    x:Name="Save_btn" TabIndex="3" Click="Save_btn_Click" />
            </Grid>

        </Grid>

    </Grid>
</Window>

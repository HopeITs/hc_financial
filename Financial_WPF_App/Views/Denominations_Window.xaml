<Window x:Class="Financial_WPF_App.Views.Denominations_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        mc:Ignorable="d"
        Title="Denominations_Window" Height="480" Width="400" KeyDown="Window_KeyDown" Closing="Window_Closing" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="90*" />
                <RowDefinition Height="10*" />
            </Grid.RowDefinitions>

            <!--<ScrollViewer   
            FlowDirection="RightToLeft"
            VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" 
            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">-->

            <DataGrid  
                x:Name="myDataGrid" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"  
                ColumnHeaderStyle="{DynamicResource DataGrid_header}"
                Style="{DynamicResource DataGrid_body}" 
                AlternatingRowBackground="{DynamicResource HopeBlue1}" 
                RowBackground="{DynamicResource HopeGrey}" AlternationCount="2" 
                IsReadOnly="False" CellEditEnding="myDataGrid_CellEditEnding"
                SelectionChanged="myDataGrid_SelectionChanged" >

                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding id}" Header="#" Visibility="Hidden" />
                    <DataGridTextColumn Header="Denominations"  Binding="{Binding name}"/>
                    <!--<DataGridTemplateColumn Header="Edit" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource Edit_Style}" Click="EditButton_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->
                    <DataGridTemplateColumn Header="Delete" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

            <Grid Grid.Column="0" Grid.Row="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="1"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50*" />
                </Grid.RowDefinitions>
                <Button Grid.Column="0" Style="{DynamicResource SaveButton_Style}" 
                    x:Name="Save_btn" TabIndex="3" Click="Save_btn_Click" />

                <!--<Label Grid.Column="1" Style="{DynamicResource lableStyle}" x:Name="Selected_lable" Content="Selected: 0" />-->
                <!--<Label Grid.Column="2" Style="{DynamicResource lableStyle}" x:Name="All_lable" Content="All: 0" />-->

                <Label Grid.Column="4" Content="All: " Style="{DynamicResource statistic_lableStyle}" />
                <Border Grid.Column="3" BorderThickness="1" CornerRadius="7" Padding="0" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" >
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                    </Border.Background>
                    <TextBlock  x:Name="All_textBlock" 
                        Text="{Binding Items.Count, ElementName=myDataGrid, StringFormat=\{0:N0\}}"  
                        Style="{DynamicResource statistic_textBlockStyle}"
                        OverridesDefaultStyle="True"  />
                </Border>

                <Label Grid.Column="2" Content="Selected: " Style="{DynamicResource statistic_lableStyle}" />
                <Border Grid.Column="1" BorderThickness="1" CornerRadius="7" Padding="0" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" >
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                    </Border.Background>
                    <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}"
                        OverridesDefaultStyle="True"  />
                </Border>
            </Grid>

        </Grid>

    </Grid>
</Window>

<Window x:Class="Financial_WPF_App.Views.Project_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        mc:Ignorable="d"
        Title="Project_Window"  Style="{StaticResource WindowPopupStyle}" WindowStartupLocation="CenterScreen">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>


    <Grid Margin="10" >
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="97*" />
        </Grid.RowDefinitions>
        
        <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0">
            <local:WindowControlBar_Popup x:Name="ControlBar" HorizontalAlignment="Right"/>
        </DockPanel>
        <Grid Grid.Row="1"  Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal" Height="30">
                <Label  Style="{DynamicResource statistic_lableStyle}" Content="Category:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Margin="10,0,29,0" />
                <ComboBox x:Name="Category_comboBox" Style="{StaticResource FloatingComboboxStyle}" DisplayMemberPath="Name" SelectedValuePath="ID"  Width="175"
TabIndex="2" />
                <Button x:Name="Category_clear_btn" Grid.Column="1" FontSize="16" BorderBrush="{x:Null}" Style="{StaticResource DeleteButtonStyle}"
            Click="Category_clear_btn_Click"  VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2"  Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal" Grid.Row="2"  Height="30" Margin="0,5,0,0">
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Project Name:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                <TextBox x:Name="Name_txtBox"  Style="{DynamicResource FloatingTextBoxStyle}" Width="175" TabIndex="2" HorizontalContentAlignment="Stretch"  />
            </StackPanel>
            
        </Grid>
        <Grid Grid.Row="3" Margin="0,5,0,5" >
            <Button  Style="{DynamicResource ButtonColoredStyle}" x:Name="Save_btn" Content="Save" Click="Save_btn_Click" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="175" Margin="10,5,1,0" />
        </Grid>


        <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="2"                                            
       Style="{DynamicResource SfDataGrid_body}"
       HeaderStyle="{DynamicResource SfDataGrid_header}"
       RowStyle="{DynamicResource SfDataGrid_RowStyle}"
       AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"      
       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
       Margin="1,2,2,0"  Grid.Row="4" Grid.ColumnSpan="4" MouseDoubleClick="myDataGrid_MouseDoubleClick" ItemsSourceChanged="myDataGrid_ItemsSourceChanged">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" HeaderText="#"  MappingName="ID"/>
                <syncfusion:GridTextColumn x:Name="ProjectName" HeaderText="Project Name"  MappingName="Name" />
                <syncfusion:GridTextColumn x:Name="Category_DataGridColumn" HeaderText="Category"  MappingName="Category" />
                <syncfusion:GridTextColumn x:Name="CategoryID_DataGridColumn" HeaderText="Category_ID"  MappingName="Category_ID" IsHidden="True"/>


                <syncfusion:GridTemplateColumn x:Name="Edit_DataGridColumn" HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn" HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

    </Grid>
</Window>

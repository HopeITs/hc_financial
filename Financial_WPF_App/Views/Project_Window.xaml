<Window x:Class="Financial_WPF_App.Views.Project_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        mc:Ignorable="d"
        Title="Project_Window"  Height="600" Width="450" FontFamily="Myriad Arabic" FontSize="16"  WindowStartupLocation="CenterScreen">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    
    
    <Grid Margin="0,11,0,0" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86*"/>
            <ColumnDefinition Width="217*"/>
            <ColumnDefinition Width="102*"/>
            <ColumnDefinition Width="45*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition/>
            <RowDefinition Height="13*"/>
            <RowDefinition Height="97*" />
        </Grid.RowDefinitions>

        <Label Grid.Column="2"  Style="{DynamicResource lableStyle}" Content="Category:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,6,1,6" HorizontalContentAlignment="Right" />
        <Grid  Grid.Column="1" Grid.Row="0" FlowDirection="RightToLeft" Margin="1,2,1,2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75*"/>
                <ColumnDefinition Width="25*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="Category_comboBox" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="ID" 
                TabIndex="2" FlowDirection="RightToLeft" Height="auto"  />
            <Button x:Name="Category_clear_btn" Grid.Column="1" FontSize="16" BorderBrush="{x:Null}"
                Click="Category_clear_btn_Click" Margin="7,10,0,0" MaxWidth="20" MinHeight="20" MinWidth="15" MaxHeight="15" VerticalAlignment="Top" HorizontalAlignment="Left" Height="23" Width="24" RenderTransformOrigin="0.291,-1.37"  >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </Grid>

        <Label Grid.Column="2" Grid.Row="1" Style="{DynamicResource lableStyle}" Content="Project Name:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,6,1,6" HorizontalContentAlignment="Right" />
        <TextBox x:Name="Name_txtBox" Grid.Column="1"  Grid.Row="1"  Style="{DynamicResource textBoxStyle}" TabIndex="2" HorizontalContentAlignment="Stretch" Margin="17,0,1,0" Height="32" />

        <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3"  Style="{DynamicResource SaveButton_Style}" x:Name="Save_btn" 
            TabIndex="4" Click="Save_btn_Click" Height="32" Margin="10,0,0,0" Width="86"   />


        <!--</ScrollViewer>-->
        <!--<ScrollViewer  
            FlowDirection="RightToLeft"
            VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" 
            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">-->
        <DataGrid  x:Name="myDataGrid"  Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="4"  
            ColumnHeaderStyle="{DynamicResource DataGrid_header}" 
            Style="{DynamicResource DataGrid_body}"
            AlternatingRowBackground="{DynamicResource HopeBlue1}" 
            RowBackground="{DynamicResource HopeGrey}" AlternationCount="2" Margin="0,2,0,0" >

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding ID}" Header="#"  />
                <DataGridTextColumn Header="Project Name"  Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Category"  Binding="{Binding Category}"/>
                <DataGridTextColumn Header="Category_ID"  Binding="{Binding Category_ID}" Visibility="Hidden" />
                <DataGridTemplateColumn Header="Edit" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource Edit_Style}" Click="EditButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Delete" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource Delete_Style}" Click="DeleteButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>


    </Grid>
</Window>

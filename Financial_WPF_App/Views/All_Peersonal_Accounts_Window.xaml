<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.All_Peersonal_Accounts_Window"
        mc:Ignorable="d"
        Title="All_Peersonal_Accounts_Window" Width="1280" Height="720"
        FontFamily="Myriad Arabic" FontSize="20" WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid >
            <Grid.ContextMenu>
                <ContextMenu x:Name="cm">
                    <MenuItem Header="Refresh" Click = "Refresh_Click" >
                        <MenuItem.Icon>
                            <Image Source="/Images/refresh32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="100*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Second_col" Width="100*" />
            </Grid.ColumnDefinitions>

            <!--<ScrollViewer  
            FlowDirection="RightToLeft"
            VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" 
            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">-->
            <Grid  Grid.Column="1" Grid.RowSpan="3" Margin="0,10,0,0"    >
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="95*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="2" 
                    Style="{DynamicResource SfDataGrid_body}"
                    HeaderStyle="{DynamicResource SfDataGrid_header}"
                    RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                    AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" SelectionChanged="myDataGrid_SelectionChanged"
                    Loaded="myDataGrid_Loaded"
                    Margin="4,0,0,11" Grid.Row="1" HorizontalAlignment="Stretch" MouseDoubleClick="myDataGrid_MouseDoubleClick" VerticalAlignment="Stretch" FilterChanged="myDataGrid_FilterChanged" >
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="ID" HeaderText="#" 
                            IsHidden="True" />
                        <syncfusion:GridTextColumn MappingName="Name" HeaderText="Account"/>
                        <syncfusion:GridDateTimeColumn HeaderText= "Start Date" MappingName="BeginDate"
                            CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"/>
                        <syncfusion:GridDateTimeColumn HeaderText= "End Date" MappingName="EndDate"
                            CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"/>
                        <syncfusion:GridTextColumn MappingName="IsClosed" HeaderText="Status"/>
                        <syncfusion:GridTemplateColumn HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                        <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
                <Grid Grid.Row="2" Margin="15,8,11,7" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="5" Content="All;" Style="{DynamicResource statistic_lableStyle}" />
                    <Border Grid.Column="4" Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"/>
                    </Border>

                    <Label Grid.Column="3" Content="Selected:" Style="{DynamicResource statistic_lableStyle}" />
                    <Border Grid.Column="2" Style="{StaticResource BorderStackPanelStyle}" >
                        <TextBlock x:Name="Selected_textBlock" Text="0" 
                            Style="{DynamicResource statistic_textBlockStyle}"
                            OverridesDefaultStyle="True"  />
                    </Border>
                </Grid>
                <Grid Margin="4,4,0,5" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="139*"/>
                        <ColumnDefinition Width="117"/>
                        <ColumnDefinition Width="225"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="238*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                        TabIndex="5" Command="Helper:Commands.ExportToExcel" Grid.Column="2" Height="25" Width="26" />
                    <Menu x:Name="ShowHideMenu" Margin="10,2,7,1" Grid.Column="1" >
                        <Menu.Background>
                            <ImageBrush/>
                        </Menu.Background>
                        <MenuItem Header="" StaysOpenOnClick="True" Grid.Column="1" Width="35" Height="32" >
                            <MenuItem.Background>
                                <ImageBrush ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                            </MenuItem.Background>
                            <MenuItem x:Name="ShowMenu" Header="Show" StaysOpenOnClick="True" Background="White" />
                            <MenuItem x:Name="HideMenu" Header="Hide" StaysOpenOnClick="True" Background="White"/>
                            <Separator Background="Black"/>
                            <MenuItem Header="ShowAll" Click="ShowAll_MenuItem_Click" Background="White"/>
                        </MenuItem>
                    </Menu>
                    <Label VerticalContentAlignment="Center" Style="{DynamicResource lableStyle}" HorizontalContentAlignment="Center" Content="Search:" Grid.Column="6" Width="62" VerticalAlignment="Stretch" Margin="0,2,0,1" HorizontalAlignment="Center"/>
                    <Border Grid.Column="5" BorderThickness="1" CornerRadius="10" Padding="0" Width="192" Margin="0,3,0,2" HorizontalAlignment="Center" >
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                        </Border.BorderBrush>
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                        </Border.Background>
                        <TextBox x:Name="Search_txtBox" Width="auto" 
                            TextChanged="Search_txtBox_TextChanged" TextWrapping="Wrap"  
                            TabIndex="1" Margin="3" 
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
                            FlowDirection="RightToLeft" TextAlignment="Center" VerticalAlignment="Center" 
                            Background="{DynamicResource HopeGrey}" BorderThickness="0" >
                            <TextBox.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                            </TextBox.BorderBrush>
                        </TextBox>
                    </Border>
                    <!--<CheckBox Grid.Column="4" x:Name="ExactSearch_checkBox" 
                        Content="Full Match" 
                        Checked="ExactSearch_checkBox_Checked" Unchecked="ExactSearch_checkBox_Unchecked" 
                        VerticalAlignment="Center" VerticalContentAlignment="Top" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="17,0,0,0" Width="96" Height="25" />-->
                </Grid>
            </Grid>

        </Grid>

    </Grid>
</Window>

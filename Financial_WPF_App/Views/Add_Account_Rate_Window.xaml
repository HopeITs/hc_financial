<Window x:Class="Financial_WPF_App.Views.Add_Account_Rate_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:local="clr-namespace:Financial_WPF_App"
        mc:Ignorable="d" Tag="Add Account Rate Window" Height="300" Width="665"
        Title="Add_Account_Rate_Window" Style="{StaticResource smallWindowPopupStyle}" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid Margin="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0" Grid.ColumnSpan="7">
                <local:WindowControlBar_Popup x:Name="ControlBar"/>
            </DockPanel>
            <Label Grid.Column="0" Grid.Row="1" Style="{DynamicResource statistic_lableStyle}" Content="Rate group name:"  HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" />
            <TextBox x:Name="Name_txtBox" Grid.Column="1" Grid.Row="1" TabIndex="2" Style="{DynamicResource FloatingTextBoxStyle}" Width="175"/>
            <Label x:Name="BeginDate_lable" Grid.Column="0" Grid.Row="2" Style="{DynamicResource statistic_lableStyle}" Content="Start date:"  HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            <DatePicker x:Name="BeginDate_datepicker" Grid.Column="1" TabIndex="3" Width="175"
            SelectedDateChanged="BeginDate_datepicker_SelectedDateChanged"  Grid.Row="2" Height="30"/>
            <Label x:Name="EndDate_lable" Grid.Column="2" Grid.Row="2" Style="{DynamicResource statistic_lableStyle}" Content="End date:"  HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center"  />
            <DatePicker x:Name="EndDate_datepicker" TabIndex="4"  Grid.Column="3" Width="175"
            SelectedDateChanged="BeginDate_datepicker_SelectedDateChanged"  Grid.Row="2" Height="30"/>
            <Label x:Name="EndDate_lable_Copy" Grid.Column="0" Style="{DynamicResource statistic_lableStyle}" Content="From till:"  Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center"  />

            <ComboBox Grid.Row="3" Grid.Column="1" Style="{DynamicResource FloatingComboboxStyle}" x:Name="From_comboBox" Width="175" DisplayMemberPath="Name" SelectedValuePath="ID" SelectionChanged="From_comboBox_SelectionChanged"
                  TabIndex="1" VerticalAlignment="Stretch" />
            <Button Grid.Row="3" Grid.Column="2" Width="21" Height="25" x:Name="From_help" ToolTip="Exchange to SYP can only be made from the budget currency." ToolTipService.InitialShowDelay="100" BorderBrush="{x:Null}" Margin="6,0,0,0" HorizontalAlignment="Left">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
            <Label x:Name="EndDate_lable_Copy1" Grid.Column="2" Style="{DynamicResource statistic_lableStyle}" Content="To till:"  Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center"  />
            <ComboBox Style="{DynamicResource FloatingComboboxStyle}" x:Name="To_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" Width="175"
            TabIndex="1"   Grid.Row="3" Grid.Column="3" SelectionChanged="To_comboBox_SelectionChanged" />
            <Label x:Name="ObserveRate_lable" Grid.Column="2" Style="{DynamicResource statistic_lableStyle}" Content="Corresponding rate:"  Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Center"  />
            <Grid x:Name="ObserveRate_StackPanel" Grid.Column="3" Grid.Row="4" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Style="{DynamicResource FloatingComboboxStyle}" x:Name="ObserveRate_comboBox" DisplayMemberPath="Rate group name" SelectedValuePath="ID" Grid.Column="0" 
              TabIndex="1"/>
                <Button x:Name="ObserveRate_clear_btn" Grid.Column="1"
Style="{StaticResource DeleteButtonStyle}"
Click="ObserveRate_clear_btn_Click" Margin="6,0,0,0" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </Grid>
            <Button Grid.Row="6" Grid.Column="0"
            Style="{DynamicResource ButtonColoredStyle}" x:Name="Save_btn" Content="Save"
            TabIndex="10" Click="Save_btn_Click"   />
            <Label Grid.Row="4" Style="{DynamicResource statistic_lableStyle}" Content="Value:" Grid.Column="0" HorizontalAlignment="Left"  VerticalAlignment="Center" VerticalContentAlignment="Center"  />
            <TextBox x:Name="Value_txtBox"  TabIndex="6" Grid.Column="1" Width="175"
            Style="{DynamicResource FloatingTextBoxStyle}" IsReadOnly="True" Grid.Row="4" />
        </Grid>
    </Grid>
</Window>

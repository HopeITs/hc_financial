<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.Monthly_Salaries_Window"
        mc:Ignorable="d"
        Title="Monthly_Salaries_Window" Width="1280" Height="720"
        FontFamily="Myriad Arabic" FontSize="20" WindowStartupLocation="CenterScreen">
    <Grid >
        <Grid.ContextMenu>
            <ContextMenu x:Name="cm">
                <MenuItem Header="Refresh" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Second_col" Width="100*" />
        </Grid.ColumnDefinitions>

        <!--<ScrollViewer  
            FlowDirection="RightToLeft"
            VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" 
            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">-->
        <Grid  Grid.Column="1" Grid.RowSpan="3" Margin="0,10,0,0"    >
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="95*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="2" 
                Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                Loaded="myDataGrid_Loaded"
                Margin="4,0,0,0" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FilterChanged="myDataGrid_FilterChanged" >
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn x:Name="Employee_Salary_ID_DataGridColumn" HeaderText="#" MappingName="Employee_Salary_ID" IsHidden="True"/>
                    <syncfusion:GridTextColumn x:Name="Employee_ID_DataGridColumn" HeaderText="Employee_ID" MappingName="Employee_ID" IsHidden="True"/>

                    <syncfusion:GridTextColumn x:Name="Employee_DataGridColumn" HeaderText="Name" MappingName="Name" />
                    <syncfusion:GridTextColumn x:Name="Subproject_DataGridColumn" HeaderText="Center" MappingName="Subproject" />
                    <syncfusion:GridTextColumn x:Name="Line_DataGridColumn" HeaderText="Position" MappingName="Line" />

                    <syncfusion:GridDateTimeColumn x:Name="EDate_DataGridColumn" HeaderText="Month" MappingName="Date"
                                                 CustomPattern="MM/yyyy" Pattern="CustomPattern"  AllowEditing="True" />

                    <syncfusion:GridNumericColumn x:Name="Basic_DataGridColumn" HeaderText="Basic"  MappingName="Basic" 
                              NumberDecimalDigits="2"
                              NumberDecimalSeparator="."
                              NumberGroupSizes="3"
                              NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  x:Name="Adj_DataGridColumn" HeaderText="Adjustment"  MappingName="Adjustment" 
                              NumberDecimalDigits="2"
                              NumberDecimalSeparator="."
                              NumberGroupSizes="3"
                              NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn x:Name="USD_Basic_DataGridColumn" HeaderText="USD Basic"  MappingName="USD_Basic" 
                              NumberDecimalDigits="2"
                              NumberDecimalSeparator="."
                              NumberGroupSizes="3"
                              NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  x:Name="USDAdj_DataGridColumn" HeaderText="USD Adjustment"  MappingName="USD_Adjustment" 
                              NumberDecimalDigits="2"
                              NumberDecimalSeparator="."
                              NumberGroupSizes="3"
                              NumberGroupSeparator=","/>

                    <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridCheckBoxColumn x:Name="Selected_DataGridColumn" HeaderText="Select" MappingName="IsSelected" AllowEditing="True" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridCheckBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chkHeader" Loaded="chkHeader_Loaded" Click="chkHeader_Click"/>
                            </DataTemplate>
                        </syncfusion:GridCheckBoxColumn.HeaderTemplate>
                        <syncfusion:GridCheckBoxColumn.CellStyle>
                            <Style>
                                <Style.Resources>
                                    <Style TargetType="CheckBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="1">
                                                <Setter Property="Background" Value="Green" />
                                                <Setter Property="FlowDirection" Value="LeftToRight" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsSelected}" Value="0">
                                                <Setter Property="Background" Value="Transparent" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </syncfusion:GridCheckBoxColumn.CellStyle>
                    </syncfusion:GridCheckBoxColumn>


                </syncfusion:SfDataGrid.Columns>

                <syncfusion:SfDataGrid.TableSummaryRows>
                    <syncfusion:GridTableSummaryRow ShowSummaryInRow="False" TitleColumnCount="1" Position="Bottom"
                                       Title="Total:">
                        <syncfusion:GridSummaryRow.SummaryColumns>
                            <syncfusion:GridSummaryColumn Name="Total_B"                                                      
                                                Format="'{Sum:N2}'"
                                                MappingName="Basic"
                                                SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Adj"                                                      
                                                Format="'{Sum:N2}'"
                                                MappingName="Adjustment"
                                                SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_B_USD"                                                      
                                                Format="'{Sum:N2}'"
                                                MappingName="USD_Basic"
                                                SummaryType="DoubleAggregate" />
                            <syncfusion:GridSummaryColumn Name="Total_Adj_USD"                                                      
                                                Format="'{Sum:N2}'"
                                                MappingName="USD_Adjustment"
                                                SummaryType="DoubleAggregate" />
                        </syncfusion:GridSummaryRow.SummaryColumns>
                    </syncfusion:GridTableSummaryRow>
                </syncfusion:SfDataGrid.TableSummaryRows>

            </syncfusion:SfDataGrid>
            <Grid Margin="4,4,0,5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="139*"/>
                    <ColumnDefinition Width="117"/>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="238*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                    TabIndex="5" Command="Helper:Commands.ExportToExcel" Grid.Column="1" Height="25" Width="26" HorizontalAlignment="Left" Margin="16,0,0,0" />
                <StackPanel x:Name="AddMultiAction_StackPanel" Grid.Column="7" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="222,2,0,-2">
                    <Button Style="{DynamicResource Add_Style}" 
                        x:Name="AddMultiSalaries_btn" TabIndex="15" Height="25" Width="25" Click="AddMultiSalaries_btn_Click"  />
                    <Label x:Name="AddMultiSalaries_Label" Style="{DynamicResource lableStyle}" 
                        Content="Add Monthly Salaries"  />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="Delete_Selected" Margin="4,13,1165,13" Grid.Row="2" TextWrapping="Wrap"><Hyperlink x:Name="Delete_Selected_TextBlock" Click="Delete_Selected_TextBlock_Click"><Run Text="Delete Selected"/></Hyperlink></TextBlock>
        </Grid>

    </Grid>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.Add_MultiPayments_Windows"
        mc:Ignorable="d"
        Title="Add_MultiPayments_Windows" Width="1000" Height="600" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168*"/>
                <ColumnDefinition Width="482*"/>
                <ColumnDefinition Width="218*"/>
                <ColumnDefinition Width="133*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35*"/>
                <RowDefinition Height="355*"/>
                <RowDefinition Height="44*"/>
            </Grid.RowDefinitions>


            <syncfusion:SfDataGrid x:Name="myDataGrid"  ShowRowHeader="True"
                AutoGenerateColumns="True"
                GridPasteOption="PasteData"
                GridValidationMode="InView"
                Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"   
                AllowFiltering ="False" ShowGroupDropArea ="False"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                Margin="0,47,0,59" Grid.ColumnSpan="4" Grid.RowSpan="3" Loaded="myDataGrid_Loaded"/>


            <StackPanel x:Name="ClearAll_panel" Orientation="Horizontal" Margin="0,1,1,1" >
                <Label x:Name="ClearAll_lable" Style="{DynamicResource lableStyle}" Content="Clear All:" Height="44" Width="65" FlowDirection="LeftToRight" />
                <Button x:Name="clear_btn" Width="21" Height="44" BorderBrush="{x:Null}" Click="clear_btn_Click" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            <Grid Grid.Row="2" Grid.ColumnSpan="4" Margin="1,1,1,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250*"/>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="250*"/>
                </Grid.ColumnDefinitions>
                <Button 
                    Style="{DynamicResource SaveButton_Style}"
                    x:Name="Save_btn" TabIndex="20" Click="Save_btn_Click" Margin="10,4,10,4" Height="NaN" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Button
                    TabIndex="5" Style="{DynamicResource Export_Style}" x:Name="Export_btn" Margin="10,16,411,16" Command="Helper:Commands.ExportToExcel" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RenderTransformOrigin="0.536,0.355"
                />
            </Grid>
        </Grid>

    </Grid>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:WPFTextBoxAutoComplete;assembly=WPFTextBoxAutoComplete"
        xmlns:Controls="clr-namespace:Financial_WPF_App.Controls" x:Class="Financial_WPF_App.Views.Payments_Window"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        mc:Ignorable="d"
        Title="Payments_Window" 
          FontSize="16" FontFamily="Myriad Arabic"
        Height="620" Width="1280" WindowState="Maximized" WindowStartupLocation="CenterScreen">



    <Grid Margin="4,4,4,4" >
        <Grid.ContextMenu>
            <ContextMenu x:Name="cm">
                <MenuItem Header="Refresh" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="First_col" Width="0*"/>
            <ColumnDefinition x:Name="Second_col" Width="50*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,3,6,2" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Expander_col" Width="30*" />
                <ColumnDefinition x:Name="Grid_col" Width="70*" />
            </Grid.ColumnDefinitions>

            <Expander x:Name="myExpander" Grid.Column="0" IsExpanded="True"
                ExpandDirection="Left" 
                Expanded="myExpander_Expanded" Collapsed="myExpander_Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="#FF30323E" Margin="0,1,0,0" Grid.RowSpan="2" Background="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="2"/>
                        <RowDefinition/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <syncfusion:SfDataGrid x:Name="Cash_DataGrid"
                        Style="{DynamicResource SfDataGrid_body}"
                        HeaderStyle="{DynamicResource SfDataGrid_header}"
                        RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                        AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" 
                        TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"
                        AutoGenerateColumns="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"     
                        Margin="1,1,0,10" Grid.Row="2" AutoGeneratingColumn="Cash_DataGrid_AutoGeneratingColumn" Loaded="Cash_DataGrid_Loaded">
                        <syncfusion:SfDataGrid.TableSummaryRows>
                            <syncfusion:GridTableSummaryRow ShowSummaryInRow="False" TitleColumnCount="1" Position="Bottom"
                                Title="Total:">
                                <syncfusion:GridTableSummaryRow.SummaryColumns>
                                    <syncfusion:GridSummaryColumn Name="Total_I"                                                      
                                        Format="'{Sum:N2}'"
                                        MappingName="Income"
                                        SummaryType="DoubleAggregate" />
                                    <syncfusion:GridSummaryColumn Name="Total_E"                                                      
                                        Format="'{Sum:N2}'"
                                        MappingName="Outcome"
                                        SummaryType="DoubleAggregate" />
                                    <syncfusion:GridSummaryColumn Name="Total_Dif"                                                      
                                        Format="'{Sum:N2}'"
                                        MappingName="Difference"
                                        SummaryType="DoubleAggregate" />
                                </syncfusion:GridTableSummaryRow.SummaryColumns>
                            </syncfusion:GridTableSummaryRow>
                        </syncfusion:SfDataGrid.TableSummaryRows>
                    </syncfusion:SfDataGrid>
                    <Label Style="{DynamicResource lableStyle}" 
                        Content="Balances" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,-1,0"  />
                    <Button
                        TabIndex="5" Style="{DynamicResource Export_Style}" x:Name="Cash_Export_btn" Margin="1,3,0,3" Command="local:Commands.ExportToExcel" VerticalAlignment="Stretch" HorizontalAlignment="Left" RenderTransformOrigin="0.536,0.355" Width="30" Grid.Row="3"/>
                </Grid>

            </Expander>
            <Grid Grid.Column="1" Margin="1,1,0,4" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="43"/>
                    <RowDefinition Height="43*"/>
                    <RowDefinition Height="105*"/>
                    <RowDefinition Height="338*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
                    <WrapPanel  Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="56"/>
                            <Border Style="{StaticResource BorderStackPanelStyle}">
                                <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"  />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Loan amount:" Style="{DynamicResource statistic_lableStyle}"  Width="79"/>
                            <Border Style="{StaticResource BorderStackPanelStyle}">
                                <TextBlock x:Name="Amount_textBlock" Text="0.00" 
                                Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Amount_textBlock_SizeChanged" />
                            </Border>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Amount owed:" Style="{DynamicResource statistic_lableStyle}"/>
                            <Border Style="{StaticResource BorderStackPanelStyle}">
                                <TextBlock x:Name="ToPayAmount_textBlock"
                                    Text="0.00"
                                    Style="{DynamicResource statistic_textBlockStyle}" 
                                    OverridesDefaultStyle="True" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Label Content="Amount paid:" Style="{DynamicResource statistic_lableStyle}"/>
                            <Border Style="{StaticResource BorderStackPanelStyle}">
                                <TextBlock x:Name="PaidAmount_textBlock"
                                Text="0.00"
                                Style="{DynamicResource statistic_textBlockStyle}" 
                                OverridesDefaultStyle="True" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Remaining amount:" Style="{DynamicResource statistic_lableStyle}"/>
                            <Border Style="{StaticResource BorderStackPanelStyle}" Height="29" >
                                <TextBlock x:Name="RemainingAmount_textBlock"
                                    Text="0.00"
                                    Style="{DynamicResource statistic_textBlockStyle}" 
                                    OverridesDefaultStyle="True" />
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                </Border>
                <!--</ScrollViewer>-->
                <!--<ScrollViewer   
                FlowDirection="RightToLeft"
                VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" 
                PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">-->

                <Grid  Grid.Row="4" Margin="0,3,1,0" Grid.RowSpan="2" >
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="25.302"/>
                    </Grid.RowDefinitions>

                    <syncfusion:SfDataGrid x:Name="myDataGrid" 
                        Style="{DynamicResource SfDataGrid_body}"
                        HeaderStyle="{DynamicResource SfDataGrid_header}"
                        RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                        AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"                              
                        SelectionChanged="myDataGrid_SelectionChanged" Loaded="myDataGrid_Loaded" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,2,2,3" FilterChanged="myDataGrid_FilterChanged" MouseDoubleClick="myDataGrid_MouseDoubleClick">

                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn MappingName="ID" HeaderText="#" IsHidden="True"/>
                            <syncfusion:GridNumericColumn  HeaderText="Payment amount"  MappingName="Income"
                                NumberDecimalDigits="2"
                                NumberDecimalSeparator="."
                                NumberGroupSizes="3"
                                NumberGroupSeparator=","/>
                            <syncfusion:GridTextColumn MappingName="MicroProject_ID" HeaderText="Project number"/>
                            <syncfusion:GridTextColumn MappingName="Name" HeaderText="Beneficiary Name"/>
                            <syncfusion:GridTextColumn MappingName="beneficiary_ID" HeaderText="beneficiary_ID" IsHidden="True"/>
                            <syncfusion:GridTextColumn MappingName="Payment_Num" HeaderText="Number of payment"/>
                            <syncfusion:GridDateTimeColumn HeaderText="Payment date" MappingName="ActionDate"
                                CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                            <syncfusion:GridTextColumn  MappingName="ActionMonth" HeaderText="Payment Month"/>
                            <syncfusion:GridTextColumn  MappingName="ActionYear" HeaderText="Payment Year"/>

                            <syncfusion:GridTextColumn MappingName="Note" HeaderText="Description"/>
                            <syncfusion:GridTextColumn MappingName="beneficiary_Account_ID" HeaderText="beneficiary_Account_ID" IsHidden="True"/>
                            <syncfusion:GridTextColumn MappingName="beneficiary_Account" HeaderText="Account"/>
                            <syncfusion:GridTextColumn MappingName="cashaccount_name" HeaderText="Cash till"/>
                            <syncfusion:GridTextColumn MappingName="beneficiaryDonor_ID" HeaderText="beneficiaryDonor_ID" IsHidden="True"/>
                            <syncfusion:GridTextColumn MappingName="beneficiaryDonor_Name" HeaderText="Donor"/>
                            <syncfusion:GridTextColumn x:Name="Created_by_DataGridColumn" MappingName="created_by" HeaderText="Created by"/>
                            <syncfusion:GridDateTimeColumn HeaderText="Date created" MappingName="created_at"
                                CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                            <syncfusion:GridTextColumn x:Name="Edited_by_DataGridColumn" MappingName="edited_by" HeaderText="Edited by"/>
                            <syncfusion:GridDateTimeColumn HeaderText="Modification date" MappingName="updated_at"
                                CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />

                            <syncfusion:GridTextColumn x:Name="Approved_by_DataGridColumn" MappingName="approved_by" HeaderText="Confirmed by"/>

                            <syncfusion:GridDateTimeColumn x:Name="Approved_at_DataGridColumn" HeaderText="Confirmation date" MappingName="Approved_at"
                                CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />

                            <syncfusion:GridTemplateColumn HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                                <syncfusion:GridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click"/>
                                    </DataTemplate>
                                </syncfusion:GridTemplateColumn.CellTemplate>
                            </syncfusion:GridTemplateColumn>

                            <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                                <syncfusion:GridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                                    </DataTemplate>
                                </syncfusion:GridTemplateColumn.CellTemplate>
                            </syncfusion:GridTemplateColumn>
                            <syncfusion:GridCheckBoxColumn x:Name="Selected_DataGridColumn" HeaderText="Select" MappingName="IsSelected" AllowEditing="True" AllowFiltering="False" AllowGrouping="False">
                                <syncfusion:GridCheckBoxColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="chkHeader" Loaded="chkHeader_Loaded" Click="chkHeader_Click"/>
                                    </DataTemplate>
                                </syncfusion:GridCheckBoxColumn.HeaderTemplate>
                                <syncfusion:GridCheckBoxColumn.CellStyle>
                                    <Style>
                                        <Style.Resources>
                                            <Style TargetType="CheckBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="1">
                                                        <Setter Property="Background" Value="Green" />
                                                        <Setter Property="FlowDirection" Value="LeftToRight" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding IsSelected}" Value="0">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Style.Resources>
                                    </Style>
                                </syncfusion:GridCheckBoxColumn.CellStyle>
                            </syncfusion:GridCheckBoxColumn>

                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                    <TextBlock x:Name="Delete_Selected" Grid.Row="1" TextWrapping="Wrap" Height="18" Width="111" Margin="1,4,772,3"><Hyperlink x:Name="Delete_Selected_TextBlock" Click="Delete_Selected_TextBlock_Click"><Run Text="Delete Selected"/></Hyperlink></TextBlock>
                </Grid>
                <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="1">
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="56"/>
                            <Border Style="{StaticResource BorderStackPanelStyle}">
                                <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"  />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Amount paid:" Style="{DynamicResource statistic_lableStyle}" Width="79"/>
                            <Border Style="{StaticResource BorderStackPanelStyle}" >
                                <TextBlock x:Name="PaidAmount_textBlock1" Text="0.00" 
                                    Style="{DynamicResource statistic_textBlockStyle}" FontSize="15" SizeChanged="Amount_textBlock_SizeChanged" />
                            </Border>
                        </StackPanel>
                        
                    </WrapPanel>
                </Border>
                <Grid Margin="1,1,1,2" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="114"/>
                        <ColumnDefinition Width="Auto" MinWidth="92" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="63*" />
                        <ColumnDefinition Width="43*"/>
                    </Grid.ColumnDefinitions>
                    <Menu
                        x:Name="ShowHideMenu" Margin="10,1,12,2">
                        <Menu.Background
        >
                            <ImageBrush
                />
                        </Menu.Background>
                        <MenuItem
                            Width="27" StaysOpenOnClick="True" Header="" Height="36">
                            <MenuItem.Background
        >
                                <ImageBrush
                                    ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"
                />
                            </MenuItem.Background>
                            <MenuItem
                                StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="White"
                />
                            <MenuItem
                                StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="White"
                />
                            <Separator
                                Background="Black"
                />
                            <MenuItem
                                Background="White" Click="ShowAll_MenuItem_Click" Header="ShowAll"
                />
                        </MenuItem>
                    </Menu>
                    <Button
                        TabIndex="5" Style="{DynamicResource Export_Style}" x:Name="Export_btn" Margin="12,8,12,7" Grid.Column="1" Command="local:Commands.ExportToExcel" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RenderTransformOrigin="0.536,0.355"
                />
                    <StackPanel x:Name="AddMultiPayments_StackPanel" Grid.Column="7" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="3,1,2,1">
                        <Button Style="{DynamicResource Add_Style}" 
                            x:Name="AddMultiPayments_btn" TabIndex="15" Height="25" Width="25" Click="AddMultiPayments_btn_Click"  />
                        <Label x:Name="AddMultiPayments_Label" Style="{DynamicResource lableStyle}" 
                            Content="New entry from excel"  />
                    </StackPanel>
                    <StackPanel x:Name="AddNewPayment_StackPanel" Grid.Column="8" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="1,0,3,2">
                        <Button Style="{DynamicResource Add_Style}" 
                            x:Name="AddNewPayment_btn" TabIndex="15" Click="AddNewPayment_btn_Click"  />
                        <Label x:Name="AddNewPayment_Label" Style="{DynamicResource lableStyle}" 
                            Content="New payment"  />
                    </StackPanel>
                    <RadioButton x:Name="NotApproved_RadioButton" Content="Show Not Approved" IsChecked="False" Style="{DynamicResource RadioButtonStyle}" Grid.ColumnSpan="2" Margin="4,3,2,4" Grid.Column="5" Tag="False" Click="NotApproved_RadioButton_Click"/>
                </Grid>
                <Grid Margin="2,1,0,2" Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="25*"/>
                        <ColumnDefinition Width="58*"/>
                        <ColumnDefinition Width="55*"/>
                        <ColumnDefinition Width="165" />
                        <ColumnDefinition Width="26*" />
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="26*" />
                        <ColumnDefinition Width="62*"/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="ActionDate_Label" Grid.Column="8" Style="{DynamicResource lableStyle}" Content="Operation date:" Margin="1,2,1,2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
                    <DatePicker x:Name="FromDate_datepicker" TabIndex="3"
                        Margin="2,0,2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Grid.Column="6" VerticalAlignment="Stretch" />
                    <Label x:Name="ActionDate_Label_Copy" Grid.Column="7" Style="{DynamicResource lableStyle}" Content="From:" Margin="1,2,1,2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
                    <Label x:Name="ActionDate_Label_Copy1" Grid.Column="5" Style="{DynamicResource lableStyle}" Content="To:" Margin="1,2,1,2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
                    <DatePicker x:Name="ToDate_datepicker" TabIndex="3"
                        Margin="2,1,2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Grid.Column="4" VerticalAlignment="Stretch" />
                    <Label x:Name="MircoProject_ID_lable" Grid.Column="3" 
                        Style="{DynamicResource lableStyle}" Content="Project number:" Margin="2,1,163,2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Grid.ColumnSpan="2" />
                    <Controls:AutoCompleteTextBoxUserControl 
                        x:Name="MircoProject_ID_autoSuggestionUserControl" 
                        LostFocus="MircoProject_ID_autoSuggestionUserControl_LostFocus"
                        TabIndex="9" Grid.ColumnSpan="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="160" Height="36" />
                    <Button 
                        Style="{DynamicResource Saveutton_Style}"
                        x:Name="Go_btn" TabIndex="20" Click="Go_btn_Click" Margin="0,0,2,0" VerticalAlignment="Center" Height="34" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Views/Payments_icon.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </Grid>

            </Grid>
        </Grid>

    </Grid>
</Window>


<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:local="clr-namespace:Financial_WPF_App.Helper"
    x:Class="Financial_WPF_App.Views.Till_Window"
        mc:Ignorable="d"
        Title="Till_Window" Width="1280" Height="620" FontSize="18" WindowStartupLocation="CenterScreen">



    <Grid >
        <Grid.ContextMenu>
            <ContextMenu x:Name="cm">
                <MenuItem Header="Refresh Till" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="Delete" Header="Delete Till" Click="Delete_Click">
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/Buttons/delete.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
            <WrapPanel  Orientation="Horizontal">
                <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"  />
                </Border>
                <Label x:Name="Income_Label" Content="Income:" Style="{DynamicResource statistic_lableStyle}"/>
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Income_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="Income_textBlock_SizeChanged"  />
                </Border>
                <Label x:Name="Outcome_Label" Content="Adv. Payment:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Outcome_Border" Style="{StaticResource BorderStackPanelStyle}" >
                    <TextBlock x:Name="Outcome_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Outcome_textBlock_SizeChanged" />
                </Border>

                <Label x:Name="Returned_Label" Content="Returned:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Returned_Border" Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Returned_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Returned_textBlock_SizeChanged" />
                </Border>
                <Label x:Name="Exchange_Label" Content="Exchanged:" Style="{DynamicResource statistic_lableStyle}"/>
                <Border x:Name="Exchange_Border" Style="{StaticResource BorderStackPanelStyle}" >
                    <TextBlock x:Name="Exchange_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchange_textBlock_SizeChanged" />
                </Border>

                <Label x:Name="Exchpand_Label" Content="Expenses:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Exchpand_Border" Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Exchpand_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchpand_textBlock_SizeChanged" />
                </Border>

                <Label x:Name="Net_lable" Content="Account Balance:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Net_Border" Style="{StaticResource BorderStackPanelStyle}" >
                    <TextBlock x:Name="Net_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" />
                </Border>
                <Label x:Name="CashNet_label" Content="Cash Balance:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="CashNet_Border" Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="CashNet_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" />
                </Border>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource MainBorderWrapPanelStyle}">
            <WrapPanel  Orientation="Horizontal">
                <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"  />
                </Border>
                <Label x:Name="Income_Label1" Content="Income:" Style="{DynamicResource statistic_lableStyle}" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Income_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="Income_textBlock_SizeChanged"  />
                </Border>
                <Label x:Name="Outcome_Label1" Content="Adv. Payment:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Outcome_Border2" Style="{StaticResource BorderStackPanelStyle}" >
                    <TextBlock x:Name="Outcome_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Outcome_textBlock_SizeChanged" />
                </Border>

                <Label x:Name="Returned_Label1" Content="Returned:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Returned_Border1" Style="{StaticResource BorderStackPanelStyle}" >
                    <TextBlock x:Name="Returned_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Returned_textBlock_SizeChanged" />
                </Border>
                <Label x:Name="Exchange_Label1" Content="Exchanged:" Style="{DynamicResource statistic_lableStyle}"/>
                <Border x:Name="Exchange_Border1" Style="{StaticResource BorderStackPanelStyle}" >
                    <TextBlock x:Name="Exchange_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchange_textBlock_SizeChanged" />
                </Border>

                <Label x:Name="Exchpand_Label1" Content="Expenses:" Style="{DynamicResource statistic_lableStyle}" />
                <Border x:Name="Exchpand_Border1" Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Exchpand_textBlock1" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" SizeChanged="Exchpand_textBlock_SizeChanged" />
                </Border>
            </WrapPanel >
        </Border>
        <Grid Grid.Row="3" Margin="2,5,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="64*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="Expander_col" Width="30*" ></ColumnDefinition>
                <ColumnDefinition Name="Grid_col" Width="70*" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="6"                                            
                Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"                   
                SelectionChanged="myDataGrid_SelectionChanged" 
                MouseDoubleClick="myDataGrid_MouseDoubleClick" 
                Loaded="myDataGrid_Loaded" 
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                Margin="2,1,2,2" Grid.Column="1" Grid.Row="2" FilterChanged="myDataGrid_FilterChanged" >

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" MappingName="ID" HeaderText="Operation ID"/>
                    <syncfusion:GridNumericColumn  x:Name="Income_DataGridColumn" HeaderText="Income"  MappingName="Income" 
                                                   NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  x:Name="Outcome_DataGridColumn" HeaderText="Adv. Payment"  MappingName="Outcome"
                                                   NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  x:Name="Returned_DataGridColumn" HeaderText="Returned"  MappingName="Returned" 
                                                      NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  x:Name="Exchange_DataGridColumn" HeaderText="Exchange"  MappingName="Exchange" 
                                                      NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  x:Name="Expand_DataGridColumn" HeaderText="Expenses"  MappingName="Expand"
                                                      NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                    <syncfusion:GridDateTimeColumn x:Name="Action_DataGridColumn" HeaderText="Operation Date" MappingName="ActionDate"
                                                   CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                    <syncfusion:GridTextColumn x:Name="ActionMonth_DataGridColumn" MappingName="ActionMonth" HeaderText="Operation Month"/>
                    <syncfusion:GridTextColumn x:Name="ActionYear_DataGridColumn" MappingName="ActionYear" HeaderText="Operation Year"/>


                    <syncfusion:GridTextColumn x:Name="MicroProject_ID_DataGridColumn" HeaderText="Micro project number"  MappingName="MicroProject_ID" />
                    <syncfusion:GridTextColumn x:Name="Name_DataGridColumn" HeaderText="Beneficiary name"  MappingName="Name" />

                    <syncfusion:GridTextColumn x:Name="Budget_DataGridColumn" HeaderText="Budget"  MappingName="Budget" />
                    <syncfusion:GridTextColumn x:Name="Line_DataGridColumn" HeaderText="Line"  MappingName="Line" />

                    <syncfusion:GridTextColumn x:Name="Donor_DataGridColumn" HeaderText="Donor"  MappingName="Donor" />

                    <syncfusion:GridTextColumn x:Name="IsReceipt_DataGridColumn" HeaderText="Document type"  MappingName="IsReceipt"  />
                    <syncfusion:GridTextColumn x:Name="ReceiptNote_DataGridColumn" HeaderText="Document number"  MappingName="ReceiptNote"  />
                    <syncfusion:GridTextColumn x:Name="Employee_DataGridColumn" HeaderText="Volunteer"  MappingName="Employee_Name"  />

                    <syncfusion:GridNumericColumn x:Name="Rate_DataGridColumn" HeaderText="Rate" MappingName="Rate"
                                                  NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn x:Name="Exchanged_DataGridColumn" HeaderText="Exchanged" MappingName="Exchanged"     
                                                  NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>

                    <syncfusion:GridTextColumn x:Name="Note_DataGridColumn" HeaderText="Description (Ar)"  MappingName="Note"  />
                    <syncfusion:GridTextColumn x:Name="E_Note_DataGridColumn" HeaderText="Description (Eng)"  MappingName="E_Note"  />
                    <syncfusion:GridTextColumn x:Name="AvgRateName_DataGridColumn" HeaderText="Original Avg Rate group"  MappingName="AvgRateName"  />
                    <syncfusion:GridNumericColumn x:Name="AvgRate_DataGridColumn" HeaderText="Original Avg Rate amount" MappingName="AvgRateValue"
                                                  NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn x:Name="USD_Value_DataGridColumn" HeaderText="Value" MappingName="USD_Value" 
                                                     NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                    <syncfusion:GridTextColumn x:Name="CashAccount_DataGridColumn" HeaderText="Cash till"  MappingName="CashAccount" />
                    <syncfusion:GridTextColumn x:Name="Rate_ID_DataGridColumn" HeaderText="Rate_ID" MappingName="Rate_ID" 
                                               IsHidden="True" />
                    <syncfusion:GridTextColumn x:Name="Till_ID_DataGridColumn" HeaderText="Till_ID" MappingName="Till_ID" 
                                               IsHidden="True" />
                    <syncfusion:GridTextColumn x:Name="ObserveTill_ID_DataGridColumn" HeaderText="ObserveTill_ID" MappingName="ObserveTill_ID" 
                                               IsHidden="True" />
                    <syncfusion:GridTextColumn x:Name="ObserveAccount_DataGridColumn" HeaderText="Corresponding account" MappingName="ObserveAccount"/>
                    <syncfusion:GridTextColumn x:Name="ObserveTill_DataGridColumn" HeaderText="Corresponding till" MappingName="ObserveTill" />
                    <syncfusion:GridTextColumn x:Name="ObserveAcctionID_DataGridColumn" HeaderText="Corresponding Operation ID" MappingName="ObserveAcion_ID" />

                    <syncfusion:GridTextColumn x:Name="ObserveCashAccount_DataGridColumn" HeaderText="Corresponding cash till"  MappingName="ObserveCashAccount" />
                    <syncfusion:GridTextColumn x:Name="ExAccount_DataGridColumn" HeaderText="Exchange account" MappingName="ExchangeAcc_Name"/>
                    <syncfusion:GridTextColumn x:Name="ExCashAccount_DataGridColumn" HeaderText="Exchange cash till" MappingName="Exchange_Cash_Name"/>

                    <syncfusion:GridTextColumn x:Name="Created_by_DataGridColumn" MappingName="created_by" HeaderText="Created By"/>
                    <syncfusion:GridDateTimeColumn x:Name="created_at_DataGridColumn" HeaderText="Date Created" MappingName="created_at" 
                                                   CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"  />
                    <syncfusion:GridTextColumn x:Name="Edited_by_DataGridColumn" MappingName="edited_by" HeaderText="Edited By"/>

                    <syncfusion:GridDateTimeColumn x:Name="updated_at_DataGridColumn" HeaderText="Modification Date" MappingName="updated_at"
                                                   CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                    <syncfusion:GridTextColumn x:Name="Approved_by_DataGridColumn" MappingName="approved_by" HeaderText="Confirmed by"/>

                    <syncfusion:GridDateTimeColumn x:Name="Approved_at_DataGridColumn" HeaderText="Confirmation date" MappingName="Approved_at"
                                                   CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />

                    <syncfusion:GridTextColumn x:Name="Attachments_Count_DataGridColumn" MappingName="Attachments_count" HeaderText="Attachments Count"/>

                    <syncfusion:GridTemplateColumn HeaderText="Attachment" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Attachment_Style}" Click="Attachment_Button_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>


                    <syncfusion:GridTemplateColumn HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridCheckBoxColumn x:Name="Selected_DataGridColumn" HeaderText="Select" MappingName="IsSelected" AllowEditing="True" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridCheckBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chkHeader" Loaded="chkHeader_Loaded" Click="chkHeader_Click"/>
                            </DataTemplate>
                        </syncfusion:GridCheckBoxColumn.HeaderTemplate>
                        <syncfusion:GridCheckBoxColumn.CellStyle>
                            <Style>
                                <Style.Resources>
                                    <Style TargetType="CheckBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="1">
                                                <Setter Property="Background" Value="Green" />
                                                <Setter Property="FlowDirection" Value="LeftToRight" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsSelected}" Value="0">
                                                <Setter Property="Background" Value="Transparent" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </syncfusion:GridCheckBoxColumn.CellStyle>
                    </syncfusion:GridCheckBoxColumn>

                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <Expander x:Name="myExpander" Grid.Column="0" IsExpanded="True"
            ExpandDirection="Left" 
            Expanded="myExpander_Expanded" Collapsed="myExpander_Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="#FF30323E" Margin="0,1,0,0" Grid.RowSpan="4" Background="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="2"/>
                        <RowDefinition/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <syncfusion:SfDataGrid x:Name="Cash_DataGrid"
                Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" 
                TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"
                AutoGenerateColumns="True"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"     
                Margin="1,1,0,10" Grid.Row="2" AutoGeneratingColumn="Cash_DataGrid_AutoGeneratingColumn" Loaded="Cash_DataGrid_Loaded">
                        <syncfusion:SfDataGrid.TableSummaryRows>
                            <syncfusion:GridTableSummaryRow ShowSummaryInRow="False" TitleColumnCount="1" Position="Bottom"
                                       Title="Total:">
                                <syncfusion:GridSummaryRow.SummaryColumns>
                                    <syncfusion:GridSummaryColumn Name="Total_I"                                                      
                                                Format="'{Sum:N2}'"
                                                MappingName="Income"
                                                SummaryType="DoubleAggregate" />
                                    <syncfusion:GridSummaryColumn Name="Total_E"                                                      
                                                Format="'{Sum:N2}'"
                                                MappingName="Expenses"
                                                SummaryType="DoubleAggregate" />
                                    <syncfusion:GridSummaryColumn Name="Total_Dif"                                                      
                                                Format="'{Sum:N2}'"
                                                MappingName="Deference"
                                                SummaryType="DoubleAggregate" />
                                </syncfusion:GridSummaryRow.SummaryColumns>
                            </syncfusion:GridTableSummaryRow>
                        </syncfusion:SfDataGrid.TableSummaryRows>
                    </syncfusion:SfDataGrid>
                    <Button
                    TabIndex="5" Style="{DynamicResource Export_Style}" x:Name="Cash_Export_btn" Margin="2,1,0,-4" Command="local:Commands.ExportToExcel" VerticalAlignment="Stretch" HorizontalAlignment="Left" RenderTransformOrigin="0.536,0.355" Width="28" Grid.Row="3"/>
                    <Label Style="{DynamicResource lableStyle}" 
                        Content="Balances" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,-1,0"  />
                </Grid>

            </Expander>
            <Grid Grid.Column="1" Margin="2,1,2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto" MinWidth="90" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="107"/>
                    <ColumnDefinition Width="86*" />
                    <ColumnDefinition Width="55*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="4" Content="Search:" Style="{DynamicResource lableStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="1,4,1,6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                <Border Grid.Column="3" BorderThickness="1" CornerRadius="10" Padding="0" Width="auto" Margin="4,4,4,4" >
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                    </Border.Background>
                    <TextBox x:Name="Search_txtBox" TabIndex="10" 
                        Style="{DynamicResource textBoxStyle}"
                        Width="auto" TextAlignment="Center" BorderThickness="0"
                        TextChanged="Search_txtBox_TextChanged" >
                        <TextBox.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                        </TextBox.BorderBrush>
                    </TextBox>
                </Border>
                <CheckBox Unchecked="ExactSearch_checkBox_Unchecked" Style="{DynamicResource checkBoxStyle}" x:Name="ExactSearch_checkBox" Margin="1,4,1,4" HorizontalAlignment="Stretch" Content="Full match" Grid.Column="2" Checked="ExactSearch_checkBox_Checked" VerticalAlignment="Stretch"/>
                <Menu
        x:Name="ShowHideMenu" Margin="10,1,12,2">
                    <Menu.Background
        >
                        <ImageBrush
                />
                    </Menu.Background>
                    <MenuItem
        Width="28" StaysOpenOnClick="True" Header="" Height="40">
                        <MenuItem.Background
        >
                            <ImageBrush
        ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"
                />
                        </MenuItem.Background>
                        <MenuItem
        StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="White"
                />
                        <MenuItem
        StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="White"
                />
                        <Separator
        Background="Black"
                />
                        <MenuItem
        Background="White" Click="ShowAll_MenuItem_Click" Header="ShowAll"
                />
                    </MenuItem>
                </Menu>
                <Button
        TabIndex="5" Style="{DynamicResource Export_Style}" x:Name="Export_btn" Margin="12,8,12,10" Grid.Column="1" Command="local:Commands.ExportToExcel" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RenderTransformOrigin="0.536,0.355"
                />
                <StackPanel x:Name="AddMultiAction_StackPanel" Grid.Column="7" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="3,1,2,1">
                    <Button Style="{DynamicResource Add_Style}" 
                        x:Name="AddMultiAction_btn" TabIndex="15" Click="AddMultiAction_btn_Click" Height="25" Width="25"  />
                    <Label x:Name="AddMultiAction_Label" Style="{DynamicResource lableStyle}" 
                        Content="New entry from excel"  />
                </StackPanel>
                <StackPanel x:Name="AddNewAction_StackPanel" Grid.Column="8" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="1,0,3,2">
                    <Button Style="{DynamicResource Add_Style}" 
              x:Name="AddNewAction_btn" TabIndex="15" Click="AddNewAction_btn_Click"  />
                    <Label x:Name="AddNewAction_Label" Style="{DynamicResource lableStyle}" 
                   Content="New entry"  />
                </StackPanel>
                <RadioButton x:Name="NotApproved_RadioButton" Content="Show Not Approved" IsChecked="False" Style="{DynamicResource RadioButtonStyle}" Grid.ColumnSpan="2" Margin="4,6,2,5" Grid.Column="5" Click="NotApproved_RadioButton_Click" Tag="False"/>
            </Grid>
            <TextBlock x:Name="Delete_Selected" Grid.Column="1" Margin="2,3,782,3" Grid.Row="3" TextWrapping="Wrap">      
                    <Hyperlink x:Name="Delete_Selected_TextBlock" Click="Delete_Selected_TextBlock_Click">Delete Selected</Hyperlink>
            </TextBlock>
            <Grid Margin="2,0,2,5" Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto" MinWidth="90" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="107"/>
                    <ColumnDefinition Width="86*" />
                    <ColumnDefinition Width="55*"/>
                </Grid.ColumnDefinitions>
                <Menu
                    x:Name="ShowHideMenu1" Margin="10,1,12,2">
                    <Menu.Background
        >
                        <ImageBrush
                />
                    </Menu.Background>
                </Menu>
                <StackPanel x:Name="AddMultiAttachments_StackPanel" Grid.Column="7" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="1,2,1,0" Grid.ColumnSpan="2">
                    <Button Style="{DynamicResource Add_Style}" 
                        x:Name="AddMultiAttachments_btn" TabIndex="15" Height="25" Width="25" Click="AddMultiAttachments_btn_Click"  />
                    <Label x:Name="AddMultiAttachments_Label" Style="{DynamicResource lableStyle}" 
                        Content="New Attachments from excel" Width="248"  />
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>

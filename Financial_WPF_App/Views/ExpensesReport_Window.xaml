<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        xmlns:Controls="clr-namespace:Financial_WPF_App.Controls" 
        x:Class="Financial_WPF_App.Views.ExpensesReport_Window"
        mc:Ignorable="d"
        Title="ExpensesReport_Window" Width="1280" Height="720" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Helper:CellStyleSelector x:Key="cellStyleSelector" />
    </Window.Resources>

    <Grid>
        <Grid >
            <Grid.ContextMenu>
                <ContextMenu x:Name="cm">
                    <MenuItem Header="Refresh Expenses Report" Click = "Refresh_Click" >
                        <MenuItem.Icon>
                            <Image Source="/Images/refresh32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0" Padding="0,5,50,5">
                <WrapPanel  Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                        <Border Style="{StaticResource BorderStackPanelStyle}">
                            <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"  />
                        </Border>
                    </StackPanel>
                </WrapPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource MainBorderWrapPanelStyle}">
                <WrapPanel  Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                        <Border Style="{StaticResource BorderStackPanelStyle}">
                            <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"  />
                        </Border>
                    </StackPanel>
                </WrapPanel >
            </Border>
            <Grid Grid.Row="3" Margin="2,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="64*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="Grid_col" Width="70*" ></ColumnDefinition>
                    <ColumnDefinition Name="Expander_col" Width="30*" ></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <syncfusion:SfDataGrid  x:Name="Expenses_DataGridView"
                        Style="{DynamicResource SfDataGrid_body}"
                               HeaderStyle="{DynamicResource SfDataGrid_header}"
                               RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                               AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" 
                               TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"   
                               CellStyleSelector="{StaticResource cellStyleSelector}"
                               GroupSummaryRowStyle="{DynamicResource GroupSummaryRowStyle}"
                               AutoGenerateColumns="True" SelectionChanged="Expenses_DataGridView_SelectionChanged"
                               AutoGeneratingColumn="DataGrid_AutoGeneratingColumn" 
                               Loaded="DataGridView_Loaded"                              
                               Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ItemsSourceChanged="Expenses_DataGridView_ItemsSourceChanged" GroupExpanded="Expenses_DataGridView_GroupExpanded"/>
                <Grid Grid.Column="0" Grid.ColumnSpan="2" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True" Background="{StaticResource LightGray1}" Height="41">
                        <WrapPanel Orientation="Horizontal" Width="647">
                            <Menu x:Name="ShowHideMenu" Margin="5,2,5,2">
                                <Menu.Resources>
                                    <!-- Custom Menu Style -->
                                    <Style TargetType="Menu">
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Menu">
                                                    <Border Background="{TemplateBinding Background}" Padding="0">
                                                        <ItemsPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <!-- Custom MenuItem Style -->
                                    <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
                                        <Setter Property="FontFamily" Value="Rubik"/>
                                        <Setter Property="FontSize" Value="13.5"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DarkGray}"/>
                                        <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Grid>
                                                        <!-- Main Item -->
                                                        <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="10,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <!-- Arrow Column -->
                                                                </Grid.ColumnDefinitions>

                                                                <ContentPresenter Grid.Column="0" 
                                                           HorizontalAlignment="Left" 
                                                           VerticalAlignment="Center" 
                                                           ContentSource="Header"/>

                                                                <!-- Submenu Arrow -->
                                                                <Path x:Name="Arrow"
                                                          Grid.Column="1"
                                                          Data="M 0 0 L 6 4 L 0 8 Z" 
                                                          Fill="{DynamicResource DarkGray}"
                                                          VerticalAlignment="Center"
                                                          Margin="5,0,0,0"
                                                          Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Submenu Popup -->
                                                        <Popup x:Name="Popup"
                                                   Placement="Bottom"
                                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                                   AllowsTransparency="True"
                                                   Focusable="False"
                                                   PopupAnimation="Fade">
                                                            <Border Background="White" CornerRadius="5" BorderBrush="{StaticResource LightGray1}" BorderThickness="1">
                                                                <StackPanel>
                                                                    <ItemsPresenter />
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>

                                                    <!-- Triggers -->
                                                    <ControlTemplate.Triggers>
                                                        <!-- Show Arrow Only if the MenuItem has sub-items (is a submenu) -->
                                                        <Trigger Property="HasItems" Value="True">
                                                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                                        </Trigger>

                                                        <!-- Submenu Hover Effect -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <!--<Setter TargetName="Border" Property="Background" Value="transparent"/>-->
                                                            <!--<Setter Property="Foreground" Value="{DynamicResource LightGray1}"/>-->
                                                        </Trigger>

                                                        <!-- Submenu Open Effect -->
                                                        <Trigger Property="IsSubmenuOpen" Value="True">
                                                            <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
                                                        </Trigger>

                                                        <!-- Disabled Effect -->
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MidGray}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                </Menu.Resources>
                                <!-- MenuItems with Custom Style -->
                                <MenuItem Width="20" Height="20" StaysOpenOnClick="True" Header=""  Style="{StaticResource CustomMenuItemStyle}" Margin="6,8,0,0" ToolTip="Show/Hide Columns" ToolTipService.InitialShowDelay="100">
                                    <MenuItem.Background>
                                        <ImageBrush ImageSource="/Images/Buttons/showHide.png" Stretch="Uniform"/>
                                    </MenuItem.Background>
                                    <!-- Submenu Items (Will Keep Hover Effect) -->
                                    <MenuItem StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                                    <MenuItem StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                                    <MenuItem Background="{StaticResource LightGray1}" Click="ShowAll_MenuItem_Click" Header="ShowAll" Style="{StaticResource CustomMenuItemStyle}"/>
                                </MenuItem>
                            </Menu>
                            <StackPanel x:Name="ExportToExcel_StackPanel" RenderTransformOrigin="0.5,0.5" Width="31">
                                <StackPanel.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="-1"/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </StackPanel.RenderTransform>
                                <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" Command="local:Commands.ExportToExcel"  Width="30" Height="25" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,8,1,1">
                                    <Button.Background>
                                        <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png" Stretch="Uniform"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                            <StackPanel  x:Name="Budget_panel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,-6">
                                <Label Grid.Column="7"  Style="{DynamicResource statistic_lableStyle}" Content="Budget:" Margin="1,3,1,3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                                <ComboBox Style="{DynamicResource ActionComboboxStyle}" x:Name="Budgets_comboBox" DisplayMemberPath="budget_Name" SelectedValuePath="budget_ID" SelectionChanged="Budgets_comboBox_SelectionChanged"/>
                                <Button x:Name="Budget_help" ToolTip="The budget only appears if Lines have been added to it." ToolTipService.InitialShowDelay="100" Width="20" Height="20" BorderBrush="{x:Null}" Margin="4,0,0,0">
                                    <Button.Background>
                                        <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="13,0,0,-6">
                                <Label Grid.Column="7"  Style="{DynamicResource statistic_lableStyle}" Content="View:" Margin="1,3,1,3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                                <ComboBox Style="{DynamicResource ActionComboboxStyle}" x:Name="View_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" SelectionChanged="View_comboBox_SelectionChanged">
                                    <ComboBoxItem x:Name="View_ComboBox_Lines_Item" Content="Lines" />
                                    <ComboBoxItem x:Name="View_ComboBox_LineTypes_Item" Content="Line Types" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,40,0" VerticalAlignment="Center">
                            <StackPanel  x:Name="Panel1" Orientation="Horizontal" >
                                <RadioButton x:Name="Total_RadioButton" Content="Show total" IsChecked="True" Style="{DynamicResource RadioButtonStyle}" Height="25" Width="126" HorizontalAlignment="Right" Checked="Total_RadioButton_Checked"/>
                                <RadioButton x:Name="PerDonor_RadioButton" Content="Show per donor" Height="25" Width="150" Style="{DynamicResource RadioButtonStyle}" HorizontalAlignment="Right" Checked="PerDonor_RadioButton_Checked" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox Style="{DynamicResource TextBoxActionStyle}" TextChanged="Search_txtBox_TextChanged" x:Name="Search_txtBox" TabIndex="10"/>
                        </StackPanel>

                    </DockPanel>
                </Grid>
                <Expander Grid.RowSpan="2" Background="{x:Null}" Grid.Column="1" Grid.Row="1"  x:Name="myExpander" 
        ExpandDirection="Left" IsExpanded="True" 
        Expanded="myExpander_Expanded" Collapsed="myExpander_Collapsed" 
        VerticalContentAlignment="Stretch" 
        FontFamily="Myriad Arabic" FontSize="20"
        FlowDirection="RightToLeft">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*" />
                            <ColumnDefinition Width="64*" />
                            <ColumnDefinition Width="207*" />
                            <ColumnDefinition Width="35*" />
                            <ColumnDefinition Width="15*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45*"/>
                            <RowDefinition Height="45*"/>
                            <RowDefinition Height="10*"/>
                            <RowDefinition Height="45*"/>
                            <RowDefinition Height="10*"/>
                            <RowDefinition Height="45*"/>
                            <RowDefinition Height="445*"/>
                            <RowDefinition Height="22*"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="1" Style="{DynamicResource lableStyle}" 
                Content="AvgRate:" HorizontalContentAlignment="Right" Width="68" Height="33" Grid.Column="1" HorizontalAlignment="Center" />
                        <Button Grid.Column="2"  Style="{DynamicResource SaveButton_Style}"
                x:Name="Save_btn" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" Height="32" Width="86" Grid.Row="3" Margin="37,0,0,0" />
                        <DataGrid Grid.ColumnSpan="4"
                x:Name="Budget_AvgRate_Datagridview"  
                ColumnHeaderStyle="{DynamicResource DataGrid_header}" 
                Style="{DynamicResource DataGrid_body}"
                AlternatingRowBackground="{DynamicResource HopeBlue1}"  
                
                RowBackground="{DynamicResource HopeGrey}" AlternationCount="2" Margin="10,10,10,10" Grid.Row="4" IsReadOnly="True" CanUserAddRows="False" Grid.RowSpan="3">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="budg_avgetrate_id"  Binding="{Binding budget_avgrate_id}" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Budge_ID"  Binding="{Binding Budget_ID}" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="AvgRate"  Binding="{Binding AvgRate}"/>
                                <DataGridTextColumn Header="AvgRate_ID"  Binding="{Binding AvgRate_ID}" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Value"  Binding="{Binding Value, StringFormat=\{0:N2\}}"/>

                                <DataGridTemplateColumn Header="Delete" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{DynamicResource Delete_Style}" Click="DeleteButton_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="2" x:Name="AvgRate_panel" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="7,2,10,3" Grid.Row="1" >
                            <ComboBox x:Name="AvgRate_comboBox" DisplayMemberPath="Rate group name" SelectedValuePath="ID"
                FlowDirection="RightToLeft" Height="29" TabIndex="1" FontSize="14" Width="158" />
                            <Button x:Name="AvgRate_help" Width="30" Height="28" BorderBrush="{x:Null}" ToolTipService.InitialShowDelay="100">

                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/qm1.png" Stretch="Uniform"/>
                                </Button.Background>
                                <Button.ToolTip>
                                    <ToolTip Content="Only AvgRates which contains exchange operation to the budget currency appears."/>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>

                        <!--<ListBox  Grid.Column="1" Grid.Row="4" Grid.RowSpan="2"
            ItemsSource="{Binding Columns, ElementName=myDataGrid}">
            <ListBox.Background>
                <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
            </ListBox.Background>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Header}" 
                              IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>-->

                    </Grid>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</Window>

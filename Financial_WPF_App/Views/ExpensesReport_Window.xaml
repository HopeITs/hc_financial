<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:Controls="clr-namespace:Financial_WPF_App.Controls" 
        xmlns:fluent="urn:fluent-ribbon" 
        x:Class="Financial_WPF_App.Views.ExpensesReport_Window"
        mc:Ignorable="d"
        Title="ExpensesReport_Window" Width="1280" Height="720" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Helper:CellStyleSelector x:Key="cellStyleSelector" />
    </Window.Resources>
    
    <Grid>

        <Grid >
            <Grid.ContextMenu>
                <ContextMenu x:Name="cm">
                    <MenuItem Header="Refresh Expenses Report" Click = "Refresh_Click" >
                        <MenuItem.Icon>
                            <Image Source="/Images/refresh32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="85*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Expander_col" Width="30*"/>
                <ColumnDefinition x:Name="Grid_col" Width="70*" />
            </Grid.ColumnDefinitions>

            <Grid  Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*"/>

                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10" >
                    <Grid.ContextMenu>
                        <ContextMenu x:Name="cm1">
                            <MenuItem Header="Refresh Expenses Report" Click = "Refresh_Click" >
                                <MenuItem.Icon>
                                    <Image Source="/Images/refresh32.png" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="33*"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="107*"/>
                        <ColumnDefinition Width="189*"/>
                        <ColumnDefinition Width="107*"/>
                        <ColumnDefinition Width="189*"/>
                        <ColumnDefinition Width="107*"/>
                        <ColumnDefinition Width="27*"/>

                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>


                        <RowDefinition Height="35" />
                        <RowDefinition/>
                        <RowDefinition Height="1" />

                    </Grid.RowDefinitions>

                    <Label Grid.Column="7"  Style="{DynamicResource lableStyle}" Content="Budget:" Margin="2,1,1,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                    <Label Grid.Column="5"  Style="{DynamicResource lableStyle}" Content="View:" Margin="1,1,1,1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                    <ComboBox x:Name="View_comboBox" TabIndex="3" 
                        FlowDirection="RightToLeft" Height="30" Width="auto" MinWidth="130" FontSize="16"
                        VerticalContentAlignment="Center" Margin="4,0,10,0" Grid.Column="4" SelectionChanged="View_comboBox_SelectionChanged">
                        <ComboBoxItem x:Name="View_ComboBox_Lines_Item" Content="Lines" />
                        <ComboBoxItem x:Name="View_ComboBox_LineTypes_Item" Content="Line Types" />
                    </ComboBox>
                    <syncfusion:SfDataGrid  x:Name="Expenses_DataGridView"
                        Style="{DynamicResource SfDataGrid_body}"
                               HeaderStyle="{DynamicResource SfDataGrid_header}"
                               RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                               AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" 
                               TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"   
                               CellStyleSelector="{StaticResource cellStyleSelector}"
                               GroupSummaryRowStyle="{DynamicResource GroupSummaryRowStyle}"
                               AutoGenerateColumns="True"
                               AutoGeneratingColumn="DataGrid_AutoGeneratingColumn" 
                               Loaded="DataGridView_Loaded"                              
                               Grid.ColumnSpan="9" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="NaN" Margin="2,10,2,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ItemsSourceChanged="Expenses_DataGridView_ItemsSourceChanged" GroupExpanded="Expenses_DataGridView_GroupExpanded"/>

                    <StackPanel x:Name="Budget_panel" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="1,3,2,3" Grid.Column="6" >
                        <ComboBox x:Name="Budgets_comboBox" TabIndex="3" 
                        DisplayMemberPath="budget_Name" SelectedValuePath="budget_ID" 
                        FlowDirection="RightToLeft" Height="30" Width="165" MinWidth="130" FontSize="16"
                        VerticalContentAlignment="Center" SelectionChanged="Budgets_comboBox_SelectionChanged"/>
                        <Button x:Name="Budget_help" Width="30" Height="28" BorderBrush="{x:Null}" ToolTipService.InitialShowDelay="100">

                            <Button.Background>
                                <ImageBrush ImageSource="/Images/qm1.png" Stretch="Uniform"/>
                            </Button.Background>
                            <Button.ToolTip>
                                <ToolTip Content="The budget only appears if Lines have been added to it."/>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                        TabIndex="5"
                        Command="Helper:Commands.ExportToExcel" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                    <StackPanel x:Name="Panel1" Orientation="Horizontal" FlowDirection="RightToLeft" Grid.ColumnSpan="9" Grid.Row="1" Margin="1,0,24,0" >
                        <RadioButton x:Name="Total_RadioButton" Content="Show total" IsChecked="True" Style="{DynamicResource RadioButtonStyle}" Height="34" Width="126" HorizontalAlignment="Right" Checked="Total_RadioButton_Checked"/>
                        <RadioButton x:Name="PerDonor_RadioButton" Content="Show per donor" Height="34" Width="150" Style="{DynamicResource RadioButtonStyle}" HorizontalAlignment="Right" Checked="PerDonor_RadioButton_Checked"/>
                    </StackPanel>
                    <Menu x:Name="ShowHideMenu" Margin="2,0,0,0" Grid.Column="2" HorizontalAlignment="Left" Width="29" >
                        <Menu.Background>
                            <ImageBrush/>
                        </Menu.Background>
                        <MenuItem Header="" StaysOpenOnClick="True" Grid.Column="1" Width="29" Height="45" >
                            <MenuItem.Background>
                                <ImageBrush ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                            </MenuItem.Background>
                            <MenuItem x:Name="ShowMenu" Header="Show" StaysOpenOnClick="True" Background="White" />
                            <MenuItem x:Name="HideMenu" Header="Hide" StaysOpenOnClick="True" Background="White"/>
                            <Separator Background="Black"/>
                            <MenuItem Header="ShowAll" Click="ShowAll_MenuItem_Click" Background="White"/>
                        </MenuItem>
                    </Menu>
                </Grid>


            </Grid>

            <Expander Grid.Column="0" Grid.Row="1"  x:Name="myExpander" 
                ExpandDirection="Right" IsExpanded="True" 
                Expanded="myExpander_Expanded" Collapsed="myExpander_Collapsed" 
                VerticalContentAlignment="Stretch" 
                Grid.RowSpan="2" FontFamily="Myriad Arabic" FontSize="20"
                FlowDirection="RightToLeft">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="15*" />
                        <ColumnDefinition Width="64*" />
                        <ColumnDefinition Width="207*" />
                        <ColumnDefinition Width="35*" />
                        <ColumnDefinition Width="15*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45*"/>
                        <RowDefinition Height="45*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="45*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="45*"/>
                        <RowDefinition Height="445*"/>
                        <RowDefinition Height="22*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="1" Style="{DynamicResource lableStyle}" 
                        Content="AvgRate:" HorizontalContentAlignment="Right" Width="68" Height="33" Grid.Column="1" HorizontalAlignment="Center" />
                    <Button Grid.Column="2"  Style="{DynamicResource SaveButton_Style}"
                        x:Name="Save_btn" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" Height="32" Width="86" Grid.Row="3" Margin="37,0,0,0" />
                    <DataGrid Grid.ColumnSpan="4"
                        x:Name="Budget_AvgRate_Datagridview"  
                        ColumnHeaderStyle="{DynamicResource DataGrid_header}" 
                        Style="{DynamicResource DataGrid_body}"
                        AlternatingRowBackground="{DynamicResource HopeBlue1}"  
                        
                        RowBackground="{DynamicResource HopeGrey}" AlternationCount="2" Margin="10,10,10,10" Grid.Row="4" IsReadOnly="True" CanUserAddRows="False" Grid.RowSpan="3">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="budg_avgetrate_id"  Binding="{Binding budget_avgrate_id}" Visibility="Collapsed"/>
                            <DataGridTextColumn Header="Budge_ID"  Binding="{Binding Budget_ID}" Visibility="Collapsed"/>
                            <DataGridTextColumn Header="AvgRate"  Binding="{Binding AvgRate}"/>
                            <DataGridTextColumn Header="AvgRate_ID"  Binding="{Binding AvgRate_ID}" Visibility="Collapsed"/>
                            <DataGridTextColumn Header="Value"  Binding="{Binding Value, StringFormat=\{0:N2\}}"/>

                            <DataGridTemplateColumn Header="Delete" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource Delete_Style}" Click="DeleteButton_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="2" x:Name="AvgRate_panel" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="7,2,10,3" Grid.Row="1" >
                        <ComboBox x:Name="AvgRate_comboBox" DisplayMemberPath="Rate group name" SelectedValuePath="ID"
                        FlowDirection="RightToLeft" Height="29" TabIndex="1" FontSize="14" Width="158" />
                        <Button x:Name="AvgRate_help" Width="30" Height="28" BorderBrush="{x:Null}" ToolTipService.InitialShowDelay="100">

                            <Button.Background>
                                <ImageBrush ImageSource="/Images/qm1.png" Stretch="Uniform"/>
                            </Button.Background>
                            <Button.ToolTip>
                                <ToolTip Content="Only AvgRates which contains exchange operation to the budget currency appears."/>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>

                    <!--<ListBox  Grid.Column="1" Grid.Row="4" Grid.RowSpan="2"
                    ItemsSource="{Binding Columns, ElementName=myDataGrid}">
                    <ListBox.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                    </ListBox.Background>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Header}" 
                                      IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>-->

                </Grid>
            </Expander>
        </Grid>

    </Grid>
</Window>

        private void AllCheckbocx_CheckedAndUnchecked(object sender, RoutedEventArgs e)
        {
            try
            {
                donor_filter = "";
                foreach (var donor in objDonorList)
                {
                    if (donor.Check_Status == true)
                    {
                        donor_filter += donor.Donor_ID + ",";
                    }
                }
                Search_DataGrid();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

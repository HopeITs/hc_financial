        private void Fill_Beneficiaries()
        {
            try
            {
                if (Login.BuildConnection())
                {
                    b_dt = b.Select("", "", SubProject_ID.ToString());
                    List<string> TestItems = new List<string>();
                    if (b_dt.Rows.Count > 0)
                    {
                        for (int i = 0; i < b_dt.Rows.Count; i++)
                        {
                            TestItems.Add(b_dt.Rows[i].Field<Int32>("MicroProject_ID").ToString());
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }
        private void Fill_Payments()
        {
            try
            {
                if (Login.BuildConnection())
                {
                    p_dt = p.Select(Beneficiary_ID.ToString());
                    if (p_dt.Rows.Count > 0)
                    {
                        payDataGrid.ItemsSource = p_dt.DefaultView;
                    }
                    else payDataGrid.ItemsSource = null;
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void Amount_txtBox_TextChanged(object sender, TextChangedEventArgs e)
        {
            try
            {
                if (Amount_txtBox.Text != "")
                {
                    //Amount_txtBox.Text = Regex.Replace(string.Format("{0:n" + 4 + "}", Convert.ToDecimal(Amount_txtBox.Text)),
                    //        @"[" + NumberFormatInfo.CurrentInfo.NumberDecimalSeparator + "]?0+$", "");
                    //Amount_txtBox.SelectionStart = Amount_txtBox.Text.Length;
                    string x = string.Format("{0:n}", Convert.ToDouble(Amount_txtBox.Text));
                    Amount_txtBox.Text = x;
                    Amount_txtBox.SelectionStart = Amount_txtBox.Text.Length - 3;
                    Amount_txtBox.SelectionLength = 0;
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        int[] IDs_array;

        private void myDataGrid_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                int count = myDataGrid.SelectedItems.Count;
                Selected_textBlock.Text = count.ToString("N3");

                // Income_textBlock
                // Outcome_textBlock
                //IDs_array = new int[count];
                double selected_incomes = 0;
                double selected_outcomes = 0;
                for (var i = 0; i < count; i++)
                {
                    DataRowView SelectedDataRow = (DataRowView)myDataGrid.SelectedItems[i];
                    //IDs_array[i] = int.Parse(SelectedDataRow["ID"].ToString());
                    if (double.Parse(SelectedDataRow["Income"].ToString()) != 0)
                    {
                        selected_incomes += double.Parse(SelectedDataRow["Income"].ToString());
                    }
                    else if (double.Parse(SelectedDataRow["Outcome"].ToString()) != 0)
                    {
                        selected_outcomes += double.Parse(SelectedDataRow["Outcome"].ToString());
                    }
                }
                Income_textBlock.Text = selected_incomes.ToString("N3");
                Outcome_textBlock.Text = selected_outcomes.ToString("N3");

            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void Save2_btn_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                if (Amount_txtBox.Text == "")
                    throw new Exception("الرجاء التأكد من وجود قيمة صادرة أو واردة قبل عملية الحفظ");

                if (Beneficiary_ID <= 0)
                    throw new Exception("الرجاء تحديد المستفيد أولا");


                if (Login.BuildConnection())
                {
                    string amount_str, Date;
                    amount = 0;
                    string inserted_value = "";


                    amount_str = Amount_txtBox.Text.Replace(",", "");
                    Double.TryParse(amount_str, out amount);

                    if (Type_comboBox.SelectedItem.ToString().Contains("وارد"))
                    {
                        inserted_value = "Income";
                    }
                    else if (Type_comboBox.SelectedItem.ToString().Contains("صادر"))
                    {
                        inserted_value = "Outcome";
                    }

                    Date = Date_datepicker.DisplayDate.ToString("yyyy/MM/dd");

                    if (MircoProject_ID_txtBox.Text != "")
                        int.TryParse(MircoProject_ID_txtBox.Text, out MicroProject_ID);
                    else MicroProject_ID = -1;


                    if (Action_ID != -1)//Edit
                    {
                        a.Update(Action_ID, -1, -1, "", inserted_value.Substring(0, 1), amount, 0, 0
                            , Date, Notes_txtBox.Text, -1, ""
                            , -1, 0, MicroProject_ID, -1, -1, -1);

                        //                  l.Insert("Update", AccountType + " Payment Till:" + Till_ID, inserted_value + ":" + amount, ID.ToString()
                        //                       , Properties.Settings.Default.username, DateTime.Now);
                    }
                    else//Add new
                    {
                        a.Insert_Payment(inserted_value.Substring(0, 1), amount, Date, Notes_txtBox.Text, MicroProject_ID);

                        //                   l.Insert("Insert", AccountType + " Till:" + Till_ID, inserted_value + ":" + amount, a.Get_Last_ID().ToString()
                        //                       , Properties.Settings.Default.username, DateTime.Now);
                    }
                    Clear_Boxes();
                    LoadGrid();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void Clear_Boxes()
        {
            Amount_txtBox.Text = Notes_txtBox.Text = MircoProject_ID_txtBox.Text = BeneficiaryName_txtBox.Text = "";

            Action_ID = Beneficiary_ID = MicroProject_ID = -1;
        }


        private void EditButton_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                DataRowView dataRow = (DataRowView)myDataGrid.CurrentItem;
                Action_ID = Convert.ToInt32(dataRow["ID"]);

                if (dataRow["Income"] != DBNull.Value && dataRow["Income"] != null)
                    if (dataRow["Income"].ToString() != "0")
                    {
                        Type_comboBox.SelectedIndex = 0; //وارد
                        Amount_txtBox.Text = dataRow["Income"].ToString();
                    }

                if (dataRow["Outcome"] != DBNull.Value && dataRow["Outcome"] != null)
                    if (dataRow["Outcome"].ToString() != "0")
                    {
                        Type_comboBox.SelectedIndex = 1; //صادر
                        Amount_txtBox.Text = dataRow["Outcome"].ToString();
                    }

                if (dataRow["MicroProject_ID"] != DBNull.Value)
                    MircoProject_ID_txtBox.Text = dataRow["MicroProject_ID"].ToString();
                else MircoProject_ID_txtBox.Text = "";

                //fill beneficiary autoatically // = 6

                Date_datepicker.SelectedDate = Convert.ToDateTime(dataRow["Date"].ToString());
                Notes_txtBox.Text = dataRow["Note"].ToString();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void DeleteButton_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var dialogResult = MessageBox.Show("هل أنت متأكدأنك تريد حذف هذه البيانات؟", "Confirm before save", MessageBoxButton.YesNo);
                if (dialogResult == MessageBoxResult.Yes)
                {
                    string deleted_value = "";

                    DataRowView dataRow = (DataRowView)myDataGrid.CurrentItem;
                    Action_ID = Convert.ToInt32(dataRow[0].ToString());
                    if (dataRow[1] != DBNull.Value && dataRow[1].ToString() != "0")
                        deleted_value = "Income:" + dataRow[1].ToString();
                    else if (dataRow[2] != DBNull.Value && dataRow[2].ToString() != "0")
                        deleted_value = "Outcome:" + dataRow[2].ToString();

                    a.Delete(Action_ID);
                    //               l.Insert("Delete", AccountType + " Payments Till:" + Till_ID, deleted_value, ID.ToString()
                    //                        , Properties.Settings.Default.username, DateTime.Now);

                    Action_ID = -1;
                    LoadGrid();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void MircoProject_ID_txtBox_TextChanged(object sender, TextChangedEventArgs e)
        {
            try
            {
                if (MircoProject_ID_txtBox.Text == "")
                {
                    MircoProject_ID_txtBox.Text = BeneficiaryName_txtBox.Text = "";
                    myDataGrid.ItemsSource = dt.DefaultView;
                }
                else
                {
                    MicroProject_ID = Convert.ToInt32(MircoProject_ID_txtBox.Text);
                    DataRow[] rows = b_dt.Select("MicroProject_ID=" + MicroProject_ID);
                    if (rows.Length != 0)
                    {
                        BeneficiaryName_txtBox.Text = rows[0].Field<string>("Name");
                        Beneficiary_ID = rows[0].Field<int>("ID");

                        //Get Benefisiaries payments and fill them in the grid
                        Fill_Payments();
                    }
                    else
                    {
                        BeneficiaryName_txtBox.Text = "";
                        Beneficiary_ID = -1;
                    }

                    // view the rows of this project in the grid //
                    DataRow[] My_rows = dt.Select("MicroProject_ID=" + MicroProject_ID.ToString());
                    if (My_rows.Length != 0)
                    {
                        DataTable selected_rows_dt = new DataTable();

                        selected_rows_dt = dt.Copy();
                        selected_rows_dt.Rows.Clear();
                        foreach (DataRow row in My_rows)
                            selected_rows_dt.ImportRow(row);

                        myDataGrid.ItemsSource = selected_rows_dt.DefaultView;
                    }
                    else
                    {
                        myDataGrid.ItemsSource = null;
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void UpdateBeneficiary_btn_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                if (Beneficiary_ID > 0)
                {
                    Beneficiary_Window beneficiary_Window = new Beneficiary_Window(Beneficiary_ID, SubProject_ID);
                    bool? dialogResult = beneficiary_Window.ShowDialog();
                    if (dialogResult == true)
                    {
                        Fill_Payments();
                    }
                }
                else
                {
                    MessageBox.Show("الرجاء تحديد المستفيد أولاً", "Error");
                }

            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }
        private void CheckButton_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                try
                {
                    var dialogResult = MessageBox.Show("هل أنت متأكدأنك تريد حذف هذه البيانات؟", "Confirm before save", MessageBoxButton.YesNo);
                    if (dialogResult == MessageBoxResult.Yes)
                    {
                        string deleted_value = "";

                        DataRowView dataRow = (DataRowView)payDataGrid.CurrentItem;
                        int Pay_ID = Convert.ToInt32(dataRow[0].ToString());
                        string Amount = dataRow[1].ToString();
                        string date = dataRow[2].ToString();

                        p.Delete(Pay_ID);
                        l.Insert("Delete", "Payemnts" + "Payment of Beneficiary:" + Action_ID.ToString(), Amount + ":" + date, Pay_ID.ToString()
                                , Properties.Settings.Default.username, DateTime.Now);

                        Fill_Payments();
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show(ex.Message);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void myExpander_Expanded(object sender, RoutedEventArgs e)
        {
            Third_col.Width = new GridLength(25, GridUnitType.Star);
            Second_col.Width = new GridLength(50, GridUnitType.Star);
            First_col.Width = new GridLength(25, GridUnitType.Star);
        }

        private void myExpander_Collapsed(object sender, RoutedEventArgs e)
        {
            Third_col.Width = new GridLength(25, GridUnitType.Star);
            Second_col.Width = new GridLength(70, GridUnitType.Star);
            First_col.Width = new GridLength(5, GridUnitType.Star);
        }

        private void ScrollViewer_PreviewMouseWheel(object sender, MouseWheelEventArgs e)
        {
            ScrollViewer scrollViewer = (ScrollViewer)sender;
            if (Keyboard.IsKeyDown(System.Windows.Input.Key.LeftShift) || Keyboard.IsKeyDown(System.Windows.Input.Key.RightShift))
            {
                if (e.Delta < 0)
                {
                    scrollViewer.LineLeft();
                }
                else
                {
                    scrollViewer.LineRight();
                }
            }
            else
            {
                if (e.Delta < 0)
                {
                    scrollViewer.LineDown();
                }
                else
                {
                    scrollViewer.LineUp();
                }
            }
            e.Handled = true;
        }

        #region donor load select combobox checkbox
        private void LoadDonors(string SubProject_ID)
        {
            try
            {
                if (Login.BuildConnection())
                {
                    d_dt = sd.Select(SubProject_ID.ToString(), "");
                    if (d_dt.Rows.Count > 0)
                    {
                        AddElementsInList();
                        BindDonorDropDown();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        string donor_filter = "";
        DataTable d_dt;

        List<SubProject_Donor> objDonorList;
        private void AddElementsInList()
        {
            objDonorList = new List<SubProject_Donor>();
            for (int i = 0; i < d_dt.Rows.Count; i++)
            {
                SubProject_Donor obj = new SubProject_Donor();
                obj.Donor_ID = d_dt.Rows[i].Field<int>(0);
                obj.DonorName = d_dt.Rows[i].Field<string>(1);
                obj.SubProject_ID = d_dt.Rows[i].Field<int>(2);
                objDonorList.Add(obj);
            }
        }
        private void BindDonorDropDown()
        {
            Donor_comboBox.ItemsSource = objDonorList;
        }


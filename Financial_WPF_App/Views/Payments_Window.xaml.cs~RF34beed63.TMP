        private void LoadGrid()
        {
            try
            {
                if (Login.BuildConnection())
                {
                    dt = a.Select("", "", SubProject_ID.ToString(), "", "pay", "", true);
                    if (dt.Rows.Count > 0) myDataGrid.ItemsSource = dt.DefaultView;
                    else
                    {
                        myDataGrid.ItemsSource = null;
                        Income_textBlock.Text = Outcome_textBlock.Text = "00,00";
                        Till_IDs.Clear();
                        sum_dt = null;
                        return;
                    }

                    //if (SubProject_comboBox.SelectedIndex != -1)
                    //{

                    DataTable IDs = t.Get_PaymentTill_ID(SubProject_ID.ToString());
                    if (IDs.Rows.Count > 0)
                    {
                        for (int i = 0; i < IDs.Rows.Count; i++)
                        {
                            Till_IDs.Add(IDs.Rows[i].Field<int>("ID").ToString());
                        }
                    }

                    //Till_ID = 
                    sum_dt = a.Select_Sums(String.Join(", ", Till_IDs.ToArray()), "");
                    //}
                    //else
                    //{
                    //    sum_dt = a.Select_Sums("select ID from till pay where pay.Type like 'pay'","");
                    //}

                    if (sum_dt.Rows.Count > 0)
                    {
                        Income_textBlock.Text = sum_dt.Rows[0].Field<double>(0).ToString("N3");
                        Outcome_textBlock.Text = sum_dt.Rows[0].Field<double>(1).ToString("N3");

                        CashNet_textBlock.Text = sum_dt.Rows[0].Field<double>(4).ToString("N3");
                    }
                    else Income_textBlock.Text = Outcome_textBlock.Text = CashNet_textBlock.Text = "00,00";
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

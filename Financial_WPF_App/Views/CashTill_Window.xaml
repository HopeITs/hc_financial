<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.CashTill_Window"
        mc:Ignorable="d"
        Title="CashTill_Window" Width="1280" Height="620" FontFamily="Myriad Arabic" FontSize="18" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid>
            <Grid.ContextMenu>
                <ContextMenu x:Name="cm">
                    <MenuItem Header="Refresh Till" Click = "Refresh_Click" >
                        <MenuItem.Icon>
                            <Image Source="/Images/refresh32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="1"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
                <WrapPanel Orientation="Horizontal">
                    <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="63" />
                    <Border Style="{StaticResource BorderStackPanelStyle}" Margin="0,2,0,1.909" >
                        <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"  />
                    </Border>
                    <Label x:Name="Income_Label" Content="Income:" Style="{DynamicResource statistic_lableStyle}"/>
                    <Border Style="{StaticResource BorderStackPanelStyle}" Margin="0,2,0,1.909" >
                        <TextBlock x:Name="Income_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"  />
                    </Border>

                    <Label x:Name="Exchpand_Label" Content="Outcome:" Style="{DynamicResource statistic_lableStyle}" />
                    <Border x:Name="Exchpand_Border" Style="{StaticResource BorderStackPanelStyle}" >
                        <TextBlock x:Name="Exchpand_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" />
                    </Border>

                    <Label x:Name="Net_lable" Content="Cash Till Balance:" Style="{DynamicResource statistic_lableStyle}" />
                    <Border x:Name="Net_Border" Style="{StaticResource BorderStackPanelStyle}" >
                        <TextBlock x:Name="Net_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" />
                    </Border>

                    <Label x:Name="CashNet_label" Content="Net accounts:" Style="{DynamicResource statistic_lableStyle}" />
                    <Border Style="{StaticResource BorderStackPanelStyle}" >
                        <TextBlock x:Name="CashNet_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" />
                    </Border>
                    <Label x:Name="CashNet_label_Copy" Content="Difference:" Style="{DynamicResource statistic_lableStyle}" />
                    <Border Style="{StaticResource BorderStackPanelStyle}" Height="30" >
                        <TextBlock x:Name="Difference_textBlock" Text="0.00" Style="{DynamicResource statistic_textBlockStyle}" />
                    </Border>
                </WrapPanel>
            </Border>
            <Grid Grid.Row="3" Margin="2,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition/>
                    <RowDefinition Height="48.848"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="Grid_col" Width="100*" />
                </Grid.ColumnDefinitions>
                <syncfusion:SfDataGrid x:Name="myDataGrid"
                    Style="{DynamicResource SfDataGrid_body}"
                    HeaderStyle="{DynamicResource SfDataGrid_header}"
                    RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                    AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" 
                    TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"                  
                    FrozenColumnCount="1"
                    AutoGenerateColumns="True" 
                    MouseDoubleClick="myDataGrid_MouseDoubleClick" 
                    Loaded="myDataGrid_Loaded" 
                    AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    Margin="2,4,2,1" Grid.Row="1" FilterChanged="myDataGrid_FilterChanged" >

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTemplateColumn HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                        <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                        <syncfusion:GridCheckBoxColumn x:Name="Selected_DataGridColumn" HeaderText="Select" MappingName="IsSelected" AllowEditing="True" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridCheckBoxColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chkHeader" Loaded="chkHeader_Loaded" Click="chkHeader_Click"/>
                                </DataTemplate>
                            </syncfusion:GridCheckBoxColumn.HeaderTemplate>
                            <syncfusion:GridCheckBoxColumn.CellStyle>
                                <Style>
                                    <Style.Resources>
                                        <Style TargetType="CheckBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="1">
                                                    <Setter Property="Background" Value="Green" />
                                                    <Setter Property="FlowDirection" Value="LeftToRight" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsSelected}" Value="0">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Style.Resources>
                                </Style>
                            </syncfusion:GridCheckBoxColumn.CellStyle>
                        </syncfusion:GridCheckBoxColumn>

                    </syncfusion:SfDataGrid.Columns>


                </syncfusion:SfDataGrid>
                <Grid Margin="2,1,2,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="62.014" />
                        <ColumnDefinition Width="215.579" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="2,0,2,0">
                        <Button Style="{DynamicResource Add_Style}" 
                            x:Name="AddNewAction_btn" TabIndex="15" Click="AddNewAction_btn_Click" HorizontalAlignment="Right"  />
                        <Label x:Name="AddNewAction_Label" Style="{DynamicResource lableStyle}" 
                            Content="Add new operation" HorizontalAlignment="Right"  />
                    </StackPanel>
                    <Label Grid.Column="5" Content="Search:" Style="{DynamicResource lableStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="3,4,3,6" VerticalAlignment="Stretch" Height="33" Width="56" HorizontalAlignment="Stretch" />
                    <Border Grid.Column="4" BorderThickness="1" CornerRadius="10" Padding="0" Width="auto" Margin="3,4,5,4" Height="35" >
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                        </Border.BorderBrush>
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                        </Border.Background>
                        <TextBox x:Name="Search_txtBox" TabIndex="10" 
                            Style="{DynamicResource textBoxStyle}"
                            Width="auto" TextAlignment="Center" BorderThickness="0"
                            TextChanged="Search_txtBox_TextChanged" >
                            <TextBox.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                            </TextBox.BorderBrush>
                        </TextBox>
                    </Border>
                    <CheckBox Unchecked="ExactSearch_checkBox_Unchecked" Style="{DynamicResource checkBoxStyle}" x:Name="ExactSearch_checkBox" Margin="2,3,3,5" HorizontalAlignment="Stretch" Content="Full match" Grid.Column="3" Checked="ExactSearch_checkBox_Checked" VerticalAlignment="Stretch"/>
                    <Menu
                        x:Name="ShowHideMenu" Margin="10,1,12,2">
                        <Menu.Background
        >
                            <ImageBrush
                />
                        </Menu.Background>
                        <MenuItem
                            Width="28" StaysOpenOnClick="True" Header="" Height="40">
                            <MenuItem.Background
        >
                                <ImageBrush
                                    ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"
                />
                            </MenuItem.Background>
                            <MenuItem
                                StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="White"
                />
                            <MenuItem
                                StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="White"
                />
                            <Separator
                                Background="Black"
                />
                            <MenuItem
                                Background="White" Click="ShowAll_MenuItem_Click" Header="ShowAll"
                />
                        </MenuItem>
                    </Menu>
                    <Button
                        TabIndex="5" Style="{DynamicResource Export_Style}" x:Name="Export_btn" Margin="12,8,12,10" Grid.Column="1" Command="Helper:Commands.ExportToExcel" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RenderTransformOrigin="0.536,0.355"
                />
                </Grid>
                <TextBlock x:Name="Delete_Selected" Margin="2,13,1165,12" Grid.Row="2" TextWrapping="Wrap"><Hyperlink x:Name="Delete_Selected_TextBlock" Click="Delete_Selected_TextBlock_Click"><Run Text="Delete Selected"/></Hyperlink></TextBlock>
            </Grid>
        </Grid>

    </Grid>
</Window>

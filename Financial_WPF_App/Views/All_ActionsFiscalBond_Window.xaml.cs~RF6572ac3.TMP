        private void Load_Form()
        {
            try
            {
                u = new Users();
                a = new Models.Action();
                dt = sum_dt = new DataTable();
                b = new Beneficiary();
                t = new Till();
                r = new Rate();
                fb = new FiscalBond();

                // 1- check user permission (Admin or normal user)
                //   ADMIN:      show comboBox of available Tills (syr-usd-eur)
                //   NormalUser: select 'syr' till and hide comboBox of available Tills
                // 2- get subproject_id of current user (the working center)
                // 3- get the 'fiscal bonds' of 'accounts' of 'subproject_id'
                // 4- get the 'actions' of 'today' and fill them into the DataGrid

                LoadFiscalBondComboBox(false);
                Fill_Actions_of_Today();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        #region fiscal bond
        private void LoadFiscalBondComboBox(bool ShowClosed)
        {
            if (Login.BuildConnection())
            {
                fb_dt = fb.Select("", "", Properties.Settings.Default.User_ID.ToString(), ShowClosed);
                if (fb_dt.Rows.Count > 0)
                {
                    FiscalBond_comboBox.ItemsSource = fb_dt.DefaultView;
                }
            }
        }

        private void FiscalBond_comboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                if (FiscalBond_comboBox.SelectedValue != null)
                {
                    myDataGrid.ItemsSource = null;
                    int id = Convert.ToInt32(FiscalBond_comboBox.SelectedValue);

                    DataRow[] rows = dt.Select("FiscalBond_ID=" + id);
                    DataTable selected_dt = new DataTable();
                    if (rows.Length != 0)
                    {
                        selected_dt = rows.CopyToDataTable();
                        if (selected_dt.Rows.Count > 0)
                            myDataGrid.ItemsSource = selected_dt.DefaultView;
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void FiscalBond_comboBox_LostFocus(object sender, RoutedEventArgs e)
        {
            if (FiscalBond_comboBox.Text == "")
            {
                myDataGrid.ItemsSource = null;
                myDataGrid.ItemsSource = dt.DefaultView;
            }
        }
        #endregion

        public void Fill_Actions_of_Today()
        {
            try
            {
                if (Login.BuildConnection())
                {
                    string today_date = DateTime.Today.ToString("yyyy/MM/dd");

                    int User_ID = Properties.Settings.Default.User_ID;
                    string UserRole = Properties.Settings.Default.Role;
                    if (UserRole == "1") //ADMIN
                        dt = a.Select("", "", "", "", "", today_date, false);
                    else
                    {
                        DataTable sub_dt = u.Get_User_Subprojects(User_ID.ToString());
                        if (sub_dt.Rows.Count == 0)
                            throw new Exception("عذراً .. هذا المستخدم ليس له صلاحية على أي مركز من المراكز.");

                        SubProject_ID = sub_dt.Rows[0].Field<int>(0);
                        dt = a.Select("", "", SubProject_ID.ToString(), "", "syr", today_date, false);
                    }


                    if (dt.Rows.Count > 0)
                    {
                        myDataGrid.ItemsSource = dt.DefaultView;
                    }

                    sum_dt = a.Select_Sums(Till_ID.ToString(), today_date);
                    if (sum_dt.Rows.Count > 0)
                    {
                        Income_textBlock.Text = sum_dt.Rows[0].Field<double>(0).ToString("N3");
                        Outcome_textBlock.Text = sum_dt.Rows[0].Field<double>(1).ToString("N3");
                        Returned_textBlock.Text = sum_dt.Rows[0].Field<double>(2).ToString("N3");
                        Exchpand_textBlock.Text = sum_dt.Rows[0].Field<double>(3).ToString("N3");
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        #region datagrid functions
        private void myDataGrid_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                int count = myDataGrid.SelectedItems.Count;
                Selected_textBlock.Text = count.ToString("N3");

                double selected_incomes = 0;
                double selected_outcomes = 0;
                double selected_returned = 0;
                double selected_expaned = 0;
                for (var i = 0; i < count; i++)
                {
                    DataRowView SelectedDataRow = (DataRowView)myDataGrid.SelectedItems[i];
                    if (double.Parse(SelectedDataRow["Income"].ToString()) != 0)
                    {
                        selected_incomes += double.Parse(SelectedDataRow["Income"].ToString());
                    }
                    else if (double.Parse(SelectedDataRow["Outcome"].ToString()) != 0)
                    {
                        selected_outcomes += double.Parse(SelectedDataRow["Outcome"].ToString());
                    }
                    else if (double.Parse(SelectedDataRow["Returned"].ToString()) != 0)
                    {
                        selected_returned += double.Parse(SelectedDataRow["Returned"].ToString());
                    }
                    else if (double.Parse(SelectedDataRow["Expand"].ToString()) != 0)
                    {
                        selected_expaned += double.Parse(SelectedDataRow["Expand"].ToString());
                    }
                }
                Income_textBlock.Text = selected_incomes.ToString("N3");
                Outcome_textBlock.Text = selected_outcomes.ToString("N3");
                Returned_textBlock.Text = selected_returned.ToString("N3");
                Exchpand_textBlock.Text = selected_expaned.ToString("N3");
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void myDataGrid_MouseDoubleClick(object sender, MouseButtonEventArgs e)
        {
            IInputElement element = e.MouseDevice.DirectlyOver;
            if (element != null && element is FrameworkElement)
            {
                if (((FrameworkElement)element).Parent is DataGridCell)
                {
                    var grid = sender as DataGrid;
                    if (grid != null && grid.SelectedItems != null && grid.SelectedItems.Count == 1)
                    {
                        DataRowView dataRow = grid.SelectedItem as DataRowView;

                        int Action_ID = Convert.ToInt32(dataRow["ID"]);
                        // Till_ID //
                        if (dataRow["Till_ID"] != DBNull.Value && dataRow["Till_ID"] != null)
                            Till_ID = Convert.ToInt32(dataRow["Till_ID"]);
                        // Account_ID //
                        if (dataRow["Account_ID"] != DBNull.Value && dataRow["Account_ID"] != null)
                            Account_ID = Convert.ToInt32(dataRow["Account_ID"]);

                        AddAction_Window _Window = new AddAction_Window(Account_ID, Till_ID, TillType, Action_ID);
                        _Window.Show();
                    }
                }
            }
        }
        #endregion


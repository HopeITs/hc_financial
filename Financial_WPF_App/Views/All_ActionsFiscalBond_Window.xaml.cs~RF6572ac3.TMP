        private void AddNewAction_btn_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                if (FiscalBond_comboBox.SelectedIndex == -1)
                    throw new Exception("الرجاء اختيار السند الرئيسي المُراد إضافة سند عليه.. ");

                //Get the account Id linked to the selected fiscal bond//
                //for ADMIN don't select till id or select a default one (syr)
                //for Normal users >> select (syr) till 

                int FiscalBond_ID = Convert.ToInt32(FiscalBond_comboBox.SelectedValue.ToString());
                int Account_ID = -1;

                DataRow[] rows = fb_dt.Select("ID=" + FiscalBond_ID);
                if (rows.Length != 0) Account_ID = rows[0].Field<int>("Account_ID");

                AddAction_Window _Window = new AddAction_Window(1, 1, "syr");
                _Window.ShowDialog();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }


        }

        #region search
        private void Search_DataGrid()
        {
            DataTable selected_dt = new DataTable();
            selected_dt = dt.Copy();

            if (Search_txtBox.Text != "")
            {
                if (selected_dt != null)
                {
                    DataTable new_dt = selected_dt.Copy();
                    new_dt.Rows.Clear();
                    var found = 0;

                    foreach (DataRow r in selected_dt.Rows)
                    {
                        for (var i = 0; i < selected_dt.Columns.Count; i++)
                        {
                            if (ExactSearch_checkBox.IsChecked == true)
                            {
                                if (r.ItemArray.ElementAt(i).ToString().ToLower() == Search_txtBox.Text.ToLower())
                                {
                                    new_dt.Rows.Add(r.ItemArray);
                                    found = 1;
                                    break;
                                }
                            }
                            else
                            {
                                if (r.ItemArray.ElementAt(i).ToString().ToLower().Contains(Search_txtBox.Text.ToLower()))
                                {
                                    new_dt.Rows.Add(r.ItemArray);
                                    found = 1;
                                    break;
                                }
                            }
                        }
                    }
                    selected_dt = new_dt.Copy();
                }
            }
            myDataGrid.ItemsSource = null;

            if (selected_dt != null)
            {
                myDataGrid.ItemsSource = selected_dt.DefaultView;
                All_textBlock.Text = myDataGrid.Items.Count.ToString();
            }
        }
        private void Search_txtBox_TextChanged(object sender, TextChangedEventArgs e)
        {
            try
            {
                Search_DataGrid();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }
        private void ExactSearch_checkBox_Checked(object sender, RoutedEventArgs e)
        {
            try
            {
                Search_DataGrid();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }
        private void ExactSearch_checkBox_Unchecked(object sender, RoutedEventArgs e)
        {
            try
            {
                Search_DataGrid();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

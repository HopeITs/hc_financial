        public All_ActionFiscalBond_Window()
        {
            InitializeComponent();
            DataContext = this;
            Load_Form();
        }


        public All_ActionFiscalBond_Window(int FiscalBond_ID, string FiscalBond_Name)
        {
            InitializeComponent();
            DataContext = this;

            this.FiscalBond_ID = FiscalBond_ID;
            this.FiscalBond_Name = FiscalBond_Name;
            //Title_lable.Content = FiscalBond_Name;

            Load_Form();
        }

        int FiscalBond_ID;
        string FiscalBond_Name;
        int Action_ID, Till_ID, Account_ID, SubProject_ID, MicroProject_ID, Rate_ID;
        Till t;
        Models.Action a;

<Window x:Class="Financial_WPF_App.Views.Add_FiscalBond_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        mc:Ignorable="d"
        Title="Add_FiscalBond_Window" 
        Height="371" Width="749" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="266*"/>
            <ColumnDefinition Width="108*"/>
            <ColumnDefinition Width="267*"/>
            <ColumnDefinition Width="108*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="3" Grid.Row="0" Style="{DynamicResource lableStyle}" Content="Bond name:" Margin="1,1,1,1" VerticalContentAlignment="Center"  />
        <TextBox x:Name="Name_txtBox" Style="{DynamicResource textBoxStyle}" 
            Grid.Column="2" Grid.Row="0" TabIndex="1" Margin="10,21,10,21" />
        <Label Grid.Row="0" Style="{DynamicResource lableStyle}" Content="Discerption:" Margin="1,1,1,1" Grid.Column="1" VerticalContentAlignment="Center"/>
        <TextBox x:Name="Notes_txtBox" Style="{DynamicResource textBoxStyle}" Grid.Row="0" TabIndex="2" Margin="10,21,10,21" />
        <Label Grid.Column="3" Style="{DynamicResource lableStyle}" Content="Center:" Margin="1,1,1,1" Grid.Row="2" VerticalContentAlignment="Center"   />
        <StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="4,10,10,20" Grid.Row="2">
            <ComboBox x:Name="SubProject_comboBox" 
                DisplayMemberPath="Name" SelectedValuePath="ID"  
                FlowDirection="RightToLeft" Height="28" TabIndex="4" 
                SelectionChanged="SubProject_comboBox_SelectionChanged" Width="184" />
            <Button x:Name="SubProject_clear_btn" Width="25" Height="25" BorderBrush="{x:Null}" Click="SubProject_clear_btn_Click" >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </StackPanel>
        <Label Grid.Column="1" Style="{DynamicResource lableStyle}" Content="Account:" FontSize="18"  Margin="1,1,1,1" Grid.Row="2" VerticalContentAlignment="Center"/>
        <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" Margin="6,10,10,20" Grid.Row="2">
            <ComboBox x:Name="Account_comboBox" 
                DisplayMemberPath="Name" SelectedValuePath="ID"  
                FlowDirection="RightToLeft" Height="28" TabIndex="5" SelectionChanged="Account_comboBox_SelectionChanged" Width="183" />
            <Button x:Name="Account_clear_btn" Width="25" Height="25" BorderBrush="{x:Null}" Click="Account_clear_btn_Click" >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </StackPanel>
        <Label Grid.Column="3" Style="{DynamicResource lableStyle}" Content="Till:" FontSize="18"  Margin="1,1,1,1" Grid.Row="3" VerticalContentAlignment="Center"  />
        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="2,10,10,20" Grid.Column="2" Grid.Row="3">
            <ComboBox x:Name="Till_ComboBox" 
                DisplayMemberPath="Type" SelectedValuePath="ID"  
                FlowDirection="RightToLeft" Height="28" TabIndex="5" Width="184" />
            <Button x:Name="Till_clear_btn" Width="25" Height="25" BorderBrush="{x:Null}" Click="Till_clear_btn_Click" >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </StackPanel>
        <Button Grid.Row="4" Style="{DynamicResource SaveButton_Style}"
            x:Name="Save_btn" TabIndex="7" Click="Save_btn_Click" Width="92" Grid.Column="1" Height="32" Margin="62,0,0,0" Grid.ColumnSpan="2" />
        <Label Grid.Row="1" Style="{DynamicResource lableStyle}" Margin="1,1,1,1" Content="Bond date:" HorizontalContentAlignment="Stretch" Grid.Column="3" VerticalContentAlignment="Center"  />
        <DatePicker x:Name="Date_datepicker"  TabIndex="3" HorizontalAlignment="Left" Margin="50,20,0,20" Width="207" Grid.Column="2" Grid.Row="1" />

    </Grid>
</Window>

<Window x:Class="Financial_WPF_App.Views.Add_FiscalBond_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:local="clr-namespace:Financial_WPF_App"
        mc:Ignorable="d" Tag="Add Fiscal Bond Window"
        Title="Add_FiscalBond_Window" Height="350" Width="330"
        Style="{StaticResource smallWindowPopupStyle}" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid Margin="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6">
                <local:WindowControlBar_Popup x:Name="ControlBar"/>
            </DockPanel>
            <Label Grid.Column="0" Grid.Row="1" Style="{DynamicResource statistic_lableStyle}" Content="Bond name:" VerticalContentAlignment="Center"  />
            <TextBox x:Name="Name_txtBox" Style="{DynamicResource FloatingTextBoxStyle}" 
            Grid.Column="1" Grid.Row="1" TabIndex="1" />
            <Label Grid.Row="2" Style="{DynamicResource statistic_lableStyle}" Content="Discerption:"  Grid.Column="0" VerticalContentAlignment="Center"/>
            <TextBox x:Name="Notes_txtBox" Style="{DynamicResource FloatingTextBoxStyle}" Grid.Row="2" Grid.Column="1" TabIndex="2" />
            <Label Grid.Column="0" Style="{DynamicResource statistic_lableStyle}" Content="Center:"  Grid.Row="4" VerticalContentAlignment="Center"   />
            <StackPanel Grid.Column="1" Orientation="Horizontal"  Grid.Row="4">
                <ComboBox x:Name="SubProject_comboBox" Style="{StaticResource FloatingComboboxStyle}"
                DisplayMemberPath="Name" SelectedValuePath="ID"  
                 TabIndex="4" 
                SelectionChanged="SubProject_comboBox_SelectionChanged" Width="175" />
                <Button x:Name="SubProject_clear_btn" Style="{StaticResource DeleteButtonStyle}" Click="SubProject_clear_btn_Click" Margin="4,0,0,0" Height="30" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            <Label Grid.Column="0" Style="{DynamicResource statistic_lableStyle}" Content="Account:"  Grid.Row="5" VerticalContentAlignment="Center"/>
            <StackPanel  Orientation="Horizontal"  Grid.Row="5" Grid.Column="1">
                <ComboBox x:Name="Account_comboBox" Style="{StaticResource FloatingComboboxStyle}"
                DisplayMemberPath="Name" SelectedValuePath="ID"  
                TabIndex="5" SelectionChanged="Account_comboBox_SelectionChanged" Width="175" />
                <Button x:Name="Account_clear_btn" Style="{StaticResource DeleteButtonStyle}" Click="Account_clear_btn_Click" Height="30" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            <Label Grid.Column="0" Style="{DynamicResource statistic_lableStyle}" Content="Till:" Grid.Row="6" VerticalContentAlignment="Center"  />
            <StackPanel Orientation="Horizontal"  Grid.Column="1" Grid.Row="6">
                <ComboBox x:Name="Till_ComboBox" Style="{StaticResource FloatingComboboxStyle}"
                DisplayMemberPath="Type" SelectedValuePath="ID"  Width="175"
                 TabIndex="5"  />
                <Button x:Name="Till_clear_btn" Style="{StaticResource DeleteButtonStyle}" Click="Till_clear_btn_Click" Height="30" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            <Button Grid.Row="7" Style="{DynamicResource ButtonColoredStyle}" Content="Save"
            x:Name="Save_btn" TabIndex="7" Click="Save_btn_Click" Grid.Column="0" VerticalAlignment="Bottom" />
            <Label Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="Bond date:" HorizontalContentAlignment="Stretch" Grid.Column="0" VerticalContentAlignment="Center"  />
            <DatePicker x:Name="Date_datepicker"  TabIndex="3" Grid.Column="1" Grid.Row="3" Height="30" />

        </Grid>
    </Grid>
</Window>

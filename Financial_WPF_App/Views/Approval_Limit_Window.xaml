<Window x:Class="Financial_WPF_App.Views.Approval_Limit_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        mc:Ignorable="d"
        Title="Approval_Limit_Window" Style="{StaticResource WindowPopupStyle}"
        WindowStartupLocation="CenterScreen"  Closing="Approval_Limit_Window_Closing">
    <Grid Margin="5" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="355*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!--<ScrollViewer   
            FlowDirection="RightToLeft"
            VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" 
            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">-->
        <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0">
            <local:WindowControlBar_Popup x:Name="ControlBar" HorizontalAlignment="Right"/>
        </DockPanel>
        <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="2"   Grid.Row="1"                                   
               Style="{DynamicResource SfDataGrid_body}"
               HeaderStyle="{DynamicResource SfDataGrid_header}"
               RowStyle="{DynamicResource SfDataGrid_RowStyle}"
               AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"      
               NavigationMode="Cell" CurrentCellBorderBrush="{StaticResource LightGray2}" CurrentCellBorderThickness="2"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowGroupDropArea ="False"
               Margin="1,1,1,5"  CurrentCellEndEdit="myDataGrid_CurrentCellEndEdit" AllowFiltering="False" ItemsSourceChanged="myDataGrid_ItemsSourceChanged">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" HeaderText="#"  MappingName="ID" IsHidden="True"/>
                <syncfusion:GridTextColumn x:Name="Role_DataGridColumn" HeaderText="Role"  MappingName="Name" />

                <syncfusion:GridNumericColumn  x:Name="Limit_DataGridColumn" HeaderText="Limit"  MappingName="Approval_Limit" AllowEditing="True"
                                                 NumberDecimalDigits="2"
                                              NumberDecimalSeparator="."
                                              NumberGroupSizes="3"
                                              NumberGroupSeparator=","/>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <Button Grid.Row="2"  Style="{DynamicResource ButtonColoredStyle}" x:Name="Save_btn" Content="Save" Click="Save_btn_Click" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="175" Margin="10,0,1,0" />

    </Grid>
</Window>

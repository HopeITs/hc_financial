<Window 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="clr-namespace:WPFTextBoxAutoComplete;assembly=WPFTextBoxAutoComplete"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="Financial_WPF_App.Views.Add_till"
        mc:Ignorable="d"
        Title="Till_Window" Width="1280" Height="620" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*"></RowDefinition>
            <RowDefinition Height="30*"></RowDefinition>
            <RowDefinition Height="30*"></RowDefinition>
            <RowDefinition Height="100*"></RowDefinition>
        </Grid.RowDefinitions>
        <Label x:Name="EndDate_lable_Copy" Grid.Column="1" Style="{DynamicResource statistic_lableStyle}" FontSize="13" Content="Please Select The Currency Of The New Till:" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,0,1,0"  />
        <ComboBox Style="{DynamicResource FloatingComboboxStyle}" x:Name="tilltypes_ComboBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="ID" 
        	TabIndex="1"  Grid.Row="2" VerticalAlignment="Stretch" />
        <Button Grid.Row="2" Grid.Column="3"
        	Style="{DynamicResource ButtonColoredStyle}" x:Name="Save_btn" Content="Save"
        	TabIndex="10"  Click="Save_btn_Click" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"   />

        <Button Style="{DynamicResource AddButtonStyle}" ToolTip="Add New Till" ToolTipService.InitialShowDelay="100"
        x:Name="AddNewTillType_btn" TabIndex="2" Click="AddNewTillType_btn_Click" Width="22" Height="22" Grid.Column="2"  Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Button.Background>
                <ImageBrush ImageSource="/Images/Buttons/newEntry.png" Stretch="Uniform"/>
            </Button.Background>
        </Button>
    </Grid>
</Window>

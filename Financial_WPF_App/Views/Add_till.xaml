<Window 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="clr-namespace:WPFTextBoxAutoComplete;assembly=WPFTextBoxAutoComplete"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    x:Class="Financial_WPF_App.Views.Add_till"
        mc:Ignorable="d"
        Title="Till_Window" Width="1200" Height="614" FontFamily="Myriad Arabic" FontSize="18" WindowStartupLocation="CenterScreen">

    <Grid Margin="0,0,3.309,4.964">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="54*"></ColumnDefinition>
            <ColumnDefinition Width="218*"></ColumnDefinition>
            <ColumnDefinition Width="189*"></ColumnDefinition>
            <ColumnDefinition Width="68*"></ColumnDefinition>
            <ColumnDefinition Width="178*"/>
            <ColumnDefinition Width="269*"></ColumnDefinition>
            <ColumnDefinition Width="166*"></ColumnDefinition>
            <ColumnDefinition Width="54*"></ColumnDefinition>

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
        </Grid.RowDefinitions>
        <Label x:Name="EndDate_lable_Copy" Grid.Column="5" Style="{DynamicResource lableStyle}" Content="Please select the currency of the new till:" Margin="5,8,6,9" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  />
        <ComboBox x:Name="tilltypes_ComboBox" Grid.Column="4" DisplayMemberPath="Name" SelectedValuePath="ID" 
        	FlowDirection="RightToLeft" TabIndex="1" FontSize="14" Margin="2,6,4,10" Grid.Row="1" VerticalAlignment="Stretch" />
        <Button Grid.Row="1" Grid.Column="2"
        	Style="{DynamicResource SaveButton_Style}" x:Name="Save_btn"
        	TabIndex="10" Margin="91,6,5,7" Height="NaN" Width="NaN" Click="Save_btn_Click" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"   />
        <Button Style="{DynamicResource Add_Style}" 
            x:Name="AddNewTillType_btn" TabIndex="15" HorizontalAlignment="Stretch" Margin="18,15,25,10" VerticalAlignment="Stretch" Grid.Column="3" Grid.Row="1" Click="AddNewTillType_btn_Click" Width="NaN"  />
    </Grid>
</Window>

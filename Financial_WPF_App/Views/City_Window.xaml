<Window x:Name="City_Window" x:Class="Financial_WPF_App.CityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        mc:Ignorable="d"
        Title="CityWindow" Style="{StaticResource WindowPopupStyle}"
        WindowStartupLocation="CenterScreen" KeyDown="City_Window_KeyDown" Closing="City_Window_Closing" >
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <!--<Window.DataContext>
        --><!-- Declaratively create an instance of our SongViewModel --><!--
        <local1:CityViewModel />
    </Window.DataContext>-->
    <Window.Resources>
        
       
    </Window.Resources>
    <Grid Margin="5">
        <Grid Margin="0,0,0,0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="355*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0">
                <local:WindowControlBar_Popup x:Name="ControlBar" HorizontalAlignment="Right"/>
            </DockPanel>
            <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="2"  Grid.Row="1"                                          
 Style="{DynamicResource SfDataGrid_body}"
 HeaderStyle="{DynamicResource SfDataGrid_header}"
 RowStyle="{DynamicResource SfDataGrid_RowStyle}" 
 AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"      
 NavigationMode="Cell" CurrentCellBorderBrush="{StaticResource LightGray2}" CurrentCellBorderThickness="2" SelectionUnit="Row" SelectionMode="Single"
 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowGroupDropArea ="False"
 Margin="1,1,1,5"  AllowFiltering="False" CurrentCellEndEdit="myDataGrid_CurrentCellEndEdit" AddNewRowPosition="Bottom" ItemsSourceChanged="myDataGrid_ItemsSourceChanged">

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" HeaderText="#"  MappingName="ID" IsHidden="True"/>
                    <syncfusion:GridTextColumn x:Name="Currency_DataGridColumn" HeaderText="City"  MappingName="Name" AllowEditing="True"/>
                    <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn"  HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>

            </syncfusion:SfDataGrid>

            <Button Grid.Row="2"  Style="{DynamicResource ButtonColoredStyle}" x:Name="Save_btn" Content="Save" Click="Save_btn_Click" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="175" Margin="10,0,1,0" />
            
        </Grid>
    </Grid>
</Window>

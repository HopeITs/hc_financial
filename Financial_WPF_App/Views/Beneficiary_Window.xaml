<Window x:Class="Financial_WPF_App.Beneficiary_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:local="clr-namespace:Financial_WPF_App"
        mc:Ignorable="d" Tag="Beneficiary Window"
        Title="Beneficiary_Window" Style="{StaticResource WindowPopupStyle}" Width="1365" Height="450" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="25*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0" Grid.ColumnSpan="3">
            <local:WindowControlBar_Popup x:Name="ControlBar"/>
        </DockPanel>
        <Border Background="White" CornerRadius="{StaticResource CornerRadius}" Padding="10" Grid.Column="0" Margin="0,5,0,0"  Grid.Row="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity=".3" Color="{StaticResource Color_DarkGray}" />
            </Border.Effect>
            <Grid  >
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width=".3*" />
                    <ColumnDefinition Width="40*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" Grid.RowSpan="14" Background="{StaticResource DarkGray}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Percentage:" Grid.Row="0" Grid.Column="0"  HorizontalContentAlignment="Right"  />
                <Label x:Name="Rate_txtBox"  Style="{DynamicResource statistic_lableStyle}" Foreground="{StaticResource HopeRed}" Content="###,###" FontSize="12" Margin="0,0,0,0" TabIndex="13"  Grid.Row="0" Grid.Column="2" />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Amount paid:"   HorizontalContentAlignment="Right" Grid.Column="0" Grid.Row="1" />

                <Label x:Name="Returned_txtBox" Grid.Row="1" Grid.Column="3" Foreground="{StaticResource HopeRed}" Content="###,###" FontSize="12" Margin="0,0,0,0" Style="{DynamicResource statistic_lableStyle}" TabIndex="13" />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Not Approved:" HorizontalContentAlignment="Right" Grid.Column="0" Grid.Row="2" />
                <Label x:Name="NotApprovedAmount_txtBox" Grid.Column="2" Grid.Row="2" Foreground="{StaticResource HopeRed}" Content="###,###" FontSize="12" Margin="0,0,0,0"  Style="{DynamicResource statistic_lableStyle}" TabIndex="13" />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Remaining:" HorizontalContentAlignment="Right" Grid.Column="0" Grid.Row="3" />
                <Label x:Name="RemainedِAmount_txtBox" Grid.Column="2" Grid.Row="3" Foreground="{StaticResource HopeRed}" Content="###,###" FontSize="12" Margin="0,0,0,0" Style="{DynamicResource statistic_lableStyle}" TabIndex="13" />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Total payments:"  HorizontalContentAlignment="Right" Grid.Row="4" Grid.Column="0" />
                <Label x:Name="PaymentCount_txtBox" Grid.Column="2" Grid.Row="4" Foreground="{StaticResource HopeRed}" Style="{DynamicResource statistic_lableStyle}" Content="###,###" FontSize="12" Margin="0,0,0,0" TabIndex="13"  />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Paid:"   HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  Grid.Column="0" Grid.Row="5" />
                <Label x:Name="PaidPaymentCount_txtBox" Grid.Column="2" Grid.Row="5" Foreground="{StaticResource HopeRed}" Style="{DynamicResource statistic_lableStyle}" TabIndex="13" Content="###,###" FontSize="12" Margin="0,0,0,0" />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Incomplete:" Grid.Column="0" Grid.Row="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
                <Label x:Name="NotCompleted_txtBox" Grid.Column="2" Grid.Row="6" Foreground="{StaticResource HopeRed}" Style="{DynamicResource statistic_lableStyle}" TabIndex="13" Content="###,###" FontSize="12" Margin="0,0,0,0" />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Late:" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Grid.Column="0" Grid.Row="8" />
                <Label x:Name="NotApprovedPaymentCont_txtBox" Foreground="{StaticResource HopeRed}" Style="{DynamicResource statistic_lableStyle}" TabIndex="13"  Grid.Column="2" Grid.Row="9" Content="###,###" FontSize="12" Margin="0,0,0,0"/>
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Unpaid:" Grid.Column="0" Grid.Row="7"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"/>
                <Label x:Name="RemainedPaymentCount_txtBox" Grid.Column="2" Grid.Row="7" Style="{DynamicResource statistic_lableStyle}" TabIndex="13" Foreground="{StaticResource HopeRed}" Content="###,###" FontSize="12" Margin="0,0,0,0"/>
                <Label x:Name="DelayedPaymentCont_txtBox" Style="{DynamicResource statistic_lableStyle}" TabIndex="13" Grid.Column="2" Grid.Row="8" Foreground="{StaticResource HopeRed}" Content="###,###" FontSize="12" Margin="0,0,0,0"/>
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Not Approved:"   HorizontalContentAlignment="Right"  Grid.Row="9" Grid.Column="0"  />
            </Grid>
        </Border>
        <Border Background="White"  CornerRadius="{StaticResource CornerRadius}" Padding="10" Margin="0,5,0,0"  Grid.Column="2" Grid.Row="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity=".3" Color="{StaticResource Color_DarkGray}" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Project Number:"  Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />
                <TextBox x:Name="MP_ID_txtBox" Grid.Column="3"  Grid.Row="0" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="1" Width="175" />
                <Label Grid.Row="0" Grid.Column="0" Style="{DynamicResource statistic_lableStyle}" Content="Project Title:" Margin="11,0,1,0" HorizontalAlignment="Right"  />
                <TextBox x:Name="MP_Name_txtBox" Grid.Column="1"  Grid.Row="0" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="2" Width="175"/>

                <Label Grid.Row="1" Style="{DynamicResource statistic_lableStyle}" Content="Beneficiary Name:"   HorizontalAlignment="Right" Grid.Column="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />

                <Label Grid.Row="2" Style="{DynamicResource statistic_lableStyle}" Content="Names of partners:"  HorizontalAlignment="Right" Grid.Column="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />
                <TextBox x:Name="Partners_txtBox" Grid.Column="1" Grid.Row="2" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="6"   Grid.ColumnSpan="3" />

                <Label Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="ID number:"  Grid.Column="0" HorizontalAlignment="Right"  HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />
                <TextBox x:Name="NationalNumber_txtBox" Grid.Column="1" Grid.Row="3" Width="175" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="7"   />

                <Label Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="Mobile number:" HorizontalAlignment="Right"  Grid.Column="2"  HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />
                <TextBox x:Name="Mobile_txtBox" Grid.Column="3" Grid.Row="3" Width="175" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="8"   />


                <Label Grid.Row="4" Style="{DynamicResource statistic_lableStyle}" Content="Loan amount:" HorizontalAlignment="Right" Grid.Column="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />
                <TextBox x:Name="Amount_txtBox" Grid.Column="1" Grid.Row="4" Width="175" LostFocus="Amount_txtBox_LostFocus" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="9" HorizontalContentAlignment="Stretch" />

                <Label Grid.Column="2"  Grid.Row="4" Style="{DynamicResource statistic_lableStyle}" Content="Amount owed:"   HorizontalAlignment="Right" HorizontalContentAlignment="Left"  />
                <TextBox x:Name="ToReturn_Amount_txtBox" Grid.Column="3" Width="175" Grid.Row="4" TabIndex="10" LostFocus="ToReturn_Amount_txtBox_LostFocus" Style="{DynamicResource FloatingTextBoxStyle}"  HorizontalContentAlignment="Stretch"    />


                <Label Grid.Column="0" Grid.Row="6" Style="{DynamicResource statistic_lableStyle}" Content="Financing date:"   HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" />
                <DatePicker x:Name="Date_datepicker" Grid.Column="1"  Grid.Row="6" TabIndex="11" Width="175"
                    SelectedDateChanged="Date_datepicker_SelectedDateChanged" 
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                   />

                <Label Grid.Column="2"  Grid.Row="6" Style="{DynamicResource statistic_lableStyle}" Content="Payments start date:" HorizontalAlignment="Right" HorizontalContentAlignment="Left" />
                <DatePicker x:Name="FirstPaymentDate_datepicker" Grid.Column="3"  Grid.Row="6" TabIndex="12" Width="175"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"  />

                <Label Grid.Row="5" Style="{DynamicResource statistic_lableStyle}" Content="Payment:" Grid.Column="0" HorizontalAlignment="Right"   HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />
                <TextBox x:Name="Payment_txtBox" Grid.Column="1" Grid.Row="5" Width="175"
             LostFocus="Payment_txtBox_LostFocus"
             Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="13" />

                <Label Grid.Column="0" Grid.Row="7" Style="{DynamicResource statistic_lableStyle}" Content="Receipt number:"   HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />
                <TextBox x:Name="ReceiptNumber_txtBox" Grid.Column="1" Grid.Row="7"  Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="14" Width="175"  />

                <Label Grid.Column="2" Grid.Row="7" Style="{DynamicResource statistic_lableStyle}" Content="Order Number:"   HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" />
                <TextBox x:Name="OrderNumber_txtBox" Grid.Column="3" Grid.Row="7" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="15" Width="175"  VerticalContentAlignment="Stretch"/>

                <Label Grid.Column="0" Grid.Row="8" Style="{DynamicResource statistic_lableStyle}" Content="Group account:"  HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />
                <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="8" Height="30">
                    <ComboBox x:Name="Account_comboBox"  Style="{StaticResource FloatingComboboxStyle}" Width="145" DisplayMemberPath="Name" SelectedValuePath="ID" TabIndex="17"  VerticalContentAlignment="Stretch"  />
                    <Button x:Name="Account_clear_btn" Style="{StaticResource DeleteButtonStyle}" Height="30" BorderBrush="{x:Null}" Grid.Column="3" Grid.Row="10" Click="Account_clear_btn_Click" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </StackPanel>


                <Label Grid.Column="0" Grid.Row="9" Style="{DynamicResource statistic_lableStyle}" Content="Notes:" HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" />
                <TextBox x:Name="Notes_txtBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Grid.Column="1" Grid.Row="9" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="18" Grid.ColumnSpan="3" HorizontalContentAlignment="Left" />
                <Button Grid.Row="10" Grid.Column="0" x:Name="Original_AvgRate_help" Width="20" Height="20" BorderBrush="{x:Null}" ToolTipService.InitialShowDelay="100" HorizontalAlignment="Right" Margin="0,0,5,0" >

                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
                    </Button.Background>
                    <Button.ToolTip>
                        <TextBlock><Run Text="To carry out a rescheduling, you must :"/><LineBreak /><Run Text="either change the loan amount"/><LineBreak /><Run Text="or change the amount owed"/><LineBreak /><Run Text="or change the payment"/><LineBreak /><Run Text="or change the payments interval"/><LineBreak /><Run Text="or change the payments start date"/></TextBlock>
                    </Button.ToolTip>
                </Button>
                <Grid Grid.Column="1" Grid.Row="10" Grid.ColumnSpan="3" Margin="0,0,1,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button  Style="{DynamicResource ButtonColoredStyle}"   Content="Re-installment" Grid.Column="0"
           	x:Name="GeneratePayments_btn" 
           	TabIndex="21" Click="GeneratePayments_btn_Click" VerticalAlignment="Bottom"/>
                    <Button  Style="{DynamicResource ButtonColoredStyle}" x:Name="Save_btn"  TabIndex="20" Grid.Column="1"
                 Click="Save_btn_Click" Content="Save" VerticalAlignment="Bottom" />
                </Grid>
                <Label Grid.Row="5" Style="{DynamicResource statistic_lableStyle}" Content="Payments interval (M):" Grid.Column="2" HorizontalAlignment="Right"  HorizontalContentAlignment="Left"   />
                <TextBox x:Name="Payment_interval_TextBox" Grid.Column="3"  Grid.Row="5" TabIndex="10" LostFocus="ToReturn_Amount_txtBox_LostFocus"
                    Style="{DynamicResource FloatingTextBoxStyle}"  HorizontalContentAlignment="Stretch"   />
                <TextBox Grid.Column="1" x:Name="FName_txtBox" TextWrapping="Wrap"  VerticalContentAlignment="Center" TabIndex="3" Grid.Row="1" Style="{StaticResource FloatingTextBoxStyle}" Tag="First Name" TextChanged="FName_txtBox_TextChanged"/>
                <TextBox Grid.Column="2" x:Name="FaName_txtBox" TextWrapping="Wrap"  VerticalContentAlignment="Center"  TabIndex="4"  Grid.Row="1" Style="{StaticResource FloatingTextBoxStyle}" Tag="Father Name" TextChanged="FaName_txtBox_TextChanged"/>
                <TextBox x:Name="LName_txtBox" TextWrapping="Wrap"  VerticalContentAlignment="Center"  TabIndex="5" Grid.Column="3" Grid.Row="1" Style="{StaticResource FloatingTextBoxStyle}" Tag="Last Name" TextChanged="LName_txtBox_TextChanged"/>

            </Grid>
        </Border>


        <syncfusion:SfDataGrid  Grid.Column="1" Grid.Row="1"  Margin="2,5,5,45" x:Name="myDataGrid" 
                       Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" 
                                    ShowGroupDropArea ="False"
                                    Loaded="myDataGrid_Loaded"
                        SelectionChanged="myDataGrid_SelectionChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="359.7" >
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="ID" HeaderText="#" 
                                               IsHidden="True" />
                <syncfusion:GridTextColumn MappingName="Num" HeaderText="Number of payment"/>
                <syncfusion:GridNumericColumn  HeaderText="Payment amount"  MappingName="Amount"
                                                   NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                <syncfusion:GridDateTimeColumn HeaderText= "Due date" MappingName="DueDate"
                                                   CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"/>
                <syncfusion:GridTextColumn x:Name="Name_DataGridColumn" HeaderText="Payment status"  MappingName="payment_state" />
                <syncfusion:GridNumericColumn  HeaderText="Amount paid"  MappingName="Paid_Amount"
                                                   NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                <syncfusion:GridTextColumn HeaderText= "Payment date" MappingName="action_date"/>
                <syncfusion:GridTextColumn MappingName="Approved" HeaderText="Approved" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Cursor="Hand" Grid.Row="1" Grid.Column="1" Command="Helper:Commands.ExportToExcel" Height="25" Width="24" HorizontalAlignment="Left" Margin="10,5,0,10" VerticalAlignment="Bottom">
            <Button.Background>
                <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png"></ImageBrush>
            </Button.Background>
        </Button>
    </Grid>
</Window>

<Window x:Class="Financial_WPF_App.Beneficiary_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:local="clr-namespace:Financial_WPF_App"
        mc:Ignorable="d" Tag="Beneficiary Window"
        Title="Beneficiary_Window" Style="{StaticResource WindowPopupStyle}" Width="1106" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Height="548">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0" Grid.ColumnSpan="3">
            <local:WindowControlBar_Popup x:Name="ControlBar"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="{StaticResource CornerRadius}" Padding="10" Margin="0,5,0,0"  VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity=".3" Color="{StaticResource Color_DarkGray}" />
                    </Border.Effect>
                    <Grid  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" />
                            <ColumnDefinition Width=".3*" />
                            <ColumnDefinition Width="40*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Grid.RowSpan="17" Background="{StaticResource DarkGray}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Total payments:"    HorizontalAlignment="Right" Grid.Column="0" Grid.Row="10" VerticalAlignment="Stretch" />
                        <Label x:Name="TotalPaymentCount_txtBox"  Style="{DynamicResource statistic_lableStyle}" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
                    TabIndex="13"   Content="###,###"  Grid.Column="2" Grid.Row="10" VerticalAlignment="Stretch" />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Paid payments:"    HorizontalAlignment="Right" Grid.Column="0" Grid.Row="11" VerticalAlignment="Stretch" />
                        <Label x:Name="PaidPaymentCount_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="2" Grid.Row="11" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
                    TabIndex="13"   Content="###,###"  />

                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Loan amount:"    HorizontalAlignment="Right" Grid.Column="0" VerticalAlignment="Stretch" />
                        <Label x:Name="LoanAmount_txtBox"  Style="{DynamicResource statistic_lableStyle}" Content="###,###" Grid.Column="2" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
        TabIndex="13"    VerticalAlignment="Stretch" />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Percentage:"    HorizontalAlignment="Right" Grid.Column="0" VerticalAlignment="Stretch" Grid.Row="1" />
                        <Label x:Name="Rate_txtBox"  Style="{DynamicResource statistic_lableStyle}" Content="###,###" Grid.Column="2" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
TabIndex="13"    VerticalAlignment="Stretch" Grid.Row="1" />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Amount owed:"    HorizontalAlignment="Right" Grid.Column="0" Grid.Row="2" VerticalAlignment="Stretch" />
                        <Label x:Name="AmountAowed_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="2" Grid.Row="2" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
        TabIndex="13"   Content="###,###"   />


                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Amount paid:"    HorizontalAlignment="Right" Grid.Column="0" Grid.Row="3" VerticalAlignment="Stretch" />
                        <Label x:Name="AmountPaid_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="2" Grid.Row="3" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
        TabIndex="13"   Content="###,###"  />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Amount returned:"    HorizontalAlignment="Right" Grid.Column="0" Grid.Row="4" VerticalAlignment="Stretch" />
                        <Label x:Name="AmountReturned_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="2" Grid.Row="4" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
TabIndex="13"   Content="###,###"  />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Balanced:"    HorizontalAlignment="Right" Grid.Column="0" Grid.Row="7" VerticalAlignment="Stretch" />
                        <Label x:Name="Balanced_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="2" Grid.Row="7" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
TabIndex="13"   Content="###,###"  />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Not Approved Amount paid:"    HorizontalAlignment="Right" Grid.Column="0" Grid.Row="5" VerticalAlignment="Stretch" />
                        <Label x:Name="NotApprovedAmount_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="2" Grid.Row="5" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
        TabIndex="13"   Content="###,###"  />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Not Approved Amount returned:"    HorizontalAlignment="Right" Grid.Column="0" Grid.Row="6" VerticalAlignment="Stretch" />
                        <Label x:Name="NotApprovedAmountReturned_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="2" Grid.Row="6" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
TabIndex="13"   Content="###,###"  />


                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Remaining amount:"    HorizontalAlignment="Right" Grid.Column="0" Grid.Row="8" VerticalAlignment="Stretch" />
                        <Label x:Name="RemainingAmount_txtBox"  Style="{DynamicResource statistic_lableStyle}"  Grid.Column="2" Grid.Row="8" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
                    TabIndex="13"   Content="###,###"  />


                        <Label Grid.Column="0" Grid.Row="12" Style="{DynamicResource statistic_lableStyle}" Content="Unpaid:"   HorizontalAlignment="Right"  VerticalAlignment="Stretch"  />
                        <Label x:Name="UnpaidPaymentCount_txtBox" Grid.Column="2" Grid.Row="12"  Style="{DynamicResource statistic_lableStyle}" TabIndex="13" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
                      Content="###,###"   />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Incomplete:"   HorizontalAlignment="Right" VerticalAlignment="Stretch" Grid.Column="0" Grid.Row="13"  />
                        <Label x:Name="InComplete_txtBox"  Style="{DynamicResource statistic_lableStyle}" TabIndex="13" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
                      Content="###,###" Grid.Column="2" Grid.Row="13"  />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Returned:"   HorizontalAlignment="Right" VerticalAlignment="Stretch" Grid.Column="0" Grid.Row="14"  />
                        <Label x:Name="Returned_txtBox"  Style="{DynamicResource statistic_lableStyle}" TabIndex="13" FontSize="12" Margin="0,0,0,0" Foreground="{StaticResource HopeRed}"
  Content="###,###" Grid.Column="2" Grid.Row="14"  />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Not approved"   HorizontalAlignment="Right" Grid.Column="0" Grid.Row="15" VerticalAlignment="Stretch"   />
                        <Label x:Name="NotApprovedPaymentCont_txtBox" Grid.Column="2" Grid.Row="15" FontSize="12" Margin="0,0,0,0" Content="###,###" Foreground="{StaticResource HopeRed}"
    Style="{DynamicResource statistic_lableStyle}" TabIndex="13"   />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Late:"  HorizontalAlignment="Right" Grid.Column="0" Grid.Row="16" VerticalAlignment="Stretch"   />
                        <Label x:Name="DelayedPaymentCont_txtBox" FontSize="12" Margin="0,0,0,0"
    Style="{DynamicResource statistic_lableStyle}" TabIndex="13"    Content="###,###" Grid.Column="2" Grid.Row="16" Foreground="{StaticResource HopeRed}" />

                    </Grid>
                </Border>
                <Border Background="White"  CornerRadius="{StaticResource CornerRadius}" Padding="10" Margin="0,5,0,0"  Grid.Column="1" Grid.Row="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity=".3" Color="{StaticResource Color_DarkGray}" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Micro Project Number:"  Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />
                        <TextBox x:Name="MP_ID_txtBox" Grid.Column="3"  Grid.Row="0" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="2" Width="175" />
                        <Label Grid.Row="0" Grid.Column="0" Style="{DynamicResource statistic_lableStyle}" Content="Project Title:" Margin="0,0,1,0" HorizontalAlignment="Right"  />
                        <TextBox x:Name="MP_Name_txtBox" Grid.Column="1"  Grid.Row="0" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="1" Width="175"/>

                        <Label Grid.Row="1" Style="{DynamicResource statistic_lableStyle}" Content="Beneficiary Name:"   HorizontalAlignment="Right" Grid.Column="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0"  />

                        <Label Grid.Row="2" Style="{DynamicResource statistic_lableStyle}" Content="Names of partners:"  HorizontalAlignment="Right" Grid.Column="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0"  />
                        <TextBox x:Name="Partners_txtBox" Grid.Column="1" Grid.Row="2" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="6"   Grid.ColumnSpan="3" />

                        <Label Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="ID number:"  Grid.Column="0" HorizontalAlignment="Right"  HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0"  />
                        <TextBox x:Name="NationalNumber_txtBox" Grid.Column="1" Grid.Row="3" Width="175" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="7"   />

                        <Label Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="Mobile number:" HorizontalAlignment="Right"  Grid.Column="2"  HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"  />
                        <TextBox x:Name="Mobile_txtBox" Grid.Column="3" Grid.Row="3" Width="175" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="8"   />
                        <Label Grid.Column="0" Grid.Row="4" Style="{DynamicResource statistic_lableStyle}" x:Name="Currency_label"  Content="Currency:" HorizontalAlignment="Right"  HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0"  />

                        <Grid Grid.Column="1" Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="Currency_comboBox"  Style="{StaticResource FloatingComboboxStyle}" DisplayMemberPath="Name" SelectedValuePath="ID" TabIndex="9"  VerticalContentAlignment="Stretch"  />
                            <Button x:Name="SubProject_clear_btn" TabIndex="10" Grid.Column="1" Grid.Row="0" Width="25" Height="30"
        Click="Currency_clear_btn_Click" Style="{DynamicResource DeleteButtonStyle}">
                            </Button>
                        </Grid>


                        <Label Grid.Row="5" Style="{DynamicResource statistic_lableStyle}" Content="Loan amount:" HorizontalAlignment="Right" Grid.Column="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0"  />
                        <TextBox x:Name="Amount_txtBox" Grid.Column="1" Grid.Row="5" Width="175" LostFocus="Amount_txtBox_LostFocus" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="12" HorizontalContentAlignment="Stretch" />

                        <Label Grid.Column="2"  Grid.Row="5" Style="{DynamicResource statistic_lableStyle}" Content="Amount owed:"   HorizontalAlignment="Right" HorizontalContentAlignment="Left"  />
                        <TextBox x:Name="ToReturn_Amount_txtBox" Grid.Column="3" Width="175" Grid.Row="5" TabIndex="13" LostFocus="ToReturn_Amount_txtBox_LostFocus" Style="{DynamicResource FloatingTextBoxStyle}"  HorizontalContentAlignment="Stretch"/>

                        <Label x:Name="correspondingLoan_label" Grid.Column="2"  Grid.Row="6" Style="{DynamicResource statistic_lableStyle}" Content="Loan Amount"   HorizontalAlignment="Right" HorizontalContentAlignment="Left"  />
                        <TextBox x:Name="correspondingLoan_txtBox" Grid.Column="3" Width="175" Grid.Row="6" TabIndex="15" Style="{DynamicResource FloatingTextBoxStyle}"  HorizontalContentAlignment="Stretch"/>

                        <Label Grid.Row="6" Style="{DynamicResource statistic_lableStyle}" Content="Exchange Rate:" HorizontalAlignment="Right" Grid.Column="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0"  />
                        <TextBox x:Name="ExchangeRate_txtBox" Grid.Column="1" Grid.Row="6" Width="175" LostFocus="ExchangeRate_txtBox_LostFocus" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="14" HorizontalContentAlignment="Stretch" />

                        <Label Grid.Column="0" Grid.Row="8" Style="{DynamicResource statistic_lableStyle}" Content="Financing date:"   HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0" />
                        <DatePicker x:Name="Date_datepicker" Grid.Column="1"  Grid.Row="8" TabIndex="18" Width="175"
                    SelectedDateChanged="Date_datepicker_SelectedDateChanged" 
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                   />

                        <Label Grid.Column="2"  Grid.Row="8" Style="{DynamicResource statistic_lableStyle}" Content="Payments start date:" HorizontalAlignment="Right" HorizontalContentAlignment="Left" />
                        <DatePicker x:Name="FirstPaymentDate_datepicker" Grid.Column="3"  Grid.Row="8" TabIndex="19" Width="175"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"  />

                        <Label Grid.Row="7" Style="{DynamicResource statistic_lableStyle}" Content="Payment:" Grid.Column="0" HorizontalAlignment="Right"   HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0"  />
                        <TextBox x:Name="Payment_txtBox" Grid.Column="1" Grid.Row="7" Width="175"
             LostFocus="Payment_txtBox_LostFocus"
             Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="16" />

                        <Label Grid.Column="0" Grid.Row="9" Style="{DynamicResource statistic_lableStyle}" Content="Receipt number:"   HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0"  />
                        <TextBox x:Name="ReceiptNumber_txtBox" Grid.Column="1" Grid.Row="9"  Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="20" Width="175"  />

                        <Label Grid.Column="2" Grid.Row="9" Style="{DynamicResource statistic_lableStyle}" Content="Order Number:"   HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" />
                        <TextBox x:Name="OrderNumber_txtBox" Grid.Column="3" Grid.Row="9" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="21" Width="175"  VerticalContentAlignment="Center"/>

                        <Label Grid.Column="0" Grid.Row="10" Style="{DynamicResource statistic_lableStyle}" Content="Group account:"  HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0"  />
                        <Grid  Grid.Column="1" Grid.Row="10" Height="30" Grid.ColumnSpan="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="Account_comboBox" Grid.Column="0" Style="{StaticResource FloatingComboboxStyle}" DisplayMemberPath="Name" SelectedValuePath="ID" TabIndex="22"  VerticalContentAlignment="Stretch"  />
                            <Button x:Name="Account_clear_btn" Grid.Column="1" Style="{StaticResource DeleteButtonStyle}" Height="30" BorderBrush="{x:Null}" Click="Account_clear_btn_Click" TabIndex="20" >
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </Grid>


                        <Label Grid.Column="0" Grid.Row="11" Style="{DynamicResource statistic_lableStyle}" Content="Notes:" HorizontalAlignment="Right" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" Margin="0,0,1,0" />
                        <TextBox x:Name="Notes_txtBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Grid.Column="1" Grid.Row="11" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="23" Grid.ColumnSpan="3" HorizontalContentAlignment="Left" />
                        <Button Grid.Row="12" Grid.Column="0" x:Name="Original_AvgRate_help" Width="20" Height="20" BorderBrush="{x:Null}" ToolTipService.InitialShowDelay="100" HorizontalAlignment="Right" Margin="0,0,5,0" >

                            <Button.Background>
                                <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
                            </Button.Background>
                            <Button.ToolTip>
                                <TextBlock><Run Text="To carry out a rescheduling, you must :"/><LineBreak /><Run Text="either change the loan amount"/><LineBreak /><Run Text="or change the amount owed"/><LineBreak /><Run Text="or change the payment"/><LineBreak /><Run Text="or change the payments interval"/><LineBreak /><Run Text="or change the payments start date"/></TextBlock>
                            </Button.ToolTip>
                        </Button>
                        <Grid Grid.Column="1" Grid.Row="12" Grid.ColumnSpan="3" Margin="0,0,1,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button  Style="{DynamicResource ButtonColoredStyle}"   Content="Re-installment" Grid.Column="0"
           	x:Name="GeneratePayments_btn" 
           	TabIndex="24" Click="GeneratePayments_btn_Click" VerticalAlignment="Bottom"/>
                            <Button  Style="{DynamicResource ButtonColoredStyle}" x:Name="Save_btn"  TabIndex="31" Grid.Column="1"
                 Click="Save_btn_Click" Content="Save" VerticalAlignment="Bottom" />
                        </Grid>
                        <Label Grid.Row="7" Style="{DynamicResource statistic_lableStyle}" Content="Payments interval (M):" Grid.Column="2" HorizontalAlignment="Right"  HorizontalContentAlignment="Left" Margin="0,0,1,0"   />
                        <TextBox x:Name="Payment_interval_TextBox" Grid.Column="3"  Grid.Row="7" TabIndex="17" LostFocus="ToReturn_Amount_txtBox_LostFocus"
                    Style="{DynamicResource FloatingTextBoxStyle}"  HorizontalContentAlignment="Stretch"   />
                        <TextBox Grid.Column="1" x:Name="FName_txtBox" TextWrapping="Wrap"  VerticalContentAlignment="Center" TabIndex="3" Grid.Row="1" Style="{StaticResource FloatingTextBoxStyle}" Tag="First Name" TextChanged="FName_txtBox_TextChanged"/>
                        <TextBox Grid.Column="2" x:Name="FaName_txtBox" TextWrapping="Wrap"  VerticalContentAlignment="Center"  TabIndex="4"  Grid.Row="1" Style="{StaticResource FloatingTextBoxStyle}" Tag="Father Name" TextChanged="FaName_txtBox_TextChanged" Width="175"/>
                        <TextBox x:Name="LName_txtBox" TextWrapping="Wrap"  VerticalContentAlignment="Center"  TabIndex="5" Grid.Column="3" Grid.Row="1" Style="{StaticResource FloatingTextBoxStyle}" Tag="Last Name" TextChanged="LName_txtBox_TextChanged"/>

                    </Grid>
                </Border>


                <syncfusion:SfDataGrid  Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"  x:Name="myDataGrid" Margin="2,35,2,5"
                       Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" 
                                    ShowGroupDropArea ="False"
                                    Loaded="myDataGrid_Loaded"
                        SelectionChanged="myDataGrid_SelectionChanged" HorizontalAlignment="Stretch" VerticalAlignment="top" Height="450" >
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="ID" HeaderText="#" 
                                               IsHidden="True" />
                        <syncfusion:GridTextColumn MappingName="Num" HeaderText="Number of payment"/>
                        <syncfusion:GridNumericColumn  HeaderText="Payment amount"  MappingName="Amount"
                                                   NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                        <syncfusion:GridDateTimeColumn HeaderText= "Due date" MappingName="DueDate"
                                                   CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"/>
                        <syncfusion:GridTextColumn x:Name="Name_DataGridColumn" HeaderText="Payment status"  MappingName="payment_state" />
                        <syncfusion:GridNumericColumn  HeaderText="Amount paid"  MappingName="Paid_Amount"
                                                   NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>
                        <syncfusion:GridTextColumn HeaderText= "Payment date" MappingName="action_date"/>
                        <syncfusion:GridTextColumn MappingName="Approved" HeaderText="Approved" />
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Cursor="Hand" Grid.Row="2" Grid.Column="0" Command="Helper:Commands.ExportToExcel" Height="25" Width="24" HorizontalAlignment="Left" Margin="10,5,0,10" VerticalAlignment="Top">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png"></ImageBrush>
                    </Button.Background>
                </Button>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

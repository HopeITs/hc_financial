<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.Lines_lifetime_Window"
        mc:Ignorable="d"
        Title="Lines_lifetime_Window" Height="615" Width="900" 
        FontFamily="Myriad Arabic" FontSize="18" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <Grid >
            <Grid.ContextMenu>
                <ContextMenu x:Name="cm">
                    <MenuItem Header="Refresh Budget Lines" Click = "Refresh_Click" >
                        <MenuItem.Icon>
                            <Image Source="/Images/refresh32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="224*"/>
                <ColumnDefinition Width="205*"/>
                <ColumnDefinition Width="47*"/>
                <ColumnDefinition Width="156*"/>
                <ColumnDefinition Width="116*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>


                <RowDefinition Height="40" />
                <RowDefinition/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="55" />
            </Grid.RowDefinitions>

            <syncfusion:SfDataGrid Grid.ColumnSpan="8" FrozenColumnCount="3"
                x:Name="myDataGrid"  
                Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"   
                GroupSummaryRowStyle="{DynamicResource GroupSummaryRowStyle}"
                AutoGenerateColumns="True"
                NavigationMode="Cell"
                Loaded="myDataGrid_Loaded" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3,1,3,4" CurrentCellEndEdit="myDataGrid_CurrentCellEndEdit" AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" Grid.Row="1" FilterChanged="myDataGrid_FilterChanged" Grid.RowSpan="3">
            </syncfusion:SfDataGrid>
            <Menu x:Name="ShowHideMenu" Margin="0,9,0,4" HorizontalAlignment="Center" Width="32" >
                <Menu.Background>
                    <ImageBrush/>
                </Menu.Background>
                <MenuItem Header="" StaysOpenOnClick="True" Grid.Column="1" Width="32" Height="35" >
                    <MenuItem.Background>
                        <ImageBrush ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                    </MenuItem.Background>
                    <MenuItem x:Name="ShowMenu" Header="Show" StaysOpenOnClick="True" Background="White" />
                    <MenuItem x:Name="HideMenu" Header="Hide" StaysOpenOnClick="True" Background="White"/>
                    <Separator Background="Black"/>
                    <MenuItem Header="ShowAll" Click="ShowAll_MenuItem_Click" Background="White"/>
                </MenuItem>
            </Menu>
            <Button Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                TabIndex="5" Command="Helper:Commands.ExportToExcel" Grid.Column="1" Height="NaN" Width="31" HorizontalAlignment="Left" Margin="4,16,0,11" VerticalAlignment="Stretch" />
            <Button Grid.Column="4"  Style="{DynamicResource SaveButton_Style}"
                x:Name="Save_btn" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" Height="NaN" Width="NaN" Grid.Row="4" Margin="64,1,64,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Class="Financial_WPF_App.Views.Add_Account_Budget_Window"
        mc:Ignorable="d"
        Title="Add_Account_Budget_Window" Height="760" Width="800" WindowStartupLocation="CenterScreen"  Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Label Style="{DynamicResource lableStyle}" Content="Name:" Grid.Column="4" Margin="1,1,1,1" RenderTransformOrigin="0.486,0.136" VerticalContentAlignment="Center"  />
        <TextBox  x:Name="Name_txtBox" Style="{DynamicResource textBoxStyle}" TabIndex="5"
             Margin="2,21,2,17" RenderTransformOrigin="0.5,0.5" Grid.Column="3"   />
        <Label  Style="{DynamicResource lableStyle}" Content="Currency:" Margin="1,1,1,1" RenderTransformOrigin="0.484,0.414" Grid.Column="2" VerticalContentAlignment="Center" />
        <ComboBox Style="{DynamicResource FloatingComboboxStyle}" x:Name="TillType_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID"
            FlowDirection="RightToLeft" TabIndex="1" FontSize="14" Margin="1,21,2,17" Grid.Column="1" />
        <Label Grid.Column="4" Style="{DynamicResource lableStyle}" Content="Start date:" Margin="1,1,1,1" Grid.Row="1" VerticalContentAlignment="Center" />
        <DatePicker x:Name="beginDate_datepicker" TabIndex="1"  Margin="2,21,2,17" Grid.Column="3" Grid.Row="1" />
        <Label Style="{DynamicResource lableStyle}" Content="End date:" Margin="1,1,1,1" Grid.Column="2" Grid.Row="1" VerticalContentAlignment="Center" />
        <DatePicker x:Name="endDate_datepicker" TabIndex="2"  Margin="1,21,2,17" Grid.Row="1" Grid.Column="1"  />
        <TextBox x:Name="Exchange_Note_TextBox_Copy" Margin="3,4,10,4" Grid.Row="2" TextWrapping="Wrap" Style="{DynamicResource textBoxStyle}" Text="Please note that the budget's currency is the only currency allowed to be exchanged to Syrian pound." FontSize="20" Foreground="#FFBE121F" Grid.ColumnSpan="5" HorizontalContentAlignment="Left"/>
        <Grid Grid.Row="3" Margin="22,14,10,13" Grid.ColumnSpan="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="198"/>
                <ColumnDefinition Width="69"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="165"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="5"  Style="{DynamicResource lableStyle}" Content="Donor:" Margin="1,1,1,1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
            <ComboBox Style="{DynamicResource FloatingComboboxStyle}" x:Name="Donor_comboBox" TabIndex="3" 
                DisplayMemberPath="Name" SelectedValuePath="ID" 
                FlowDirection="RightToLeft" Width="auto" MinWidth="130" FontSize="16"
                VerticalContentAlignment="Center" Grid.Column="4" Margin="11,3,11,8"/>
            <Label  Style="{DynamicResource lableStyle}" Content="%" Grid.Column="2" FontSize="25"/>
            <Button Style="{DynamicResource Add_Style}" 
                x:Name="AddDonor_btn" TabIndex="15" Margin="0,0,5,5" Width="NaN" Click="AddDonor_btn_Click" Grid.Column="1"  />
            <TextBox x:Name="Rate_TextBox" Margin="2,2,2,2" TextWrapping="Wrap" Style="{DynamicResource textBoxStyle}" Grid.Column="3" LostFocus="Rate_TextBox_LostFocus"/>
        </Grid>

        <syncfusion:SfDataGrid x:Name="Budget_Dononrs_DataGrid" Margin="1,10,10,10" Grid.Row="4" Grid.ColumnSpan="5" 
        Style="{DynamicResource SfDataGrid_body}"
        HeaderStyle="{DynamicResource SfDataGrid_header}"
        RowStyle="{DynamicResource SfDataGrid_RowStyle}"
        AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
        AllowFiltering="False"  
        ShowGroupDropArea ="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="Budget_Donor_ID" HeaderText="Budget_Donor_ID" 
                IsHidden="True" />
                <syncfusion:GridTextColumn MappingName="Donor_ID" HeaderText="Donor_ID" 
                IsHidden="True" />
                <syncfusion:GridTextColumn MappingName="Donor" HeaderText="Donor"/>
                <syncfusion:GridNumericColumn  HeaderText="Percentage"  MappingName="Rate" 
                NumberDecimalDigits="2"
                NumberDecimalSeparator="."
                NumberGroupSizes="3"
                NumberGroupSeparator=","/>

                <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Delete_Style}" Click="Donor_DeleteButton_Click"/>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>

        </syncfusion:SfDataGrid>
        <Button  Style="{DynamicResource SaveButton_Style}"
            x:Name="Save_btn" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" Height="NaN" Width="NaN" Grid.Row="4" Margin="215,405,26,10" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="1" Grid.RowSpan="2" />

    </Grid>
</Window>

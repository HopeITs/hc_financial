<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Class="Financial_WPF_App.Views.Add_Account_Budget_Window"
        mc:Ignorable="d" Tag="Add Account Budget Window" Width="550"
        Title="Add_Account_Budget_Window" Style="{StaticResource smallWindowPopupStyle}" WindowStartupLocation="CenterScreen"  Closing="Window_Closing">
    <Grid Margin="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0" Grid.ColumnSpan="5">
                <local:WindowControlBar_Popup x:Name="ControlBar"/>
            </DockPanel>
            <Label Style="{DynamicResource statistic_lableStyle}" Content="Name:" Grid.Column="0" Grid.Row="1" VerticalContentAlignment="Center"  />
            <TextBox  x:Name="Name_txtBox" Style="{DynamicResource FloatingTextBoxStyle}" TabIndex="5" Width="175"
              Grid.Column="1" Grid.Row="1"  />
            <Label  Style="{DynamicResource statistic_lableStyle}" Content="Currency:"  Grid.Column="2" Grid.Row="1" VerticalContentAlignment="Center" />
            <ComboBox Style="{DynamicResource FloatingComboboxStyle}" Grid.Row="1" x:Name="TillType_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID"
             TabIndex="1"  Grid.Column="3"  Width="175"/>
            <Label Grid.Column="0" Style="{DynamicResource statistic_lableStyle}" Content="Start date:"  Grid.Row="2" VerticalContentAlignment="Center" />
            <DatePicker x:Name="beginDate_datepicker" TabIndex="1"  Grid.Column="1" Grid.Row="2" Width="175" Height="30"/>
            <Label Style="{DynamicResource statistic_lableStyle}" Content="End date:"  Grid.Column="2" Grid.Row="2" VerticalContentAlignment="Center" />
            <DatePicker x:Name="endDate_datepicker" TabIndex="2"  Grid.Row="2" Grid.Column="3" Width="175" Height="30" />
            <Label x:Name="Exchange_Note_TextBox_Copy" Grid.Row="3" Grid.Column="0"  Style="{DynamicResource statistic_lableStyle}" Content="Please note that the budget's currency is the only currency allowed to be " Foreground="{StaticResource HopeRed}"  HorizontalContentAlignment="Left" HorizontalAlignment="Center" Grid.ColumnSpan="4" VerticalAlignment="Bottom"/>
            <Label x:Name="Exchange_Note_TextBox_Copy1" Grid.Row="4" Grid.Column="0"  Style="{DynamicResource statistic_lableStyle}" Content="exchanged to Syrian pound." Foreground="{StaticResource HopeRed}"  HorizontalContentAlignment="Left" HorizontalAlignment="Center" Grid.ColumnSpan="4" VerticalAlignment="Top"/>


                <Label Style="{DynamicResource statistic_lableStyle}" Content="Donor:"  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Grid.Row="5" Grid.Column="0"/>
                <ComboBox Style="{DynamicResource FloatingComboboxStyle}" x:Name="Donor_comboBox" TabIndex="3" Grid.Row="5" Grid.Column="1"
                DisplayMemberPath="Name" SelectedValuePath="ID"  Width="175" VerticalContentAlignment="Center" />
        
                <TextBox x:Name="Rate_TextBox" TextWrapping="Wrap"  Grid.Row="5" Grid.Column="3" Style="{DynamicResource FloatingTextBoxStyle}" Tag="%"  LostFocus="Rate_TextBox_LostFocus" Margin="0,0,1,0" TextChanged="Rate_TextBox_TextChanged"/>
               
            <Button Style="{DynamicResource AddButtonStyle}" ToolTip="Insert" ToolTipService.InitialShowDelay="100" Width="18" Height="18"
        x:Name="AddDonor_btn" TabIndex="15" Click="AddDonor_btn_Click" Margin="2,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="4" Grid.Row="5">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/NewEntry.png"></ImageBrush>
                </Button.Background>
            </Button>
            <syncfusion:SfDataGrid x:Name="Budget_Dononrs_DataGrid" Grid.Row="6" Grid.ColumnSpan="5" 
        Style="{DynamicResource SfDataGrid_body}"
        HeaderStyle="{DynamicResource SfDataGrid_header}"
        RowStyle="{DynamicResource SfDataGrid_RowStyle}"
        AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
        AllowFiltering="False"  
        ShowGroupDropArea ="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,5,5,5" Grid.RowSpan="3">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="Budget_Donor_ID" HeaderText="Budget_Donor_ID" 
                IsHidden="True" />
                    <syncfusion:GridTextColumn MappingName="Donor_ID" HeaderText="Donor_ID" 
                IsHidden="True" />
                    <syncfusion:GridTextColumn MappingName="Donor" HeaderText="Donor"/>
                    <syncfusion:GridNumericColumn  HeaderText="Percentage"  MappingName="Rate" 
                NumberDecimalDigits="2"
                NumberDecimalSeparator="."
                NumberGroupSizes="3"
                NumberGroupSeparator=","/>

                    <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn" HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="Donor_DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>

            </syncfusion:SfDataGrid>
            <Button  Style="{DynamicResource ButtonColoredStyle}" Content="Save"
            x:Name="Save_btn" TabIndex="4" Click="Save_btn_Click"  Grid.Row="9"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.ColumnSpan="2" />
        </Grid>
    </Grid>
</Window>

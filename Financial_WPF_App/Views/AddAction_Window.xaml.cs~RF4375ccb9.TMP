        public AddAction_Window(int Account_ID, string Account_Name, int Till_ID, string TillType, bool ActionTOTill)
        {
            InitializeComponent();
            this.Action_ID = -1;
            this.Account_ID = Account_ID;
            this.Account_Name = Account_Name;
            this.Till_ID = Till_ID;
            this.TillType = TillType;
            this.ActionTOTill = ActionTOTill;
            this.dataRowView = null;

            Load_Form();
        }

        public AddAction_Window(int Account_ID, int Till_ID, string TillType, int Action_ID)
        {
            InitializeComponent();
            this.Action_ID = Action_ID;
            this.Account_ID = Account_ID;
            this.Till_ID = Till_ID;
            this.TillType = TillType;

            AccountName_lable.Content = Account_ID.ToString();

            //this.dataRowView = dataRowView;

            Load_Form();
        }


        private void Save_btn_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                if (Type_comboBox.Text == "")
                    throw new Exception("الرجاء التأكد من اختيار نوع العملية");

                if (Amount_txtBox.Text == "")
                    throw new Exception("الرجاء التأكد من إدخال المبلغ");

                if (ActionDate_datepicker.SelectedDate == null)
                    throw new Exception("الرجاء التأكد من اختيار تاريخ العملية");

                string amount_str, ReceiptDate, ActionDate;
                amount = exchanged = rate = 0;
                string inserted_value = "";
                amount_str = Amount_txtBox.Text.Replace(",", "");
                Double.TryParse(amount_str, out amount);

                ActionDate = ((DateTime)ActionDate_datepicker.SelectedDate).ToString("yyyy/MM/dd");


                if (MircoProject_ID_autoSuggestionUserControl.autoTextBox.Text != "" && BeneficiaryName_txtBox.Text != "")
                    int.TryParse(MircoProject_ID_autoSuggestionUserControl.autoTextBox.Text, out MicroProject_ID);
                else MicroProject_ID = -1;


                if (Type_comboBox.SelectedItem.ToString().Contains("وارد"))
                {
                    inserted_value = "I";
                }

                else if (Type_comboBox.SelectedItem.ToString().Contains("سلفة"))
                {
                    inserted_value = "O";
                    if (MicroProject_ID == -1)
                        throw new Exception("الرجاء اختيار المشروع");
                }
                else if (Type_comboBox.SelectedItem.ToString().Contains("مرتجع"))
                {
                    inserted_value = "R";
                    if (MicroProject_ID == -1)
                        throw new Exception("الرجاء اختيار المشروع");
                }
                else if (Type_comboBox.SelectedItem.ToString().Contains("تصريف"))
                {
                    inserted_value = "Ex";

                    if (DestinationTill_comboBox.SelectedIndex == -1)
                        throw new Exception("الرجاء اختيار الصندوق المقابل");

                    if (Rate_txtBox.Text == "")
                        throw new Exception("الرجاء التأكد من ادخال Rate قبل عملية الحفظ");

                    Double.TryParse(Rate_txtBox.Text, out rate);

                }
                else if (Type_comboBox.SelectedItem.ToString().Contains("صادر/مصروف"))
                {
                    inserted_value = "E";

                    if (IsReceipt_comboBox.SelectedIndex == -1)
                        throw new Exception("الرجاء التأكد من اختيار إيصال/فاتورة قبل عملية الحفظ");

                    if (Receipt_txtBox.Text == "")
                        throw new Exception("الرجاء التأكد من إدخال رقم الايصال او الفاتورة قبل عملية الحفظ");

                    if (Rate_ID == -1 || AvgRate_comboBox.SelectedIndex == -1)
                        throw new Exception("الرجاء التأكد من وجود Avg.");
                }


                ReceiptDate = "";
                int IsReceipt = -1;
                if (IsReceipt_comboBox.SelectedIndex == -1)
                    IsReceipt = -1;
                else if (IsReceipt_comboBox.SelectedItem.ToString().Contains("فاتورة"))
                {
                    ReceiptDate = ((DateTime)ReceiptDate_datepicker.SelectedDate).ToString("yyyy/MM/dd");
                    IsReceipt = 1;
                }

                else if (IsReceipt_comboBox.SelectedItem.ToString().Contains("إيصال"))
                {
                    ReceiptDate = ((DateTime)ReceiptDate_datepicker.SelectedDate).ToString("yyyy/MM/dd");
                    IsReceipt = 0;
                }

                int DestinationTill_ID = -1;
                if (DestinationTill_comboBox.SelectedIndex != -1)
                    DestinationTill_ID = Convert.ToInt32(DestinationTill_comboBox.SelectedValue);

                if (Login.BuildConnection())
                {
                    if (Action_ID != -1)//Edit
                    {
                        if (inserted_value == "Ex")
                        {
                            a.Update(Action_ID, -1, DestinationTill_ID, true, inserted_value, amount, rate
                           , ReceiptDate, Notes_txtBox.Text, IsReceipt, Receipt_txtBox.Text
                           , Rate_ID, MicroProject_ID, -1, -1, -1);
                        }
                        else
                        {
                            a.Update(Action_ID, -1, DestinationTill_ID, false, inserted_value, amount, rate
                           , ReceiptDate, Notes_txtBox.Text, IsReceipt, Receipt_txtBox.Text
                           , Rate_ID, MicroProject_ID, -1, -1, -1);
                        }

                    }
                    else//Add new
                    {
                        if (inserted_value == "Ex")
                        {
                            a.Insert(Till_ID, DestinationTill_ID, true, inserted_value, amount, rate, ActionDate
                           , ReceiptDate, Notes_txtBox.Text, IsReceipt, Receipt_txtBox.Text
                           , Rate_ID, MicroProject_ID, -1, -1, -1, Account_ID);
                        }
                        else
                        {
                            a.Insert(Till_ID, DestinationTill_ID, false, inserted_value, amount, rate, ActionDate
                            , ReceiptDate, Notes_txtBox.Text, IsReceipt, Receipt_txtBox.Text
                            , Rate_ID, MicroProject_ID, -1, -1, -1, -1);
                        }
                        MessageBox.Show("تم حفظ المعلومات بنجاح");
                        Clear_Boxes();
                        //LoadGrid();
                    }
                }
            }
            catch (Exception ex)
            {
                if (Login.MyConn != null && Login.MyConn.State == ConnectionState.Open)
                {
                    Login.MyConn.Close();
                }
                MessageBox.Show(ex.Message);
            }
        }

        private void Clear_Boxes()
        {
            Amount_txtBox.Text = USD_Value_TxtBox.Text =
                Rate_txtBox.Text = Exchanged_txtBox.Text =
                Notes_txtBox.Text = Receipt_txtBox.Text = BeneficiaryName_txtBox.Text =
                MircoProject_ID_autoSuggestionUserControl.autoTextBox.Text = "";

            IsReceipt_comboBox.SelectedIndex = DestinationTill_comboBox.SelectedIndex = AvgRate_comboBox.SelectedIndex = -1;

            ActionDate_datepicker.SelectedDate = ReceiptDate_datepicker.SelectedDate = DateTime.Today;
        }

        private void Type_comboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                Show_Hide_Components();

                if (UserMode)
                    if (Type_ComboBox_Expand_Item.IsSelected)
                        Fill_AvgRate();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

    }
}

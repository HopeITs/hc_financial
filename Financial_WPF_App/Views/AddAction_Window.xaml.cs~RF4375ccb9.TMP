        private void Avgrate_clear_btn_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                AvgRate_comboBox.SelectedIndex = -1;
            }
            catch (Exception ex)
            { MessageBox.Show(ex.Message); }
        }

        private void ActionDate_datepicker_SelectedDateChanged(object sender, SelectionChangedEventArgs e)
        {
            if (Type_ComboBox_Expand_Item.IsSelected)
                Fill_AvgRate();
        }

        private void Fill_Action()
        {
            try
            {

                DataTable dt = a.Select(Action_ID.ToString(), "", "", "", "", "", true);


                if (dt.Rows[0]["Income"] != DBNull.Value)
                    if (dt.Rows[0].Field<Double>("Income") != 0)
                    {
                        Type_comboBox.SelectedIndex = 0; //وارد
                        Amount_txtBox.Text = string.Format("{0:N3}", dt.Rows[0].Field<Double>("Income"));
                    }

                if (dt.Rows[0]["Outcome"] != DBNull.Value)
                    if (dt.Rows[0].Field<Double>("Outcome") != 0)
                    {
                        Type_comboBox.SelectedIndex = 1; //سلفة
                        Amount_txtBox.Text = string.Format("{0:N3}", dt.Rows[0].Field<Double>("Outcome"));
                    }

                if (dt.Rows[0]["Returned"] != DBNull.Value)
                    if (dt.Rows[0].Field<Double>("Returned") != 0)
                    {
                        Type_comboBox.SelectedIndex = 2; //مرتجع
                        Amount_txtBox.Text = string.Format("{0:N3}", dt.Rows[0].Field<Double>("Returned"));
                    }
                if (dt.Rows[0]["Exchange"] != DBNull.Value)
                    if (dt.Rows[0].Field<Double>("Exchange") != 0)
                    {
                        Type_comboBox.SelectedIndex = 3; //تصريف
                        Amount_txtBox.Text = string.Format("{0:N3}", dt.Rows[0].Field<Double>("Exchange"));
                    }
                if (dt.Rows[0]["Expand"] != DBNull.Value)
                    if (dt.Rows[0].Field<Double>("Expand") != 0)
                    {
                        Type_comboBox.SelectedIndex = 4; //فاتورة
                        Amount_txtBox.Text = string.Format("{0:N3}", dt.Rows[0].Field<Double>("Expand"));
                    }


                ActionDate_datepicker.SelectedDate = Convert.ToDateTime(dt.Rows[0].Field<DateTime>("ActiontDate").ToString());

                Notes_txtBox.Text = dt.Rows[0].Field<string>("Note").ToString();

                // ObserveTill_ID //
                if (dt.Rows[0]["ObserveTill_ID"] != DBNull.Value)
                {
                    DestinationTill_comboBox.SelectedValue = Convert.ToInt32(dt.Rows[0].Field<int>("ObserveTill_ID"));
                }
                else DestinationTill_comboBox.SelectedIndex = -1;


                if (dt.Rows[0]["MicroProject_ID"] != DBNull.Value)
                    MircoProject_ID_autoSuggestionUserControl.autoTextBox.Text = dt.Rows[0].Field<int>("MicroProject_ID").ToString();
                else MircoProject_ID_autoSuggestionUserControl.autoTextBox.Text = "";

                //Don't show the popup list//
                MircoProject_ID_autoSuggestionUserControl.CloseAutoSuggestionBox();
                //fill beneficiary name manually//
                if (dt.Rows[0]["Name"] != DBNull.Value)
                    BeneficiaryName_txtBox.Text = dt.Rows[0].Field<string>("Name").ToString();


                if (dt.Rows[0]["IsReceipt"] != DBNull.Value)
                {
                    if (dt.Rows[0].Field<string>("IsReceipt") == "إيصال") IsReceipt_comboBox.SelectedIndex = 1;
                    else if (dt.Rows[0].Field<string>("IsReceipt") == "فاتورة") IsReceipt_comboBox.SelectedIndex = 0;
                    else IsReceipt_comboBox.SelectedIndex = -1;
                }

                Receipt_txtBox.Text = dt.Rows[0].Field<string>("ReceiptNote");


                if (dt.Rows[0]["ReceiptDate"] != DBNull.Value)
                    ReceiptDate_datepicker.SelectedDate = Convert.ToDateTime(dt.Rows[0].Field<DateTime>("ReceiptDate").ToString());



                /*
                if (dt.Rows[0]["AvgRate"] != DBNull.Value)
                    AvgRate_TxtBox.Text = string.Format("{0:N3}", dt.Rows[0].Field<string>("AvgRate"));
*/
                if (dt.Rows[0]["AvgRate"] != DBNull.Value)
                    AvgRate_comboBox.SelectedValue = dt.Rows[0].Field<int>("AvgRate");

                //AvgRate_comboBox.SelectedValue = Convert.ToInt32(dataRow["AvgRate"].ToString());
                /*
                if (dt.Rows[0]["USD_Value"] != DBNull.Value)
                    if (dt.Rows[0].Field<Double>("USD_Value").ToString() != "0")
                    {
                        USD_Value_TxtBox.Text = string.Format("{0:N3}", dt.Rows[0].Field<Double>("USD_Value"));
                    }
*/
                if (dt.Rows[0]["Rate"] != DBNull.Value)
                    Rate_txtBox.Text = string.Format("{0:N3}", dt.Rows[0].Field<Double>("Rate"));




            }
            catch (Exception ex)
            { MessageBox.Show(ex.Message); }
        }

        private void Fill_Beneficiaries()
        {
            try
            {
                if (Login.BuildConnection())
                {
                    b_dt = b.Select("", Account_ID.ToString(), "");
                    List<string> TestItems = new List<string>();
                    if (b_dt.Rows.Count > 0)
                    {
                        for (int i = 0; i < b_dt.Rows.Count; i++)
                        {
                            TestItems.Add(b_dt.Rows[i].Field<Int32>("MicroProject_ID").ToString());
                        }
                        MircoProject_ID_autoSuggestionUserControl.AutoSuggestionList = TestItems;
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void Fill_Tills()
        {
            try
            {
                if (Login.BuildConnection())
                {
                    t_dt = t.Select(Account_ID.ToString(), "");
                    if (t_dt.Rows.Count > 0)
                    {
                        //Till_comboBox.ItemsSource = t_dt.DefaultView;
                        DestinationTill_comboBox.ItemsSource = t_dt.DefaultView;
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }

        }

        private void Fill_AvgRate()
        {
            try
            {
                string Date = ((DateTime)ActionDate_datepicker.SelectedDate).ToString("yyyy/MM/dd");
                if (Login.BuildConnection())
                {
                    AvgRate_comboBox.ItemsSource = null;
                    Rate_ID = -1;
                    rate_dt = r.Select(Account_ID.ToString(), Date, "", TillType);
                    if (rate_dt.Rows.Count == 0)
                    {
                        USD_Value_TxtBox.Text = "";
                        throw new Exception("لا يوجد قيمة مرتبطة بهذا الحساب وتضم تاريخ هذه العملية. الرجاء التأكد من وجود Avg Rate.");
                    }

                    AvgRate_comboBox.ItemsSource = rate_dt.DefaultView;
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }

        }

        private void AvgRate_comboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                if (AvgRate_comboBox.SelectedIndex != -1)
                {
                    Rate_ID = Convert.ToInt32(AvgRate_comboBox.SelectedValue);
                }
                Calc_ExValue();

            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void Calc_ExValue()
        {
            //Calculate USD Value//
            if (Amount_txtBox.Text != "" && AvgRate_comboBox.SelectedIndex != -1)
            {
                DataRow[] rows = rate_dt.Select("ID=" + Rate_ID);
                double avgRate = rows[0].Field<double>("Value");

                string expand = Amount_txtBox.Text.Replace(",", "");
                Double.TryParse(expand, out expandature);
                USD_Value = expandature / avgRate;
                USD_Value_TxtBox.Text = USD_Value.ToString("N3");
            }
            else
            {
                USD_Value = 0;
                USD_Value_TxtBox.Text = "";
            }
        }

        #region clear btns

        private void DestinationTill_clear_btn_Click(object sender, RoutedEventArgs e)
        {
            DestinationTill_comboBox.SelectedIndex = -1;
        }

        #endregion

        #region textbox functions
        private void Amount_txtBox_LostFocus(object sender, RoutedEventArgs e)
        {
            string value = Amount_txtBox.Text;
            if (value != "")
            {
                Amount_txtBox.Text = Login.ConvertToDouble(value);

                // Calculate Exchanged //  
                if (Type_ComboBox_Exchange_Item.IsSelected && Rate_txtBox.Text != "") //outcome
                {
                    exchanged = Double.Parse(Amount_txtBox.Text.Replace(",", "")) * Double.Parse(Rate_txtBox.Text.Replace(",", ""));
                    Exchanged_txtBox.Text = exchanged.ToString();
                }

                Calc_ExValue();
            }
        }

        private void Rate_txtBox_LostFocus(object sender, RoutedEventArgs e)
        {
            string value = Rate_txtBox.Text;
            if (value != "")
            {
                Rate_txtBox.Text = Login.ConvertToDouble(value);

                if (Amount_txtBox.Text != "") //outcome
                {
                    exchanged = Double.Parse(Amount_txtBox.Text.Replace(",", "")) * Double.Parse(Rate_txtBox.Text.Replace(",", ""));
                    Exchanged_txtBox.Text = exchanged.ToString("N3");
                }
            }
        }


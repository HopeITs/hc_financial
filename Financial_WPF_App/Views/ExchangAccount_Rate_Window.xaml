<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Class="Financial_WPF_App.Views.ExchangAccount_Rate_Window"
        mc:Ignorable="d"
        Title="ExchangAccount_Rate_Window" Width="1280" Height="620" FontFamily="Myriad Arabic" FontSize="18" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid>
            <Grid.ContextMenu>
                <ContextMenu x:Name="cm">
                    <MenuItem Header="Refresh Rate" Click = "Refresh_Click" >
                        <MenuItem.Icon>
                            <Image Source="/Images/refresh32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid  Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="233*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                        <Border Style="{StaticResource BorderStackPanelStyle}">
                            <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource MainBorderWrapPanelStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                        <Border Style="{StaticResource BorderStackPanelStyle}">
                            <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,5,0,0" Grid.ColumnSpan="2" >
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <DockPanel  LastChildFill="True" Background="{StaticResource LightGray1}" Height="40" Grid.RowSpan="2">
                        <WrapPanel VerticalAlignment="Center">
                            <Label Style="{StaticResource statistic_lableStyle}" x:Name="EndDate_lable_Copy"  Content="From:" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
                            <ComboBox Style="{StaticResource ActionComboboxStyle}"  x:Name="From_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" 
                                TabIndex="1"  Margin="2,0,1,0" SelectionChanged="From_comboBox_SelectionChanged" />
                            <Label Style="{StaticResource statistic_lableStyle}" x:Name="EndDate_lable_Copy1" Content="To:" Height="33" Width="34" HorizontalContentAlignment="Right" VerticalContentAlignment="Stretch" VerticalAlignment="Top" HorizontalAlignment="Center"  />
                            <ComboBox Style="{StaticResource ActionComboboxStyle}" x:Name="To_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" 
TabIndex="1"   VerticalAlignment="Stretch" SelectionChanged="To_comboBox_SelectionChanged" Margin="1,0,40,0" />

                        </WrapPanel>
                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0">
                            <Label Style="{StaticResource statistic_lableStyle}" x:Name="Date_lable" Content="Date:"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="7,0,1,0"/>
                            <DatePicker Style="{StaticResource DatePickerActionBar}" x:Name="Date_datepicker" Grid.Column="10" Margin="1,0,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="175"/>
                            <Label Style="{StaticResource statistic_lableStyle}" x:Name="Value_Lable" Grid.Column="9"  Content="Value:" Margin="10,0,1,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  />
                            <TextBox x:Name="Value_txtBox"  TabIndex="6" Tag=""
                                    Style="{DynamicResource CustomTextBoxActionStyle}" Margin="0,0,2,0" Grid.Column="8" Height="30" VerticalAlignment="Stretch" />
                            <Button Style="{DynamicResource AddButtonStyle}" 
                                x:Name="Insert_btn" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="InsertAction_btn_Click" Grid.Column="7" ToolTip="Insert" ToolTipService.InitialShowDelay="100" Margin="1,0,0,0">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/newEntry.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                            
                            
                        </WrapPanel>
                    </DockPanel>

                </Grid>
                <Grid Grid.Row="3" Margin="0,5,0,0" Grid.ColumnSpan="2" >
                    <DockPanel  LastChildFill="True" Background="{StaticResource LightGray1}" Height="40">
                        <WrapPanel Orientation="Horizontal" Width="Auto">
                            <Menu x:Name="ShowHideMenu" Margin="5,2,5,2">
                                <Menu.Resources>
                                    <!-- Custom Menu Style -->
                                    <Style TargetType="Menu">
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Menu">
                                                    <Border Background="{TemplateBinding Background}" Padding="0">
                                                        <ItemsPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <!-- Custom MenuItem Style -->
                                    <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
                                        <Setter Property="FontFamily" Value="Rubik"/>
                                        <Setter Property="FontSize" Value="13.5"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DarkGray}"/>
                                        <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Grid>
                                                        <!-- Main Item -->
                                                        <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="10,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <!-- Arrow Column -->
                                                                </Grid.ColumnDefinitions>

                                                                <ContentPresenter Grid.Column="0" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Center" 
        ContentSource="Header"/>

                                                                <!-- Submenu Arrow -->
                                                                <Path x:Name="Arrow"
       Grid.Column="1"
       Data="M 0 0 L 6 4 L 0 8 Z" 
       Fill="{DynamicResource DarkGray}"
       VerticalAlignment="Center"
       Margin="5,0,0,0"
       Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Submenu Popup -->
                                                        <Popup x:Name="Popup"
Placement="Bottom"
PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
IsOpen="{TemplateBinding IsSubmenuOpen}"
AllowsTransparency="True"
Focusable="False"
PopupAnimation="Fade">
                                                            <Border Background="White" CornerRadius="5" BorderBrush="{StaticResource LightGray1}" BorderThickness="1">
                                                                <StackPanel>
                                                                    <ItemsPresenter />
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>

                                                    <!-- Triggers -->
                                                    <ControlTemplate.Triggers>
                                                        <!-- Show Arrow Only if the MenuItem has sub-items (is a submenu) -->
                                                        <Trigger Property="HasItems" Value="True">
                                                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                                        </Trigger>

                                                        <!-- Submenu Hover Effect -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <!--<Setter TargetName="Border" Property="Background" Value="transparent"/>-->
                                                            <!--<Setter Property="Foreground" Value="{DynamicResource LightGray1}"/>-->
                                                        </Trigger>

                                                        <!-- Submenu Open Effect -->
                                                        <Trigger Property="IsSubmenuOpen" Value="True">
                                                            <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
                                                        </Trigger>

                                                        <!-- Disabled Effect -->
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MidGray}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                </Menu.Resources>
                                <!-- MenuItems with Custom Style -->
                                <MenuItem Width="20" Height="20" StaysOpenOnClick="True" Header=""  Style="{StaticResource CustomMenuItemStyle}" Margin="6,9,0,0" ToolTip="Show/Hide Columns" ToolTipService.InitialShowDelay="100">
                                    <MenuItem.Background>
                                        <ImageBrush ImageSource="/Images/Buttons/showHide.png" Stretch="Uniform"/>
                                    </MenuItem.Background>
                                    <!-- Submenu Items (Will Keep Hover Effect) -->
                                    <MenuItem StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                                    <MenuItem StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                                    <MenuItem Background="{StaticResource LightGray1}" Click="ShowAll_MenuItem_Click" Header="ShowAll" Style="{StaticResource CustomMenuItemStyle}"/>
                                </MenuItem>
                            </Menu>
                            <StackPanel x:Name="ExportToExcel_StackPanel" RenderTransformOrigin="0.5,0.5" Width="31">
                                <StackPanel.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="-1"/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </StackPanel.RenderTransform>
                                <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" Command="local:Commands.ExportToExcel"  Width="30" Height="25" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,10,1,1">
                                    <Button.Background>
                                        <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png" Stretch="Uniform"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel x:Name="Panel1" Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,61,0">
                            <TextBox Style="{DynamicResource TextBoxActionStyle}" TextChanged="Search_txtBox_TextChanged" x:Name="Search_txtBox" TextWrapping="Wrap" TabIndex="10"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
                <syncfusion:SfDataGrid  x:Name="myDataGrid"
                        Style="{DynamicResource SfDataGrid_body}"
                        HeaderStyle="{DynamicResource SfDataGrid_header}"
                        RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                        AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                        TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"
                        HorizontalAlignment="Stretch" Grid.Row="4" SelectionChanged="myDataGrid_SelectionChanged"
                        AutoGenerateColumns="True" Loaded="myDataGrid_Loaded" VerticalAlignment="Stretch" AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" Grid.ColumnSpan="2" Grid.RowSpan="2" FilterChanged="myDataGrid_FilterChanged" Margin="2,5,35,5">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn" HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>

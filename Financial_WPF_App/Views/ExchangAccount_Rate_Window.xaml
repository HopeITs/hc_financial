<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Class="Financial_WPF_App.Views.ExchangAccount_Rate_Window"
        mc:Ignorable="d"
        Title="ExchangAccount_Rate_Window" Width="1280" Height="620" FontFamily="Myriad Arabic" FontSize="18" WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid>
            <Grid.ContextMenu>
                <ContextMenu x:Name="cm">
                    <MenuItem Header="Refresh Rate" Click = "Refresh_Click" >
                        <MenuItem.Icon>
                            <Image Source="/Images/refresh32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
                <RowDefinition Height="175"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid x:Name="Grid1" Grid.Row="0" Margin="0,10,0,54">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66*"/>
                    <ColumnDefinition Width="61*"/>
                    <ColumnDefinition Width="108*"/>
                    <ColumnDefinition Width="116*"/>
                    <ColumnDefinition Width="128*"/>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="204*"/>
                    <ColumnDefinition Width="58*"/>
                    <ColumnDefinition Width="143*"/>
                    <ColumnDefinition Width="61*"/>
                    <ColumnDefinition Width="143*"/>
                    <ColumnDefinition Width="61*"/>
                    <ColumnDefinition Width="2"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="1"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label x:Name="Date_lable" Grid.Column="11" Grid.Row="2" Style="{DynamicResource lableStyle}" Content="Date:" Margin="0,10,0,9" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"/>
                <DatePicker x:Name="Date_datepicker" Grid.Column="10" TabIndex="3" Margin="1,0,2,9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="2"/>

                <Label x:Name="Value_Lable" Grid.Column="9" Grid.Row="2" Style="{DynamicResource lableStyle}" Content="Value:" Margin="0,12,5,12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  />
                <TextBox x:Name="Value_txtBox"  TabIndex="6"
                    Style="{DynamicResource textBoxStyle}" Margin="0,0,2,0" Grid.Column="8" Height="37" Grid.Row="2" PreviewTextInput="NumberValidationTextBox" VerticalAlignment="Stretch" />
                <Label x:Name="EndDate_lable_Copy" Grid.Column="11" Style="{DynamicResource lableStyle}" Content="From:" Margin="0,10,5,11" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
                <Label x:Name="EndDate_lable_Copy1" Grid.Column="9" Style="{DynamicResource lableStyle}" Content="To:" Height="33" Width="60" HorizontalContentAlignment="Right" VerticalContentAlignment="Stretch" Margin="0,14,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"  />
                <ComboBox x:Name="To_comboBox" Grid.Column="8" DisplayMemberPath="Name" SelectedValuePath="ID" 
                    FlowDirection="RightToLeft" TabIndex="1" FontSize="14" Margin="5,13,4,12" VerticalAlignment="Stretch" SelectionChanged="To_comboBox_SelectionChanged" />
                <Menu x:Name="ShowHideMenu" Margin="27,6,0,11" Grid.Row="2" >
                    <Menu.Background>
                        <ImageBrush/>
                    </Menu.Background>
                    <MenuItem Header="" StaysOpenOnClick="True" Grid.Column="1" Width="35" Height="34" >
                        <MenuItem.Background>
                            <ImageBrush ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                        </MenuItem.Background>
                        <MenuItem x:Name="ShowMenu" Header="Show" StaysOpenOnClick="True" Background="White" />
                        <MenuItem x:Name="HideMenu" Header="Hide" StaysOpenOnClick="True" Background="White"/>
                        <Separator Background="Black"/>
                        <MenuItem Header="ShowAll" Click="ShowAll_MenuItem_Click" Background="White"/>
                    </MenuItem>
                </Menu>
                <Button Grid.Column="1" Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                    TabIndex="5" HorizontalAlignment="Left" Margin="23,10,0,0"
                    Command="Helper:Commands.ExportToExcel" Grid.Row="2" Height="30" Width="34" VerticalAlignment="Top"
                />
                <Button Style="{DynamicResource Add_Style}" 
                    x:Name="Insert_btn" TabIndex="15" Height="NaN" Width="NaN" HorizontalAlignment="Stretch" Margin="17,14,5,13" VerticalAlignment="Stretch" Click="InsertAction_btn_Click" Grid.Column="7" Grid.Row="2" />
                <ComboBox x:Name="From_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" 
                        FlowDirection="RightToLeft" Height="29" TabIndex="1" FontSize="14" Grid.Column="10" Margin="2,0,1,0" SelectionChanged="From_comboBox_SelectionChanged" />
            </Grid>

            <!--</ScrollViewer>-->
            <!--<ScrollViewer 
            FlowDirection="RightToLeft"
            VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" 
            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">-->
            <Grid Margin="0,126,0,10" Grid.RowSpan="2"  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="716*"/>
                    <ColumnDefinition Width="557*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <syncfusion:SfDataGrid  x:Name="myDataGrid"  FrozenColumnCount="1"
                    Style="{DynamicResource SfDataGrid_body}"
                    HeaderStyle="{DynamicResource SfDataGrid_header}"
                    RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                    AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                    TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"
                    HorizontalAlignment="Stretch"
                    AutoGenerateColumns="True" Loaded="myDataGrid_Loaded" VerticalAlignment="Stretch" Margin="8,0,6,10" AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" Grid.ColumnSpan="2" Grid.RowSpan="2" FilterChanged="myDataGrid_FilterChanged">
                    <syncfusion:SfDataGrid.Columns>


                        <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

            </Grid>

        </Grid>

    </Grid>
</Window>

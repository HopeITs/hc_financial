                    Margin="0,6,0,6.764" VerticalContentAlignment="Center"/>
                <Button x:Name="ExchangeCash_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Width="25" Height="25" BorderBrush="{x:Null}" Margin="0,9,0,8.764" Click="ExchangeCash_clear_btn_Click" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            <Label Grid.Column="2" Grid.Row="11" x:Name="Employee_lable" Style="{DynamicResource lableStyle}" Content="Volunteer:" Margin="1,2,1,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
            <StackPanel Grid.Row="11" x:Name="Budget_panel_Copy" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="1,2,3,2" Grid.Column="1" >
                <ComboBox x:Name="Employee_comboBox" TabIndex="12" 
                    DisplayMemberPath="Employee_Name" SelectedValuePath="Employee_Salary_ID" 
                    FlowDirection="RightToLeft" Height="30" Width="150" MinWidth="130" FontSize="16"
                    Margin="0,6,0,6.764" VerticalContentAlignment="Center"/>
                <Button x:Name="Employee_comboBox_clear" HorizontalAlignment="Left" VerticalAlignment="Center" Width="25" Height="25" BorderBrush="{x:Null}" Margin="0,9,0,8.764" Click="Employee_comboBox_clear_Click" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
                <Button x:Name="Employee_help" Width="25" Height="28" BorderBrush="{x:Null}" ToolTipService.InitialShowDelay="100">

                    <Button.Background>
                        <ImageBrush ImageSource="/Images/qm1.png" Stretch="Uniform"/>
                    </Button.Background>
                    <Button.ToolTip>
                        <TextBlock><Run Text="Only the volunteer from this center appears, provided that his salary has been added for the month corresponding to the operation date."/></TextBlock>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
            <Label Grid.Column="4" Style="{DynamicResource lableStyle}" Content="Subproject:" Margin="2,2,2,2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
            <Label Grid.Column="2" Style="{DynamicResource lableStyle}" Content="Account:" Margin="2,2,2,2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
            <ComboBox x:Name="Subproject_comboBox" TabIndex="1" Grid.Column="3" DisplayMemberPath="Subproject_Name" SelectedValuePath="Subproject_ID" 
                FlowDirection="RightToLeft" FontSize="14" Margin="5,5,6,5" Width="auto" MinWidth="100px"
                HorizontalContentAlignment="Right" 
                VerticalAlignment="Stretch" SelectionChanged="Subproject_comboBox_SelectionChanged" >

            </ComboBox>
            <ComboBox x:Name="Account_comboBox" TabIndex="1"
                FlowDirection="RightToLeft" FontSize="14" Margin="10,5,4,5" Width="auto" MinWidth="100px" DisplayMemberPath="Account_Name" SelectedValuePath="Account_ID" 
                HorizontalContentAlignment="Right" 
                VerticalAlignment="Stretch" Grid.ColumnSpan="2" SelectionChanged="Account_comboBox_SelectionChanged" >

            </ComboBox>
            <Label Grid.Column="4" Style="{DynamicResource lableStyle}" Content="Till:" Margin="2,4,2,3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Grid.Row="1"  />
            <ComboBox x:Name="Till_comboBox" TabIndex="1" Grid.Column="3" DisplayMemberPath="Tilltypes_Name" SelectedValuePath="Till_ID" 
                FlowDirection="RightToLeft" FontSize="14" Margin="6,7,6,6" Width="auto" MinWidth="100px"
                HorizontalContentAlignment="Right" 
                VerticalAlignment="Stretch" Grid.Row="1" SelectionChanged="Till_comboBox_SelectionChanged" >

            </ComboBox>
        </Grid>
    </ScrollViewer>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:WPFTextBoxAutoComplete="clr-namespace:WPFTextBoxAutoComplete;assembly=WPFTextBoxAutoComplete" 
        xmlns:uc ="clr-namespace:Financial_WPF_App.Controls"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        x:Class="Financial_WPF_App.AddAction_Window"
    
        mc:Ignorable="d" Tag="Add Action Window"
        Title="AddAction_Window" Style="{StaticResource WindowPopupStyle}" WindowStartupLocation="CenterScreen" d:DesignHeight="800">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0">
            <local:WindowControlBar_Popup x:Name="ControlBar"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" >
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="30"/>


                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition/>

                </Grid.RowDefinitions>

                <Label x:Name="MircoProject_ID_lable" Grid.Column="1" Grid.Row="9" 
                Style="{DynamicResource statistic_lableStyle}" Content="Micro Project number:" HorizontalContentAlignment="Left" />
                <uc:AutoCompleteTextBoxUserControl  Style="{StaticResource TextBoxUserControlStyle}"
                x:Name="MircoProject_ID_autoSuggestionUserControl" Tag="Project Number"
                Grid.Column="2" Grid.Row="9" TabIndex="9" 
                LostFocus="MircoProject_ID_autoSuggestionUserControl_LostFocus" />

                <!--<TextBox x:Name="MircoProject_ID_txtBox" TabIndex="3"
                     Grid.Column="5" Grid.Row="1"  
                TextChanged="MircoProject_ID_txtBox_TextChanged" 
                     Style="{DynamicResource textBoxStyle}" 
                Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}"
                WPFTextBoxAutoComplete:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding XPath=TestItems}" />-->

                <Label x:Name="BeneficiaryName_lable" Grid.Column="4" Grid.Row="9" 
                Style="{DynamicResource statistic_lableStyle}" Content="Beneficiary Name:" HorizontalContentAlignment="Left" />

                <Label Grid.Column="1" Grid.Row="16" x:Name="DestinationTill_lable" Style="{DynamicResource statistic_lableStyle}" Content="Corresponding till:" HorizontalContentAlignment="Left" />
                <Grid Grid.Column="2" Grid.Row="16" x:Name="DestinationTill_panel" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="DestinationTill_comboBox" TabIndex="5" Grid.Column="0" Style="{DynamicResource FloatingComboboxStyle}"
                          DisplayMemberPath="Type" SelectedValuePath="ID" 
                          SelectionChanged="DestinationTill_comboBox_SelectionChanged"/>
                    <Button Grid.Column="1" x:Name="DestinationTill_clear_btn" HorizontalAlignment="Left" Style="{StaticResource DeleteButtonStyle}"
                    Click="DestinationTill_clear_btn_Click" Margin="5,0,0,0" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>

                </Grid>
                <Button Grid.Row="16" Grid.Column="3" x:Name="DestinationTill_help" Width="25" Height="25" ToolTipService.InitialShowDelay="100" BorderBrush="{x:Null}" Margin="5,0,0,0" HorizontalAlignment="Left">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
                    </Button.Background>
                    <Button.ToolTip>
                        <TextBlock><Run Text="The account only appears if it contains a till of the same currency."/><LineBreak /><Run Text="In foreign currency till, The account only appears if it contains a till of the same currency and the account has the selected donor"/></TextBlock>
                    </Button.ToolTip>
                </Button>
                <ComboBox x:Name="Type_comboBox" TabIndex="1" Grid.Column="5" Grid.Row="1" 
                       Style="{StaticResource FloatingComboboxStyle}"
                      HorizontalContentAlignment="Left" 
                      SelectionChanged="Type_comboBox_SelectionChanged">
                    <ComboBoxItem x:Name="Type_ComboBox_Income_Item" Content="Income" />
                    <ComboBoxItem x:Name="Type_ComboBox_Outcome_Item" Content="Adv. Payment"/>
                    <ComboBoxItem x:Name="Type_ComboBox_Returned_Item" Content="Returned"/>
                    <ComboBoxItem x:Name="Type_ComboBox_Exchange_Item" Content="Exchange"/>
                    <ComboBoxItem x:Name="Type_ComboBox_Expand_Item" Content="Expenses"/>
                    <ComboBoxItem x:Name="Type_ComboBox_Move_Item" Content="Move"/>
                </ComboBox>
                <Label x:Name="Amount_Label" Grid.Row="2" Grid.Column="1" Style="{DynamicResource statistic_lableStyle}" Content="Amount:" HorizontalContentAlignment="Left" />
                <TextBox x:Name="Amount_txtBox" Style="{DynamicResource FloatingTextBoxStyle}" 
                Grid.Column="2" Grid.Row="2" TabIndex="2" 
                LostFocus="Amount_txtBox_LostFocus" />

                <Label x:Name="ActionDate_Label" Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="Operation date:" HorizontalContentAlignment="Left" Grid.Column="1"  />
                <DatePicker Height="30" x:Name="ActionDate_datepicker" Grid.Row="3" TabIndex="3" 
                        FirstDayOfWeek="Monday" Grid.Column="2" SelectedDateChanged="ActionDate_datepicker_SelectedDateChanged" />

                <Label x:Name="Notes_Label" Grid.Column="1" Grid.Row="4" Style="{DynamicResource statistic_lableStyle}" Content="Description (AR):" HorizontalContentAlignment="Left" />
                <TextBox x:Name="Notes_txtBox"
         Style="{DynamicResource FloatingTextBoxStyle}"
         HorizontalContentAlignment="Right"
         Grid.Column="2"
         Grid.Row="4"
         Grid.ColumnSpan="4"
         Grid.RowSpan="2"
         TabIndex="4"
         Margin="1,1,1,1"
         Height="70"
         AcceptsReturn="True"
         TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto" />
                <Label x:Name="Document_Label" Grid.Column="1" Grid.Row="12" Style="{DynamicResource statistic_lableStyle}" Content="Document:" HorizontalContentAlignment="Left" />

                <Grid Height="30"  Grid.Row="12"  x:Name="Document_panel" Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Style="{StaticResource FloatingComboboxStyle}" x:Name="IsReceipt_comboBox" TabIndex="15"
                                IsEditable="True"
                                    HorizontalContentAlignment="Left" VerticalAlignment="Stretch" SelectionChanged="IsReceipt_comboBox_SelectionChanged" >
                        <ComboBoxItem x:Name="invoice_ComboBoxItem" Content="invoice" />
                        <ComboBoxItem x:Name="receipt_ComboBoxItem" Content="receipt"/>
                        <ComboBoxItem x:Name="payslip_ComboBoxItem" Content="payslip"/>
                    </ComboBox>

                    <TextBox Grid.Column="1" x:Name="ReceiptNum_txtBox" Style="{DynamicResource FloatingTextBoxStyle}" Background="{StaticResource LightGray1}" Tag="Document Number"
                           TabIndex="16" Padding="40,2,2,2" />
                </Grid>




                <Label Grid.Column="1" Grid.Row="13" x:Name="Original_AvgRate_lable" Style="{DynamicResource statistic_lableStyle}" Content="Origin Avg Rate:" HorizontalContentAlignment="Left"  />
                <!--<StackPanel  Grid.Column="5" Grid.Row="7" x:Name="AvgRate_panel" Orientation="Horizontal" >
                <ComboBox x:Name="AvgRate_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" 
                    Height="30" Width="auto" MinWidth="130" FontSize="16"
                    TabIndex="12" Margin="0" VerticalContentAlignment="Center"
                    SelectionChanged="Rate_comboBox_SelectionChanged"  />
                <Button x:Name="Avg_clear_btn" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Width="25" Height="25" BorderBrush="{x:Null}" 
                    Click="Avg_clear_btn_Click" >
                    <Button.Background>
                        <ImageBrush ImageSource="../Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>-->

                <Label Grid.Column="1" Grid.Row="19" x:Name="USD_Value_lable" Style="{DynamicResource statistic_lableStyle}" Content="Value:" HorizontalContentAlignment="Left"  />
                <TextBox x:Name="USD_Value_TxtBox"  IsReadOnly="True" Style="{DynamicResource FloatingTextBoxStyle}" 
                     Grid.Column="2" Grid.Row="19" TabIndex="100" Height="30"  />

                <Label x:Name="Rate_lable" Grid.Column="4" Grid.Row="15" Style="{DynamicResource statistic_lableStyle}" Content="Rate:"  HorizontalContentAlignment="Left"   />
                <TextBox x:Name="Rate_txtBox" Style="{DynamicResource FloatingTextBoxStyle}" 
                Grid.Column="5" Grid.Row="15" TabIndex="19"   
                LostFocus="Rate_txtBox_LostFocus" Height="30"  />

                <Label x:Name="Exchanged_lable" Grid.Column="4" Grid.Row="19" Style="{DynamicResource statistic_lableStyle}" Content="Exchanged:"  HorizontalContentAlignment="Left"   />
                <TextBox x:Name="Exchanged_txtBox" IsReadOnly="True" Style="{DynamicResource FloatingTextBoxStyle}"
                Grid.Column="5" Grid.Row="19" TabIndex="101"   Height="30"  />

                <Button Grid.Row="20" 
                    Style="{DynamicResource ButtonColoredStyle}" Content="Save"
                x:Name="Save_btn" TabIndex="20" Click="Save_btn_Click" Grid.Column="1" />
                <Label Grid.Column="4" Grid.Row="1" Style="{DynamicResource statistic_lableStyle}" Content="Operation type:"  HorizontalContentAlignment="Left"  />

                <Label Grid.Row="17" x:Name="ExchangeAcc_lable" Style="{DynamicResource statistic_lableStyle}" Content="Exchange account:"  Margin="10,0,1,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Grid.Column="1" />
                <Grid Grid.Row="17" Height="30" x:Name="ExchangeAcc_panel" Grid.Column="2" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ExchangeAcc_comboBox" TabIndex="8" Grid.Column="0"
                    DisplayMemberPath="Name" SelectedValuePath="id" Style="{StaticResource FloatingComboboxStyle}"
                     SelectionChanged="ExchangeAcc_comboBox_SelectionChanged"/>
                    <Button Grid.Column="1" x:Name="ExchangeAcc_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}" 
                    Click="ExchangeTill_clear_btn_Click" Margin="5,0,0,0">
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>

                </Grid>
                <Button Grid.Row="17" Grid.Column="3" x:Name="ExchangeAcc_help" ToolTipService.InitialShowDelay="100" Width="25" Height="25" Margin="5,0,0,0" BorderBrush="{x:Null}" HorizontalAlignment="Left">

                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
                    </Button.Background>
                    <Button.ToolTip>
                        <ToolTip Content="The exchange account only appears if it contains a till for both currencies (from/to))"/>
                    </Button.ToolTip>
                </Button>
                <Label Grid.Column="1" Grid.Row="11" x:Name="Line_lable" Style="{DynamicResource statistic_lableStyle}" Content="Budget Line:" Margin="10,0,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Left" />
                <Grid Height="30" Grid.Column="2" Grid.Row="11" x:Name="Line_panel" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="Line_comboBox" TabIndex="14" Style="{StaticResource FloatingComboboxStyle}"
                    DisplayMemberPath="line_Name" SelectedValuePath="budget_line_ID" 
                   
                   />
                    <Button Grid.Column="1" x:Name="Line_comboBox_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}" Click="Line_comboBox_clear_btn_Click" Margin="5,0,0,0" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </Grid>
                <Label Grid.Column="1" Grid.Row="8" x:Name="CashAccount_lable" Style="{DynamicResource statistic_lableStyle}" Content="Cash till:"  HorizontalContentAlignment="Left" />
                <Grid Height="30" Grid.Row="8" x:Name="CashAccount_panel"  Grid.Column="2" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="CashAccount_comboBox" TabIndex="6"
                    DisplayMemberPath="Name" SelectedValuePath="ID" Style="{StaticResource FloatingComboboxStyle}"
                    VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="CashAccount_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}"  Click="CashAccount_clear_btn_Click" Margin="5,0,0,0" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </Grid>
                <Label Grid.Column="1" Grid.Row="10" x:Name="Budget_lable" Style="{DynamicResource statistic_lableStyle}" Content="Budget:" HorizontalContentAlignment="Left" />
                <Grid Grid.Column="2" Height="30" Grid.Row="10" x:Name="Budget_panel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="Budget_comboBox" TabIndex="12" Style="{StaticResource FloatingComboboxStyle}"
                    DisplayMemberPath="budget_Name" SelectedValuePath="budget_ID" 
                     SelectionChanged="Budget_comboBox_SelectionChanged"/>
                    <Button Grid.Column="1" x:Name="Budget_comboBox_clear" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}"  Click="Budget_comboBox_clear_Click" Margin="5,0,0,0" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>

                </Grid>
                <Button Grid.Row="10" Grid.Column="3" x:Name="Budget_help" ToolTipService.InitialShowDelay="100" Margin="5,0,0,0" Width="25" Height="25" BorderBrush="{x:Null}" HorizontalAlignment="Left">

                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
                    </Button.Background>
                    <Button.ToolTip>
                        <ToolTip Content="The budget only appears if Lines have been added to it."/>
                    </Button.ToolTip>
                </Button>
                <Label Grid.Column="4" Grid.Row="10" x:Name="Category_lable" Style="{DynamicResource statistic_lableStyle}" Content="Category:"/>
                <Grid Grid.Row="10" Height="30" x:Name="Category_panel" Grid.Column="5" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="Category_comboBox" TabIndex="13" Style="{StaticResource FloatingComboboxStyle}"
                    DisplayMemberPath="linecategory_Name" SelectedValuePath="linecategory_ID" 
                     SelectionChanged="Category_comboBox_SelectionChanged"/>
                    <Button Grid.Column="1" x:Name="Category_comboBox_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}" Click="Category_comboBox_clear_btn_Click" Margin="5,0,0,0" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </Grid>
                <Grid Grid.Column="2" Grid.Row="13" Height="30" x:Name="Line_panel_Copy">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="Original_AvgRate_comboBox" TabIndex="18"  
            	DisplayMemberPath="Name" SelectedValuePath="ID" Style="{StaticResource FloatingComboboxStyle}"
            	VerticalContentAlignment="Center" SelectionChanged="Original_AvgRate_comboBox_SelectionChanged"/>
                    <Button Grid.Column="1" x:Name="Original_AvgRate_clear_btn" Click="Avgrate_clear_btn_Click" Style="{StaticResource DeleteButtonStyle}" Margin="5,0,0,0">
                    </Button>

                </Grid>
                <Button Grid.Row="13" Grid.Column="3" x:Name="Original_AvgRate_help" Width="25" Height="25" ToolTipService.InitialShowDelay="100" Margin="5,0,0,0" BorderBrush="{x:Null}" HorizontalContentAlignment="Left" HorizontalAlignment="Left">

                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
                    </Button.Background>
                    <Button.ToolTip>
                        <TextBlock>
Avg Rate only appears if it includes the operation date implicitly or if there is a remainder in it.
<LineBreak /> 
In case of having a budget, Avg Rate only appears from the selected budget currency to the local currency (Syr).
                        </TextBlock>
                    </Button.ToolTip>
                </Button>
                <Label Style="{StaticResource NoteStyle}" Grid.Column="2" Grid.Row="20" x:Name="Exchange_Note_lable" Content="Please ensure that there is at least one AvgRate that matches the conversion currency and extends for a period that includes the transaction date."  Grid.ColumnSpan="4" Foreground="{StaticResource HopeRed}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Label x:Name="Attachment_lable" Grid.Column="4" Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="Attachments:"  HorizontalContentAlignment="Left"   />

                <Grid Grid.Row="3" Grid.Column="5" Height="30" x:Name="AddedAttachments_panel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Clear button -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Add button -->
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="AddedAttachments_lable"
             IsReadOnly="True"
             Style="{DynamicResource FloatingTextBoxStyle}"
             Text="Count: 0"
             Grid.Column="0"
             Margin="0,0,0,0" />

                    <Button x:Name="AddedAttachments_clear_btn"
            Grid.Column="1"
            Style="{StaticResource DeleteButtonStyle}"
            Click="AddedAttachments_clear_btn_Click"
            ToolTip="Clear Attachments"
            ToolTipService.InitialShowDelay="100" />

                    <Button x:Name="Add_Attachment_btn"
            Grid.Column="2"
            ToolTip="Add Attachment"
            ToolTipService.InitialShowDelay="100"
            Click="Add_Attachment_btn_Click"
            Style="{StaticResource AddButtonStyle}"
            Height="30"
            Width="25"
            Margin="5,0,0,0">
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Icons/add_attach.png" Stretch="UniformToFill"/>
                        </Button.Background>
                    </Button>

                </Grid>
                <uc:AutoCompleteTextBoxUserControl Grid.Column="5" Style="{StaticResource TextBoxUserControlStyle}"
                x:Name="BeneficiaryName_txtBox" TabIndex="10" Tag="Beneficiary Number"
                LostFocus="BeneficiaryName_autoSuggestionUserControl_LostFocus"  Grid.Row="9" />
                <Grid Height="30" Grid.Row="15" x:Name="Donor_panel"  Grid.Column="2" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="Donor_comboBox" TabIndex="11" Style="{StaticResource FloatingComboboxStyle}"
                    DisplayMemberPath="Name" SelectedValuePath="ID" 
                    SelectionChanged="Donor_comboBox_SelectionChanged"/>
                    <Button Grid.Column="1" x:Name="Donor_comboBox_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}" Click="Donor_comboBox_clear_btn_Click" Margin="5,0,0,0" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </Grid>
                <Label Grid.Column="1" Grid.Row="15" x:Name="Donor_lable" Style="{DynamicResource statistic_lableStyle}" Content="Donor:" Margin="10,0,1,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Label Grid.Column="4" Grid.Row="16" x:Name="ObserveCashAccount_lable" Style="{DynamicResource statistic_lableStyle}" Content="Corresponding cash till:"  Margin="10,0,1,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Grid Grid.Row="16" Height="30" x:Name="ObserveCashAccount_panel" Grid.Column="5" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="ObserveCashAccount_comboBox" TabIndex="7" Style="{StaticResource FloatingComboboxStyle}"
                    DisplayMemberPath="Name" SelectedValuePath="ID" />
                    <Button Grid.Column="1" x:Name="ObserveCashAccount_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center"  Click="ObserveCashAccount_clear_btn_Click" Style="{StaticResource DeleteButtonStyle}" Margin="5,0,0,0">
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </Grid>
                <Label x:Name="E_Notes_Label" Grid.Row="6" Style="{DynamicResource statistic_lableStyle}" Content="Description (Eng):" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Grid.Column="1" />
                <TextBox x:Name="E_Notes_txtBox" Style="{DynamicResource FloatingTextBoxStyle}"  HorizontalContentAlignment="Left" Grid.Row="6" TabIndex="4"  Grid.Column="2" Grid.ColumnSpan="4" Grid.RowSpan="2" AcceptsReturn="True"
TextWrapping="Wrap"
VerticalScrollBarVisibility="Auto" Height="70" Margin="1,1,1,1"/>
                <Label Grid.Column="4" Grid.Row="17" x:Name="ExchangeCash_lable" Style="{DynamicResource statistic_lableStyle}" Content="Exchange cash till:"  Margin="10,0,1,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <Grid Height="30" Grid.Row="17" x:Name="ExchangeAcc_panel_Copy"  Grid.Column="5" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="ExchangeCash_comboBox" TabIndex="8" Style="{DynamicResource  FloatingComboboxStyle}"
                    DisplayMemberPath="Name" SelectedValuePath="ID" />
                    <Button Grid.Column="1" x:Name="ExchangeCash_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}" Click="ExchangeCash_clear_btn_Click" Margin="5,0,0,0" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </Grid>
                <Label Grid.Column="4" Grid.Row="12" x:Name="Employee_lable" Style="{DynamicResource statistic_lableStyle}" Content="Volunteer:" HorizontalContentAlignment="Left" />
                <Grid Height="30" Grid.Row="12" x:Name="Budget_panel_Copy" Grid.Column="5" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="Employee_comboBox" TabIndex="12" Style="{DynamicResource FloatingComboboxStyle}"
                    DisplayMemberPath="Employee_Name" SelectedValuePath="Employee_Salary_ID" />
                    <Button Grid.Column="1" x:Name="Employee_comboBox_clear" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}" Click="Employee_comboBox_clear_Click" Margin="5,0,0,0" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>

                </Grid>
                <Button Grid.Column="6" Grid.Row="12" x:Name="Employee_help" ToolTipService.InitialShowDelay="100" Width="25" Height="25" Margin="5,0,0,0" BorderBrush="{x:Null}">

                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
                    </Button.Background>
                    <Button.ToolTip>
                        <TextBlock><Run Text="Only the volunteer from this center appears, provided that his salary has been added for the month corresponding to the operation date."/></TextBlock>
                    </Button.ToolTip>
                </Button>
                <Label Grid.Row="0" Grid.Column="1" Style="{DynamicResource statistic_lableStyle}" Content="Subproject:" HorizontalContentAlignment="Left"  />
                <ComboBox Grid.Row="0" x:Name="Subproject_comboBox" TabIndex="1" Grid.Column="2" DisplayMemberPath="Subproject_Name" SelectedValuePath="Subproject_ID" 
                Style="{DynamicResource FloatingComboboxStyle}"
                    SelectionChanged="Subproject_comboBox_SelectionChanged" >
                </ComboBox>
                <Label Grid.Row="0" Grid.Column="4" Style="{DynamicResource statistic_lableStyle}" Content="Account:" HorizontalContentAlignment="Left"  />
                <ComboBox Grid.Row="0" Grid.Column="5" x:Name="Account_comboBox" TabIndex="1" Style="{StaticResource FloatingComboboxStyle}"
                DisplayMemberPath="Account_Name" SelectedValuePath="Account_ID" 
                HorizontalContentAlignment="Left" 
                VerticalAlignment="Stretch" SelectionChanged="Account_comboBox_SelectionChanged" >

                </ComboBox>
                <Label Grid.Row="1" Grid.Column="1" Style="{DynamicResource statistic_lableStyle}" Content="Till:" HorizontalContentAlignment="Left" />
                <ComboBox x:Name="Till_comboBox" Grid.Row="1" Grid.Column="2" TabIndex="1"  DisplayMemberPath="Tilltypes_Name" SelectedValuePath="Till_ID" 
              Style="{DynamicResource FloatingComboboxStyle}"
                HorizontalContentAlignment="Left"  SelectionChanged="Till_comboBox_SelectionChanged" >
                </ComboBox>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

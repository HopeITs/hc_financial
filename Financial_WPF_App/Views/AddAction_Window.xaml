            <StackPanel Grid.Row="6" x:Name="ExchangeAcc_panel_Copy" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="2,2,2,2" Grid.Column="1" >
                <ComboBox x:Name="ExchangeCash_comboBox" TabIndex="8" 

            <StackPanel Grid.Row="5" x:Name="ObserveCashAccount_panel" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="2,2,2,2" Grid.Column="1" >
                <ComboBox x:Name="ObserveCashAccount_comboBox" TabIndex="7" 
                    DisplayMemberPath="Name" SelectedValuePath="ID" 
                    FlowDirection="RightToLeft" Height="30" Width="auto" MinWidth="130" FontSize="16"
                    Margin="0,6,0,6.764" VerticalContentAlignment="Center" SelectionChanged="ObserveCashAccount_comboBox_SelectionChanged"/>
                <Button x:Name="ObserveCashAccount_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Width="25" Height="25" BorderBrush="{x:Null}" Margin="0,9,0,8.764" Click="ObserveCashAccount_clear_btn_Click" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            <Label x:Name="E_Notes_Label" Grid.Column="2" Grid.Row="3" Style="{DynamicResource lableStyle}" Content="Description (Eng):" Margin="2,3,2,3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
            <TextBox x:Name="E_Notes_txtBox" Style="{DynamicResource textBoxStyle}"  HorizontalContentAlignment="Right" Grid.Row="3" TabIndex="4" Margin="2,6,2,6" VerticalAlignment="Stretch" Grid.Column="1"   />

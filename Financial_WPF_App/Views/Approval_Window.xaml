<Window 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Financial_WPF_App"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
    x:Class="Financial_WPF_App.Views.Approval_Window"
        mc:Ignorable="d"
        Title="Approval_Window" Height="614" Width="1280"  
    FontFamily="Myriad Arabic"
    FontSize="18" 
    WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="tabItemStyle" TargetType="{x:Type TabItem}" >
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" >
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" >
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" >
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="16" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" >
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" >
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource Color_HopeYellow2}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontFamily" Value="Arial Bold" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" >
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource Color_HopeBlue3}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" >
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource Color_HopeYellow2}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontFamily" Value="Arial Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu Name="cm">
                <MenuItem Header="Refresh All" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <TabControl x:Name="Main_tabControl" Style="{StaticResource TabControlStyle}" ></TabControl>

    </Grid>
</Window>

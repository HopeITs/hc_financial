<Window 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Financial_WPF_App"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
    x:Class="Financial_WPF_App.Views.Approval_Window"
        mc:Ignorable="d"
        Title="Approval_Window" Height="614" Width="1280"  
    FontFamily="Myriad Arabic"
    FontSize="18" 
    WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu Name="cm">
                <MenuItem Header="Refresh All" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <TabControl x:Name="Main_tabControl" Grid.Column="0" Style="{StaticResource TabControlStyle}" />

    </Grid>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.Approval_Sub_Window"
        mc:Ignorable="d"
        Title="Approval_Sub_Window"  Width="1280" Height="620" FontFamily="Myriad Arabic" FontSize="18" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Helper:Approval_CustomRowStyleSelector x:Key="rowStyleSelector" />
        <Helper:Approval_CustomAlternatingRowStyleSelector x:Key="AlternatingrowStyleSelector" />
    </Window.Resources>
    <Grid  Grid.Column="0" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="233*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"/>
                </Border>
            </StackPanel>
        </Border>
        <!--<Border Grid.Row="1" Style="{StaticResource MainBorderWrapPanelStyle}">
            <StackPanel Orientation="Horizontal">
                <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"/>
                </Border>
            </StackPanel>
        </Border>-->
        <Grid Grid.Row="2" Margin="0,5,0,0" Grid.ColumnSpan="2" >
            <DockPanel  LastChildFill="True" Background="{StaticResource LightGray1}" Height="40">
                <WrapPanel Orientation="Horizontal" Width="Auto">
                    <Menu x:Name="ShowHideMenu" Margin="5,2,5,2">
                        <Menu.Resources>
                            <!-- Custom Menu Style -->
                            <Style TargetType="Menu">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Menu">
                                            <Border Background="{TemplateBinding Background}" Padding="0">
                                                <ItemsPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Custom MenuItem Style -->
                            <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
                                <Setter Property="FontFamily" Value="Rubik"/>
                                <Setter Property="FontSize" Value="13.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource DarkGray}"/>
                                <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Grid>
                                                <!-- Main Item -->
                                                <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="10,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <!-- Arrow Column -->
                                                        </Grid.ColumnDefinitions>

                                                        <ContentPresenter Grid.Column="0" 
           HorizontalAlignment="Left" 
           VerticalAlignment="Center" 
           ContentSource="Header"/>

                                                        <!-- Submenu Arrow -->
                                                        <Path x:Name="Arrow"
          Grid.Column="1"
          Data="M 0 0 L 6 4 L 0 8 Z" 
          Fill="{DynamicResource DarkGray}"
          VerticalAlignment="Center"
          Margin="5,0,0,0"
          Visibility="Collapsed"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Submenu Popup -->
                                                <Popup x:Name="Popup"
   Placement="Bottom"
   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
   IsOpen="{TemplateBinding IsSubmenuOpen}"
   AllowsTransparency="True"
   Focusable="False"
   PopupAnimation="Fade">
                                                    <Border Background="White" CornerRadius="5" BorderBrush="{StaticResource LightGray1}" BorderThickness="1">
                                                        <StackPanel>
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>

                                            <!-- Triggers -->
                                            <ControlTemplate.Triggers>
                                                <!-- Show Arrow Only if the MenuItem has sub-items (is a submenu) -->
                                                <Trigger Property="HasItems" Value="True">
                                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                                </Trigger>

                                                <!-- Submenu Hover Effect -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <!--<Setter TargetName="Border" Property="Background" Value="transparent"/>-->
                                                    <!--<Setter Property="Foreground" Value="{DynamicResource LightGray1}"/>-->
                                                </Trigger>

                                                <!-- Submenu Open Effect -->
                                                <Trigger Property="IsSubmenuOpen" Value="True">
                                                    <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
                                                </Trigger>

                                                <!-- Disabled Effect -->
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource MidGray}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </Menu.Resources>
                        <!-- MenuItems with Custom Style -->
                        <MenuItem Width="20" Height="20" StaysOpenOnClick="True" Header=""  Style="{StaticResource CustomMenuItemStyle}" Margin="6,9,0,0" ToolTip="Show/Hide Columns" ToolTipService.InitialShowDelay="100">
                            <MenuItem.Background>
                                <ImageBrush ImageSource="/Images/Buttons/showHide.png" Stretch="Uniform"/>
                            </MenuItem.Background>
                            <!-- Submenu Items (Will Keep Hover Effect) -->
                            <MenuItem StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                            <MenuItem StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                            <MenuItem Background="{StaticResource LightGray1}" Click="ShowAll_MenuItem_Click" Header="ShowAll" Style="{StaticResource CustomMenuItemStyle}"/>
                        </MenuItem>
                    </Menu>
                    <StackPanel x:Name="ExportToExcel_StackPanel" RenderTransformOrigin="0.5,0.5" Width="31">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" Command="local:Commands.ExportToExcel"  Width="30" Height="25" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,10,1,1">
                            <Button.Background>
                                <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png" Stretch="Uniform"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                    <Button  Style="{DynamicResource AddButtonStyle}"
                        x:Name="Restore_btn" FlowDirection="LeftToRight" HorizontalAlignment="Stretch" Grid.Column="1" VerticalAlignment="Stretch" Width="30" Height="22" Click="Restore_btn_Click" ToolTip="Restore" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,10,1,1">
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/restore.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </WrapPanel>
                <StackPanel x:Name="Panel1" Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,5,0">
                    <RadioButton Style="{StaticResource RadioButtonStyle}" x:Name="DeletedActions_RadioButton" Content="Show Deleted Actions" IsChecked="False" Margin="112,6,3,8" Grid.Column="2" Tag="False" Click="DeletedActions_RadioButton_Click"/>
                    <TextBox Style="{DynamicResource TextBoxActionStyle}" TextChanged="Search_txtBox_TextChanged" x:Name="Search_txtBox" TextWrapping="Wrap" TabIndex="10"/>
                </StackPanel>
                <StackPanel x:Name="Filter_StackPanel" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">

                    <Label x:Name="Period_Label" Style="{DynamicResource statistic_lableStyle}" Content="Month:" Margin="8,2,1,2" VerticalAlignment="Center" HorizontalContentAlignment="Right"/>
                    <ComboBox Style="{DynamicResource ActionComboboxStyle}" x:Name="Period_comboBox" TabIndex="17"
                              ToolTip="Tick the months to show, or Select All. Nothing ticked uses the dates instead."
                              ToolTipService.InitialShowDelay="100"
                              IsEditable="True" IsReadOnly="True"
                              Margin="3,0,2,0" VerticalAlignment="Center" Width="110" Height="30">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Width="200"
                                          Click="Period_Checkbox_Item_Clicked"
                                          Style="{DynamicResource CheckBoxStyle}"
                                          Content="{Binding Display}"
                                          IsChecked="{Binding Check_Status}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- The grey behind the X is baked into delete.png, so no Background
                         setting could show through it. DeleteButtonWhiteStyle is the same
                         button drawn from a white-backed copy of the icon. -->
                    <Button Style="{DynamicResource DeleteButtonWhiteStyle}"
                            x:Name="Period_clear_btn" TabIndex="18" Click="Period_clear_btn_Click"
                            ToolTip="Clear the months" ToolTipService.InitialShowDelay="100"
                            Width="25" Height="30"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>

                    <Label x:Name="From_Label" Style="{DynamicResource statistic_lableStyle}" Content="From:" Margin="10,2,1,2" VerticalAlignment="Center" HorizontalContentAlignment="Right"/>
                    <DatePicker Style="{StaticResource DatePickerActionBar}" x:Name="FromDate_datepicker" Margin="3,0,2,0" VerticalAlignment="Center" Width="105" Height="30"
                                SelectedDateChanged="Date_Changed"/>

                    <Label x:Name="To_Label" Style="{DynamicResource statistic_lableStyle}" Content="To:" Margin="8,2,1,2" VerticalAlignment="Center" HorizontalContentAlignment="Right"/>
                    <DatePicker Style="{StaticResource DatePickerActionBar}" x:Name="ToDate_datepicker" Margin="3,0,2,0" VerticalAlignment="Center" Width="105" Height="30"
                                SelectedDateChanged="Date_Changed"/>

                    <Button ToolTip="Show the selected period" ToolTipService.InitialShowDelay="100"
                            Style="{DynamicResource AddButtonStyle}"
                            x:Name="Go_btn" TabIndex="20" Click="Go_btn_Click" Margin="8,0,0,0" VerticalAlignment="Center" Height="25" Width="50">
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/apply.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>
        <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="1"                                            
         Style="{DynamicResource SfDataGrid_body}"
                         HeaderStyle="{DynamicResource SfDataGrid_header}"
                         RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                         AlternatingRowStyleSelector="{StaticResource AlternatingrowStyleSelector}"
                         RowStyleSelector="{StaticResource rowStyleSelector}"                    
                Loaded="myDataGrid_Loaded" SelectionChanged="myDataGrid_SelectionChanged"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                Grid.Row="3" FilterChanged="myDataGrid_FilterChanged" CurrentCellValueChanged="myDataGrid_CurrentCellValueChanged" Margin="2,5,5,5" >

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridCheckBoxColumn x:Name="Selected_DataGridColumn" HeaderText="Select" MappingName="IsSelected" AllowEditing="True" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridCheckBoxColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="chkHeader" Loaded="chkHeader_Loaded" Click="chkHeader_Click"/>
                        </DataTemplate>
                    </syncfusion:GridCheckBoxColumn.HeaderTemplate>
                    <syncfusion:GridCheckBoxColumn.CellStyle>
                        <Style>
                            <Style.Resources>
                                <Style TargetType="CheckBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="1">
                                            <Setter Property="Background" Value="{StaticResource LightGray1}" />
                                            <Setter Property="FlowDirection" Value="LeftToRight" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsSelected}" Value="0">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Style.Resources>
                        </Style>
                    </syncfusion:GridCheckBoxColumn.CellStyle>
                </syncfusion:GridCheckBoxColumn>

                <syncfusion:GridTextColumn x:Name="Subproject_DataGridColumn" MappingName="Subproject_Name" HeaderText="Project"/>
                <syncfusion:GridTextColumn x:Name="Account_DataGridColumn" MappingName="Account_Name" HeaderText="Account"/>

                <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" MappingName="ID" HeaderText="Operation ID"/>
                <syncfusion:GridNumericColumn  x:Name="Income_DataGridColumn" HeaderText="Income"  MappingName="Income" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  x:Name="Incomeusd_DataGridColumn" HeaderText="Income(USD)"  MappingName="Incomeusd" 
                       NumberDecimalDigits="2"
                       NumberDecimalSeparator="."
                       NumberGroupSizes="3" 
                       NumberGroupSeparator=","/>
                <!--<syncfusion:GridNumericColumn  x:Name="Outcome_DataGridColumn" HeaderText="Adv. Payment"  MappingName="Outcome"
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  x:Name="Returned_DataGridColumn" HeaderText="Returned"  MappingName="Returned" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>-->
                <syncfusion:GridNumericColumn  x:Name="Exchange_DataGridColumn" HeaderText="Exchange"  MappingName="Exchange" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  x:Name="Expand_DataGridColumn" HeaderText="Expenses"  MappingName="Expand"
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  x:Name="Expandusd_DataGridColumn" HeaderText="Expenses(USD)"  MappingName="Expandusd"
                       NumberDecimalDigits="2"
                       NumberDecimalSeparator="."
                       NumberGroupSizes="3" 
                       NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  x:Name="Transfer_DataGridColumn" HeaderText="Transfer"  MappingName="Outcome"
                       NumberDecimalDigits="2"
                       NumberDecimalSeparator="."
                       NumberGroupSizes="3" 
                       NumberGroupSeparator=","/>
                <syncfusion:GridTextColumn   x:Name="Currency_DataGridColumn" HeaderText="Currency"  MappingName="Currency"/>
                <syncfusion:GridDateTimeColumn x:Name="Action_DataGridColumn" HeaderText="Operation Date" MappingName="ActionDate"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                <syncfusion:GridTextColumn x:Name="ActionMonth_DataGridColumn" MappingName="ActionMonth" HeaderText="Operation Month"/>
                <syncfusion:GridTextColumn x:Name="ActionYear_DataGridColumn" MappingName="ActionYear" HeaderText="Operation Year"/>

                <syncfusion:GridTextColumn x:Name="MicroProject_ID_DataGridColumn" HeaderText="Micro project number"  MappingName="MicroProject_ID" />
                <syncfusion:GridTextColumn x:Name="Name_DataGridColumn" HeaderText="Beneficiary name"  MappingName="Name" />

                <syncfusion:GridTextColumn x:Name="Budget_DataGridColumn" HeaderText="Budget"  MappingName="Budget" />
                <syncfusion:GridTextColumn x:Name="Line_DataGridColumn" HeaderText="Line"  MappingName="Line" />

                <syncfusion:GridTextColumn x:Name="Donor_DataGridColumn" HeaderText="Donor"  MappingName="Donor" />

                <syncfusion:GridTextColumn x:Name="IsReceipt_DataGridColumn" HeaderText="Document type"  MappingName="IsReceipt"  />
                <syncfusion:GridTextColumn x:Name="ReceiptNote_DataGridColumn" HeaderText="Document number"  MappingName="ReceiptNote"  />
                <syncfusion:GridTextColumn x:Name="Employee_DataGridColumn" HeaderText="Volunteer"  MappingName="Employee_Name"  />

                <syncfusion:GridNumericColumn x:Name="Rate_DataGridColumn" HeaderText="Rate" MappingName="Rate"
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn x:Name="Exchanged_DataGridColumn" HeaderText="Exchanged" MappingName="Exchanged"     
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>

                <syncfusion:GridTextColumn x:Name="Note_DataGridColumn" HeaderText="Description (Eng)"  MappingName="Note"  />
                <syncfusion:GridTextColumn x:Name="E_Note_DataGridColumn" HeaderText="Description (AR)"  MappingName="E_Note"  />
                <syncfusion:GridTextColumn x:Name="AvgRateName_DataGridColumn" HeaderText="Original Avg Rate group"  MappingName="AvgRateName"  />
                <syncfusion:GridNumericColumn x:Name="AvgRate_DataGridColumn" HeaderText="Original Avg Rate amount" MappingName="AvgRateValue"
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn x:Name="USD_Value_DataGridColumn" HeaderText="Value" MappingName="USD_Value" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                <syncfusion:GridTextColumn x:Name="CashAccount_DataGridColumn" HeaderText="Cash till"  MappingName="CashAccount" />
                <syncfusion:GridTextColumn x:Name="Rate_ID_DataGridColumn" HeaderText="Rate_ID" MappingName="Rate_ID" 
                        IsHidden="True" />
                <syncfusion:GridTextColumn x:Name="Till_ID_DataGridColumn" HeaderText="Till_ID" MappingName="Till_ID" 
                        IsHidden="True" />
                <syncfusion:GridTextColumn x:Name="ObserveTill_ID_DataGridColumn" HeaderText="ObserveTill_ID" MappingName="ObserveTill_ID" 
                        IsHidden="True" />
                <syncfusion:GridTextColumn x:Name="ObserveAccount_DataGridColumn" HeaderText="Corresponding account" MappingName="ObserveAccount"/>
                <syncfusion:GridTextColumn x:Name="ObserveTill_DataGridColumn" HeaderText="Corresponding till" MappingName="ObserveTill" />
                <syncfusion:GridTextColumn x:Name="ObserveAcctionID_DataGridColumn" HeaderText="Corresponding Operation ID" MappingName="ObserveAcion_ID" />

                <syncfusion:GridTextColumn x:Name="ObserveCashAccount_DataGridColumn" HeaderText="Corresponding cash till"  MappingName="ObserveCashAccount" />
                <syncfusion:GridTextColumn x:Name="ExAccount_DataGridColumn" HeaderText="Exchange account" MappingName="ExchangeAcc_Name"/>
                <syncfusion:GridTextColumn x:Name="ExCashAccount_DataGridColumn" HeaderText="Exchange cash till" MappingName="Exchange_Cash_Name"/>

                <syncfusion:GridTextColumn x:Name="Created_by_DataGridColumn" MappingName="created_by" HeaderText="Created By"/>
                <syncfusion:GridDateTimeColumn x:Name="created_at_DataGridColumn" HeaderText="Date Created" MappingName="created_at" 
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"  />
                <syncfusion:GridTextColumn x:Name="Edited_by_DataGridColumn" MappingName="edited_by" HeaderText="Edited By"/>

                <syncfusion:GridDateTimeColumn x:Name="updated_at_DataGridColumn" HeaderText="Modification Date" MappingName="updated_at"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />

                <syncfusion:GridTextColumn x:Name="Deleted_by_DataGridColumn" MappingName="deleted_by" HeaderText="Deleted By"/>

                <syncfusion:GridDateTimeColumn x:Name="Deleted_at_DataGridColumn" HeaderText="Date Deleted" MappingName="deleted_at"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />

                <syncfusion:GridTextColumn x:Name="Attachments_Count_DataGridColumn" MappingName="Attachments_count" HeaderText="Attachments Count"/>

                <syncfusion:GridTemplateColumn x:Name="Attachment_DataGridColumn" MappingName =" " HeaderText="Attachment" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Attachment_Style}" Click="Attachment_Button_Click"/>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
        <Grid Grid.Row="4" VerticalAlignment="Center">
            <Button   Style="{DynamicResource ButtonColoredStyle}"
                x:Name="Save_btn" Content="Approve" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="175" />
            <Label x:Name="Exchange_Note_lable" Style="{DynamicResource NoteStyle}" Content="Red-highlighted row refers to an edited action."/>
        </Grid>
    </Grid>
</Window>




using Financial_WPF_App.Models;
using Financial_WPF_App.Views;
using System;
using System.Collections.Generic;
using System.Data;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Input;
using System.Windows.Media;

namespace Financial_WPF_App
{
    public partial class Account_Window : Window
    {

        public Account_Window(string Category_ID, string Project_ID, string SubProject_ID)
        {
            InitializeComponent();

            OnLoad();

            this.Acc_ID = -1;
            if (Category_ID != "")
            {
                this.Category_ID = Convert.ToInt32(Category_ID);
            }

            this.Project_ID = Convert.ToInt32(Project_ID);
            Project_comboBox.SelectedValue = this.Project_ID;
            Project_comboBox_SelectionChanged(Project_comboBox, null);

            if (SubProject_ID != "")
            {
                this.SubProject_ID = Convert.ToInt32(SubProject_ID);
                SubProject_comboBox.SelectedValue = this.SubProject_ID;
            }
            else this.SubProject_ID = -1;

            UserMode = false;
            BeginDate_datepicker.Text = BeginDate_datepicker.DisplayDate.ToString("yyyy/MM/dd");

            EndDate_CheckBox.IsChecked = true;
            EndDate_datepicker.IsEnabled = false;
            EndDate_datepicker.Text = "";
            UserMode = true;

            tabControl1.Visibility = Visibility.Hidden; //Create New//
        }


        public Account_Window(DataRowView dataRow)
        {
            InitializeComponent();
            this.Acc_ID = -1;
            this.SubProject_ID = -1;
            this.dataRow = dataRow;
            OnLoad();
            tabControl1.Visibility = Visibility.Visible; //Update// 

            myExpander.IsExpanded = false;

            Fill_Account(dataRow);
            Fill_Account_Tabs("", "");
            tabControl1.SelectedIndex = 0;
        }


        public Account_Window(int Account_ID)
        {
            InitializeComponent();
            this.Acc_ID = Account_ID;
            this.Project_ID = -1;
            this.SubProject_ID = -1;
            OnLoad();

            tabControl1.Visibility = Visibility.Visible; //Update//

            myExpander.IsExpanded = false;

            Fill_Account(Acc_ID);
            Fill_Account_Tabs("", "");
            tabControl1.SelectedIndex = 0;
        }

        private int Acc_ID;
        private int Category_ID, Project_ID, SubProject_ID, Donor_ID;
        private Project p;
        private SubProject sub;
        private Account a;
        private Till t; SubProject_Donor sd;
        private Log l;
        private DataRowView dataRow;
        private DataTable dt, t_dt, sub_dt, donor_dt, p_dt, Amount_dt;
        int IsClosed = 0;
        bool UserMode;

        private void OnLoad()
        {
            try
            {
                p = new Project();
                sub = new SubProject();
                a = new Account();
                l = new Log();
                t = new Till();
                sd = new SubProject_Donor();

                LoadProjectComboBox();
                LoadSubProjectComboBox();
                LoadDonorComboBox();
                LoadAmountTypecomboBox();


            }
            catch (Exception ex)
            { MessageBox.Show(ex.Message); }
        }

        private void Fill_Account(DataRowView dataRow)
        {
            try
            {
                UserMode = false;
                Acc_ID = Convert.ToInt32(dataRow["ID"].ToString());

                Project_ID = Convert.ToInt32(dataRow["Project_ID"].ToString());
                SubProject_ID = Convert.ToInt32(dataRow["SubProject_ID"].ToString());

                if (dataRow["Donor_ID"] != DBNull.Value)
                    Donor_ID = Convert.ToInt32(dataRow["Donor_ID"].ToString());

                Project_comboBox.SelectedValue = Project_ID;
                Project_comboBox_SelectionChanged(Project_comboBox, null);
                SubProject_comboBox.SelectedValue = SubProject_ID;
                SubProject_comboBox_SelectionChanged(Project_comboBox, null);
                Donor_comboBox.SelectedValue = Donor_ID;

                Name_txtBox.Text = dataRow["Name"].ToString();
                ProjectNumber_txtBox.Text = dataRow["ProjectNumber"].ToString();
                BeginDate_datepicker.SelectedDate = Convert.ToDateTime(dataRow["BeginDate"].ToString());
                if (dataRow["EndDate"].ToString() != "0")
                {
                    EndDate_datepicker.SelectedDate = Convert.ToDateTime(dataRow["EndDate"].ToString());
                    EndDate_CheckBox.IsChecked = false;
                }
                else
                {
                    EndDate_CheckBox.IsChecked = true;
                    EndDate_datepicker.IsEnabled = false;
                    EndDate_datepicker.Text = "";
                }

                if (dataRow["TotalAmount"] != DBNull.Value) TotalAmount_txtBox.Text = dataRow["TotalAmount"].ToString();

                if (dataRow["AmountType_ID"] != DBNull.Value) AmountType_comboBox.SelectedValue = dataRow["AmountType_ID"].ToString();

                string isclosed = dataRow["IsClosed"].ToString();

                if (isclosed == "Open")
                {
                    IsClosed_btn.Content = isclosed;
                    SolidColorBrush brush2 = (SolidColorBrush)App.Current.Resources["HopeBlue4"];
                    IsClosed_btn.Foreground = brush2;
                    IsClosed = 0;
                }
                else if (isclosed == "CLOSED")
                {
                    IsClosed_btn.Content = isclosed;
                    SolidColorBrush brush2 = (SolidColorBrush)App.Current.Resources["HopeRed2"];
                    IsClosed_btn.Foreground = brush2;
                    IsClosed = 1;
                }
                UserMode = true;
            }
            catch (Exception ex)
            { MessageBox.Show(ex.Message); }
        }

        private void Fill_Account(int Account_ID)
        {
            try
            {
                dt = new DataTable();
                dt = a.Select("", Account_ID.ToString(), false);
                if (dt.Rows.Count > 0)
                {
                    for (int i = 0; i < dt.Rows.Count; i++)
                    {
                        Project_ID = dt.Rows[i].Field<int>("Project_ID");
                        SubProject_ID = dt.Rows[i].Field<int>("SubProject_ID");
                        if (dt.Rows[i]["Donor_ID"] != DBNull.Value)
                            Donor_ID = dt.Rows[i].Field<int>("Donor_ID");

                        Project_comboBox.SelectedValue = Project_ID;
                        Project_comboBox_SelectionChanged(Project_comboBox, null);
                        SubProject_comboBox.SelectedValue = SubProject_ID;
                        SubProject_comboBox_SelectionChanged(Project_comboBox, null);
                        Donor_comboBox.SelectedValue = Donor_ID;

                        Name_txtBox.Text = dt.Rows[i].Field<string>("Name").ToString();
                        ProjectNumber_txtBox.Text = dt.Rows[i].Field<string>("ProjectNumber").ToString();
                        BeginDate_datepicker.SelectedDate = dt.Rows[i].Field<DateTime>("BeginDate");


                        if (dt.Rows[i].Field<object>("EndDate").ToString() != "0")
                        {
                            EndDate_datepicker.SelectedDate = dt.Rows[i].Field<DateTime>("EndDate");
                            EndDate_CheckBox.IsChecked = false;
                        }
                        else EndDate_CheckBox.IsChecked = true;

                        if (dt.Rows[i].Field<object>("TotalAmount") != null)
                            TotalAmount_txtBox.Text = dt.Rows[i].Field<Double>("TotalAmount").ToString();

                        if (dataRow["AmountType_ID"] != DBNull.Value) AmountType_comboBox.SelectedValue = dataRow["AmountType_ID"].ToString();

                        IsClosed = dt.Rows[i].Field<int>("IsClosed");
                        if (IsClosed == 0)
                        {
                            IsClosed_btn.Content = "Open";
                            SolidColorBrush brush2 = (SolidColorBrush)App.Current.Resources["HopeBlue4"];
                            IsClosed_btn.Foreground = brush2;
                        }
                        else if (IsClosed == 1)
                        {
                            IsClosed_btn.Content = "CLOSED";
                            SolidColorBrush brush2 = (SolidColorBrush)App.Current.Resources["HopeRed2"];
                            IsClosed_btn.Foreground = brush2;
                        }
                    }
                }
            }
            catch (Exception ex)
            { MessageBox.Show(ex.Message); }
        }

        public void Fill_Account_Tabs(string till_ID, string type)
        {

            //Select Till IDs for this Account//
            if (Login.BuildConnection())
            {
                if (till_ID == "" && type == "")
                {
                    t_dt = new DataTable();
                    t_dt = t.Select(Acc_ID.ToString(), "");
                    if (t_dt.Rows.Count > 0)
                    {
                        for (int i = 0; i < t_dt.Rows.Count; i++)
                        {
                            int Till_ID = t_dt.Rows[i].Field<int>(0);
                            Till_Window till_Window = new Till_Window(Acc_ID, Till_ID, t_dt.Rows[i].Field<string>(1).ToString(), this);
                            if (t_dt.Rows[i].Field<string>(1) == "usd")
                            {
                                usd_tab.Content = null;
                                usd_tab.Content = till_Window.Content;
                            }
                            else if (t_dt.Rows[i].Field<string>(1) == "eur")
                            {
                                eur_tab.Content = null;
                                eur_tab.Content = till_Window.Content;
                            }
                            else if (t_dt.Rows[i].Field<string>(1) == "syr")
                            {
                                syr_tab.Content = null;
                                syr_tab.Content = till_Window.Content;
                            }
                        }
                    }
                }
                else
                {
                    Till_Window till_Window = new Till_Window(Acc_ID, Convert.ToInt32(till_ID), type, this);
                    if (type == "usd")
                    {
                        usd_tab.Content = null;
                        usd_tab.Content = till_Window.Content;
                    }
                    else if (type == "eur")
                    {
                        eur_tab.Content = null;
                        eur_tab.Content = till_Window.Content;
                    }
                    else if (type == "syr")
                    {
                        syr_tab.Content = null;
                        syr_tab.Content = till_Window.Content;
                    }
                }
            }

            Rate_Window rate_Window = new Rate_Window(Acc_ID);
            rate_tab.Content = rate_Window.Content;

            Account_Beneficiaries_Window account_Beneficiaries_Window = new Account_Beneficiaries_Window(Acc_ID);
            ben_tab.Content = account_Beneficiaries_Window.Content;
        }

        private void LoadProjectComboBox()
        {
            if (Login.BuildConnection())
            {
                p_dt = p.Select("", "", "");
                if (p_dt.Rows.Count > 0)
                {
                    Project_comboBox.ItemsSource = p_dt.DefaultView;
                }
            }
        }

        private void LoadAmountTypecomboBox()
        {
            if (Login.BuildConnection())
            {
                Amount_dt = a.Select_AmountType();
                if (Amount_dt.Rows.Count > 0)
                {
                    AmountType_comboBox.ItemsSource = Amount_dt.DefaultView;
                }
            }
        }

        private void LoadSubProjectComboBox()
        {
            if (Login.BuildConnection())
            {
                sub_dt = sub.Select("", "", "", "");
                if (sub_dt.Rows.Count > 0)
                {
                    SubProject_comboBox.ItemsSource = sub_dt.DefaultView;
                }
            }
        }

        private void LoadDonorComboBox()
        {
            if (Login.BuildConnection())
            {
                donor_dt = sd.Select("", "");
                if (donor_dt.Rows.Count > 0)
                {
                    Donor_comboBox.ItemsSource = donor_dt.DefaultView;
                }
            }
        }

        private void Project_comboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                if (Project_comboBox.SelectedValue != null)
                {
                    SubProject_comboBox.ItemsSource = null;

                    int project_id = Convert.ToInt32(Project_comboBox.SelectedValue);

                    DataRow[] rows = sub_dt.Select("Project_ID=" + project_id);
                    DataTable selected_dt = new DataTable();
                    if (rows.Length != 0)
                    {
                        selected_dt = rows.CopyToDataTable();
                        if (selected_dt.Rows.Count > 0)
                            SubProject_comboBox.ItemsSource = selected_dt.DefaultView;
                    }
                }
                Donor_comboBox.SelectedIndex = -1;
                Donor_comboBox.ItemsSource = null;
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void Project_clear_btn_Click(object sender, RoutedEventArgs e)
        {
            Project_comboBox.SelectedIndex = -1;

            SubProject_comboBox.SelectedIndex = -1;
            SubProject_comboBox.ItemsSource = null;
        }
        private void SubProject_clear_btn_Click(object sender, RoutedEventArgs e)
        {
            SubProject_comboBox.SelectedIndex = -1;

            Donor_comboBox.SelectedIndex = -1;
            Donor_comboBox.ItemsSource = null;
        }
        private void Donor_clear_btn_Click(object sender, RoutedEventArgs e)
        {
            Donor_comboBox.SelectedIndex = -1;
        }

        private void SubProject_comboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                if (SubProject_comboBox.SelectedIndex != -1)
                {
                    Donor_comboBox.ItemsSource = null;
                    int sub_project_id = Convert.ToInt32(SubProject_comboBox.SelectedValue);
                    DataRow[] rows = donor_dt.Select("SubProject_ID=" + sub_project_id);
                    DataTable selected_dt = new DataTable();
                    if (rows.Length != 0)
                    {
                        selected_dt = rows.CopyToDataTable();
                        if (selected_dt.Rows.Count > 0)
                            Donor_comboBox.ItemsSource = selected_dt.DefaultView;
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void TotalAmount_txtBox_LostFocus(object sender, RoutedEventArgs e)
        {
            if (TotalAmount_txtBox.Text != "")
            {
                TotalAmount_txtBox.Text = Login.ConvertToDouble(TotalAmount_txtBox.Text);
            }
        }


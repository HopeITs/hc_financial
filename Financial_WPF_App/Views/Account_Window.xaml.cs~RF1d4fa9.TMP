        private void Save_btn_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                if (Name_txtBox.Text == "" || Project_comboBox.SelectedIndex == -1 || SubProject_comboBox.SelectedIndex == -1)
                    throw new Exception("يوجد خلايا فارغة ! الرجاء التأكد قبل عملية الحفظ وإعادة المحاولة.");

                if (Login.BuildConnection())
                {
                    string Name = Login.ReplaceQuotation(Name_txtBox.Text);

                    Project_ID = Convert.ToInt32(Project_comboBox.SelectedValue);
                    SubProject_ID = Convert.ToInt32(SubProject_comboBox.SelectedValue);

                    if (Donor_comboBox.SelectedIndex != -1)
                        Donor_ID = Convert.ToInt32(Donor_comboBox.SelectedValue);
                    else
                        Donor_ID = -1;

                    string ProjectNumber = Login.ReplaceQuotation(ProjectNumber_txtBox.Text);
                    string beginDate = BeginDate_datepicker.DisplayDate.ToString("yyyy/MM/dd");
                    string endDate = "";
                    if (EndDate_CheckBox.IsChecked == true) //&& EndDate_datepicker.IsEnabled == false
                        endDate = "NULL";
                    else endDate = EndDate_datepicker.DisplayDate.ToString("yyyy/MM/dd");
                    string text = TotalAmount_txtBox.Text.Replace(",", "");
                    float totalAmount = (text == "" ? 0 : float.Parse(text));

                    int amountType_ID;
                    if (AmountType_comboBox.SelectedIndex != -1)
                        amountType_ID = Convert.ToInt32(AmountType_comboBox.SelectedValue);
                    else
                        amountType_ID = -1;


                    if (Acc_ID != -1)//Edit
                    {
                        a.Update(Acc_ID, Name, ProjectNumber, beginDate, endDate, totalAmount, amountType_ID, IsClosed, SubProject_ID, Donor_ID);
                        l.Insert("Update", "Account", Name, Acc_ID.ToString(), Properties.Settings.Default.username, DateTime.Now);
                    }
                    else//Add new
                    {
                        List<string> Auto_Tills = new List<string>();

                        //Create Tills accourding to account type
                        switch (Category_ID)
                        {
                            case 1: //Admin
                            { }
                            break;
                            case 2: //Cash
                            { }
                            break;
                            case 3: //مشاريع
                            case 6: //شبيبة
                            {
                                Auto_Tills.Add("syr");
                                Auto_Tills.Add("usd");
                                Auto_Tills.Add("eur");
                            }
                            break;
                            case 4: //معونة
                            { }
                            break;
                            case 5: //كنائس
                            { }
                            break;
                            case 7: //شخصي
                            { }
                            break;
                        }

                        Acc_ID = a.Insert(Name, ProjectNumber, beginDate, endDate, totalAmount, amountType_ID, IsClosed, SubProject_ID, Donor_ID, Auto_Tills);
                        l.Insert("Insert", "Account", Name, "", Properties.Settings.Default.username, DateTime.Now);

                        tabControl1.Visibility = Visibility.Visible; //Update//

                        Fill_Account_Tabs("", "");
                    }
                }
            }
            catch (Exception ex)
            {
                if (Login.MyConn != null && Login.MyConn.State == ConnectionState.Open)
                {
                    Login.MyConn.Close();
                }
                MessageBox.Show(ex.Message);
            }
        }

        private void EndDate_CheckBox_Checked(object sender, RoutedEventArgs e)
        {
            if (UserMode)
            {
                EndDate_datepicker.IsEnabled = false;
                EndDate_datepicker.Text = "";
            }
        }

        private void EndDate_CheckBox_Unchecked(object sender, RoutedEventArgs e)
        {
            if (UserMode)
            {
                EndDate_datepicker.IsEnabled = true;
                EndDate_datepicker.SelectedDate = DateTime.Now;
            }

        }

        private void ScrollViewer_PreviewMouseWheel(object sender, MouseWheelEventArgs e)
        {
            ScrollViewer scrollViewer = (ScrollViewer)sender;
            if (Keyboard.IsKeyDown(System.Windows.Input.Key.LeftShift) || Keyboard.IsKeyDown(System.Windows.Input.Key.RightShift))
            {
                if (e.Delta < 0)
                {
                    scrollViewer.LineLeft();
                }
                else
                {
                    scrollViewer.LineRight();
                }
            }
            else
            {
                if (e.Delta < 0)
                {
                    scrollViewer.LineDown();
                }
                else
                {
                    scrollViewer.LineUp();
                }
            }
            e.Handled = true;
        }

        private void myExpander_Expanded(object sender, RoutedEventArgs e)
        {
            First_col.Width = new GridLength(70, GridUnitType.Star);
            Second_col.Width = new GridLength(30, GridUnitType.Star);
        }

        private void myExpander_Collapsed(object sender, RoutedEventArgs e)
        {
            First_col.Width = new GridLength(95, GridUnitType.Star);
            Second_col.Width = new GridLength(5, GridUnitType.Star);
        }

        private void IsClosed_btn_Click(object sender, RoutedEventArgs e)
        {
            if (IsClosed_btn.Content == "Open")
            {
                IsClosed_btn.Content = "CLOSED";
                SolidColorBrush brush2 = (SolidColorBrush)App.Current.Resources["HopeRed2"];
                IsClosed_btn.Foreground = brush2;
                IsClosed = 1;
            }
            else
            {
                IsClosed_btn.Content = "Open";
                SolidColorBrush brush2 = (SolidColorBrush)App.Current.Resources["HopeBlue4"];
                IsClosed_btn.Foreground = brush2;
                IsClosed = 0;
            }
        }
    }
}

using Financial_WPF_App.Models;
using System;
using System.Data;
using System.Linq;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Input;

namespace Financial_WPF_App.Views
{
    /// <summary>
    /// Interaction logic for FiscalBond_Window.xaml
    /// </summary>
    public partial class FiscalBond_Window : Window
    {
        public FiscalBond_Window(Main_Window_2 main_Window)
        {
            InitializeComponent();
            this.main_Window = main_Window;
            Load_Form();
        }

        Main_Window_2 main_Window;
        private int ID;
        private FiscalBond fb;
        private SubProject sub;
        private Account a;
        private Till t;
        private Log l;
        private DataRowView dataRow;
        private DataTable dt, a_dt, sub_dt;

        private void Load_Form()
        {
            sub = new SubProject();
            a = new Account();
            t = new Till();
            fb = new FiscalBond();
            l = new Log();
            dt = sub_dt = a_dt = new DataTable();

            ID = -1;

            Date_datepicker.SelectedDate = DateTime.Today;
            LoadAccountComboBox("");
            LoadSubProjectComboBox();

            LoadGrid();
        }

        private void LoadGrid()
        {
            try
            {
                if (Login.BuildConnection())
                {
                    dt = fb.Select("", "", "", true);
                    if (dt.Rows.Count > 0)
                    {
                        myDataGrid.ItemsSource = dt.DefaultView;
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void Fill_FiscalBond(DataRowView dataRow)
        {
            try
            {
                ID = Convert.ToInt32(dataRow["ID"].ToString());
                Name_txtBox.Text = dataRow["Name"].ToString();
                Date_datepicker.SelectedDate = Convert.ToDateTime(dataRow["Date"].ToString());
                Notes_txtBox.Text = dataRow["Notes"].ToString();
                if (dataRow["SubProject_ID"] != DBNull.Value)
                    SubProject_comboBox.SelectedValue = Convert.ToInt32(dataRow["SubProject_ID"]);

                if (dataRow["Account_ID"] != DBNull.Value)
                    Account_comboBox.SelectedValue = Convert.ToInt32(dataRow["Account_ID"]);

            }
            catch (Exception ex)
            { MessageBox.Show(ex.Message); }
        }

        private void AddActionFiscalBond_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                DataRowView dataRow = (DataRowView)myDataGrid.SelectedItem;
                ID = Convert.ToInt32(dataRow[0].ToString());
                string Name = dataRow[1].ToString();

                All_ActionFiscalBond_Window window = new All_ActionFiscalBond_Window(ID, Name);
                main_Window.Create_dragablz_tabItem(window, "سند جديد");
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void EditButton_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                DataRowView dataRow = (DataRowView)myDataGrid.SelectedItem;
                Fill_FiscalBond(dataRow);
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void DeleteButton_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var dialogResult = MessageBox.Show("هل أنت متأكدأنك تريد حذف هذه البيانات؟", "Confirm before save", MessageBoxButton.YesNo);
                if (dialogResult == MessageBoxResult.Yes)
                {
                    DataRowView dataRow = (DataRowView)myDataGrid.SelectedItem;
                    ID = Convert.ToInt32(dataRow[0].ToString());
                    string Name = dataRow[1].ToString();
                    fb.Delete(ID);
                    l.Insert("Delete", "Fiscal Bond", Name, ID.ToString(), Properties.Settings.Default.username, DateTime.Now);
                    ID = -1;

                    LoadGrid();
                    //myDataGrid.Items.RemoveAt(myDataGrid.SelectedIndex); 
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void FiscalBond_KeyDown(object sender, KeyEventArgs e)
        {
            if (e.Key == Key.Return)
            {
                Save_btn_Click(sender, e);
            }
        }

        private void FiscalBond_Closing(object sender, System.ComponentModel.CancelEventArgs e)
        {

        }

        private void Save_btn_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                if (Name_txtBox.Text == "" || Account_comboBox.SelectedIndex == -1)
                    throw new Exception("يوجد خلايا فارغة ! الرجاء التأكد قبل عملية الحفظ وإعادة المحاولة.");

                if (Login.BuildConnection())
                {
                    string Name = Name_txtBox.Text;
                    string Date = Date_datepicker.DisplayDate.ToString("yyyy/MM/dd");
                    string Notes = Notes_txtBox.Text;
                    int SubProject_ID = Convert.ToInt32(SubProject_comboBox.SelectedValue);
                    int Account_ID = Convert.ToInt32(Account_comboBox.SelectedValue);
                    string Account = Account_comboBox.Text.ToString();

                    if (ID != -1)//Edit
                    {
                        fb.Update(ID, Name, Date, Notes, Account_ID);
                        l.Insert("Update", "Fiscal Bond", Name_txtBox + ":" + Account
                            , ID.ToString()
                            , Properties.Settings.Default.username, DateTime.Now);
                    }
                    else//Add new
                    {
                        fb.Insert(Name, Date, Notes, Account_ID);
                        l.Insert("Insert", "Fiscal Bond", Name_txtBox + ":" + Account
                            , fb.Get_Last_ID().ToString()
                            , Properties.Settings.Default.username, DateTime.Now);
                    }

                    Clear_Boxes();
                    LoadGrid();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void Clear_Boxes()
        {
            Name_txtBox.Text = Notes_txtBox.Text = "";
            Account_comboBox.SelectedIndex = SubProject_comboBox.SelectedIndex = -1;
            ID = -1;

        }

        private void Search_txtBox_TextChanged(object sender, TextChangedEventArgs e)
        {
            try
            {
                Search_DataGrid();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void Search_DataGrid()
        {
            DataTable selected_dt = new DataTable();
            selected_dt = dt.Copy();

            if (Search_txtBox.Text != "")
            {
                if (selected_dt != null)
                {
                    DataTable new_dt = selected_dt.Copy();
                    new_dt.Rows.Clear();
                    var found = 0;

                    foreach (DataRow r in selected_dt.Rows)
                    {
                        for (var i = 0; i < selected_dt.Columns.Count; i++)
                        {
                            if (ExactSearch_checkBox.IsChecked == true)
                            {
                                if (r.ItemArray.ElementAt(i).ToString().ToLower() == Search_txtBox.Text.ToLower())
                                {
                                    new_dt.Rows.Add(r.ItemArray);
                                    found = 1;
                                    break;
                                }
                            }
                            else
                            {
                                if (r.ItemArray.ElementAt(i).ToString().ToLower().Contains(Search_txtBox.Text.ToLower()))
                                {
                                    new_dt.Rows.Add(r.ItemArray);
                                    found = 1;
                                    break;
                                }
                            }
                        }
                    }
                    selected_dt = new_dt.Copy();
                }
            }
            myDataGrid.ItemsSource = null;

            if (selected_dt != null)
            {
                myDataGrid.ItemsSource = selected_dt.DefaultView;
                All_textBlock.Text = myDataGrid.Items.Count.ToString();
            }
        }

        private void ExactSearch_checkBox_Checked(object sender, RoutedEventArgs e)
        {
            try
            {
                Search_DataGrid();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }
        private void ExactSearch_checkBox_Unchecked(object sender, RoutedEventArgs e)
        {
            try
            {
                Search_DataGrid();
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void myDataGrid_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            try
            {
                int count = myDataGrid.SelectedItems.Count;
                Selected_textBlock.Text = count.ToString("N3");
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }

        private void myDataGrid_MouseDoubleClick(object sender, MouseButtonEventArgs e)
        {
            IInputElement element = e.MouseDevice.DirectlyOver;
            if (element != null && element is FrameworkElement)
            {
                if (((FrameworkElement)element).Parent is DataGridCell)
                {
                    var grid = sender as DataGrid;
                    if (grid != null && grid.SelectedItems != null && grid.SelectedItems.Count == 1)
                    {
                        DataRowView rowview = grid.SelectedItem as DataRowView;
                        Fill_FiscalBond(rowview);
                    }
                }
            }
        }

        private void Refresh_Click(object sender, RoutedEventArgs e)
        {
            LoadGrid();
        }

        private void Export_btn_Click(object sender, RoutedEventArgs e)
        {

        }

        private void LoadSubProjectComboBox()
        {
            if (Login.BuildConnection())
            {
                sub_dt = sub.Select("", "", "3", ""); //Select only micro project
                if (sub_dt.Rows.Count > 0)
                {
                    SubProject_comboBox.ItemsSource = sub_dt.DefaultView;
                }
                SubProject_comboBox.SelectedIndex = -1;
                SubProject_comboBox_SelectionChanged(SubProject_comboBox, null);

            }
        }

        private void LoadAccountComboBox(string SubProject_ID)
        {
            if (SubProject_ID == "" && a_dt.Rows.Count == 0) //first time
            {
                if (Login.BuildConnection())
                {
                    a_dt = a.Select("", "", false);
                    if (a_dt.Rows.Count > 0)
                        Account_comboBox.ItemsSource = a_dt.DefaultView;
                }
            }
            else
            {
                DataRow[] rows = a_dt.Select("SubProject_ID=" + SubProject_ID);
                DataTable selected_dt = new DataTable();
                if (rows.Length != 0)
                {
                    selected_dt = rows.CopyToDataTable();
                    if (selected_dt.Rows.Count > 0)
                        Account_comboBox.ItemsSource = selected_dt.DefaultView;
                }
            }
        }

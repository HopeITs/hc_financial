<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.All_BidgetLine_Sub_Window"
        mc:Ignorable="d"
        Title="All_BidgetLine_Sub_Window" Width="1280" Height="620"
        FontFamily="Myriad Arabic" FontSize="22" WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>
            <Grid >
                <Grid.ContextMenu>
                    <ContextMenu x:Name="cm">
                        <MenuItem Header="Refresh" Click = "Refresh_Click" >
                            <MenuItem.Icon>
                                <Image Source="/Images/refresh32.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="224*"/>
                    <ColumnDefinition Width="205*"/>
                    <ColumnDefinition Width="47*"/>
                    <ColumnDefinition Width="156*"/>
                    <ColumnDefinition Width="116*"/>

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>


                    <RowDefinition Height="25" />
                    <RowDefinition/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="40.004" />
                </Grid.RowDefinitions>

                <syncfusion:SfDataGrid Grid.ColumnSpan="8"
                    x:Name="myDataGrid"  
                    Style="{DynamicResource SfDataGrid_body}"
                    HeaderStyle="{DynamicResource SfDataGrid_header}"
                    RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                    AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                    TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"   
                    GroupSummaryRowStyle="{DynamicResource GroupSummaryRowStyle}"
                    AutoGenerateColumns="True"
                    Loaded="myDataGrid_Loaded" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3,3,3,2" AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" Grid.Row="1" ItemsSourceChanged="myDataGrid_ItemsSourceChanged" FilterChanged="myDataGrid_FilterChanged" Grid.RowSpan="4">
                </syncfusion:SfDataGrid>
                <Menu x:Name="ShowHideMenu" Margin="3,8,0,10" Grid.Column="1" HorizontalAlignment="Left" Width="32" >
                    <Menu.Background>
                        <ImageBrush/>
                    </Menu.Background>
                    <MenuItem Header="" StaysOpenOnClick="True" Grid.Column="1" Width="32" Height="34" >
                        <MenuItem.Background>
                            <ImageBrush ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                        </MenuItem.Background>
                        <MenuItem x:Name="ShowMenu" Header="Show" StaysOpenOnClick="True" Background="White" />
                        <MenuItem x:Name="HideMenu" Header="Hide" StaysOpenOnClick="True" Background="White"/>
                        <Separator Background="Black"/>
                        <MenuItem Header="ShowAll" Click="ShowAll_MenuItem_Click" Background="White"/>
                    </MenuItem>
                </Menu>
                <Button Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                    TabIndex="5" Command="Helper:Commands.ExportToExcel" Grid.Column="2" Height="NaN" Width="31" HorizontalAlignment="Left" Margin="3,12,0,15" VerticalAlignment="Stretch" />
                <StackPanel x:Name="Panel1" Orientation="Horizontal" FlowDirection="RightToLeft" Grid.ColumnSpan="8" Margin="4,5,3,5" >
                    <RadioButton x:Name="Total_RadioButton" Content="Show total" IsChecked="True" Style="{DynamicResource RadioButtonStyle}" Height="34" Width="126" HorizontalAlignment="Right" Checked="Total_RadioButton_Checked"/>
                    <RadioButton x:Name="PerDonor_RadioButton" Content="Show per donor" Height="34" Width="150" Style="{DynamicResource RadioButtonStyle}" HorizontalAlignment="Right" Checked="PerDonor_RadioButton_Checked"/>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>

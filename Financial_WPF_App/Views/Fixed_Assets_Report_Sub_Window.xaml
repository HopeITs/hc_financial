<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.Fixed_Assets_Report_Sub_Window"
        mc:Ignorable="d"
        Title="Fixed_Assets_Report_Sub_Window" Width="1280" Height="620" FontFamily="Myriad Arabic" FontSize="18" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="51.451"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <syncfusion:SfDataGrid  x:Name="myDataGrid"  FrozenColumnCount="1"
                Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"
                GroupSummaryRowStyle="{DynamicResource GroupSummaryRowStyle}"                 
                HorizontalAlignment="Stretch"
                AutoGenerateColumns="True"
                Loaded="myDataGrid_Loaded" VerticalAlignment="Stretch" Margin="2,1,2,1" AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" ItemsSourceChanged="myDataGrid_ItemsSourceChanged" FilterChanged="myDataGrid_FilterChanged" Grid.Row="1"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="190*"/>
                    <ColumnDefinition Width="320*"/>
                    <ColumnDefinition Width="151*"/>
                    <ColumnDefinition Width="489*"/>
                </Grid.ColumnDefinitions>
                <Menu x:Name="ShowHideMenu" Margin="14,7,20,6" >
                    <Menu.Background>
                        <ImageBrush/>
                    </Menu.Background>
                    <MenuItem Header="" StaysOpenOnClick="True" Grid.Column="1" Width="34" Height="32" >
                        <MenuItem.Background>
                            <ImageBrush ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                        </MenuItem.Background>
                        <MenuItem x:Name="ShowMenu" Header="Show" StaysOpenOnClick="True" Background="White" />
                        <MenuItem x:Name="HideMenu" Header="Hide" StaysOpenOnClick="True" Background="White"/>
                        <Separator Background="Black"/>
                        <MenuItem Header="ShowAll" Click="ShowAll_MenuItem_Click" Background="White"/>
                    </MenuItem>
                </Menu>
                <Button Grid.Column="1" Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                    TabIndex="5" HorizontalAlignment="Stretch" Margin="2,10,166,10"
                    Command="Helper:Commands.ExportToExcel" Height="26" Width="32" VerticalAlignment="Stretch"
                />
            </Grid>
        </Grid>
    </Grid>
</Window>

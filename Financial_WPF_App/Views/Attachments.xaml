<Window x:Class="Financial_WPF_App.Views.Attachments"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        mc:Ignorable="d"
        Title="Attachments" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="mainGrid" Margin="0,0,10,0" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*"/>
                <ColumnDefinition Width="109*"/>
                <ColumnDefinition Width="68*"/>
                <ColumnDefinition Width="79*"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="172*"/>
                <ColumnDefinition Width="91*"/>
                <ColumnDefinition Width="127*"/>
                <ColumnDefinition Width="20*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="55*"/>


                <RowDefinition Height="358*" />
                <RowDefinition Height="20.918"/>

            </Grid.RowDefinitions>


            <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="2"                                            
      Style="{DynamicResource SfDataGrid_body}"
      HeaderStyle="{DynamicResource SfDataGrid_header}"
      RowStyle="{DynamicResource SfDataGrid_RowStyle}"
      AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"      
      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
      Margin="1,1,5,0" Grid.Row="1" Grid.ColumnSpan="7" Grid.Column="1">

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" HeaderText="id"  MappingName="id" IsHidden="True"/>
                    <syncfusion:GridTextColumn x:Name="ActionID_DataGridColumn" HeaderText="action_id"  MappingName="action_id" IsHidden="True"/>

                    <syncfusion:GridTextColumn x:Name="Attachment_DataGridColumn" HeaderText="Attachment"  MappingName="attach_name" />

                    <syncfusion:GridTemplateColumn x:Name="View_DataGridColumn" HeaderText="View" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource View_Style}" Click="View_Button_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn x:Name="Download_DataGridColumn" HeaderText="Download" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Download_Style}" Click="Download_Button_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn" HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>



            <Label Grid.Column="7"  Style="{DynamicResource lableStyle}" Content="Add attachments:" Margin="4,4,2,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
            <Button Style="{DynamicResource Add_Style}" 
                x:Name="AddAttachments_btn" TabIndex="15" Margin="19,15,11,15" Grid.Column="6" Height="NaN" Width="NaN" HorizontalAlignment="Stretch" Click="AddAttachments_btn_Click" VerticalAlignment="Stretch"/>

            <Syncfusion:SfCircularProgressBar x:Name="circularProgressBar" IsIndeterminate="False" 
                                              ShowProgressValue ="True"
             Grid.ColumnSpan="2" Margin="13,115,54,119" Grid.Column="4" Grid.Row="1">

            </Syncfusion:SfCircularProgressBar>

        </Grid>

    </Grid>
</Window>

<Window x:Class="Financial_WPF_App.Views.Attachments"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        mc:Ignorable="d"
        Title="Attachments" Style="{StaticResource smallWindowPopupStyle}" WindowStartupLocation="CenterScreen">
        <Grid  Margin="5">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="355*"/>
            </Grid.RowDefinitions>
            <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0">
                <local:WindowControlBar_Popup x:Name="ControlBar" HorizontalAlignment="Right"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="1" Height="40">
                <Image Source="/Images/Icons/attachement.png" Width="20" Height="20" Margin="10,0,0,0"/>
                <Label  Style="{DynamicResource statistic_lableStyle}" Content="Attachments:" Margin="4,4,0,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                <Label  Style="{DynamicResource statistic_lableStyle}" Content="3" Margin="0,4,0,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                <Button Style="{DynamicResource AddButtonStyle}" ToolTip="Add Attachments" ToolTipService.InitialShowDelay="100" Cursor="Hand"
                    x:Name="AddAttachments_btn" TabIndex="15" HorizontalAlignment="Stretch" Click="AddAttachments_btn_Click" VerticalAlignment="Stretch">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Icons/add_attach.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
                    <syncfusion:SfLinearProgressBar x:Name="circularProgressBar" Width="175"
                        Height="20" SegmentCount="10"
                        TrackColor="{StaticResource LightGray1}"
                        ProgressColor="{StaticResource GreenBlue}"/>
                <Label  Style="{DynamicResource statistic_lableStyle}" Content="{Binding totalFiles}" Margin="0,4,0,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                <!--<Syncfusion:SfCircularProgressBar x:Name="circularProgressBar" IsIndeterminate="False" 
                                  ShowProgressValue ="True"
                                Grid.ColumnSpan="2" Margin="13,115,54,119" Grid.Column="4" Grid.Row="1">

                </Syncfusion:SfCircularProgressBar>-->
                
                
            </StackPanel>
            <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="2"                                            
      Style="{DynamicResource SfDataGrid_body}"
      HeaderStyle="{DynamicResource SfDataGrid_header}"
      RowStyle="{DynamicResource SfDataGrid_RowStyle}"
      AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"      
      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
      Margin="1,1,5,0" Grid.Row="2" >

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" HeaderText="id"  MappingName="id" IsHidden="True"/>
                    <syncfusion:GridTextColumn x:Name="ActionID_DataGridColumn" HeaderText="action_id"  MappingName="action_id" IsHidden="True"/>

                    <syncfusion:GridTextColumn x:Name="Attachment_DataGridColumn" HeaderText="Attachment"  MappingName="attach_name" />

                    <syncfusion:GridTemplateColumn x:Name="View_DataGridColumn" HeaderText="View" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource View_Style}" Click="View_Button_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn x:Name="Download_DataGridColumn" HeaderText="Download" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Download_Style}" Click="Download_Button_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn" HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>




        </Grid>

    </Grid>
</Window>

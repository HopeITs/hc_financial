<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Budget_Window" 
        mc:Ignorable="d"
        Title="Budget_Window" 
        WindowStartupLocation="CenterScreen" KeyDown="ProjectWindow_KeyDown"
        Height="600" Width="450" FontFamily="Myriad Arabic" FontSize="16" >
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Margin="0,11,0,0.4" Grid.Column="0" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="13*"/>
            <RowDefinition Height="97*" />
        </Grid.RowDefinitions>

        <Label Grid.Column="2"  Style="{DynamicResource lableStyle}" Content="Category:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,6,1,6" HorizontalContentAlignment="Right" />
        <Grid  Grid.Column="1" Grid.Row="0" FlowDirection="RightToLeft" Margin="1,2,1,2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75*"/>
                <ColumnDefinition Width="25*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="Category_comboBox" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="ID" 
                       TabIndex="2" FlowDirection="RightToLeft" Height="auto"  />
            <Button x:Name="EditCategory_btn" Grid.Column="1" HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Width="25" Height="25" BorderBrush="{x:Null}" 
                            Click="EditCategory_btn_Click" Margin="2" >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/edit.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </Grid>

        <Label Grid.Column="2" Grid.Row="1" Style="{DynamicResource lableStyle}" Content="Name:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,6,1,6" HorizontalContentAlignment="Right" />
        <TextBox x:Name="Name_txtBox" Grid.Column="1"  Grid.Row="1"  Style="{DynamicResource textBoxStyle}" TabIndex="2" HorizontalContentAlignment="Stretch" Margin="68,0,1,0" Height="32" />

        <Button Grid.Column="1" Grid.Row="3"  Style="{DynamicResource SaveButton_Style}" x:Name="Save_btn" 
                TabIndex="4" Click="Save_btn_Click" Height="32" Width="86"   />


        <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="2"                                            
               Style="{DynamicResource SfDataGrid_body}"
               HeaderStyle="{DynamicResource SfDataGrid_header}"
               RowStyle="{DynamicResource SfDataGrid_RowStyle}"
               AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"      
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               Margin="1,2,2,0"  Grid.Row="4" Grid.ColumnSpan="4" Loaded="myDataGrid_Loaded" MouseDoubleClick="myDataGrid_MouseDoubleClick" ItemsSourceChanged="myDataGrid_ItemsSourceChanged">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" HeaderText="#"  MappingName="ID" IsHidden="True"/>
                <syncfusion:GridTextColumn x:Name="Category_DataGridColumn" HeaderText="Category"  MappingName="Category" />
                <syncfusion:GridTextColumn x:Name="Name_DataGridColumn" HeaderText="Name"  MappingName="Name" />
                <syncfusion:GridTextColumn x:Name="Project_DataGridColumn" HeaderText="Projects"  MappingName="Projects" />
                <syncfusion:GridTextColumn x:Name="Category_ID_DataGridColumn" HeaderText="Category_ID"  MappingName="Category_ID" IsHidden="True"/>


                <syncfusion:GridTemplateColumn x:Name="Edit_DataGridColumn"  HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn"  HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
        <Label Grid.Column="2" Grid.Row="2" Style="{DynamicResource lableStyle}" Content="Project:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,6,1,6" HorizontalContentAlignment="Right" />
        <Grid Grid.Column="1" Margin="1,2,1,2" Grid.Row="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*"/>
                <ColumnDefinition Width="75*"/>

            </Grid.ColumnDefinitions>
            <ComboBox x:Name="Project_comboBox" Grid.Column="1" 
                FlowDirection="RightToLeft" TabIndex="2"
                FontSize="14" VerticalContentAlignment="Center" IsEditable="True" PreviewTextInput="comboBox_PreviewTextInput" PreviewKeyDown="comboBox_PreviewKeyDown" Height="34">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox x:Name="SubProject_comboBox" Width="220" 
                            Click="Project_Checkbox_Item_Clicked"
                            Content="{Binding ProjectName}" 
                            IsChecked="{Binding Project_Check_Status}" 
                            CommandParameter="{Binding ProjectID}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="Project_clear_btn" Grid.Column="0" FontSize="16" BorderBrush="{x:Null}"
                Click="Project_clear_btn_Click" Margin="43,10,0,0" MaxWidth="20" MinHeight="20" MinWidth="15" MaxHeight="15" VerticalAlignment="Top" HorizontalAlignment="Left" Height="23" Width="24"  >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </Grid>


        <Button
            TabIndex="5" Style="{DynamicResource Export_Style}" x:Name="Export_btn" Margin="10,14,10,13" Command="Helper:Commands.ExportToExcel" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RenderTransformOrigin="0.536,0.355" Grid.Row="3"
                />


        <!--</ScrollViewer>-->
    </Grid>

</Window>

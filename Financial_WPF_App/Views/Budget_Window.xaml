<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Budget_Window" 
        mc:Ignorable="d" Tag="Budget Window"
        Title="Budget_Window" 
        WindowStartupLocation="CenterScreen" KeyDown="ProjectWindow_KeyDown"
        Style="{StaticResource WindowPopupStyle}">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Margin="10" >
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="97*" />
        </Grid.RowDefinitions>

        <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0">
            <local:WindowControlBar_Popup x:Name="ControlBar"/>
        </DockPanel>
        <DockPanel LastChildFill="True" Background="{StaticResource LightGray1}" Height="40" Grid.Row="1">
            <WrapPanel Orientation="Horizontal" Width="Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Height="30">
                    <Label  Style="{DynamicResource statistic_lableStyle}" Content="Category:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Margin="10,0,2,0" />
                    <ComboBox x:Name="Category_comboBox" Style="{StaticResource ActionComboboxStyle}" DisplayMemberPath="Name" SelectedValuePath="ID" 
                        TabIndex="2" />
                    <Button x:Name="EditCategory_btn" Grid.Column="1"  BorderBrush="{x:Null}" Style="{StaticResource AddButtonStyle}"
                        Click="EditCategory_btn_Click"  VerticalAlignment="Top" Height="30" Margin="5,0,1,0">
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Icons/dg_edit.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="2"  Height="30" Margin="0,5,0,0">
                    <Label Style="{DynamicResource statistic_lableStyle}" Content="Name:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                    <TextBox x:Name="Name_txtBox"  Style="{DynamicResource CustomTextBoxActionStyle}" Width="175" TabIndex="2" HorizontalContentAlignment="Stretch"  />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="2"  Height="30" Margin="0,5,0,0">
                    <Label Style="{DynamicResource statistic_lableStyle}" Content="Project:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                    <ComboBox x:Name="Project_comboBox" Style="{StaticResource ActionComboboxStyle}" PreviewTextInput="comboBox_PreviewTextInput" PreviewKeyDown="comboBox_PreviewKeyDown"  Width="175"
                        TabIndex="2">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="SubProject_comboBox" Width="220" 
                                   Click="Project_Checkbox_Item_Clicked"
                                   Style="{DynamicResource CheckBoxStyle}"
                                   Content="{Binding Name}" 
                                   IsChecked="{Binding Project_Check_Status}" 
                                   CommandParameter="{Binding ID}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="Project_clear_btn" Grid.Column="1"  BorderBrush="{x:Null}" Style="{StaticResource ActionDeleteButtonStyle}"
                    Click="Project_clear_btn_Click"  VerticalAlignment="Top" Height="30" Margin="5,0,1,0">
                    </Button>
                </StackPanel>
                <Button  Style="{DynamicResource AddButtonStyle}" x:Name="Save_btn" Click="Save_btn_Click" FlowDirection="LeftToRight" ToolTip="Save Project" ToolTipService.InitialShowDelay="100" HorizontalAlignment="Left" Margin="10,2,1,0" Width="22" Height="23">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/newEntry.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </WrapPanel>
        </DockPanel>


        <syncfusion:SfDataGrid x:Name="myDataGrid" FrozenColumnCount="2"                                            
               Style="{DynamicResource SfDataGrid_body}"
               HeaderStyle="{DynamicResource SfDataGrid_header}"
               RowStyle="{DynamicResource SfDataGrid_RowStyle}"
               AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"      
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               Grid.Row="2"  Loaded="myDataGrid_Loaded" MouseDoubleClick="myDataGrid_MouseDoubleClick" Margin="2,5,1,5">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" HeaderText="#"  MappingName="ID" IsHidden="True"/>
                <syncfusion:GridTextColumn x:Name="Category_DataGridColumn" HeaderText="Category"  MappingName="Category" />
                <syncfusion:GridTextColumn x:Name="Name_DataGridColumn" HeaderText="Name"  MappingName="Name" />
                <syncfusion:GridTextColumn x:Name="Project_DataGridColumn" HeaderText="Projects"  MappingName="Projects" />
                <syncfusion:GridTextColumn x:Name="Category_ID_DataGridColumn" HeaderText="Category_ID"  MappingName="Category_ID" IsHidden="True"/>


                <syncfusion:GridTemplateColumn x:Name="Edit_DataGridColumn"  HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn"  HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>



    </Grid>

</Window>

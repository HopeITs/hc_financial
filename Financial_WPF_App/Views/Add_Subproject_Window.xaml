<Window x:Class="Financial_WPF_App.Views.Add_Subproject_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        mc:Ignorable="d" Tag="Add Sub Project Window"
        Title="Add_Subproject_Window" Style="{StaticResource WindowPopupStyle}" Width="700"  WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".5*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width=".5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0" Grid.ColumnSpan="4">
            <local:WindowControlBar_Popup x:Name="ControlBar"/>
        </DockPanel>
        <Label Grid.Column="0"  Style="{DynamicResource statistic_lableStyle}" Content="Project:"  VerticalContentAlignment="Center" Grid.Row="2"  VerticalAlignment="Center" />
        <ComboBox x:Name="Project_comboBox" Style="{StaticResource FloatingComboboxStyle}"
            Grid.Column="1"  TabIndex="1" 
            DisplayMemberPath="Name" SelectedValuePath="ID" Grid.Row="2" />
        <Label Grid.Column="2" Style="{DynamicResource statistic_lableStyle}" Content="City:"  VerticalContentAlignment="Center"  Grid.Row="2" />
        <ComboBox x:Name="City_comboBox" Grid.Column="3" DisplayMemberPath="Name" SelectedValuePath="ID"   TabIndex="2"  VerticalContentAlignment="Center"   Style="{StaticResource FloatingComboboxStyle}" Grid.Row="2"/>
        <Label Grid.Column="0" Grid.Row="1" Style="{DynamicResource statistic_lableStyle}" Content="Center name:"  VerticalContentAlignment="Center" HorizontalAlignment="Left"/>
        <TextBox x:Name="Name_txtBox" Grid.Column="1" Grid.Row="1"  TabIndex="3"
            Style="{DynamicResource FloatingTextBoxStyle}"/>
        <Label Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="Start date:" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>
        <DatePicker x:Name="beginDate_datepicker" Grid.Row="3" TabIndex="4"  VerticalContentAlignment="Center" Grid.Column="1" Height="30" />
        <Label Grid.Column="2" Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="End date:"  VerticalContentAlignment="Center"/>
        
            <Label Grid.Column="3" Grid.Row="4"
                Style="{DynamicResource statistic_lableStyle}" Content="All Donors" 
                HorizontalAlignment="Stretch"  HorizontalContentAlignment="Center"
                VerticalAlignment="Bottom" Margin="1,10,1,0" Height="30"/>
            <ListBox x:Name="alldonors_listbox" Background="{DynamicResource LightGray1}" BorderBrush="{x:Null}" FontSize="12" FontFamily="Rubik" Padding="5" FontWeight="SemiBold" Foreground="{StaticResource DarkGray}"
                Grid.Column="3" Grid.Row="5"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

        <Button Grid.Column="2" Grid.Row="5" x:Name="add_btn"  
                Content="&lt;&lt;" Width="25" Height="25" TabIndex="4"
                Click="AddDonor_btn_Click"  BorderBrush="{StaticResource LightGray1}" Background="{StaticResource LightGray2}" Foreground="{StaticResource DarkGray}" Margin="0,-33,0,0">
            </Button>

            <Button Grid.Column="2" Grid.Row="5" x:Name="remove_btn" BorderBrush="{StaticResource LightGray1}" Background="{StaticResource LightGray2}" Foreground="{StaticResource DarkGray}"
                Content="&gt;&gt;" Height="25" TabIndex="4" Width="25"
                Click="RemoveDonor_btn_Click" Margin="0,52,0,0">
            </Button>


            <Label Grid.Column="1" Grid.Row="4" Style="{DynamicResource statistic_lableStyle}" 
                Content="Center Donors" 
                Margin="1,10,1,0" Width="auto" HorizontalAlignment="Stretch" 
                VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Height="30"/>

        <ListBox x:Name="donors_listbox"  Grid.Column="1" Grid.Row="5" BorderBrush="{x:Null}" Background="{DynamicResource LightGray1}" FontSize="12" Padding="5" FontFamily="Rubik" FontWeight="SemiBold" Foreground="{StaticResource DarkGray}"
               
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        <Button  Style="{DynamicResource ButtonColoredStyle}" Content="Save"
            x:Name="Save_btn" TabIndex="4" Click="Save_btn_Click" Grid.Row="6" />
        <Grid Grid.Row="3" Grid.Column="3" Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DatePicker  x:Name="endDate_datepicker" Grid.Column="0" TabIndex="15" FirstDayOfWeek="Monday" Margin="1,0,1,0"/>
            <Border x:Name="EndDate_Border" Width="26" Height="30" MouseDown="Border_MouseDown" Grid.Column="1" Background="{StaticResource LightGray1}" ToolTip="TBD" ToolTipService.InitialShowDelay="100" 
            ToolTipService.ShowDuration="5000"
            ToolTipService.BetweenShowDelay="200" Margin="3,0,0,0">
                <CheckBox x:Name="EndDate_CheckBox" TabIndex="16"  ToolTip="TBD" ToolTipService.InitialShowDelay="100" 
            ToolTipService.ShowDuration="5000"
            ToolTipService.BetweenShowDelay="200" Style="{StaticResource CheckBoxStyle}"
            Checked="EndDate_CheckBox_Checked" Unchecked="EndDate_CheckBox_Unchecked" HorizontalAlignment="Center" Width="12"
            />
            </Border>
        </Grid>

    </Grid>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.Log_Window"
        mc:Ignorable="d"
        Title="Log_Window" Height="613.8" Width="1280" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu Name="cm">
                <MenuItem Header="Refresh" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <syncfusion:SfDataGrid  x:Name="myDataGrid"  
        Style="{DynamicResource SfDataGrid_body}"
        HeaderStyle="{DynamicResource SfDataGrid_header}"
        RowStyle="{DynamicResource SfDataGrid_RowStyle}"
        AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
        FrozenColumnCount="3"
        AutoGenerateColumns="True"
        Loaded="myDataGrid_Loaded" 
        AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,0,-1,0" Grid.Row="1"/>

        <Grid Margin="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="333*"/>
                <ColumnDefinition Width="103"/>
                <ColumnDefinition Width="242"/>
                <ColumnDefinition Width="67"/>
                <ColumnDefinition Width="142"/>
                <ColumnDefinition Width="293*"/>
            </Grid.ColumnDefinitions>
            <Menu x:Name="ShowHideMenu" Margin="3,4,2,4" >
                <Menu.Background>
                    <ImageBrush/>
                </Menu.Background>
                <MenuItem Header="" StaysOpenOnClick="True" Grid.Column="1" Width="39" Height="40" >
                    <MenuItem.Background>
                        <ImageBrush ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                    </MenuItem.Background>
                    <MenuItem x:Name="ShowMenu" Header="Show" StaysOpenOnClick="True" Background="White" />
                    <MenuItem x:Name="HideMenu" Header="Hide" StaysOpenOnClick="True" Background="White"/>
                    <Separator Background="Black"/>
                    <MenuItem Header="ShowAll" Click="ShowAll_MenuItem_Click" Background="White"/>
                </MenuItem>
            </Menu>
            <Button Grid.Column="1" Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                TabIndex="5"
                Command="Helper:Commands.ExportToExcel" Height="26" Width="25"
                />
            <Label VerticalContentAlignment="Center" Style="{DynamicResource lableStyle}" HorizontalContentAlignment="Center" Content="Search:" Grid.Column="5" Width="52" VerticalAlignment="Stretch" Margin="6,12,0,6"/>
            <Border Grid.Column="4" BorderThickness="1" CornerRadius="10" Padding="0" Margin="8,8,8,8" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBox x:Name="Search_txtBox" Width="auto" TextChanged="Search_txtBox_TextChanged" TextWrapping="Wrap"  
                    TabIndex="1" Margin="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
                    FlowDirection="RightToLeft" TextAlignment="Center"
                    Background="{DynamicResource HopeGrey}" BorderThickness="0" >
                    <TextBox.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                    </TextBox.BorderBrush>
                </TextBox>
            </Border>
            <!--<CheckBox Grid.Column="3" x:Name="ExactSearch_checkBox" Content="Full match"                        
                Foreground = "{DynamicResource HopeBlue4}"
                Checked="ExactSearch_checkBox_Checked" Unchecked="ExactSearch_checkBox_Unchecked" VerticalContentAlignment="Center" 
                HorizontalAlignment="Right" HorizontalContentAlignment="Center" Margin="0,15,0,9" Width="91" />-->
        </Grid>

    </Grid>
</Window>

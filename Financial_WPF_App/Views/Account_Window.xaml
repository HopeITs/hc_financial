<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Financial_WPF_App"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
    x:Class="Financial_WPF_App.Account_Window"
    mc:Ignorable="d"
    x:Name="AccountWindow" Title="Account_Window" Height="614" Width="1280"  
    FontFamily="Myriad Arabic"
    FontSize="18" 
    WindowState="Maximized" WindowStartupLocation="CenterScreen">


    <Window.Resources>
    </Window.Resources>
    <Grid >
        <Grid.ContextMenu>
            <ContextMenu x:Name="cm">
                <MenuItem Header="Refresh Account" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="First_col"  Width="70*"/>
            <ColumnDefinition x:Name="Second_col" Width="30*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>

        <Expander x:Name="myExpander" Grid.Column="1" IsExpanded="True"
                  ExpandDirection="Right"
                  HorizontalContentAlignment="Stretch"  Margin="5,2,2,0" 
                  Expanded="myExpander_Expanded" Collapsed="myExpander_Collapsed" />

        <TabControl x:Name="tabControl1" Style="{StaticResource TabControlStyle}" Grid.Column="0"></TabControl>
        <Grid Grid.Column="1" Margin="50,7,10,10" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="197*"/>
                <ColumnDefinition Width="127*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="40*"/>

                <RowDefinition Height="40*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="60*" />
                <RowDefinition Height="50*" />
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="2" x:Name="Project_lable" Style="{DynamicResource lableStyle}" Content="Project:" 
                       VerticalContentAlignment="Center" 
                       RenderTransformOrigin="-1.058,0.555"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,2,2,2" Grid.Column="1" />
            <Grid Grid.Column="0" Margin="2,2,2,2" Grid.Row="2" >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="75*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Project_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" 
                              FlowDirection="RightToLeft" TabIndex="1" FontSize="14"
                              SelectionChanged="Project_comboBox_SelectionChanged" Grid.Row="1" Grid.Column="1" 
                              VerticalAlignment="Center" VerticalContentAlignment="Center" />
                <Button x:Name="Project_clear_btn" Grid.Column="0" 
                            FontSize="16" BorderBrush="{x:Null}" Margin="0" 
                        Click="Project_clear_btn_Click"  Grid.Row="1" MaxWidth="20" MinHeight="20" MinWidth="15" MaxHeight="15" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </Grid>


            <Label x:Name="SubProject_label" Grid.Row="3" Style="{DynamicResource lableStyle}" Content="Center:" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,2,2,2" Grid.Column="1" />
            <Grid Grid.Column="0" Margin="2,2,2,2" Grid.Row="3" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="75*"/>

                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SubProject_comboBox" Grid.Column="1" 
                              FlowDirection="RightToLeft" TabIndex="2"
                              FontSize="14"
                              SelectionChanged="SubProject_comboBox_SelectionChanged" 
                              VerticalAlignment="Center" VerticalContentAlignment="Center" IsEditable="True" PreviewTextInput="comboBox_PreviewTextInput" PreviewKeyDown="comboBox_PreviewKeyDown">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="SubProject_comboBox" Width="220" 
                                      Click="SubProject_Checkbox_Item_Clicked"
                                      Content="{Binding SubName}" 
                                      IsChecked="{Binding Sub_Check_Status}" 
                                      CommandParameter="{Binding SubID}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="SubProject_clear_btn" Grid.Column="0" FontSize="16" BorderBrush="{x:Null}"
                            Click="SubProject_clear_btn_Click" Margin="0" MaxWidth="20" MinHeight="20" MinWidth="15" MaxHeight="15"  >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </Grid>


            <Label x:Name="Donor_label" Grid.Row="4" Style="{DynamicResource lableStyle}" Content="Donor:" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,2,2,2" Grid.Column="1" />
            <Grid Grid.Row="4" Grid.Column="0" Margin="2,2,2,2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="75*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Donor_comboBox" Grid.Column="1"
                               FlowDirection="RightToLeft" 
                              TabIndex="3" FontSize="14" 
                              VerticalAlignment="Center" VerticalContentAlignment="Center" IsEditable="True" PreviewTextInput="comboBox_PreviewTextInput" PreviewKeyDown="comboBox_PreviewKeyDown">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="Donor_CheckBox" Width="220" 
                                      Click="Donor_Checkbox_Item_Clicked"
                                      Content="{Binding DonorName}" 
                                      IsChecked="{Binding Check_Status}" 
                                      CommandParameter="{Binding Donor_ID}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>
                <Button x:Name="Donor_clear_btn" Grid.Column="0" FontSize="16" BorderBrush="{x:Null}"
                        Click="Donor_clear_btn_Click" Margin="0" MaxWidth="20" MinHeight="20" MinWidth="15" MaxHeight="15" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </Grid>


            <Label Style="{DynamicResource lableStyle}" Content="Account Name:" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,2,2,2" Grid.Column="1"/>
            <TextBox x:Name="Name_txtBox" 
                         TabIndex="4" Style="{DynamicResource textBoxStyle}" RenderTransformOrigin="0.5,0.5" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,0,2,0" Height="29"/>
            <Label x:Name="ProjectNumber_label" Grid.Row="7" Style="{DynamicResource lableStyle}" Content="Project Number:" VerticalContentAlignment="Center" RenderTransformOrigin="0.505,0.76" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,2,2,2" Grid.Column="1" />

            <Label x:Name="BeginDate_label" Grid.Row="8" Style="{DynamicResource lableStyle}" Content="Start Date:" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,2,2,2" Grid.Column="1" />
            <DatePicker x:Name="BeginDate_datepicker" Grid.Column="0" Grid.Row="8" FirstDayOfWeek="Monday" FlowDirection="LeftToRight" TabIndex="6"  VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,5,2,5"/>

            <Label x:Name="EndDate_label" Grid.Row="9" Style="{DynamicResource lableStyle}" Content="End Date:" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2,2,2,2" Grid.Column="1" FlowDirection="RightToLeft" HorizontalContentAlignment="Right" />
            <Grid Grid.Row="9
                  " Grid.Column="0" Margin="2,2,2,2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="87*"/>
                    <ColumnDefinition Width="158*"/>
                </Grid.ColumnDefinitions>
                <DatePicker x:Name="EndDate_datepicker" Grid.Column="1" TabIndex="7" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Margin="3,5,0,5"  />
                <CheckBox x:Name="EndDate_CheckBox" Content="TBD" TabIndex="8" 
                              Checked="EndDate_CheckBox_Checked" Unchecked="EndDate_CheckBox_Unchecked"  
                              FlowDirection="RightToLeft"
                              FontSize="14" HorizontalContentAlignment="Right" Margin="1,1,1,1"  />
            </Grid>


            <Label x:Name="TotalAmount_label" Grid.Row="10" Style="{DynamicResource lableStyle}" Content="Total Budget:" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,2,2,2" Grid.Column="1" />
            <Grid Grid.Row="10" Grid.Column="0" Margin="2,2,2,2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="75*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TotalAmount_txtBox"  
                              Style="{DynamicResource textBoxStyle}" 
                             PreviewTextInput="NumberValidationTextBox" 
                             TabIndex="9" LostFocus="TotalAmount_txtBox_LostFocus" VerticalAlignment="Stretch" Margin="3,3,3,3" Grid.Column="1"  />
                <ComboBox x:Name="AmountType_comboBox" Grid.Column="0" DisplayMemberPath="NAME" SelectedValuePath="ID"
                              FlowDirection="RightToLeft" VerticalContentAlignment="Stretch" VerticalAlignment="Stretch" TabIndex="10" FontSize="14" Margin="1,3,1,3" />
            </Grid>

            <Label x:Name="IsClosed_label" Grid.Row="11
                   " Style="{DynamicResource lableStyle}" Content="Account Status:" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,6,2,6" Grid.Column="1" VerticalAlignment="Stretch" />

            <!--<ToggleButton Grid.Row="8" Grid.Column="0" x:Name = "tb" Content = ""  
                        Checked = "HandleCheck" Unchecked = "HandleUnchecked" IsChecked="True"
                        HorizontalAlignment = "Right" FlowDirection="RightToLeft" >
                    <ToggleButton.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                    </ToggleButton.Background>
                </ToggleButton>-->

            <Button x:Name="IsClosed_btn" Grid.Column="0" Grid.Row="11
                    " 
                    Style="{DynamicResource SaveButton_Style}" TabIndex="11"  
                    Click="IsClosed_btn_Click" HorizontalContentAlignment="Center" Content="Open" Background="{x:Null}"
                        BorderThickness="1" Width="Auto" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Height="32" Margin="7,0,0,0">
                <Button.Foreground>
                    <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                </Button.Foreground>

            </Button>
            <Grid Grid.Row="12
                  " Margin="7,3,2,3" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="101*"/>
                    <ColumnDefinition Width="214*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="Save_btn" Grid.Column="0" 
                    Style="{DynamicResource SaveButton_Style}" TabIndex="11" 
                    Click="Save_btn_Click" Margin="0,8,0,6" VerticalAlignment="Stretch" Width="75"  />
                <StackPanel x:Name="AddAdminAcc_StackPanel" Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="3,2,1,2">
                    <Button Style="{DynamicResource Add_Style}" 
                        x:Name="AddAdminAcc_btn" TabIndex="15" Click="AddAdminAcc_btn_Click"  />
                    <Label x:Name="AddAdminAcc_Label" Style="{DynamicResource lableStyle}" 
                        Content="Add administrative account" Width="184"  />
                </StackPanel>
            </Grid>
            <Label x:Name="PersonalAccount_label" Grid.Row="5" Style="{DynamicResource lableStyle}" Content="Personal account:" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,2,2,2" Grid.Column="1" />
            <Grid Grid.Column="0" Margin="2,2,2,2" Grid.Row="5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="75*"/>

                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PersonalAccount_comboBox" Grid.Column="1" 
                        FlowDirection="RightToLeft" TabIndex="2"
                        FontSize="14"
                        VerticalAlignment="Center" VerticalContentAlignment="Center" IsEditable="True" PreviewTextInput="comboBox_PreviewTextInput" PreviewKeyDown="comboBox_PreviewKeyDown">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="PersonalAcc_comboBox" Width="220" 
                                      Click="PersonalAcc_Checkbox_Item_Clicked"
                                    Content="{Binding PersonalAcc_Name}" 
                                    IsChecked="{Binding PersonalAcc_Check_Status}" 
                                    CommandParameter="{Binding PersonalAcc_ID}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="PersonalAccount_clear_btn" Grid.Column="0" FontSize="16" BorderBrush="{x:Null}"
                        Click="PersonalAccount_clear_btn_Click" Margin="0" MaxWidth="20" MinHeight="20" MinWidth="15" MaxHeight="15"  >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </Grid>
            <Label x:Name="ExchangeAccount_label" Grid.Row="6" Style="{DynamicResource lableStyle}" Content="Exchange account:" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,2,2,2" Grid.Column="1" />
            <Grid Grid.Column="0" Margin="2,2,2,2" Grid.Row="6" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="75*"/>

                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ExchangeAccount_comboBox" Grid.Column="1" 
                        FlowDirection="RightToLeft" TabIndex="2"
                        FontSize="14"
                        VerticalAlignment="Center" VerticalContentAlignment="Center" IsEditable="True" PreviewKeyDown="comboBox_PreviewKeyDown" PreviewTextInput="comboBox_PreviewTextInput" >

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="ExchangeAcc_comboBox" Width="220" 
                                       Click="ExchangeAcc_Checkbox_Item_Clicked"
                                    Content="{Binding ExchangeAcc_Name}" 
                                    IsChecked="{Binding ExchangeAcc_Check_Status}" 
                                    CommandParameter="{Binding ExchangeAcc_ID}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="ExchangeAccount_clear_btn" Grid.Column="0" FontSize="16" BorderBrush="{x:Null}"
                        Click="ExchangeAccount_clear_btn_Click" Margin="0" MaxWidth="20" MinHeight="20" MinWidth="15" MaxHeight="15"  >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </Grid>
            <TextBox x:Name="ProjectNumber_txtBox" 
                TabIndex="4" Style="{DynamicResource textBoxStyle}" RenderTransformOrigin="0.5,0.5" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,6,2,6" Grid.Row="7" VerticalAlignment="Stretch"/>
            <Label Grid.Row="1" x:Name="City_lable" Style="{DynamicResource lableStyle}" Content="City:" 
                VerticalContentAlignment="Center" 
                RenderTransformOrigin="-1.058,0.555"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Margin="2,2,2,2" Grid.Column="1" />
            <Grid Grid.Column="0" Margin="2,2,2,2" Grid.Row="1" >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="75*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="City_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" 
                    FlowDirection="RightToLeft" TabIndex="1" FontSize="14" Grid.Row="1" Grid.Column="1" 
                    VerticalAlignment="Center" VerticalContentAlignment="Center" />
                <Button x:Name="City_clear_btn" Grid.Column="0" 
                    FontSize="16" BorderBrush="{x:Null}" Margin="0"  Grid.Row="1" MaxWidth="20" MinHeight="20" MinWidth="15" MaxHeight="15" Click="City_clear_btn_Click" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </Grid>

        </Grid>


    </Grid>
</Window>

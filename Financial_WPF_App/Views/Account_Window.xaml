<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Financial_WPF_App"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
    x:Class="Financial_WPF_App.Account_Window"
    mc:Ignorable="d"
    x:Name="AccountWindow" Title="Account_Window" Height="614" Width="1280"  
    FontFamily="Myriad Arabic"
    FontSize="18"
    WindowState="Maximized" WindowStartupLocation="CenterScreen">


    <Window.Resources>
        <ControlTemplate x:Key="DatePickerTemplate1" TargetType="{x:Type DatePicker}">
            <Border Background="{StaticResource LightGray1}" BorderBrush="{x:Null}" BorderThickness="0" Padding="15,0,0,5">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <DoubleAnimation Duration="0" Storyboard.TargetName="PART_DisabledVisual" To="1" Storyboard.TargetProperty="Opacity"/>
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid x:Name="PART_Root" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <Grid.Resources>
                        <SolidColorBrush x:Key="DisabledBrush" Color="white"/>
                        <ControlTemplate x:Key="DropDownButtonTemplate" TargetType="{x:Type Button}">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                            <VisualTransition GeneratedDuration="0:0:0.1" To="MouseOver"/>
                                            <VisualTransition GeneratedDuration="0:0:0.1" To="Pressed"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Duration="0" Storyboard.TargetName="Background" To="#FF448DCA" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"/>
                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[3].(GradientStop.Color)">
                                                    <SplineColorKeyFrame KeyTime="0" Value="#7FFFFFFF"/>
                                                </ColorAnimationUsingKeyFrames>
                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Color)">
                                                    <SplineColorKeyFrame KeyTime="0" Value="#CCFFFFFF"/>
                                                </ColorAnimationUsingKeyFrames>
                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)">
                                                    <SplineColorKeyFrame KeyTime="0" Value="#F2FFFFFF"/>
                                                </ColorAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetName="Background" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                                    <SplineColorKeyFrame KeyTime="0" Value="#FF448DCA"/>
                                                </ColorAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetName="Highlight" Storyboard.TargetProperty="(UIElement.Opacity)">
                                                    <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)">
                                                    <SplineColorKeyFrame KeyTime="0" Value="#EAFFFFFF"/>
                                                </ColorAnimationUsingKeyFrames>
                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Color)">
                                                    <SplineColorKeyFrame KeyTime="0" Value="#C6FFFFFF"/>
                                                </ColorAnimationUsingKeyFrames>
                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[3].(GradientStop.Color)">
                                                    <SplineColorKeyFrame KeyTime="0" Value="#6BFFFFFF"/>
                                                </ColorAnimationUsingKeyFrames>
                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)">
                                                    <SplineColorKeyFrame KeyTime="0" Value="#F4FFFFFF"/>
                                                </ColorAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid Background="{StaticResource MidGray}" FlowDirection="LeftToRight" HorizontalAlignment="Center" Height="18" Margin="0" VerticalAlignment="Center" Width="19">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20*"/>
                                        <ColumnDefinition Width="20*"/>
                                        <ColumnDefinition Width="20*"/>
                                        <ColumnDefinition Width="20*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="23*"/>
                                        <RowDefinition Height="19*"/>
                                        <RowDefinition Height="19*"/>
                                        <RowDefinition Height="19*"/>
                                    </Grid.RowDefinitions>
                                    <Border x:Name="Highlight" BorderBrush="{StaticResource LightGray2}" BorderThickness="1" CornerRadius="0,0,1,1" Grid.ColumnSpan="4" Margin="-1" Opacity="0" Grid.RowSpan="4" Grid.Row="0"/>
                                    <Border x:Name="Background" Background="{StaticResource LightGray1}" BorderBrush="{x:Null}" BorderThickness="1" CornerRadius=".5" Grid.ColumnSpan="4" Margin="0,-1,0,0" Opacity="1" Grid.RowSpan="3" Grid.Row="1"/>

                                    <Rectangle Grid.ColumnSpan="4" Grid.RowSpan="1" StrokeThickness="1">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush EndPoint="0.3,-1.1" StartPoint="0.46,1.6">
                                                <GradientStop Color="{StaticResource Color_LightGray1}"/>
                                                <GradientStop Color="{StaticResource Color_LightGray1}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.Stroke>
                                            <LinearGradientBrush EndPoint="0.48,-1" StartPoint="0.48,1.25">
                                                <GradientStop Color="{StaticResource Color_LightGray1}"/>
                                                <GradientStop Color="{StaticResource Color_MidGray}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Stroke>
                                    </Rectangle>
                                    <Path Grid.Column="0" Grid.ColumnSpan="4" Data="M11.426758,8.4305077 L11.749023,8.4305077 L11.749023,16.331387 L10.674805,16.331387 L10.674805,10.299648 L9.0742188,11.298672 L9.0742188,10.294277 C9.4788408,10.090176 9.9094238,9.8090878 10.365967,9.4510155 C10.82251,9.0929432 11.176106,8.7527733 11.426758,8.4305077 z M14.65086,8.4305077 L18.566387,8.4305077 L18.566387,9.3435936 L15.671368,9.3435936 L15.671368,11.255703 C15.936341,11.058764 16.27293,10.960293 16.681133,10.960293 C17.411602,10.960293 17.969301,11.178717 18.354229,11.615566 C18.739157,12.052416 18.931622,12.673672 18.931622,13.479336 C18.931622,15.452317 18.052553,16.438808 16.294415,16.438808 C15.560365,16.438808 14.951641,16.234707 14.468243,15.826504 L14.881817,14.929531 C15.368796,15.326992 15.837872,15.525723 16.289043,15.525723 C17.298809,15.525723 17.803692,14.895514 17.803692,13.635098 C17.803692,12.460618 17.305971,11.873379 16.310528,11.873379 C15.83071,11.873379 15.399232,12.079271 15.016094,12.491055 L14.65086,12.238613 z" Fill="#FF2F2F2F" HorizontalAlignment="Center" Margin="4,3,4,3" RenderTransformOrigin="0.5,0.5" Grid.RowSpan="3" Grid.Row="1" Stretch="Fill" VerticalAlignment="Center"/>

                                    <Border x:Name="DisabledVisual" BorderBrush="{StaticResource LightGray2}" BorderThickness="1" CornerRadius="0.5" Grid.ColumnSpan="4" Opacity="0" Grid.RowSpan="4" Grid.Row="0"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PART_Button" Grid.Column="1" Foreground="{TemplateBinding Foreground}" Focusable="False" HorizontalAlignment="Left" Margin="3,0,3,0" Grid.Row="0" Template="{StaticResource DropDownButtonTemplate}" VerticalAlignment="Top" Width="20"/>
                    <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Focusable="{TemplateBinding Focusable}" HorizontalContentAlignment="Stretch" Grid.Row="0" VerticalContentAlignment="Stretch"/>
                    <Grid x:Name="PART_DisabledVisual" Grid.Column="0" Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="0" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#A5FFFFFF" Grid.Row="0" RadiusX="1" RadiusY="1"/>
                        <Rectangle Grid.Column="1" Fill="#A5FFFFFF" Height="18" Margin="3,0,3,0" Grid.Row="0" RadiusX="1" RadiusY="1" Width="19"/>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}" StaysOpen="False">
                            <Border BorderThickness="1" BorderBrush="Gray" Background="White">
                                <Calendar x:Name="PART_Calendar" />
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="false">
                    <Setter Property="Foreground" TargetName="PART_TextBox" Value="{Binding Foreground, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid >
        <Grid.ContextMenu>
            <ContextMenu x:Name="cm">
                <MenuItem Header="Refresh Account" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="First_col"  Width="70*"/>
            <ColumnDefinition x:Name="Second_col" Width="30*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>

        <TabControl Grid.ColumnSpan="2" x:Name="tabControl1" Style="{StaticResource TabControlStyle}" Grid.Column="0"></TabControl>

        <Expander Style="{StaticResource AccountExpander}" IsExpanded="False" Grid.Column="1" x:Name="myExpander" ExpandDirection="Right"
         HorizontalContentAlignment="Stretch"
         Expanded="myExpander_Expanded" Collapsed="myExpander_Collapsed" >
            <Grid x:Name="FloatingExpanderContent" Margin="20,7,20,30" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="117"/>
                    <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>

                <Label Style="{DynamicResource FloatingExpanderlableStyle}" Content="Account Name:" Grid.Column="0"/>
                <TextBox Style="{DynamicResource FloatingTextBoxStyle}" Grid.Column="1" x:Name="Name_txtBox" TabIndex="0" Margin="1,0,0,0"/>

                <Label Grid.Row="1" x:Name="City_lable" Style="{DynamicResource FloatingExpanderlableStyle}" Content="City:"  Grid.Column="0"/>
                <Grid Grid.Column="1" Grid.Row="1" Height="30" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{DynamicResource FloatingComboboxStyle}" x:Name="City_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" 
                             TabIndex="1" Grid.Row="1" Grid.Column="0"/>
                    <Button x:Name="City_clear_btn" Grid.Column="1" TabIndex="2" Style="{DynamicResource DeleteButtonStyle}"
                         Grid.Row="1" Click="City_clear_btn_Click"/>
                </Grid>

                <Label Grid.Row="2" x:Name="Project_lable" Style="{DynamicResource FloatingExpanderlableStyle}" Content="Project:" Grid.Column="0" />
                <Grid Grid.Column="1" Grid.Row="2" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*"/>
                        <ColumnDefinition Width="15*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="Project_comboBox" Style="{DynamicResource FloatingComboboxStyle}" DisplayMemberPath="Name" SelectedValuePath="ID" 
             TabIndex="3" 
              SelectionChanged="Project_comboBox_SelectionChanged" Grid.Row="1" Grid.Column="0"
              />
                    <Button x:Name="Project_clear_btn" Grid.Column="1" TabIndex="4"
                        Click="Project_clear_btn_Click"  Grid.Row="1" Style="{DynamicResource DeleteButtonStyle}">
                    </Button>
                </Grid>

                <Label x:Name="SubProject_label" Grid.Row="3" Style="{DynamicResource FloatingExpanderlableStyle}" Content="Center:" Grid.Column="0" />
                <Grid Grid.Column="1" Grid.Row="3" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*"/>
                        <ColumnDefinition Width="15*"/>

                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{DynamicResource FloatingMultiComboboxStyle}" x:Name="SubProject_comboBox" Grid.Column="0" 
                              TabIndex="5" SelectionChanged="SubProject_comboBox_SelectionChanged" 
                              IsEditable="True" PreviewTextInput="comboBox_PreviewTextInput" PreviewKeyDown="comboBox_PreviewKeyDown" Margin="1,0,1,0">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="SubProject_comboBox" Width="220" 
                                            Click="SubProject_Checkbox_Item_Clicked"
                                            Style="{DynamicResource ComboBoxCheckBoxStyle}"
                                            Content="{Binding SubName}" 
                                            IsChecked="{Binding Sub_Check_Status}" 
                                            CommandParameter="{Binding SubID}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="SubProject_clear_btn" TabIndex="6" Grid.Column="1"
                            Click="SubProject_clear_btn_Click" Style="{DynamicResource DeleteButtonStyle}">
                    </Button>
                </Grid>

                <Label x:Name="Donor_label" Grid.Row="4" Style="{DynamicResource FloatingExpanderlableStyle}" Content="Donor:" Grid.Column="0" />
                <Grid Grid.Row="4" Grid.Column="1" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*"/>
                        <ColumnDefinition Width="15*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{DynamicResource FloatingMultiComboboxStyle}" x:Name="Donor_comboBox" Grid.Column="0"
                        TabIndex="7" IsEditable="True" PreviewTextInput="comboBox_PreviewTextInput" PreviewKeyDown="comboBox_PreviewKeyDown">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="Donor_CheckBox" Width="220" 
                                            Click="Donor_Checkbox_Item_Clicked"
                                            Style="{DynamicResource ComboBoxCheckBoxStyle}"
                                            Content="{Binding DonorName}" 
                                            IsChecked="{Binding Check_Status}" 
                                            CommandParameter="{Binding Donor_ID}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>
                    <Button x:Name="Donor_clear_btn" Grid.Column="1" TabIndex="8"
        Click="Donor_clear_btn_Click" Style="{DynamicResource DeleteButtonStyle}">
                    </Button>
                </Grid>

                <Label x:Name="PersonalAccount_label" Grid.Row="5" Style="{DynamicResource FloatingExpanderlableStyle}" Content="Personal account:" Grid.Column="0" />
                <Grid Grid.Column="1" Grid.Row="5" Height="30" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*"/>
                        <ColumnDefinition Width="15*"/>

                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{DynamicResource FloatingMultiComboboxStyle}" x:Name="PersonalAccount_comboBox" Grid.Column="0" 
                        TabIndex="9" IsEditable="True" PreviewTextInput="comboBox_PreviewTextInput" PreviewKeyDown="comboBox_PreviewKeyDown">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="PersonalAcc_comboBox" Width="220" 
              Click="PersonalAcc_Checkbox_Item_Clicked"
            Content="{Binding PersonalAcc_Name}" 
            IsChecked="{Binding PersonalAcc_Check_Status}" 
            CommandParameter="{Binding PersonalAcc_ID}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="PersonalAccount_clear_btn" TabIndex="10" Grid.Column="1"
Click="PersonalAccount_clear_btn_Click" Style="{DynamicResource DeleteButtonStyle}">
                    </Button>
                </Grid>

                <Label x:Name="ExchangeAccount_label" Grid.Row="6" Style="{DynamicResource FloatingExpanderlableStyle}" Content="Exchange account:" Grid.Column="0" />
                <Grid Grid.Column="1" Grid.Row="6" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*"/>
                        <ColumnDefinition Width="15*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{DynamicResource FloatingMultiComboboxStyle}" x:Name="ExchangeAccount_comboBox" Grid.Column="0" 
                       TabIndex="11" IsEditable="True" PreviewKeyDown="comboBox_PreviewKeyDown" PreviewTextInput="comboBox_PreviewTextInput" >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="ExchangeAcc_comboBox" Width="220" 
               Click="ExchangeAcc_Checkbox_Item_Clicked"
            Content="{Binding ExchangeAcc_Name}" 
            IsChecked="{Binding ExchangeAcc_Check_Status}" 
            CommandParameter="{Binding ExchangeAcc_ID}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="ExchangeAccount_clear_btn" TabIndex="12" Grid.Column="1"
                        Click="ExchangeAccount_clear_btn_Click" Style="{DynamicResource DeleteButtonStyle}">
                    </Button>
                </Grid>

                <Label x:Name="ProjectNumber_label" Grid.Row="7" Style="{DynamicResource FloatingExpanderlableStyle}" Content="Project Number:"  Grid.Column="0" />
                <TextBox Style="{DynamicResource FloatingTextBoxStyle}" x:Name="ProjectNumber_txtBox" TabIndex="13"  Grid.Row="7" Grid.Column="1"/>

                <Label x:Name="BeginDate_label" Grid.Row="8" Style="{DynamicResource FloatingExpanderlableStyle}" Content="Start Date:"  Grid.Column="0" />
                <DatePicker  Height="30" x:Name="BeginDate_datepicker" Grid.Column="1" Grid.Row="8" FirstDayOfWeek="Monday" TabIndex="14"/>

                <Label x:Name="EndDate_label" Grid.Row="9" Style="{DynamicResource FloatingExpanderlableStyle}" Content="End Date:" />
                <Grid Grid.Row="9" Grid.Column="1" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85*"/>
                        <ColumnDefinition Width="15*"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker  x:Name="EndDate_datepicker" Grid.Column="0" TabIndex="15" FirstDayOfWeek="Monday" Margin="1,0,1,0"/>
                    <Border x:Name="EndDate_Border" Width="27" Height="30" MouseDown="Border_MouseDown" Grid.Column="1" Background="{StaticResource LightGray1}" ToolTip="TBD" ToolTipService.InitialShowDelay="100" 
                            ToolTipService.ShowDuration="5000"
                            ToolTipService.BetweenShowDelay="200" Margin="3,0,0,0">
                        <CheckBox x:Name="EndDate_CheckBox" TabIndex="16"  ToolTip="TBD" ToolTipService.InitialShowDelay="100" 
                            ToolTipService.ShowDuration="5000"
                            ToolTipService.BetweenShowDelay="200" Style="{StaticResource CheckBoxStyle}"
                            Checked="EndDate_CheckBox_Checked" Unchecked="EndDate_CheckBox_Unchecked" Width="9" HorizontalAlignment="Center" Height="8" Margin="0,0,0,0"
                            />
                    </Border>
                </Grid>

                <Label x:Name="TotalAmount_label" Grid.Row="10" Style="{DynamicResource FloatingExpanderlableStyle}" Content="Total Budget:" Grid.Column="0" />
                <Grid Grid.Row="10" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="87*"/>
                        <ColumnDefinition Width="15*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TotalAmount_txtBox" Style="{DynamicResource FloatingTextBoxStyle}"
                        PreviewTextInput="NumberValidationTextBox" 
                        TabIndex="9" LostFocus="TotalAmount_txtBox_LostFocus" Grid.Column="0"  />
                    <ComboBox x:Name="AmountType_comboBox" Grid.Column="1" DisplayMemberPath="NAME" SelectedValuePath="ID"
                        Style="{DynamicResource SmallComboboxStyle}" TabIndex="17" Margin="3,0,0,0"/>
                </Grid>

                <Label x:Name="IsClosed_label" Grid.Row="11" Style="{DynamicResource FloatingExpanderlableStyle}" Content="Account Status:" Grid.Column="0" />
                <Button x:Name="IsClosed_btn" Grid.Column="1" Grid.Row="11" 
                    Style="{DynamicResource HoverBoxesStyle}" TabIndex="18"  
                    Click="IsClosed_btn_Click" HorizontalContentAlignment="Center" Content="Open" 
                        BorderThickness="1" Height="30" Padding="2,2,2,2">
                </Button>
                <!--<ToggleButton Grid.Row="8" Grid.Column="0" x:Name = "tb" Content = ""  
        Checked = "HandleCheck" Unchecked = "HandleUnchecked" IsChecked="True"
        HorizontalAlignment = "Right" FlowDirection="RightToLeft" >
    <ToggleButton.Background>
        <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
    </ToggleButton.Background>
</ToggleButton>-->


                <StackPanel Height="30" Grid.Row="12" x:Name="AddAdminAcc_StackPanel" Grid.Column="1" Grid.ColumnSpan="1" Orientation="Horizontal"  Margin="3,2,1,2" FlowDirection="RightToLeft">
                    <Button Style="{DynamicResource AddButtonStyle}" 
                            x:Name="AddAdminAcc_btn" TabIndex="15" Click="AddAdminAcc_btn_Click" Width="26"  />
                    <Label x:Name="AddAdminAcc_Label" Style="{DynamicResource FloatingExpanderlableStyle}" 
                            Content="Add administrative account" Width="Auto" Margin="7,0,1,0"  />
                </StackPanel>
                <Button Grid.Row="14" Grid.ColumnSpan="2" x:Name="Save_btn" Grid.Column="0" Style="{DynamicResource ButtonColoredStyle}" TabIndex="11" 
                    Click="Save_btn_Click" Margin="0,8,0,3" Content="Save" VerticalAlignment="Stretch" Grid.RowSpan="2" HorizontalAlignment="Stretch"  />
            </Grid>
        </Expander>
    </Grid>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:WPFTextBoxAutoComplete="clr-namespace:WPFTextBoxAutoComplete;assembly=WPFTextBoxAutoComplete" 
        xmlns:uc ="clr-namespace:Financial_WPF_App.Controls"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        x:Class="Financial_WPF_App.AddAction_Window"
    
        mc:Ignorable="d"
        Title="AddAction_Window" Height="500" Width="700" >
    <Grid >

        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>

                <ColumnDefinition Width="60*"/>
                <ColumnDefinition Width="40*"/>

                <ColumnDefinition Width="60*"/>
                <ColumnDefinition Width="40*"/>

                <ColumnDefinition Width="10*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*" />
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="10*"/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" FlowDirection="RightToLeft" Grid.ColumnSpan="6" >
                <StackPanel.Background>
                    <ImageBrush ImageSource="/Images/MainForm/MainForm Tab Header.png"/>
                </StackPanel.Background>
                <Label Content="الحســــــاب: " Style="{DynamicResource title_lableStyle}" 
                       HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   />
                <Label Content="Account" Style="{DynamicResource title_lableStyle}" 
                       x:Name="AccountName_lable"
                       HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   />
                <Label Content="الصندوق:" Style="{DynamicResource title_lableStyle}" 
                	HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   Margin="0,3,0,4.764"   />
                <Label Content="Till" Style="{DynamicResource title_lableStyle}" 
                	x:Name="TillName_lable"
                	HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   Margin="0,4,0,3.764"   />

                <!--<Label Content="الصــــندوق: " Style="{DynamicResource title_lableStyle}" 
                       HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   />
                <Label Content="syr " Style="{DynamicResource title_lableStyle}" 
                       x:Name="TillName_lable"
                       HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   />-->
            </StackPanel>

            <Label x:Name="MircoProject_ID_lable" Grid.Column="4" Grid.Row="5" 
                Style="{DynamicResource lableStyle}" Content="رقم المشروع:" Margin="10.018,6.182,0,3.582" />
            <uc:AutoCompleteTextBoxUserControl 
                x:Name="MircoProject_ID_autoSuggestionUserControl" 
                Grid.Column="3" Grid.Row="4" Margin="0,41.945,113.527,3.582" TabIndex="1"
                HorizontalAlignment="Right" 
                LostFocus="MircoProject_ID_autoSuggestionUserControl_LostFocus" Grid.ColumnSpan="2" Grid.RowSpan="2" />

            <!--<TextBox x:Name="MircoProject_ID_txtBox" TabIndex="3"
                     Grid.Column="3" Grid.Row="1"  
                TextChanged="MircoProject_ID_txtBox_TextChanged" 
                     Style="{DynamicResource textBoxStyle}" 
                Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}"
                WPFTextBoxAutoComplete:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding XPath=TestItems}" />-->

            <Label x:Name="BeneficiaryName_lable" Grid.Column="2" Grid.Row="5" 
                Style="{DynamicResource lableStyle}" Content="اسم المستفيد:" Margin="4.2,9.182,0,1.582" />
            <TextBox x:Name="BeneficiaryName_txtBox" Style="{DynamicResource textBoxStyle}" 
                Grid.Column="1" Grid.Row="5"  TabIndex="1" IsReadOnly="True" Margin="3.582,9.182,125.473,3.582" Grid.ColumnSpan="2" />
            <StackPanel Grid.Column="3" Grid.Row="2" Orientation="Horizontal" FlowDirection="RightToLeft" x:Name="Till_panel" />

            <Label Grid.Column="4" Grid.Row="4" x:Name="DestinationTill_lable" Style="{DynamicResource lableStyle}" Content="الصندوق المقابل:" Margin="3.018,9.945,0,0.818" />
            <StackPanel Grid.Column="2" Grid.Row="3" x:Name="DestinationTill_panel" Orientation="Horizontal" FlowDirection="RightToLeft" Grid.ColumnSpan="2" Margin="123.2,42.709,1.982,0.818" Grid.RowSpan="2" >
                <ComboBox x:Name="DestinationTill_comboBox" TabIndex="3" 
                          DisplayMemberPath="Type" SelectedValuePath="ID" 
                          FlowDirection="RightToLeft" Height="30" Width="auto" MinWidth="130" FontSize="16"
                          Margin="0,6,0,6.764" VerticalContentAlignment="Center"/>
                <Button x:Name="DestinationTill_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Width="25" Height="25" BorderBrush="{x:Null}" 
                    Click="DestinationTill_clear_btn_Click" Margin="0,9,0,8.764" >
                    <Button.Background>
                        <ImageBrush ImageSource="../Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>

            <ComboBox x:Name="Type_comboBox" TabIndex="4" Grid.Column="3" Grid.Row="1"
                      FlowDirection="RightToLeft" FontSize="14"
                      Height="28" Margin="57.527,13.236,9.982,1.527" Width="auto" MinWidth="100px" IsEditable="True"
                      HorizontalContentAlignment="Right" 
                      SelectionChanged="Type_comboBox_SelectionChanged" >
                <ComboBoxItem x:Name="Type_ComboBox_Income_Item" Content="وارد" />
                <ComboBoxItem x:Name="Type_ComboBox_Outcome_Item" Content="سلفة"/>
                <ComboBoxItem x:Name="Type_ComboBox_Returned_Item" Content="مرتجع"/>
                <ComboBoxItem x:Name="Type_ComboBox_Expand_Item" Content="صادر/مصروف"/>
            </ComboBox>

            <TextBox x:Name="Amount_txtBox" Style="{DynamicResource textBoxStyle}" 
                Grid.Column="1" Grid.Row="1" TabIndex="5"
                LostFocus="Amount_txtBox_LostFocus" Margin="117.582,12.236,12.473,1.527" Grid.ColumnSpan="2"   />

            <Label x:Name="Date_Label" Grid.Column="2" Grid.Row="6" Style="{DynamicResource lableStyle}" Content="تاريخ الفاتورة:" Margin="0.2,6.418,0,4.345"  />
            <DatePicker x:Name="Date_datepicker" Grid.Column="1" Grid.Row="6"  TabIndex="8"
                        Margin="0.582,5.418,125.473,3.345" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                        SelectedDateChanged="Date_datepicker_SelectedDateChanged" Grid.ColumnSpan="2" />

            <Label x:Name="CreatedAt_Label" Grid.Column="4" Grid.Row="2" Style="{DynamicResource lableStyle}" Content="تاريخ العملية:" Margin="0.018,10.473,0,0.291"  />
            <DatePicker x:Name="CreatedAt_datepicker" Grid.Row="2"
                        Margin="1.527,4.473,123.527,4.291" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                        SelectedDateChanged="Date_datepicker_SelectedDateChanged" Grid.ColumnSpan="2" Grid.Column="3" />

            <Label x:Name="Notes_Label" Grid.Column="4" Grid.Row="3" Style="{DynamicResource lableStyle}" Content="البيان:" Margin="14.018,6.709,0,4.055" />
            <TextBox x:Name="Notes_txtBox" Style="{DynamicResource textBoxStyle}"  HorizontalContentAlignment="Right"
                     Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="3" TabIndex="9" Margin="16.582,7.709,113.527,5.055"   />

            <ComboBox x:Name="IsReceipt_comboBox" Grid.Column="4" Grid.Row="6" TabIndex="6" 
                FlowDirection="RightToLeft" FontSize="14"
                      Height="28" Margin="3.018,8.418,2.527,6.345" Width="auto" MinWidth="100px" IsEditable="True"
                      HorizontalContentAlignment="Right" >
                <ComboBoxItem Content="فاتورة" />
                <ComboBoxItem Content="إيصال"/>
            </ComboBox>

            <TextBox x:Name="Receipt_txtBox" Style="{DynamicResource textBoxStyle}"
                     Grid.Column="2" Grid.Row="6" TabIndex="7" Grid.ColumnSpan="2" Margin="125.2,6.418,3.982,6.345" />
            <TextBlock Grid.Column="3" Grid.Row="6" x:Name="Placeholder1" IsHitTestVisible="False" 
                Text="رقم الفاتورة..." Foreground="DarkGray" FlowDirection="RightToLeft"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,13.418,2.982,13.345" >
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Type_comboBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=Receipt_txtBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>




            <Label Grid.Column="4" Grid.Row="7" x:Name="AvgRate_lable" Style="{DynamicResource lableStyle}" Content="Avg Rate:" Margin="0.018,1.655,0,9.109"  />
            <TextBox x:Name="AvgRate_TxtBox" Style="{DynamicResource textBoxStyle}" 
                     Grid.Column="3" Grid.Row="7" TabIndex="13" IsReadOnly="True" Margin="1.527,2.655,1.982,10.109"  />
            <!--<StackPanel  Grid.Column="3" Grid.Row="7" x:Name="AvgRate_panel" Orientation="Horizontal" FlowDirection="RightToLeft" >
                <ComboBox x:Name="AvgRate_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" 
                    FlowDirection="RightToLeft" Height="30" Width="auto" MinWidth="130" FontSize="16"
                    TabIndex="12" Margin="0" VerticalContentAlignment="Center"
                    SelectionChanged="Rate_comboBox_SelectionChanged"  />
                <Button x:Name="Avg_clear_btn" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Width="25" Height="25" BorderBrush="{x:Null}" 
                    Click="Avg_clear_btn_Click" >
                    <Button.Background>
                        <ImageBrush ImageSource="../Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>-->

            <Label Grid.Column="2" Grid.Row="7" x:Name="USD_Value_lable" Style="{DynamicResource lableStyle}" Content="Value ($):" Margin="0.2,1.655,0,9.109"  />
            <TextBox x:Name="USD_Value_TxtBox" Style="{DynamicResource textBoxStyle}" 
                     Grid.Column="1" Grid.Row="7" TabIndex="13" IsReadOnly="True" Margin="1.582,2.655,1.8,10.109"  />

            <Label x:Name="Rate_lable" Grid.Column="4" Grid.Row="7" Style="{DynamicResource lableStyle}" Content="Rate:" Margin="0.018,42.655,0,10.873" Grid.RowSpan="2"   />
            <TextBox x:Name="Rate_txtBox" Style="{DynamicResource textBoxStyle}" 
                Grid.Column="3" Grid.Row="8" TabIndex="14"   
                LostFocus="Rate_txtBox_LostFocus" Margin="1.527,2.891,1.982,9.873"  />

            <Label x:Name="Exchanged_lable" Grid.Column="2" Grid.Row="8" Style="{DynamicResource lableStyle}" Content="Exchanged:" Margin="0.2,0.891,0,9.873"   />
            <TextBox x:Name="Exchanged_txtBox" Style="{DynamicResource textBoxStyle}" 
                Grid.Column="1" Grid.Row="8" TabIndex="14" IsReadOnly="True" Margin="1.582,2.891,1.8,9.873"  />

            <Button Grid.Row="9" Grid.Column="1" 
                    Style="{DynamicResource SaveButton_Style}"
                x:Name="Save_btn" TabIndex="15" Click="Save_btn_Click" Margin="9.582,1.127,0,9.636" />
            <Label Grid.Column="4" Grid.Row="1" Style="{DynamicResource lableStyle}" Content="نوع العملية:" Margin="0.018,11.236,0,42.291" Grid.RowSpan="2"  />
            <TextBlock Grid.Column="2" Grid.Row="1" x:Name="Placeholder2" IsHitTestVisible="False" 
            	Text="المبلغ..." Foreground="DarkGray" FlowDirection="RightToLeft"
            	HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,18.236,11.473,8.527" >
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Amount_txtBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

    </Grid>
</Window>

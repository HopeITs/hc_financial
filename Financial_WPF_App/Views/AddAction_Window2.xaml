<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:WPFTextBoxAutoComplete="clr-namespace:WPFTextBoxAutoComplete;assembly=WPFTextBoxAutoComplete" 
        xmlns:uc ="clr-namespace:Financial_WPF_App.Controls"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        x:Class="Financial_WPF_App.Views.AddAction_Window2"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:helper="clr-namespace:Financial_WPF_App.helper"
        mc:Ignorable="d" Tag="Add Action Window2"
        Title="AddAction_Window2" d:DesignHeight="900"
        WindowStartupLocation="CenterScreen" Style="{StaticResource WindowPopupStyle}">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0">
            <local:WindowControlBar_Popup x:Name="ControlBar"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" >

            <Grid Grid.Row="1"  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="1" Style="{DynamicResource statistic_lableStyle}" Content="Project:" HorizontalContentAlignment="Left"  />
                <ComboBox Grid.Row="0" x:Name="Subproject_comboBox" TabIndex="1" Grid.Column="2"
            DisplayMemberPath="Subproject_Name" SelectedValuePath="Subproject_ID"
            Style="{DynamicResource FloatingComboboxStyle}"
            IsEditable="True"
            IsTextSearchEnabled="False"
            StaysOpenOnEdit="True"
            SelectionChanged="Subproject_comboBox_SelectionChanged" >
                    <i:Interaction.Behaviors>
                        <helper:MouseClickComboBoxBehavior />
                        <helper:DataViewContainsFilterComboBoxBehavior />
                    </i:Interaction.Behaviors>
                </ComboBox>

                <Label Grid.Row="0" Grid.Column="4" Style="{DynamicResource statistic_lableStyle}" Content="Account:" HorizontalContentAlignment="Left"  />
                <ComboBox Grid.Row="0" Grid.Column="5" x:Name="Account_comboBox" TabIndex="2" Style="{StaticResource FloatingComboboxStyle}"
            DisplayMemberPath="Account_Name" SelectedValuePath="Account_ID" 
            HorizontalContentAlignment="Left" 
            VerticalAlignment="Stretch" SelectionChanged="Account_comboBox_SelectionChanged" >
                </ComboBox>

                <Label Grid.Row="1" Grid.Column="1" Style="{DynamicResource statistic_lableStyle}" Content="Till:" HorizontalContentAlignment="Left" />
                <ComboBox x:Name="Till_comboBox" Grid.Row="1" Grid.Column="2" TabIndex="3"  DisplayMemberPath="Tilltypes_Name" SelectedValuePath="Till_ID" 
              Style="{DynamicResource FloatingComboboxStyle}"
                HorizontalContentAlignment="Left"  SelectionChanged="Till_comboBox_SelectionChanged" >
                </ComboBox>

                <Label Grid.Column="4" Grid.Row="1" Style="{DynamicResource statistic_lableStyle}" Content="Operation type:"  HorizontalContentAlignment="Left"  />
                <ComboBox x:Name="Type_comboBox" TabIndex="4" Grid.Column="5" Grid.Row="1" 
             Style="{StaticResource FloatingComboboxStyle}"
             HorizontalContentAlignment="Left" 
             SelectionChanged="Type_comboBox_SelectionChanged" HorizontalAlignment="Right" Margin="0,5,1,5" Width="248"/>

                <Label x:Name="Amount_Label" Grid.Row="2" Grid.Column="1" Style="{DynamicResource statistic_lableStyle}" Content="Amount:" HorizontalContentAlignment="Left" />
                <TextBox x:Name="Amount_txtBox" Style="{DynamicResource FloatingTextBoxStyle}" 
            Grid.Column="2" Grid.Row="2" TabIndex="5" 
            LostFocus="Amount_txtBox_LostFocus" />

                <Label x:Name="ActionDate_Label" Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="Operation date:" HorizontalContentAlignment="Left" Grid.Column="1"  />
                <DatePicker Height="30" x:Name="ActionDate_datepicker" Grid.Row="3" TabIndex="6" 
            FirstDayOfWeek="Monday" Grid.Column="2" SelectedDateChanged="ActionDate_datepicker_SelectedDateChanged" />

                <Label x:Name="Attachment_lable" Grid.Column="4" Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="Attachments:"  HorizontalContentAlignment="Left"   />
                <Grid Grid.Row="3" Grid.Column="5" Height="30" x:Name="AddedAttachments_panel" Margin="1,0,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <!-- TextBox will stretch -->
                        <ColumnDefinition Width="*" />
                        <!-- Clear button -->
                        <ColumnDefinition Width="*" />
                        <!-- Add button -->
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="AddedAttachments_lable"
     IsReadOnly="True"
     Style="{DynamicResource FloatingTextBoxStyle}" 
     Text="Count: 0"
     Grid.Column="0"
     Margin="0,0,0,0" />

                    <Button x:Name="AddedAttachments_clear_btn"
    Grid.Column="1"  Margin="4,0,0,0"
    Style="{StaticResource DeleteButtonStyle}"
    Click="AddedAttachments_clear_btn_Click"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
    ToolTip="Clear Attachments"
    ToolTipService.InitialShowDelay="100"  />

                    <Button x:Name="Add_Attachment_btn"
Grid.Column="2" Margin="4,0,0,0" Width="27"
ToolTip="Add Attachment"
ToolTipService.InitialShowDelay="100"
Click="Add_Attachment_btn_Click"
  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="30" >


                        <!-- Use the existing AddButtonStyle and modify only the Disabled State -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AddButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="/Images/Icons/add_attach_disabled.png" Stretch="Fill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="/Images/Icons/add_attach.png" Stretch="Fill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </Grid>

                <Label x:Name="Notes_Label" Grid.Column="1" Grid.Row="4" Style="{DynamicResource statistic_lableStyle}" Content="Description (AR):" HorizontalContentAlignment="Left" />
                <TextBox x:Name="Notes_txtBox" Style="{DynamicResource FloatingTextBoxStyle}" HorizontalContentAlignment="Right"
            Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="4" Grid.RowSpan="2" TabIndex="7" Margin="1,0,1,0" Height="NaN" 
            AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                <Label x:Name="E_Notes_Label" Grid.Row="6" Style="{DynamicResource statistic_lableStyle}" Content="Description (Eng):" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Grid.Column="1" />
                <TextBox x:Name="E_Notes_txtBox" Style="{DynamicResource FloatingTextBoxStyle}"  HorizontalContentAlignment="Left" Grid.Row="6" TabIndex="8"  Grid.Column="2" Grid.ColumnSpan="4" Grid.RowSpan="2" AcceptsReturn="True"
            TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="70" Margin="1,0,1,0"/>

                <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,0,0,0" Padding="0"
             BorderBrush="#DDDDDD" BorderThickness="0" CornerRadius="5">

                    <ContentControl x:Name="DynamicOperationContainer"/>

                </Border>

                <Button Grid.Row="9" 
            Style="{DynamicResource ButtonColoredStyle}" Content="Save"
            x:Name="Save_btn" TabIndex="9" Click="Save_btn_Click" Grid.Column="1" />

            </Grid>

        </ScrollViewer>
    </Grid>
</Window>

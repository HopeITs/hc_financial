<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" 
        x:Class="Financial_WPF_App.Views.Add_MultiActions_Window"
        mc:Ignorable="d"
        Title="Add_MultiActions_Window" Width="1000" Height="600" WindowStartupLocation="CenterScreen" >

    <Grid>
        <Grid  Grid.Column="0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="233*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                    <Border Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource MainBorderWrapPanelStyle}">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Error:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                    <Border Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="Error_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"/>
                    </Border>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,5,0,0" Grid.ColumnSpan="2" >
                <DockPanel  LastChildFill="True" Background="{StaticResource LightGray1}" VerticalAlignment="Center" Height="40">
                    <WrapPanel Orientation="Horizontal" Width="Auto" ItemHeight="40">
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Grid.Row="1">
                            <Label Style="{DynamicResource statistic_lableStyle}" Content="Operation type:" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="Type_comboBox" Style="{StaticResource ActionComboboxStyle}"
                                  IsEditable="True" 
                                SelectionChanged="Type_comboBox_SelectionChanged" >
                                <ComboBoxItem x:Name="Type_ComboBox_Income_Item" Content="Income" />
                                <ComboBoxItem x:Name="Type_ComboBox_Outcome_Item" Content="Adv. Payment"/>
                                <ComboBoxItem x:Name="Type_ComboBox_Returned_Item" Content="Returned"/>
                                <ComboBoxItem x:Name="Type_ComboBox_Exchange_Item" Content="Exchange"/>
                                <ComboBoxItem x:Name="Type_ComboBox_Expand_Item" Content="Expenses"/>
                                <ComboBoxItem x:Name="Type_ComboBox_Move_Item" Content="Move"/>
                            </ComboBox>
                            <Button x:Name="clear_type_btn" Style="{StaticResource ActionDeleteButtonStyle}" Width="27" Height="30" BorderBrush="{x:Null}" Click="clear_type_btn_Click" >
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Account Type:" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
                        <StackPanel  Orientation="Horizontal" FlowDirection="LeftToRight">
                            <ComboBox x:Name="AccountType_comboBox" Style="{StaticResource ActionComboboxStyle}" TabIndex="1"
                                IsEditable="True" SelectionChanged="AccountType_comboBox_SelectionChanged" >
                                <ComboBoxItem x:Name="ComboBox_MicroProject_Item" Content="Micro Project Account" />
                                <ComboBoxItem x:Name="ComboBox_Budget_Item" Content="Budget Account"/>
                                <ComboBoxItem x:Name="ComboBox_Exchange_Item" Content="Exchange Account"/>
                                <ComboBoxItem x:Name="ComboBox_Personal_Item" Content="Personal Account"/>
                            </ComboBox>
                        </StackPanel>



                        <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight">
                            <Label Style="{DynamicResource statistic_lableStyle}" Content="Till Type:" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
                            <ComboBox x:Name="Tilltype_comboBox" Style="{StaticResource ActionComboboxStyle}" 
                                DisplayMemberPath="Tilltypes_Name" SelectedValuePath="Tilltypes_ID" 
                                HorizontalContentAlignment="Right"  SelectionChanged="Tilltype_comboBox_SelectionChanged" >
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </Grid>
            <Grid Grid.Row="3" Margin="0,5,0,0" Grid.ColumnSpan="2" >
                <DockPanel  LastChildFill="True" Background="{StaticResource LightGray1}" Height="40">
                    <WrapPanel Orientation="Horizontal" Width="Auto">

                        <StackPanel x:Name="ExportToExcel_StackPanel" Margin="10,0,0,0">
                            <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" Command="local:Commands.ExportToExcel"  Width="30" Height="25" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,10,1,1">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="ClearAll_panel" Orientation="Horizontal" Margin="0,8,1,1" VerticalAlignment="Center" >
                            <Label x:Name="ClearAll_lable" Style="{DynamicResource statistic_lableStyle}" Content="Clear All:" />
                            <Button Style="{StaticResource ActionDeleteButtonStyle}" x:Name="clear_btn" Click="clear_btn_Click" Width="18" Height="18" >
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/delete_actionbar.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </Grid>
            

            <syncfusion:SfDataGrid x:Name="myDataGrid"  ShowRowHeader="True"
            AutoGenerateColumns="True"
            GridPasteOption="PasteData"
            GridValidationMode="InView"
            Style="{DynamicResource SfDataGrid_body}"
            HeaderStyle="{DynamicResource SfDataGrid_header}"
            RowStyle="{DynamicResource SfDataGrid_RowStyle}"
            AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"   
            AllowFiltering ="False" ShowGroupDropArea ="False"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
            Loaded="myDataGrid_Loaded" Grid.Row="4"/>

            <syncfusion:SfCircularProgressBar x:Name="circularProgressBar" IsIndeterminate="False" 
                ShowProgressValue ="True"
                 Grid.Row="4"/>

            <Button Grid.Row="5"  Style="{DynamicResource ButtonColoredStyle}"
                x:Name="Save_btn" Content="Save" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="175" Margin="12,0,1,0" />
        </Grid>

    </Grid>
</Window>

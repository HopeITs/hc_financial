<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" 
        x:Class="Financial_WPF_App.Views.Add_MultiActions_Window"
        mc:Ignorable="d"
        Title="Add_MultiActions_Window" Width="1000" Height="600" WindowStartupLocation="CenterScreen" >

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="298*"/>
                <ColumnDefinition Width="197*"/>
                <ColumnDefinition Width="139*"/>
                <ColumnDefinition Width="227*"/>
                <ColumnDefinition Width="139*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="47*"/>
                <RowDefinition Height="47*"/>
                <RowDefinition Height="431*"/>
                <RowDefinition Height="59*"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="4" Style="{DynamicResource lableStyle}" Content="Operation type:" Margin="1,1,1,1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Grid.Row="1"  />


            <syncfusion:SfDataGrid x:Name="myDataGrid"  ShowRowHeader="True"
            AutoGenerateColumns="True"
            GridPasteOption="PasteData"
            GridValidationMode="InView"
            Style="{DynamicResource SfDataGrid_body}"
            HeaderStyle="{DynamicResource SfDataGrid_header}"
            RowStyle="{DynamicResource SfDataGrid_RowStyle}"
            AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"   
            AllowFiltering ="False" ShowGroupDropArea ="False"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
            Margin="0,2,0,0" Grid.ColumnSpan="5" Loaded="myDataGrid_Loaded" Grid.Row="2"/>


            <StackPanel x:Name="ClearAll_panel" Orientation="Horizontal" Margin="0,1,1,1" Grid.Row="1" >
                <Label x:Name="ClearAll_lable" Style="{DynamicResource lableStyle}" Content="Clear All:" Height="44" Width="65" FlowDirection="LeftToRight" />
                <Button x:Name="clear_btn" Width="21" Height="44" BorderBrush="{x:Null}" Click="clear_btn_Click" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            <Grid Grid.Row="3" Grid.ColumnSpan="5" Margin="1,1,1,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250*"/>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="250*"/>
                </Grid.ColumnDefinitions>
                <Button 
                Style="{DynamicResource SaveButton_Style}"
                x:Name="Save_btn" TabIndex="20" Click="Save_btn_Click" Margin="10,4,10,4" Height="NaN" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Button
                    TabIndex="5" Style="{DynamicResource Export_Style}" x:Name="Export_btn" Margin="10,16,411,16" Command="Helper:Commands.ExportToExcel" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RenderTransformOrigin="0.536,0.355"
                />
            </Grid>
            <StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="1,1,1,1" Grid.Row="1">
                <ComboBox x:Name="Type_comboBox" TabIndex="1"
                FlowDirection="RightToLeft" FontSize="14" Width="177" MinWidth="100px" IsEditable="True"
                HorizontalContentAlignment="Right" 
                SelectionChanged="Type_comboBox_SelectionChanged" Height="37" >
                    <ComboBoxItem x:Name="Type_ComboBox_Income_Item" Content="Income" />
                    <ComboBoxItem x:Name="Type_ComboBox_Outcome_Item" Content="Adv. Payment"/>
                    <ComboBoxItem x:Name="Type_ComboBox_Returned_Item" Content="Returned"/>
                    <ComboBoxItem x:Name="Type_ComboBox_Exchange_Item" Content="Exchange"/>
                    <ComboBoxItem x:Name="Type_ComboBox_Expand_Item" Content="Expenses"/>
                    <ComboBoxItem x:Name="Type_ComboBox_Move_Item" Content="Move"/>
                </ComboBox>
                <Button x:Name="clear_type_btn" Width="21" Height="44" BorderBrush="{x:Null}" Click="clear_type_btn_Click" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            <Label Grid.Column="4" Style="{DynamicResource lableStyle}" Content="Account Type:" Margin="1,1,1,1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
            <StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="1,1,1,1">
                <ComboBox x:Name="AccountType_comboBox" TabIndex="1"
                    FlowDirection="RightToLeft" FontSize="14" Width="213" MinWidth="100px" IsEditable="True"
                    HorizontalContentAlignment="Right" 
                    SelectionChanged="AccountType_comboBox_SelectionChanged" Height="37" >
                    <ComboBoxItem x:Name="ComboBox_MicroProject_Item" Content="Micro Project Account" />
                    <ComboBoxItem x:Name="ComboBox_Budget_Item" Content="Budget Account"/>
                    <ComboBoxItem x:Name="ComboBox_Exchange_Item" Content="Exchange Account"/>
                    <ComboBoxItem x:Name="ComboBox_Personal_Item" Content="Personal Account"/>
                </ComboBox>
            </StackPanel>
            <Label Grid.Column="2" Style="{DynamicResource lableStyle}" Content="Till Type:" Margin="1,1,1,1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" RenderTransformOrigin="0.5,0.5"  >
                <Label.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="-0.066"/>
                        <RotateTransform/>
                        <TranslateTransform X="-0.026"/>
                    </TransformGroup>
                </Label.RenderTransform>
            </Label>
            <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="2,1,1,1">
                <ComboBox x:Name="Tilltype_comboBox" TabIndex="1"
                    FlowDirection="RightToLeft" FontSize="14" Width="193" MinWidth="100px"
                    DisplayMemberPath="Tilltypes_Name" SelectedValuePath="Tilltypes_ID" 
                    HorizontalContentAlignment="Right" Height="37" SelectionChanged="Tilltype_comboBox_SelectionChanged" >
                </ComboBox>
            </StackPanel>
        </Grid>

    </Grid>
</Window>

<Window x:Name="SubProject_Window" x:Class="Financial_WPF_App.SubProjectWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        mc:Ignorable="d"
        Title="SubProjectWindow" Width="1000" Height="600"  
        WindowStartupLocation="CenterScreen" KeyDown="SubProjectWindow_KeyDown" 
        FontFamily="Myriad Arabic" FontSize="16">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Window.Resources>

    </Window.Resources>
    <Window.Foreground>
        <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
    </Window.Foreground>
    <Grid>
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="50*"></ColumnDefinition>
                <ColumnDefinition Width="25*"></ColumnDefinition>
                <ColumnDefinition Width="20*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="12*"></RowDefinition>
                <RowDefinition Height="12*"></RowDefinition>
                <RowDefinition Height="12*"></RowDefinition>
                <RowDefinition Height="12*"></RowDefinition>
                <RowDefinition Height="12*"></RowDefinition>
                <RowDefinition Height="12*" ></RowDefinition>
                <RowDefinition Height="20*" ></RowDefinition>
                <RowDefinition Height="89*" ></RowDefinition>
                <RowDefinition Height="41.785" ></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="3"  Style="{DynamicResource lableStyle}" Content="Project:" Height="32" HorizontalContentAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,2,1,2" />
            <ComboBox x:Name="Project_comboBox" 
                      Grid.Column="2"  TabIndex="1" 
                      DisplayMemberPath="Name" SelectedValuePath="ID" Width="auto" FlowDirection="RightToLeft" Grid.ColumnSpan="2" Height="28" Margin="0,0,190,0" />

            <Label Grid.Column="3" Grid.Row="1" Style="{DynamicResource lableStyle}" Content="City:" Height="33" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,1,1,-1" HorizontalContentAlignment="Right" />
            <ComboBox x:Name="City_comboBox" Grid.Column="2" Grid.Row="1" DisplayMemberPath="Name" SelectedValuePath="ID"  FlowDirection="RightToLeft" Height="28" TabIndex="2" Margin="0,0,190,0" VerticalContentAlignment="Center" Grid.ColumnSpan="2"  />

            <Label Grid.Column="3" Grid.Row="2" Style="{DynamicResource lableStyle}" Content="Center name:" Height="33" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,1,1,-2" HorizontalContentAlignment="Right"/>
            <TextBox x:Name="Name_txtBox" Grid.Column="2" Grid.Row="2"  TabIndex="3"
                     Style="{DynamicResource textBoxStyle}" Width="Auto" Height="30" Margin="2,0,2,0" />

            <Label Grid.Column="3" Grid.Row="3" Style="{DynamicResource lableStyle}" Content="Start date:" Height="33" HorizontalContentAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1,1,1,1" />
            <DatePicker x:Name="beginDate_datepicker" Grid.Column="2" Grid.Row="3" TabIndex="4" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="34" Margin="91,0,0,0" Width="147" />

            <Label Grid.Column="3" Grid.Row="4" Style="{DynamicResource lableStyle}" Content="End date:" Height="33" HorizontalAlignment="Stretch" Margin="1,0,1,0" HorizontalContentAlignment="Right" />
            <DatePicker x:Name="endDate_datepicker" Grid.Column="2" Grid.Row="4" TabIndex="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="33" Margin="91,0,0,0" Width="147"  />
            <CheckBox x:Name="EndDate_CheckBox" Grid.Column="2" Grid.Row="4" Content="TBD"
                      HorizontalAlignment="Left"  VerticalAlignment="Center" FlowDirection="RightToLeft" 
                      Height="17" Margin="1,0,0,0" Width="71" 
                      Checked="EndDate_CheckBox_Checked" Unchecked="EndDate_CheckBox_Unchecked" />

            <Grid x:Name="donors_grid" Grid.Column="1" Grid.Row="0" Grid.RowSpan="7" Grid.ColumnSpan="2" Margin="0,0,238,60" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*"></ColumnDefinition>
                    <ColumnDefinition Width="8*"></ColumnDefinition>
                    <ColumnDefinition Width="30*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="13*"></RowDefinition>
                    <RowDefinition Height="13*"></RowDefinition>
                    <RowDefinition Height="13*"></RowDefinition>
                    <RowDefinition Height="13*"></RowDefinition>
                    <RowDefinition Height="13*"></RowDefinition>
                    <RowDefinition Height="22*" ></RowDefinition>
                </Grid.RowDefinitions>

                <Label Grid.Column="2" Grid.Row="0"
                       Style="{DynamicResource lableStyle}" Content="Al donors" 
                       HorizontalAlignment="Stretch"  HorizontalContentAlignment="Center"
                       VerticalAlignment="Stretch"/>
                <ListBox x:Name="alldonors_listbox" 
                         Grid.Column="2" Grid.Row="1" Grid.RowSpan="5" 
                         Height="auto" Margin="30,10,10,10" 
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="auto">
                    <ListBox.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeBlue1}"/>
                    </ListBox.Background>
                </ListBox>

                <Button Grid.Column="1" Grid.Row="2" x:Name="add_btn"  
                         Content="&lt;&lt;" Width="35" TabIndex="4"
                        Click="AddDonor_btn_Click" Padding="4" Margin="10.2,2,10,2.2" >
                    <Button.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue1}"/>
                    </Button.BorderBrush>
                    <Button.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue1}"/>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                    </Button.Foreground>
                </Button>

                <Button Grid.Column="1" Grid.Row="4" x:Name="remove_btn" 
                       Content="&gt;&gt;" Height="35" Width="35" TabIndex="4" 
                        Click="RemoveDonor_btn_Click" Padding="4" >
                    <Button.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue1}"/>
                    </Button.BorderBrush>
                    <Button.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue1}"/>
                    </Button.Background>
                    <Button.Foreground>
                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                    </Button.Foreground>
                </Button>


                <Label Grid.Column="0" Grid.Row="0" Style="{DynamicResource lableStyle}" 
                       Content="Center dononrs" 
                       Margin="10,0,30,0" Width="auto" HorizontalAlignment="Stretch" 
                       VerticalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                <ListBox x:Name="donors_listbox"  Grid.Column="0" Grid.Row="1" Height="auto" 
                         Margin="10,10,30,10" Grid.RowSpan="5" 
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="auto">
                    <ListBox.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeBlue1}"/>
                    </ListBox.Background>

                </ListBox>
            </Grid>

            <syncfusion:SfDataGrid Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="7" FrozenColumnCount="2"
                      x:Name="myDataGrid"  
                            Style="{DynamicResource SfDataGrid_body}"
                               HeaderStyle="{DynamicResource SfDataGrid_header}"
                               RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                               AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                      SelectionChanged="myDataGrid_SelectionChanged" Loaded="myDataGrid_Loaded" HorizontalAlignment="Stretch" Margin="11,9,8,8" VerticalAlignment="Stretch" FilterChanged="myDataGrid_FilterChanged">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="ID" HeaderText="#" 
                                               IsHidden="True" />
                    <syncfusion:GridTextColumn MappingName="Project" HeaderText="Project" />
                    <syncfusion:GridTextColumn MappingName="City" HeaderText="City" />
                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Center" />


                    <syncfusion:GridDateTimeColumn HeaderText="Start date" MappingName="BeginDate"
                                                   CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"/>
                    <syncfusion:GridDateTimeColumn HeaderText="End date" MappingName="EndDate"
                                                   CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"/>


                    <syncfusion:GridTemplateColumn HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
            <StackPanel Orientation="Horizontal" Grid.Row="7" FlowDirection="RightToLeft" Grid.ColumnSpan="5" Margin="-1,266,0,2" Grid.RowSpan="2" >
                <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" />
                <Border Style="{StaticResource BorderStackPanelStyle}" >
                    <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"/>
                </Border>

                <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"  />
                </Border>
            </StackPanel>
            <Grid Grid.Row="6" Margin="10,10,238,10" Grid.Column="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="100*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="90*"/>
                    <RowDefinition Height="6*"/>
                </Grid.RowDefinitions>
                <Button

                    TabIndex="5" Style="{DynamicResource Export_Style}" Grid.Row="1" x:Name="Export_btn" Margin="10,4,0,0" HorizontalAlignment="Left" Grid.Column="2" Command="local:Commands.ExportToExcel" VerticalAlignment="Top" />
                <Button Grid.Column="1" Grid.Row="1"  Style="{DynamicResource SaveButton_Style}"
                    x:Name="Save_btn" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" Margin="4,0,0,0" />
            </Grid>


        </Grid>
    </Grid>
</Window>

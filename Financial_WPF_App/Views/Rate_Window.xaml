<Window x:Class="Financial_WPF_App.Views.Rate_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        mc:Ignorable="d"
        Title="Rate_Window" Width="1280" Height="749" WindowStartupLocation="CenterScreen">


    <Grid x:Name="MainGrid">
        <Grid.ContextMenu>
            <ContextMenu Name="cm">
                <MenuItem Header="Refresh Rate" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="Row1" Height="175"></RowDefinition>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid x:Name="Grid1" Grid.Row="0" Margin="4,3,3,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45*"></ColumnDefinition>
                <ColumnDefinition Width="165*"></ColumnDefinition>
                <ColumnDefinition Width="160*"></ColumnDefinition>
                <ColumnDefinition Width="182*"></ColumnDefinition>
                <ColumnDefinition Width="85*"></ColumnDefinition>
                <ColumnDefinition Width="182*"></ColumnDefinition>
                <ColumnDefinition Width="114*"></ColumnDefinition>
                <ColumnDefinition Width="182*"></ColumnDefinition>
                <ColumnDefinition Width="114*"></ColumnDefinition>
                <ColumnDefinition Width="45*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"></RowDefinition>
                <RowDefinition Height="10*"></RowDefinition>
                <RowDefinition Height="10*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="8" Grid.Row="0" Style="{DynamicResource lableStyle}" Content="Rate group name:" Margin="1,10,1,11" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.ColumnSpan="2" HorizontalContentAlignment="Right" />
            <TextBox x:Name="Name_txtBox" Grid.Column="7" TabIndex="2"  Style="{DynamicResource textBoxStyle}" Margin="1,0,1,0" VerticalContentAlignment="Stretch" Height="29"/>

            <Label x:Name="BeginDate_lable" Grid.Column="6" Grid.Row="0" Style="{DynamicResource lableStyle}" Content="Start date:" Margin="1,11,1,11" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right"/>
            <DatePicker x:Name="BeginDate_datepicker" Grid.Column="5" TabIndex="3"
                         SelectedDateChanged="BeginDate_datepicker_SelectedDateChanged" Margin="14,0,0,0" Width="158" HorizontalAlignment="Left" Height="32"/>

            <Label x:Name="EndDate_lable" Grid.Column="4" Grid.Row="0" Style="{DynamicResource lableStyle}" Content="End date:" Margin="1,12,181,12" HorizontalContentAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.ColumnSpan="2"  />
            <DatePicker x:Name="EndDate_datepicker" Grid.Column="3" TabIndex="4"   
                        SelectedDateChanged="BeginDate_datepicker_SelectedDateChanged" Margin="14,0,0,0" Width="158" HorizontalAlignment="Left" Height="31"/>

            <Label Grid.Column="2" Grid.Row="0" Style="{DynamicResource lableStyle}" Content="Value:" Margin="1,14,1,13" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  />
            <TextBox x:Name="Value_txtBox"  TabIndex="6"
                    Style="{DynamicResource textBoxStyle}" IsReadOnly="True" Margin="10,0,9,0" Grid.Column="1" Height="28" />

            <Button Grid.Row="2" Grid.Column="4"
                    Style="{DynamicResource SaveButton_Style}" x:Name="Save_btn"
                    TabIndex="10" Click="Save_btn_Click" Margin="4,0,0,0" Height="38" Width="88" Grid.ColumnSpan="2"   />
            <Label x:Name="EndDate_lable_Copy" Grid.Column="6" Grid.Row="1" Style="{DynamicResource lableStyle}" Content="From till:" Margin="1,12,1,12" HorizontalContentAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  />
            <Label x:Name="EndDate_lable_Copy1" Grid.Column="4" Grid.Row="1" Style="{DynamicResource lableStyle}" Content="To till:" Margin="1,12,181,12" HorizontalContentAlignment="Right" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.ColumnSpan="2"  />
            <ComboBox x:Name="To_comboBox" Grid.Column="3" DisplayMemberPath="Name" SelectedValuePath="ID" 
            	FlowDirection="RightToLeft" Height="29" TabIndex="1" FontSize="14" Margin="14,0,10,0" Grid.Row="1" SelectionChanged="BeginDate_datepicker_SelectedDateChanged" />
            <Label x:Name="EndDate_lable_Copy2" Grid.Column="2" Grid.Row="1" Style="{DynamicResource lableStyle}" Content="Corresponding rate:" Margin="1,12,1,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right"  />
            <ComboBox x:Name="ObserveRate_comboBox" Grid.Column="1" DisplayMemberPath="Rate group name" SelectedValuePath="ID" 
            	FlowDirection="RightToLeft" Height="33" TabIndex="1" FontSize="14" Margin="13,0,10,0" Grid.Row="1" />
            <Button x:Name="ObserveRate_clear_btn" Grid.Row="1"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Width="25" Height="25" BorderBrush="{x:Null}" 
                Click="ObserveRate_clear_btn_Click" Margin="17,0,0,0" >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
            <StackPanel Grid.Column="5" Grid.Row="1" x:Name="From_panel" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="2,8,2,11" >
                <ComboBox x:Name="From_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" 
            	FlowDirection="RightToLeft" Height="29" TabIndex="1" FontSize="14" SelectionChanged="From_comboBox_SelectionChanged" Width="156" VerticalAlignment="Stretch" />
                <Button x:Name="From_help" Width="20" Height="29" BorderBrush="{x:Null}" ToolTipService.InitialShowDelay="100">

                    <Button.Background>
                        <ImageBrush ImageSource="/Images/qm1.png" Stretch="Uniform"/>
                    </Button.Background>
                    <Button.ToolTip>
                        <ToolTip Content="Exchange to SYR can only be made from the budget currency."/>
                    </Button.ToolTip>
                </Button>
            </StackPanel>
        </Grid>

        <!--<ScrollViewer 
            FlowDirection="RightToLeft"
            VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" 
            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">-->
        <Grid Grid.Row="1" Margin="0,0,0,5"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="716*"/>
                <ColumnDefinition Width="557*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="46*"/>
                <RowDefinition Height="467*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <syncfusion:SfDataGrid  x:Name="myDataGrid"  FrozenColumnCount="1"
                               Style="{DynamicResource SfDataGrid_body}"
                               HeaderStyle="{DynamicResource SfDataGrid_header}"
                               RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                               AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                               Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                               AutoGenerateColumns="True"
                               SelectionChanged="myDataGrid_SelectionChanged" Loaded="myDataGrid_Loaded" VerticalAlignment="Stretch" Margin="4,1,0,10" AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" ItemsSourceChanged="myDataGrid_ItemsSourceChanged" FilterChanged="myDataGrid_FilterChanged" Grid.Row="1">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTemplateColumn HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <StackPanel Orientation="Horizontal" Grid.Row="1" FlowDirection="RightToLeft" Grid.ColumnSpan="2" Margin="0,461,0,0" Grid.RowSpan="2" >
                <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"/>
                </Border>

                <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"  />
                </Border>
            </StackPanel>
            <Grid Grid.ColumnSpan="2" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="190*"/>
                    <ColumnDefinition Width="320*"/>
                    <ColumnDefinition Width="151*"/>
                    <ColumnDefinition Width="489*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Panel1" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="35,0,5,0" Grid.Column="4" >
                    <RadioButton x:Name="Total_RadioButton" Content="Show total" IsChecked="True" Style="{DynamicResource RadioButtonStyle}" Height="34" Width="126" HorizontalAlignment="Right" Checked="Total_RadioButton_Checked"/>
                    <RadioButton x:Name="PerDonor_RadioButton" Content="Show per donor" Height="34" Width="150" Style="{DynamicResource RadioButtonStyle}" HorizontalAlignment="Right" Checked="PerDonor_RadioButton_Checked"/>
                    <Button x:Name="From_help_Copy" Width="30" Height="28" BorderBrush="{x:Null}" ToolTipService.InitialShowDelay="100">

                        <Button.Background>
                            <ImageBrush ImageSource="/Images/qm1.png" Stretch="Uniform"/>
                        </Button.Background>
                        <Button.ToolTip>
                            <ToolTip Content="The totals appear according to the donor only for the Rate from any currency to Syrian"/>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
                <Menu x:Name="ShowHideMenu" Margin="14,7,20,6" >
                    <Menu.Background>
                        <ImageBrush/>
                    </Menu.Background>
                    <MenuItem Header="" StaysOpenOnClick="True" Grid.Column="1" Width="34" Height="32" >
                        <MenuItem.Background>
                            <ImageBrush ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                        </MenuItem.Background>
                        <MenuItem x:Name="ShowMenu" Header="Show" StaysOpenOnClick="True" Background="White" />
                        <MenuItem x:Name="HideMenu" Header="Hide" StaysOpenOnClick="True" Background="White"/>
                        <Separator Background="Black"/>
                        <MenuItem Header="ShowAll" Click="ShowAll_MenuItem_Click" Background="White"/>
                    </MenuItem>
                </Menu>
                <Button Grid.Column="1" Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                TabIndex="5" HorizontalAlignment="Stretch" Margin="2,10,166,10"
                Command="local:Commands.ExportToExcel" Height="26" Width="32" VerticalAlignment="Stretch"
                />
            </Grid>

        </Grid>

        <!--</ScrollViewer>-->
    </Grid>
</Window>

<Window x:Class="Financial_WPF_App.Views.Rate_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        mc:Ignorable="d"
        Title="Rate_Window" Width="1280" Height="749" WindowStartupLocation="CenterScreen">


    <Grid x:Name="MainGrid">
        <Grid.ContextMenu>
            <ContextMenu Name="cm">
                <MenuItem Header="Refresh Rate" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="Row1" Height="175"></RowDefinition>
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--<ScrollViewer 
            FlowDirection="RightToLeft"
            VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Auto" 
            PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">-->
        <Grid Margin="0,3,0,2" Grid.RowSpan="2"  >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="716*"/>
                <ColumnDefinition Width="557*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="46*"/>
                <RowDefinition Height="467*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <syncfusion:SfDataGrid  x:Name="myDataGrid"  FrozenColumnCount="1"
                               Style="{DynamicResource SfDataGrid_body}"
                               HeaderStyle="{DynamicResource SfDataGrid_header}"
                               RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                               AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                               Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                               AutoGenerateColumns="True"
                               SelectionChanged="myDataGrid_SelectionChanged" Loaded="myDataGrid_Loaded" VerticalAlignment="Stretch" Margin="4,1,0,10" AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" ItemsSourceChanged="myDataGrid_ItemsSourceChanged" FilterChanged="myDataGrid_FilterChanged" Grid.Row="1">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTemplateColumn HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <StackPanel Orientation="Horizontal" Grid.Row="2" FlowDirection="RightToLeft" Grid.ColumnSpan="2" Margin="0,4,0,0" >
                <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"/>
                </Border>

                <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"  />
                </Border>
            </StackPanel>
            <Grid Grid.ColumnSpan="2" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="104*"/>
                    <ColumnDefinition Width="433*"/>
                    <ColumnDefinition Width="159*"/>
                    <ColumnDefinition Width="515*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Panel1" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="35,0,5,0" Grid.Column="4" >
                    <RadioButton x:Name="Total_RadioButton" Content="Show total" IsChecked="True" Style="{DynamicResource RadioButtonStyle}" Height="34" Width="126" HorizontalAlignment="Right" Checked="Total_RadioButton_Checked"/>
                    <RadioButton x:Name="PerDonor_RadioButton" Content="Show per donor" Height="34" Width="150" Style="{DynamicResource RadioButtonStyle}" HorizontalAlignment="Right" Checked="PerDonor_RadioButton_Checked"/>
                    <Button x:Name="From_help_Copy" Width="30" Height="28" BorderBrush="{x:Null}" ToolTipService.InitialShowDelay="100">

                        <Button.Background>
                            <ImageBrush ImageSource="/Images/qm1.png" Stretch="Uniform"/>
                        </Button.Background>
                        <Button.ToolTip>
                            <ToolTip Content="The totals appear according to the donor only for the Rate from any currency to Syrian"/>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
                <Menu x:Name="ShowHideMenu" Margin="14,7,20,6" >
                    <Menu.Background>
                        <ImageBrush/>
                    </Menu.Background>
                    <MenuItem Header="" StaysOpenOnClick="True" Grid.Column="1" Width="34" Height="32" >
                        <MenuItem.Background>
                            <ImageBrush ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                        </MenuItem.Background>
                        <MenuItem x:Name="ShowMenu" Header="Show" StaysOpenOnClick="True" Background="White" />
                        <MenuItem x:Name="HideMenu" Header="Hide" StaysOpenOnClick="True" Background="White"/>
                        <Separator Background="Black"/>
                        <MenuItem Header="ShowAll" Click="ShowAll_MenuItem_Click" Background="White"/>
                    </MenuItem>
                </Menu>
                <Button Grid.Column="1" Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                TabIndex="5" HorizontalAlignment="Stretch" Margin="2,10,65,8"
                Command="local:Commands.ExportToExcel" Height="NaN" Width="NaN" VerticalAlignment="Stretch"
                />
                <StackPanel Margin="0,4,410,3" x:Name="Add_btn"  Orientation="Horizontal" FlowDirection="RightToLeft" ToolTip="New Entry" ToolTipService.InitialShowDelay="100" Grid.Column="2">
                    <Button  Style="{DynamicResource AddButtonStyle}"  Width="22" Height="22" x:Name="AddNewAction_btn" TabIndex="15" Click="AddNewAction_btn_Click" Margin="0,0,1,0" HorizontalAlignment="Center">
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/newEntry.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>

        <!--</ScrollViewer>-->
    </Grid>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        x:Class="Financial_WPF_App.Views.User_Window"
        mc:Ignorable="d"
        Title="User_Window" Width="1280" Height="620"  WindowStartupLocation="CenterScreen"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">


    <Grid >
        <Grid.ContextMenu>
            <ContextMenu Name="cm">
                <MenuItem Header="Refresh" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>


        <Grid  Grid.Column="0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource LightGray1}">
                <DockPanel  LastChildFill="True"  VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" Width="Auto">
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Username:" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <TextBox x:Name="Username_txtBox"  TabIndex="4" Style="{DynamicResource CustomTextBoxActionStyle}" Height="30"/>
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Password:" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <TextBox x:Name="Password_txtBox"  TabIndex="4" Style="{DynamicResource CustomTextBoxActionStyle}" Height="30" />
                        <Label Style="{DynamicResource statistic_lableStyle}" Content="Role:" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="Role_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID" Style="{StaticResource ActionComboboxStyle}" TabIndex="1"  SelectionChanged="Role_comboBox_SelectionChanged" />
                            <Button x:Name="Role_clear_btn"  Style="{StaticResource ActionDeleteButtonStyle}" Click="Role_clear_btn_Click" Height="30" >
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <Button x:Name="Save_btn"  Style="{DynamicResource AddButtonStyle}" TabIndex="11"  Click="Save_btn_Click" ToolTip="Save" ToolTipService.InitialShowDelay="100" Margin="10,0,1,0" Width="25" Height="25" >
                            <Button.Background>
                                <ImageBrush ImageSource="/Images/Buttons/NewEntry.png"/>
                            </Button.Background>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Grid>
            <syncfusion:SfDataGrid x:Name="myDataGrid"                                            
      Style="{DynamicResource SfDataGrid_body}"
      HeaderStyle="{DynamicResource SfDataGrid_header}"
      RowStyle="{DynamicResource SfDataGrid_RowStyle}"
      AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"      
      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
       MouseDoubleClick="myDataGrid_MouseDoubleClick" Grid.Row="2" Margin="2,5,5,5">

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" HeaderText="#"  MappingName="user_id" IsHidden="True"/>
                    <syncfusion:GridTextColumn x:Name="Username_DataGridColumn" HeaderText="Username"  MappingName="username" />
                    <syncfusion:GridTextColumn x:Name="Role_DataGridColumn" HeaderText="Role"  MappingName="role" />

                    <syncfusion:GridTemplateColumn x:Name="Edit_DataGridColumn" HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click" />
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>

                    <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn" HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <Grid Grid.Row="1" Background="{StaticResource LightGray2}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Grid.Column="2" BorderBrush="{StaticResource DarkGray}" Margin="10">
                    <StackPanel Orientation="Vertical">
                        <Label x:Name="Account_Label" Style="{DynamicResource statistic_lableStyle}" HorizontalContentAlignment="Center" Foreground="White" Background="{StaticResource GreenBlue}" Content="Account" VerticalAlignment="Stretch" Margin="0,0,0,0" />
                        <syncfusion:CheckListBox  x:Name="Account_CheckListBox" Height="250" DisplayMemberPath="Name" SelectedValuePath="ID" IsSelectAllEnabled="False" ItemChecked="Account_CheckListBox_ItemChecked" ScrollViewer.HorizontalScrollBarVisibility="Visible">
                        </syncfusion:CheckListBox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{StaticResource DarkGray}"  Margin="10">
                    <StackPanel Orientation="Vertical">
                        <Label x:Name="Subproject_Label" Style="{DynamicResource statistic_lableStyle}" HorizontalContentAlignment="Center" Foreground="White" Background="{StaticResource GreenBlue}" Content="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,1,0"/>
                        <syncfusion:CheckListBox x:Name="Subproject_CheckListBox" Margin="0,0,1,0" Height="250" DisplayMemberPath="Name" SelectedValuePath="ID" IsSelectAllEnabled="False" ItemChecked="Subproject_CheckListBox_ItemChecked" ItemContainerStyle="{StaticResource CustomCheckListBoxItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Visible"/>

                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Grid.ColumnSpan="2" BorderBrush="{StaticResource DarkGray}"  Margin="10">
                    <StackPanel Orientation="Vertical">
                        <Label x:Name="ExchangeAccountAccount_Label" Style="{DynamicResource statistic_lableStyle}" HorizontalContentAlignment="Center" Foreground="White" Background="{StaticResource GreenBlue}" Content="Exchange" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,1,0"/>
                        <syncfusion:CheckListBox x:Name="ExchangeAccount_CheckListBox" Margin="0,0,1,0" Height="250" DisplayMemberPath="Name" SelectedValuePath="ID" IsSelectAllEnabled="False" ItemChecked="ExchangeAccount_CheckListBox_ItemChecked" ScrollViewer.HorizontalScrollBarVisibility="Visible"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Grid.ColumnSpan="2" BorderBrush="{StaticResource DarkGray}"  Margin="10">
                    <StackPanel Orientation="Vertical">
                        <Label x:Name="PersonalAccount_Label" Style="{DynamicResource statistic_lableStyle}" HorizontalContentAlignment="Center" Foreground="White" Background="{StaticResource GreenBlue}" Content="Personal"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,1,0"/>
                        <syncfusion:CheckListBox x:Name="PersonalAccount_CheckListBox" Height="250" Margin="0,0,1,0" DisplayMemberPath="Name" SelectedValuePath="ID" IsSelectAllEnabled="False" ItemChecked="PersonalAccount_CheckListBox_ItemChecked" ScrollViewer.HorizontalScrollBarVisibility="Visible"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="8" Grid.ColumnSpan="2" BorderBrush="{StaticResource DarkGray}"  Margin="10">
                    <StackPanel Orientation="Vertical">
                        <Label x:Name="CashAccount_Label" Style="{DynamicResource statistic_lableStyle}" HorizontalContentAlignment="Center" Foreground="White" Background="{StaticResource GreenBlue}" Content="Cash" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,1,0"/>
                        <Grid Margin="0,0,1,0" Height="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <syncfusion:CheckListBox x:Name="CashAccount_CheckListBox" DisplayMemberPath="Name" SelectedValuePath="ID" IsSelectAllEnabled="False" Grid.Column="0"  ItemChecked="CashAccount_CheckListBox_ItemChecked" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Disabled" LayoutUpdated="CashAccount_CheckListBox_LayoutUpdated"/>
                            <syncfusion:CheckListBox x:Name="IsCashier_CashAccount_CheckListBox" DisplayMemberPath="isCashier" SelectedValuePath="ID" IsSelectAllEnabled="False" Grid.Column="1" ItemChecked="IsCashier_CashAccount_CheckListBox_ItemChecked" ScrollViewer.HorizontalScrollBarVisibility="Visible"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>

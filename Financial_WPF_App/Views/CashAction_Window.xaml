<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:Controls="clr-namespace:Financial_WPF_App.Controls" xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Class="Financial_WPF_App.Views.CashAction_Window"
        mc:Ignorable="d"
        Title="CashAction_Window" Height="702" Width="700"
    KeyboardNavigation.TabNavigation="Cycle" WindowStartupLocation="CenterScreen">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>

        <Grid Margin="0,0,0,8" >
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17*"/>

                    <ColumnDefinition Width="225*"/>
                    <ColumnDefinition Width="108*"/>

                    <ColumnDefinition Width="67*"/>
                    <ColumnDefinition Width="156*"/>
                    <ColumnDefinition Width="111*"/>

                    <ColumnDefinition Width="16*"/>

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="80*"/>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="50*"/>

                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Grid.ColumnSpan="7" Margin="0,0,0,44" Grid.RowSpan="2" Style="{StaticResource SolidStackPanelStyle}">
                    <Label Content="Account: " Style="{DynamicResource title_lableStyle}" 
                        HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   />
                    <Label Content="Account" Style="{DynamicResource title_lableStyle}" 
                        x:Name="AccountName_lable"
                        HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   />

                    <!--<Label Content="الصــــندوق: " Style="{DynamicResource title_lableStyle}" 
                       HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   />
                <Label Content="syr " Style="{DynamicResource title_lableStyle}" 
                       x:Name="TillName_lable"
                       HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   />-->
                </StackPanel>

                <!--<TextBox x:Name="MircoProject_ID_txtBox" TabIndex="3"
                     Grid.Column="3" Grid.Row="1"  
                TextChanged="MircoProject_ID_txtBox_TextChanged" 
                     Style="{DynamicResource textBoxStyle}" 
                Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}"
                WPFTextBoxAutoComplete:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding XPath=TestItems}" />-->

                <TextBox x:Name="Amount_txtBox" Style="{DynamicResource textBoxStyle}" 
                    Grid.Column="2" Grid.Row="4" TabIndex="4"
                    LostFocus="Amount_txtBox_LostFocus" Margin="5,8,5,8" Grid.ColumnSpan="2" VerticalAlignment="Stretch"   />

                <Label x:Name="ActionDate_Label" Grid.Column="5" Grid.Row="1" Style="{DynamicResource lableStyle}" Content="Counting date:" Margin="2,3,2,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right"  />
                <DatePicker x:Name="ActionDate_datepicker" Grid.Row="1" TabIndex="1"
                    Margin="4,6,4,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Grid.Column="4" VerticalAlignment="Stretch" />

                <Label x:Name="Notes_Label" Grid.Column="5" Grid.Row="2" Style="{DynamicResource lableStyle}" Content="Description AR:" Margin="2,2,2,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                <TextBox x:Name="Notes_txtBox" Style="{DynamicResource textBoxStyle}"  HorizontalContentAlignment="Right" 
                    Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="2" TabIndex="2" Margin="4,2,4,4" VerticalAlignment="Stretch"   />
          
                <TextBlock Grid.Column="2" Grid.Row="4" x:Name="Placeholder2" IsHitTestVisible="False" 
                    Text="Amount..." Foreground="DarkGray" FlowDirection="RightToLeft" Margin="5,0,5,0" Grid.ColumnSpan="2" VerticalAlignment="Center" Height="16" >
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=Amount_txtBox}" Value="" />
                                        <Condition Binding="{Binding Visibility, ElementName=Amount_txtBox}" Value="Visible" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="4" Grid.Row="4" x:Name="denominations_panel" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="2,3,2,3" >
                    <ComboBox x:Name="Denominations_comboBox" TabIndex="3" 
                        DisplayMemberPath="name" SelectedValuePath="id" 
                        FlowDirection="RightToLeft" Height="30" Width="119" MinWidth="110 " FontSize="16"
                        VerticalContentAlignment="Center"/>
                    <Button x:Name="Denominations_comboBox_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Width="25" Height="25" BorderBrush="{x:Null}" Margin="0,9,0,8.764" Click="Denominations_comboBox_clear_btn_Click" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
                <Label Grid.Column="5" Grid.Row="4" x:Name="Donor_lable" Style="{DynamicResource lableStyle}" Content="Denomination:" Margin="2,0,2,0" Height="33" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
                <Grid Grid.Column="1" Grid.Row="4" Margin="2,3,2,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*"/>
                        <ColumnDefinition Width="152*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" x:Name="Donor_panel_Copy" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="1,2,1,2" >
                        <RadioButton x:Name="E_RadioButton" Content="Outcome" IsChecked="True" Style="{DynamicResource RadioButtonStyle}" Height="34" Width="93" TabIndex="5"/>
                        <RadioButton x:Name="I_RadioButton" Content="Income" Style="{DynamicResource RadioButtonStyle}" Height="34" Width="86" TabIndex="6"/>
                    </StackPanel>
                    <Button Style="{DynamicResource Add_Style}" 
            x:Name="InsertAction_btn" TabIndex="15" Height="NaN" Width="NaN" HorizontalAlignment="Stretch" Margin="0,7,2,7" VerticalAlignment="Stretch" Click="InsertAction_btn_Click" />
                </Grid>
                <syncfusion:SfDataGrid x:Name="Actions_DataGrid" Margin="6,10,2,10" Grid.Row="5" Grid.RowSpan="8" Grid.ColumnSpan="5" 
                Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"
                AllowFiltering="False"  
                ShowGroupDropArea ="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="1" ItemsSourceChanged="Actions_DataGrid_ItemsSourceChanged">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="cashaction_denominations_id" HeaderText="cashaction_denominations_id"  IsHidden="True"/>
                        <syncfusion:GridNumericColumn  HeaderText="Amount"  MappingName="Amount" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                        <syncfusion:GridNumericColumn  HeaderText="Income"  MappingName="Income" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator="," IsHidden="True"/>
                        <syncfusion:GridNumericColumn  HeaderText="Expand"  MappingName="Expand" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator="," IsHidden="True"/>
                        <syncfusion:GridTextColumn MappingName="denominations_id" HeaderText="denominations_id" 
                        IsHidden="True" />
                        <syncfusion:GridTextColumn MappingName="denominations_name" HeaderText="Denomination"/>
                        <syncfusion:GridTextColumn MappingName="actiontype_shortname" HeaderText="actiontype_shortname" 
                        IsHidden="True" />
                        <syncfusion:GridTextColumn MappingName="actiontype_name" HeaderText="Operation type"/>

                        <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Delete_Style}" Click="Donor_DeleteButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                    </syncfusion:SfDataGrid.Columns>


                    <syncfusion:SfDataGrid.TableSummaryRows>
                        <syncfusion:GridTableSummaryRow Title=" Income: {TotalIncome} | Outcome:  {TotalExpand}" ShowSummaryInRow="True">
                            <syncfusion:GridSummaryRow.SummaryColumns>
                                <syncfusion:GridSummaryColumn Name="TotalIncome"                                                      
                                                Format="'{Sum:N2}'"
                                                MappingName="Income"
                                                SummaryType="DoubleAggregate" />

                                <syncfusion:GridSummaryColumn Name="TotalExpand"
                                                Format="'{Sum:N2}'"
                                                MappingName="Expand"
                                                SummaryType="DoubleAggregate" />

                            </syncfusion:GridSummaryRow.SummaryColumns>
                        </syncfusion:GridTableSummaryRow>
                    </syncfusion:SfDataGrid.TableSummaryRows>

                </syncfusion:SfDataGrid>
                <Grid Grid.Column="1" Grid.Row="15" Grid.ColumnSpan="5" Margin="8,4,4,3">
                    <Button 
                    Style="{DynamicResource SaveButton_Style}" 
                    x:Name="Save_btn" TabIndex="15" Click="Save_btn_Click" Margin="260,5,260,5" Height="NaN" Width="NaN" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
                <Label Grid.Column="5" Grid.Row="14" x:Name="Total_lable" Style="{DynamicResource lableStyle}" Content="Total:" Margin="2,2,2,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5" >
                    <Label.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0.079"/>
                            <RotateTransform/>
                            <TranslateTransform X="-0.035"/>
                        </TransformGroup>
                    </Label.RenderTransform>
                </Label>
                <Label Grid.Column="4" Grid.Row="14" x:Name="Net_lable" Style="{DynamicResource lableStyle}" Content="0.00" Margin="2,2,2,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5" >
                    <Label.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0.079"/>
                            <RotateTransform/>
                            <TranslateTransform X="-0.035"/>
                        </TransformGroup>
                    </Label.RenderTransform>
                </Label>
                <Label x:Name="E_Notes_Label" Grid.Column="5" Grid.Row="3" Style="{DynamicResource lableStyle}" Content="Description EN:" Margin="2,2,2,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />
                <TextBox x:Name="E_Notes_txtBox" Style="{DynamicResource textBoxStyle}"  HorizontalContentAlignment="Right" 
                    Grid.Column="1" Grid.ColumnSpan="4" Grid.Row="3" TabIndex="2" Margin="4,3,4,3" VerticalAlignment="Stretch"   />
            </Grid>

        </Grid>

    </Grid>
</Window>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:Controls="clr-namespace:Financial_WPF_App.Controls" xmlns:syncfusion="http://schemas.syncfusion.com/wpf" x:Class="Financial_WPF_App.Views.CashAction_Window"
        mc:Ignorable="d" Tag="Cash Action Window "
        Title="CashAction_Window" Style="{StaticResource WindowPopupStyle}" Width="780"
    KeyboardNavigation.TabNavigation="Cycle" WindowStartupLocation="CenterScreen">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="355*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0" Grid.ColumnSpan="5">
                <local:WindowControlBar_Popup x:Name="ControlBar"/>
            </DockPanel>

                <!--<Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Content="Account" Style="{DynamicResource statistic_lableStyle}" 
                        x:Name="AccountName_lable"
                        HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch"   />-->

                    <!--<Label Content="الصــــندوق: " Style="{DynamicResource title_lableStyle}" 
                       HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   />
                <Label Content="syr " Style="{DynamicResource title_lableStyle}" 
                       x:Name="TillName_lable"
                       HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"   />-->
            

                <!--<TextBox x:Name="MircoProject_ID_txtBox" TabIndex="3"
                     Grid.Column="3" Grid.Row="1"  
                TextChanged="MircoProject_ID_txtBox_TextChanged" 
                     Style="{DynamicResource textBoxStyle}" 
                Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}"
                WPFTextBoxAutoComplete:AutoCompleteBehavior.AutoCompleteItemsSource="{Binding XPath=TestItems}" />-->

                

                <Label x:Name="ActionDate_Label" Grid.Column="0" Grid.Row="2" Style="{DynamicResource statistic_lableStyle}" Content="Counting date:"  />
                <DatePicker x:Name="ActionDate_datepicker" Grid.Row="2" TabIndex="1"
                    Grid.Column="1"/>

                <Label x:Name="Notes_Label" Grid.Column="0" Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="Description AR:"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  />
                <TextBox x:Name="Notes_txtBox" TextWrapping="Wrap" Grid.RowSpan="2" HorizontalContentAlignment="Right" Style="{DynamicResource FloatingTextBoxStyle}" 
                    Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="3" TabIndex="2"  Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"   />

            
            <StackPanel Grid.Column="1" Grid.Row="7" x:Name="denominations_panel" Orientation="Horizontal" >
                    <ComboBox x:Name="Denominations_comboBox" TabIndex="3" Style="{StaticResource FloatingComboboxStyle}" Width="175"
                        DisplayMemberPath="name" SelectedValuePath="id" />
                    <Button x:Name="Denominations_comboBox_clear_btn" Click="Denominations_comboBox_clear_btn_Click" Style="{StaticResource DeleteButtonStyle}" Margin="4,2,0,2">
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                        
                </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="7" HorizontalAlignment="Right" Grid.ColumnSpan="2">
                <Label  x:Name="Amount_Label" Style="{DynamicResource statistic_lableStyle}" Content="Amount:" VerticalAlignment="Stretch" HorizontalAlignment="Left"  />
                <TextBox Width="175" x:Name="Amount_txtBox" Style="{DynamicResource FloatingTextBoxStyle}" 
                    TabIndex="4"
                    LostFocus="Amount_txtBox_LostFocus"  />
                <RadioButton x:Name="E_RadioButton" Content="Outcome" IsChecked="True" Style="{DynamicResource RadioButtonStyle}" TabIndex="5"/>
                <RadioButton x:Name="I_RadioButton" Content="Income" Style="{DynamicResource RadioButtonStyle}" TabIndex="6"/>
                <Button Grid.Column="6" Grid.Row="7" Style="{DynamicResource AddButtonStyle}" ToolTip="Insert" ToolTipService.InitialShowDelay="100"
x:Name="InsertAction_btn" TabIndex="15" Click="InsertAction_btn_Click" HorizontalAlignment="Left" Margin="1,0,5,0">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/NewEntry.png"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            
            <Label Grid.Column="0" Grid.Row="7" x:Name="Donor_lable" Style="{DynamicResource statistic_lableStyle}" Content="Denomination:"/>
               
                
            <syncfusion:SfDataGrid x:Name="Actions_DataGrid" Grid.Row="8"  Grid.ColumnSpan="4" 
                Style="{DynamicResource SfDataGrid_body}"
                HeaderStyle="{DynamicResource SfDataGrid_header}"
                RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"
                AllowFiltering="False"  
                ShowGroupDropArea ="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,5,5,0">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="cashaction_denominations_id" HeaderText="cashaction_denominations_id"  IsHidden="True"/>
                    <syncfusion:GridNumericColumn  HeaderText="Amount"  MappingName="Amount" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                    <syncfusion:GridNumericColumn  HeaderText="Income"  MappingName="Income" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator="," IsHidden="True"/>
                    <syncfusion:GridNumericColumn  HeaderText="Expand"  MappingName="Expand" 
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator="," IsHidden="True"/>
                    <syncfusion:GridTextColumn MappingName="denominations_id" HeaderText="denominations_id" 
                        IsHidden="True" />
                    <syncfusion:GridTextColumn MappingName="denominations_name" HeaderText="Denomination"/>
                    <syncfusion:GridTextColumn MappingName="actiontype_shortname" HeaderText="actiontype_shortname" 
                        IsHidden="True" />
                    <syncfusion:GridTextColumn MappingName="actiontype_name" HeaderText="Operation type"/>

                    <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn" HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="Donor_DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
                <Grid Grid.Row="10" Grid.Column="0">
                    <Button 
                    Style="{DynamicResource ButtonColoredStyle}" 
                    x:Name="Save_btn" TabIndex="15" Click="Save_btn_Click" Content="Save" Margin="10,0,1,0" />
                </Grid>


            <Label x:Name="E_Notes_Label" Grid.Column="0" Grid.Row="5" Style="{DynamicResource statistic_lableStyle}" Content="Description EN:"  />
            <TextBox x:Name="E_Notes_txtBox" Grid.RowSpan="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"  TextWrapping="Wrap" HorizontalContentAlignment="Left" Style="{DynamicResource FloatingTextBoxStyle}" 
                    Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="3" TabIndex="2" Height="80" />
            </Grid>

        </Grid>

</Window>

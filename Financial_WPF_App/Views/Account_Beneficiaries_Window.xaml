<Window x:Class="Financial_WPF_App.Views.Account_Beneficiaries_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        mc:Ignorable="d" 
        Title="Till_Window" Width="1280" Height="620"
        FontFamily="Myriad Arabic" FontSize="22" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Helper:CustomRowStyleSelector x:Key="rowStyleSelector" />
        <Helper:CustomAlternatingRowStyleSelector x:Key="AlternatingrowStyleSelector" />
    </Window.Resources>

    <Grid >
        <Grid.ContextMenu>
            <ContextMenu Name="cm">
                <MenuItem Header="Refresh Beneficiary" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid.RowDefinitions>
            <RowDefinition Height="100*" ></RowDefinition>
        </Grid.RowDefinitions>
        

        <Grid  Grid.Column="0" Margin="10,0,10,0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="233*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                    <Border Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource MainBorderWrapPanelStyle}">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                    <Border Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" />
                    </Border>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,5,0,0" Grid.ColumnSpan="2" >
                <DockPanel  LastChildFill="True" Background="{StaticResource LightGray1}">
                    <WrapPanel Orientation="Horizontal" Width="Auto">
                        <Menu x:Name="ShowHideMenu" Margin="5,2,5,2">
                            <Menu.Resources>
                                <!-- Custom Menu Style -->
                                <Style TargetType="Menu">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Menu">
                                                <Border Background="{TemplateBinding Background}" Padding="0">
                                                    <ItemsPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <!-- Custom MenuItem Style -->
                                <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
                                    <Setter Property="FontFamily" Value="Rubik"/>
                                    <Setter Property="FontSize" Value="13.5"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DarkGray}"/>
                                    <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Grid>
                                                    <!-- Main Item -->
                                                    <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="10,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <!-- Arrow Column -->
                                                            </Grid.ColumnDefinitions>

                                                            <ContentPresenter Grid.Column="0" 
                                               HorizontalAlignment="Left" 
                                               VerticalAlignment="Center" 
                                               ContentSource="Header"/>

                                                            <!-- Submenu Arrow -->
                                                            <Path x:Name="Arrow"
                                              Grid.Column="1"
                                              Data="M 0 0 L 6 4 L 0 8 Z" 
                                              Fill="{DynamicResource DarkGray}"
                                              VerticalAlignment="Center"
                                              Margin="5,0,0,0"
                                              Visibility="Collapsed"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Submenu Popup -->
                                                    <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                                        <Border Background="White" CornerRadius="5" BorderBrush="{StaticResource LightGray1}" BorderThickness="1">
                                                            <StackPanel>
                                                                <ItemsPresenter />
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>

                                                <!-- Triggers -->
                                                <ControlTemplate.Triggers>
                                                    <!-- Show Arrow Only if the MenuItem has sub-items (is a submenu) -->
                                                    <Trigger Property="HasItems" Value="True">
                                                        <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                                    </Trigger>

                                                    <!-- Submenu Hover Effect -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <!--<Setter TargetName="Border" Property="Background" Value="transparent"/>-->
                                                        <!--<Setter Property="Foreground" Value="{DynamicResource LightGray1}"/>-->
                                                    </Trigger>

                                                    <!-- Submenu Open Effect -->
                                                    <Trigger Property="IsSubmenuOpen" Value="True">
                                                        <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
                                                    </Trigger>

                                                    <!-- Disabled Effect -->
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource MidGray}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                            </Menu.Resources>
                            <!-- MenuItems with Custom Style -->
                            <MenuItem Width="20" Height="20" StaysOpenOnClick="True" Header=""  Style="{StaticResource CustomMenuItemStyle}" Margin="6,11,0,0" ToolTip="Show/Hide Columns" ToolTipService.InitialShowDelay="100">
                                <MenuItem.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/showHide.png" Stretch="Uniform"/>
                                </MenuItem.Background>
                                <!-- Submenu Items (Will Keep Hover Effect) -->
                                <MenuItem StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                                <MenuItem StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                                <MenuItem Background="{StaticResource LightGray1}" Click="ShowAll_MenuItem_Click" Header="ShowAll" Style="{StaticResource CustomMenuItemStyle}"/>
                            </MenuItem>
                        </Menu>
                        <StackPanel x:Name="XeportToExcel_StackPanel" RenderTransformOrigin="0.5,0.5" Width="31">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="-1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </StackPanel.RenderTransform>
                            <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" Command="local:Commands.ExportToExcel"  Width="30" Height="25" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,12,1,1">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <StackPanel Margin="5,2,5,2" x:Name="AddNewAction_StackPanel"  Orientation="Horizontal" FlowDirection="RightToLeft" ToolTip="New Entry" ToolTipService.InitialShowDelay="100">
                            <Button  Style="{DynamicResource AddButtonStyle}"  Width="22" Height="22" x:Name="Add_btn" TabIndex="15" Click="NewBeneficiary_Click" Margin="0,0,1,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/newEntry.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <StackPanel Margin="5,8,5,8" x:Name="AddMultiAction_StackPanel"  Orientation="Horizontal" FlowDirection="RightToLeft">
                            <Button ToolTip="New Entry From Excel" ToolTipService.InitialShowDelay="100" Style="{DynamicResource AddButtonStyle}"  Width="30" Height="25"
                  x:Name="AddMultiBeneficiary_btn" TabIndex="15" Click="AddMultiBeneficiary_btn_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,1,0">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/newEntryExcel.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="Delete_Selected" Margin="5,8,5,8" Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBlock Style="{StaticResource HyperlinkWithImageStyle}" ToolTip="Delete Selected" ToolTipService.InitialShowDelay="100" Height="29" Width="24.5" VerticalAlignment="Bottom">
                    <Hyperlink x:Name="Delete_Selected_TextBlock" Click="Delete_Selected_TextBlock_Click">
                        <Run Text=" " /> <!-- Empty text since we are using an image -->
                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="5,8,5,8" Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBox x:Name="monthes_txtBox" TextChanged="monthes_txtBox_TextChanged"
                    Style="{DynamicResource CustomTextBoxActionStyle}" PreviewTextInput="NumberValidationTextBox" VerticalAlignment="Stretch" />
                            <Border Background="White" Margin="3,0,0,0">
                                <Button Style="{DynamicResource AddButtonStyle}" ToolTip="Save" ToolTipService.InitialShowDelay="100"
                         x:Name="delaypayment_btn" TabIndex="15" Click="delaypayment_btn_Click" Height="17" Width="24" >
                                    <Button.Background>
                                        <ImageBrush ImageSource="/Images/Buttons/postpon_payments.png" Stretch="Uniform"/>
                                    </Button.Background>
                                </Button>
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,40,0">
                        <TextBox Style="{DynamicResource TextBoxActionStyle}" TextChanged="Search_txtBox_TextChanged" x:Name="Search_txtBox" TextWrapping="Wrap" TabIndex="10"/>
                    </StackPanel>
                </DockPanel>
                <!--<CheckBox Grid.Column="3" x:Name="ExactSearch_checkBox" Content="Full Match"                        
              Foreground = "{DynamicResource HopeBlue4}"
        Checked="ExactSearch_checkBox_Checked" Unchecked="ExactSearch_checkBox_Unchecked" VerticalContentAlignment="Center" 
        HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,15,0,9" Width="90" />-->
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="Grid_col" Width="70*" ></ColumnDefinition>
                    <ColumnDefinition Name="Expander_col" Width="30*" ></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <syncfusion:SfDataGrid  x:Name="myDataGrid"  Grid.Column="0"
       Style="{DynamicResource SfDataGrid_body}"
       HeaderStyle="{DynamicResource SfDataGrid_header}"
       RowStyle="{DynamicResource SfDataGrid_RowStyle}"
       AlternatingRowStyleSelector="{StaticResource AlternatingrowStyleSelector}"
       RowStyleSelector="{StaticResource rowStyleSelector}"
       FrozenColumnCount="3"
AutoGenerateColumns="True"
SelectionChanged="myDataGrid_SelectionChanged"
MouseDoubleClick="myDataGrid_MouseDoubleClick"
Loaded="myDataGrid_Loaded" 
AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="14,1,14,10" FilterChanged="myDataGrid_FilterChanged">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTemplateColumn HeaderText="Attachment" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Attachment_Style}" Click="Attachment_Button_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                        <syncfusion:GridTemplateColumn HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                        <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                        <syncfusion:GridCheckBoxColumn x:Name="Selected_DataGridColumn" HeaderText="Select" MappingName="IsSelected" AllowEditing="True" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridCheckBoxColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chkHeader" Loaded="chkHeader_Loaded" Click="chkHeader_Click"/>
                                </DataTemplate>
                            </syncfusion:GridCheckBoxColumn.HeaderTemplate>
                            <syncfusion:GridCheckBoxColumn.CellStyle>
                                <Style>
                                    <Style.Resources>
                                        <Style TargetType="CheckBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="1">
                                                    <Setter Property="Background" Value="Green" />
                                                    <Setter Property="FlowDirection" Value="LeftToRight" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsSelected}" Value="0">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Style.Resources>
                                </Style>
                            </syncfusion:GridCheckBoxColumn.CellStyle>
                        </syncfusion:GridCheckBoxColumn>

                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
                <Expander x:Name="myExpander" Grid.Column="1" IsExpanded="True"
    ExpandDirection="Right" 
    Expanded="myExpander_Expanded" Collapsed="myExpander_Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="#FF30323E">

                    <Grid  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="15*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="15*" />
                            <RowDefinition Height="15*" />
                            <RowDefinition Height="15*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="15*" />
                            <RowDefinition Height="15*" />
                            <RowDefinition Height="15*" />
                            <RowDefinition Height="10*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40*" />
                            <ColumnDefinition Width="60*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1" Grid.Row="0" Style="{DynamicResource textBlockStyle}" 
            Text="Total income:" HorizontalAlignment="Left"  />
                        <Label Grid.Column="0" Grid.Row="0" x:Name="sum_imports_lbl" 
            Style="{DynamicResource lableStyle}"  Content="###,###" HorizontalAlignment="Right" Margin="0,0,4.836,28.6" Grid.RowSpan="2"  />

                        <TextBlock Grid.Column="1" Grid.Row="1" Style="{DynamicResource textBlockStyle}" Text="Total loans amount:" HorizontalAlignment="Left" />
                        <Label Grid.Column="0" Grid.Row="1" x:Name="sum_BAmounts_lbl" Style="{DynamicResource lableStyle}" Content="###,###" HorizontalAlignment="Right" Margin="0,0.2,4.836,28.4" Grid.RowSpan="2" />

                        <TextBlock Grid.Column="1" Grid.Row="2" Style="{DynamicResource textBlockStyle}" Text="Total invoices amount:" HorizontalAlignment="Left" />
                        <Label Grid.Column="0" Grid.Row="2" x:Name="sum_RAmounts_lbl" Style="{DynamicResource lableStyle}" Content="###,###" HorizontalAlignment="Right" Margin="0,0.4,4.836,0.4" />

                        <TextBlock Grid.Column="1" Grid.Row="3" Style="{DynamicResource textBlockStyle}" Text="Total unbilled amounts:" HorizontalAlignment="Left" />
                        <Label Grid.Column="0" Grid.Row="3" x:Name="sum_RemainedAmounts_lbl" Style="{DynamicResource lableStyle}" Content="###,###" HorizontalAlignment="Right" Margin="0,5.6,4.836,6.036" />

                        <TextBlock Grid.Column="1" Grid.Row="4"  Style="{DynamicResource textBlockStyle}" Text="Net account:" HorizontalAlignment="Left" />
                        <Label Grid.Column="0" Grid.Row="3" x:Name="sum_NetAmounts_lbl" Style="{DynamicResource lableStyle}" Content="###,###" HorizontalAlignment="Right" Margin="0,43.6,4.836,28.636" Grid.RowSpan="3" />

                        <TextBlock Grid.Row="5"  Style="{DynamicResource textBlockStyle}" Text="The remaining after paying all loan amounts:" FontSize="14" Margin="2,0,-4,0" Height="26" HorizontalAlignment="Left" Grid.Column="1" />
                        <Label Grid.Column="0" Grid.Row="5" x:Name="sum_RemainedAfterPay_lbl" Style="{DynamicResource lableStyle}" Content="###,###" HorizontalAlignment="Right" Margin="0,0.164,4.836,28.436" Grid.RowSpan="2" />

                        <TextBlock Grid.Column="1" Grid.Row="6"  Style="{DynamicResource textBlockStyle}" Text="Average micro project cost:" HorizontalAlignment="Left" />
                        <Label Grid.Column="0" Grid.Row="6" x:Name="avg_amounts_lbl" Style="{DynamicResource lableStyle}" Content="###,###" HorizontalAlignment="Right" Margin="0,0.364,4.836,0.436" />

                        <TextBlock Grid.Column="1" Grid.Row="7"  Style="{DynamicResource textBlockStyle}" Text="Average micro project cost in:" HorizontalAlignment="Left" />
                        <Label Grid.Column="0" Grid.Row="8" x:Name="avg_amounts_usd_lbl" Style="{DynamicResource lableStyle}" Content="###,###" HorizontalAlignment="Right" Margin="0,5.8,9.836,4.964" />

                        <TextBlock Grid.Column="1" Grid.Row="9"  Style="{DynamicResource textBlockStyle}" Text="Financed micro projects:" Margin="11,13,0,0" VerticalAlignment="Top" />
                        <Label Grid.Column="0" Grid.Row="9" x:Name="num_Done_lbl"  Style="{DynamicResource lableStyle}"                                                   
            HorizontalAlignment="Right" Margin="0,7.036,9.836,3.727" RenderTransformOrigin="-0.202,0.527" />

                        <TextBlock Grid.Row="10"  Style="{DynamicResource textBlockStyle}" Text="Ongoing micro projects:" Margin="10,0,0,0" Grid.Column="1" />
                        <Label Grid.Column="0" Grid.Row="9" x:Name="num_Ongoing_lbl"  Style="{DynamicResource lableStyle}" Content="0" HorizontalAlignment="Right" Margin="0,39.036,9.836,0.527" Grid.RowSpan="2" />

                        <TextBlock Grid.Column="1" Grid.Row="11"  Style="{DynamicResource textBlockStyle}" Text="Total micro projects:" Margin="10,0,0,0" />
                        <Label Grid.Column="0" Grid.Row="10" x:Name="num_Allprojects_lbl" Style="{DynamicResource lableStyle}" Content="0" HorizontalAlignment="Right" Margin="0,28.273,9.836,0.327" Grid.RowSpan="2" />
                        <ComboBox x:Name="Till_comboBox" HorizontalAlignment="Left" Margin="10.164,5.8,0,0" VerticalAlignment="Top" Width="111" Grid.Row="8" FlowDirection="RightToLeft" DisplayMemberPath="Type" SelectedValuePath="Type" Grid.Column="1" SelectionChanged="Till_comboBox_SelectionChanged"/>

                    </Grid>
                </Expander>
            </Grid>
            
        </Grid>
        
        

    </Grid>
</Window>
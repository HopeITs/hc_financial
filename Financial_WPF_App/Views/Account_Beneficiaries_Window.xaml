<Window x:Class="Financial_WPF_App.Views.Account_Beneficiaries_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        mc:Ignorable="d" 
        Title="Till_Window" Width="1280" Height="620"
         WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Helper:CustomRowStyleSelector x:Key="rowStyleSelector" />
        <Helper:CustomAlternatingRowStyleSelector x:Key="AlternatingrowStyleSelector" />
    </Window.Resources>

    <Grid Background="{StaticResource LightGray2}" >
        <Grid.ContextMenu>
            <ContextMenu Name="cm">
                <MenuItem Header="Refresh Beneficiaries" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid.RowDefinitions>
            <RowDefinition Height="100*" ></RowDefinition>
        </Grid.RowDefinitions>


        <Grid  Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="233*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                    <Border Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged" />
                    </Border>
                    <Label Content="Ongoing:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                    <Border Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="ongoing_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged" />
                    </Border>
                    <Label Content="Financed:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                    <Border Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="financed_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource MainBorderWrapPanelStyle}">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                    <Border Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged" />
                    </Border>
                    <Label Content="Ongoing:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                    <Border Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="selected_ongoing_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged" />
                    </Border>
                    <Label Content="Financed:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                    <Border Style="{StaticResource BorderStackPanelStyle}">
                        <TextBlock x:Name="selected_financed_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged" />
                    </Border>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,5,0,0" Grid.ColumnSpan="2" >
                <DockPanel  LastChildFill="True" Background="{StaticResource LightGray1}">
                    <WrapPanel Orientation="Horizontal" Width="Auto">
                        <Menu x:Name="ShowHideMenu" Margin="5,2,5,2">
                            <Menu.Resources>
                                <!-- Custom Menu Style -->
                                <Style TargetType="Menu">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Menu">
                                                <Border Background="{TemplateBinding Background}" Padding="0">
                                                    <ItemsPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <!-- Custom MenuItem Style -->
                                <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
                                    <Setter Property="FontFamily" Value="Rubik"/>
                                    <Setter Property="FontSize" Value="13.5"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DarkGray}"/>
                                    <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Grid>
                                                    <!-- Main Item -->
                                                    <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="10,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <!-- Arrow Column -->
                                                            </Grid.ColumnDefinitions>

                                                            <ContentPresenter Grid.Column="0" 
                                               HorizontalAlignment="Left" 
                                               VerticalAlignment="Center" 
                                               ContentSource="Header"/>

                                                            <!-- Submenu Arrow -->
                                                            <Path x:Name="Arrow"
                                              Grid.Column="1"
                                              Data="M 0 0 L 6 4 L 0 8 Z" 
                                              Fill="{DynamicResource DarkGray}"
                                              VerticalAlignment="Center"
                                              Margin="5,0,0,0"
                                              Visibility="Collapsed"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Submenu Popup -->
                                                    <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                                        <Border Background="White" CornerRadius="5" BorderBrush="{StaticResource LightGray1}" BorderThickness="1">
                                                            <StackPanel>
                                                                <ItemsPresenter />
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>

                                                <!-- Triggers -->
                                                <ControlTemplate.Triggers>
                                                    <!-- Show Arrow Only if the MenuItem has sub-items (is a submenu) -->
                                                    <Trigger Property="HasItems" Value="True">
                                                        <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                                    </Trigger>

                                                    <!-- Submenu Hover Effect -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <!--<Setter TargetName="Border" Property="Background" Value="transparent"/>-->
                                                        <!--<Setter Property="Foreground" Value="{DynamicResource LightGray1}"/>-->
                                                    </Trigger>

                                                    <!-- Submenu Open Effect -->
                                                    <Trigger Property="IsSubmenuOpen" Value="True">
                                                        <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
                                                    </Trigger>

                                                    <!-- Disabled Effect -->
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource MidGray}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                            </Menu.Resources>
                            <!-- MenuItems with Custom Style -->
                            <MenuItem Width="20" Height="20" StaysOpenOnClick="True" Header=""  Style="{StaticResource CustomMenuItemStyle}" Margin="6,11,0,0" ToolTip="Show/Hide Columns" ToolTipService.InitialShowDelay="100">
                                <MenuItem.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/showHide.png" Stretch="Uniform"/>
                                </MenuItem.Background>
                                <!-- Submenu Items (Will Keep Hover Effect) -->
                                <MenuItem StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                                <MenuItem StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                                <MenuItem Background="{StaticResource LightGray1}" Click="ShowAll_MenuItem_Click" Header="ShowAll" Style="{StaticResource CustomMenuItemStyle}"/>
                            </MenuItem>
                        </Menu>
                        <StackPanel x:Name="ExportToExcel_StackPanel" RenderTransformOrigin="0.5,0.5" Width="31">
                            <StackPanel.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="-1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </StackPanel.RenderTransform>
                            <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" Command="local:Commands.ExportToExcel"  Width="30" Height="25" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,12,1,1">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <StackPanel Margin="5,2,5,2" x:Name="AddNewAction_StackPanel"  Orientation="Horizontal" FlowDirection="RightToLeft" ToolTip="New Entry" ToolTipService.InitialShowDelay="100">
                            <Button  Style="{DynamicResource AddButtonStyle}"  Width="22" Height="22" x:Name="Add_btn" TabIndex="15" Click="NewBeneficiary_Click" Margin="0,0,1,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/newEntry.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <StackPanel Margin="5,8,5,8" x:Name="AddMultiAction_StackPanel"  Orientation="Horizontal" FlowDirection="RightToLeft">
                            <Button ToolTip="New Entry From Excel" ToolTipService.InitialShowDelay="100" Style="{DynamicResource AddButtonStyle}"  Width="30" Height="25"
                  x:Name="AddMultiBeneficiary_btn" TabIndex="15" Click="AddMultiBeneficiary_btn_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,1,0">
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/newEntryExcel.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="Delete_Selected" Margin="5,8,5,8" Orientation="Horizontal" FlowDirection="LeftToRight">
                            <Button ToolTip="Delete Selected" ToolTipService.InitialShowDelay="100" Style="{DynamicResource AddButtonStyle}" 
                       x:Name="Delete_Selected_btn" TabIndex="15" Height="22" Width="30" Margin="0,2,1,0" Click="Delete_Selected_btn_Click"  >
                                <Button.Background>
                                    <ImageBrush ImageSource="/Images/Buttons/delete_selected.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                            <!--<TextBlock Style="{StaticResource HyperlinkWithImageStyle}" ToolTip="Delete Selected" ToolTipService.InitialShowDelay="100" Height="29" Width="24.5" VerticalAlignment="Bottom">
                    <Hyperlink x:Name="Delete_Selected_TextBlock" Click="Delete_Selected_TextBlock_Click">
                        <Run Text=" " /> -->
                            <!-- Empty text since we are using an image -->
                            <!--
                </Hyperlink>
                            </TextBlock>-->
                        </StackPanel>
                        <StackPanel x:Name="Postpone_StackPanel" Margin="5,8,5,8" Orientation="Horizontal" FlowDirection="LeftToRight">
                            <TextBox x:Name="monthes_txtBox" TextChanged="monthes_txtBox_TextChanged" Tag="Postpone Payments"
                    Style="{DynamicResource CustomTextBoxActionStyle}" VerticalAlignment="Stretch" />
                            <Border Background="White" Margin="3,0,0,0">
                                <Button Style="{DynamicResource AddButtonStyle}" ToolTip="Save" ToolTipService.InitialShowDelay="100"
                         x:Name="delaypayment_btn" TabIndex="15" Click="delaypayment_btn_Click" Height="17" Width="24" >
                                    <Button.Background>
                                        <ImageBrush ImageSource="/Images/Buttons/postpon_payments.png" Stretch="Uniform"/>
                                    </Button.Background>
                                </Button>
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Name="Search_StackPanel" Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <TextBox Style="{DynamicResource TextBoxActionStyle}" TextChanged="Search_txtBox_TextChanged" x:Name="Search_txtBox" TextWrapping="Wrap" TabIndex="10"/>
                    </StackPanel>
                </DockPanel>
                <!--<CheckBox Grid.Column="3" x:Name="ExactSearch_checkBox" Content="Full Match"                        
              Foreground = "{DynamicResource HopeBlue4}"
        Checked="ExactSearch_checkBox_Checked" Unchecked="ExactSearch_checkBox_Unchecked" VerticalContentAlignment="Center" 
        HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,15,0,9" Width="90" />-->
            </Grid>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="233*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="Grid_col" Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Name="Expander_col" Width="*" ></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <syncfusion:SfDataGrid   Grid.Row="0" x:Name="myDataGrid"  Grid.Column="1"
                    Style="{DynamicResource SfDataGrid_body}"
                    HeaderStyle="{DynamicResource SfDataGrid_header}"
                    RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                    AlternatingRowStyleSelector="{StaticResource AlternatingrowStyleSelector}"
                    RowStyleSelector="{StaticResource rowStyleSelector}"
                    FrozenColumnCount="3"
                    AutoGenerateColumns="True"
                    SelectionChanged="myDataGrid_SelectionChanged"
                    MouseDoubleClick="myDataGrid_MouseDoubleClick"
                    Loaded="myDataGrid_Loaded" 
                    AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FilterChanged="myDataGrid_FilterChanged" Margin="5,5,10,5">

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTemplateColumn x:Name="Attachment_DataGridColumn" MappingName =" " HeaderText="Attachment" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Attachment_Style}" Click="Attachment_Button_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                        <syncfusion:GridTemplateColumn x:Name="Edit_DataGridColumn" MappingName =" " HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                        <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn" MappingName =" " HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                        <syncfusion:GridCheckBoxColumn x:Name="Selected_DataGridColumn" HeaderText="Select" MappingName="IsSelected" AllowEditing="True" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridCheckBoxColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chkHeader" Loaded="chkHeader_Loaded" Click="chkHeader_Click"/>
                                </DataTemplate>
                            </syncfusion:GridCheckBoxColumn.HeaderTemplate>
                            <syncfusion:GridCheckBoxColumn.CellStyle>
                                <Style>
                                    <Style.Resources>
                                        <Style TargetType="CheckBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="1">
                                                    <Setter Property="Background" Value="{StaticResource LightGray1}" />
                                                    <Setter Property="FlowDirection" Value="LeftToRight" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsSelected}" Value="0">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Style.Resources>
                                </Style>
                            </syncfusion:GridCheckBoxColumn.CellStyle>
                        </syncfusion:GridCheckBoxColumn>

                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
                <Grid Grid.Column="1" Grid.Row="1" VerticalAlignment="Center">
                    <Label x:Name="Exchange_Note_lable" Style="{DynamicResource NoteStyle}" Content="Red-highlighted row refers to a beneficiary with 3 or more delayed payments." HorizontalAlignment="Left"/>
                </Grid>
                <Expander x:Name="myExpander" Grid.Column="0" Width="Auto" Grid.RowSpan="2" Margin="5" FlowDirection="RightToLeft" IsExpanded="False"
                 Style="{StaticResource AccountExpander}"
                    Expanded="myExpander_Expanded"  Collapsed="myExpander_Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="{StaticResource DarkGray}" HorizontalAlignment="Left">
                    <ScrollViewer x:Name="Scroll_Viewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="Auto">
                        <Grid x:Name="Totals_Grid" Margin="20,7,20,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="1" Grid.RowSpan="28" Background="{StaticResource DarkGray}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                            <Label Tag="LegacySection" Grid.Row="0" Grid.ColumnSpan="3" Style="{DynamicResource NoteStyle}" FontSize="14" FontFamily="Rubik" FontWeight="Medium" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center" Background="{StaticResource LightGray1}"
                             x:Name="LocalTotals_Title_lbl" Content="SYP" Foreground="{StaticResource HopeRed}"
                             Margin="1,0,1,0" VerticalAlignment="Stretch" />
                           

                            <Label Tag="LegacySection" Grid.Column="2" Grid.Row="1" FontSize="12" Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total loans amount:" HorizontalAlignment="Left"/>
                            <Label Tag="LegacySection" Grid.Column="0" Grid.Row="1" FontSize="12" Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="sum_BAmounts_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right" />

                            <Label Tag="LegacySection" Grid.Column="2" Grid.Row="3" FontSize="12" Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total returned amount(pay):" HorizontalAlignment="Left"/>
                            <Label Tag="LegacySection" Grid.Column="0" Grid.Row="3" FontSize="12" Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="sum_ReturnedAmounts_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right" />

                            <Label Tag="LegacySection" Grid.Column="2" Grid.Row="2" FontSize="12" Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total income amount(pay):" HorizontalAlignment="Left" />
                            <Label Tag="LegacySection" Grid.Column="0" Grid.Row="2" FontSize="12"  Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="sum_imports_lbl" Style="{DynamicResource statistic_lableStyle}"  Content="###,###" HorizontalAlignment="Right" />

                            <Label Tag="LegacySection" Grid.Column="2" Grid.Row="4" FontSize="12"  Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total income amount:" HorizontalAlignment="Left"/>
                            <Label Tag="LegacySection" Grid.Column="0" Grid.Row="4" FontSize="12"  Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="sum_IAmounts_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right"/>

                            <Label Tag="LegacySection" Grid.Column="2" Grid.Row="5" FontSize="12"  Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total invoices amount:" HorizontalAlignment="Left"/>
                            <Label Tag="LegacySection" Grid.Column="0" Grid.Row="5" FontSize="12"  Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="sum_RAmounts_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right"/>

                            <!--<Label Tag="LegacySection" Grid.Column="2" Grid.Row="5" FontSize="12"  Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total unbilled amounts:" HorizontalAlignment="Left"/>
                            <Label Tag="LegacySection" Grid.Column="0" Grid.Row="5" FontSize="12"   Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="sum_RemainedAmounts_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right"  />-->

                            <Label Tag="LegacySection" Grid.Column="2" Grid.Row="6"  FontSize="12"  Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Net account:" HorizontalAlignment="Left"/>
                            <Label Tag="LegacySection" Grid.Column="0" Grid.Row="6" FontSize="12"   Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="sum_NetAmounts_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right" />

                            <Label Tag="LegacySection" Grid.Column="2" Grid.Row="7"  FontSize="12"  Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Average micro program cost:" HorizontalAlignment="Left"/>
                            <Label Tag="LegacySection" Grid.Column="0" Grid.Row="7" FontSize="12"  Margin="0,0,0,10"  Foreground="{StaticResource HopeRed}" x:Name="avg_amounts_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right"  />
                            <!-- the current local currency's totals (columns "... new" from P2); shown only
                                 where the account / project holds anything in that currency -->
                            <Label Grid.Row="8" Grid.ColumnSpan="3" Style="{DynamicResource NoteStyle}" FontSize="14" FontFamily="Rubik" FontWeight="Medium" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center" Background="{StaticResource LightGray1}"
                            x:Name="CurrentTotals_Title_lbl" Tag="CurrentSection" Content="SYPNEW" Foreground="{StaticResource HopeRed}"
                            Margin="1,0,1,0" VerticalAlignment="Stretch" />
                            <Label Grid.Column="2" Grid.Row="9" Tag="CurrentSection" FontSize="12" Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total loans amount:" HorizontalAlignment="Left"/>
                            <Label Grid.Column="0" Grid.Row="9" Tag="CurrentSection" FontSize="12" Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="cur_sum_BAmounts_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right" />
                            <Label Grid.Column="2" Grid.Row="10" Tag="CurrentSection" FontSize="12" Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total income amount(pay):" HorizontalAlignment="Left"/>
                            <Label Grid.Column="0" Grid.Row="10" Tag="CurrentSection" FontSize="12" Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="cur_sum_imports_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right" />
                            <Label Grid.Column="2" Grid.Row="11" Tag="CurrentSection" FontSize="12" Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total returned amount(pay):" HorizontalAlignment="Left"/>
                            <Label Grid.Column="0" Grid.Row="11" Tag="CurrentSection" FontSize="12" Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="cur_sum_ReturnedAmounts_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right" />
                            <Label Grid.Column="2" Grid.Row="12" Tag="CurrentSection" FontSize="12" Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total income amount:" HorizontalAlignment="Left"/>
                            <Label Grid.Column="0" Grid.Row="12" Tag="CurrentSection" FontSize="12" Margin="0,0,0,10" Foreground="{StaticResource HopeRed}" x:Name="cur_sum_IAmounts_lbl" Style="{DynamicResource statistic_lableStyle}" Content="###,###" HorizontalAlignment="Right" />
                            <Label Grid.Column="2" Grid.Row="13" Tag="CurrentSection" FontSize="12" Margin="0,0,0,10" Style="{DynamicResource statistic_lableStyle}" Content="Total invoices amount:" HorizontalAlignment="Left"/>

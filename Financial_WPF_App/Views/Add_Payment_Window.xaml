<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:Helper="clr-namespace:Financial_WPF_App.Helper"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"  xmlns:Controls="clr-namespace:Financial_WPF_App.Controls" x:Class="Financial_WPF_App.Views.Add_Payment_Window"
        mc:Ignorable="d" Tag="Add Payment Window" Height="700"
        Title="Add_Payment_Window" Style="{StaticResource WindowPopupStyle}" WindowStartupLocation="CenterScreen"  Closing="Window_Closing">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1.4*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="35*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0" Grid.ColumnSpan="2">
            <local:WindowControlBar_Popup x:Name="ControlBar"/>
        </DockPanel>
        <Border Background="White" CornerRadius="{StaticResource CornerRadius}" Padding="10" Grid.Column="1" Grid.Row="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity=".3" Color="{StaticResource Color_DarkGray}" />
            </Border.Effect>
            <Grid  >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width=".3*" />
                    <ColumnDefinition Width="40*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" Grid.RowSpan="14" Background="{StaticResource DarkGray}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Total payments:"    HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="0" VerticalAlignment="Stretch" />
                <Label x:Name="TotalPaymentCount_txtBox"  Style="{DynamicResource statistic_lableStyle}" FontSize="12" Margin="0,0,0,10"
                    TabIndex="13"   Content="###,###"  Grid.Column="1" Grid.Row="0" />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Paid payments:"    HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="1" VerticalAlignment="Stretch" />
                <Label x:Name="PaidPaymentCount_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="1" Grid.Row="1" FontSize="12" Margin="0,0,0,10"
                    TabIndex="13"   Content="###,###"  />

                <Label Style="{DynamicResource statistic_lableStyle}" Content="Loan amount:"    HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="2" VerticalAlignment="Stretch" />
                <Label x:Name="LoanAmount_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="1" Grid.Row="2" FontSize="12" Margin="0,0,0,10"
        TabIndex="13"    VerticalAlignment="Stretch" />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Amount owed:"    HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="3" VerticalAlignment="Stretch" />
                <Label x:Name="AmountAowed_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="1" Grid.Row="3" FontSize="12" Margin="0,0,0,10"
        TabIndex="13"   Content="###,###"   />


                <Label Style="{DynamicResource statistic_lableStyle}" Content="Amount paid:"    HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="4" VerticalAlignment="Stretch" />
                <Label x:Name="AmountPaid_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="1" Grid.Row="4" FontSize="12" Margin="0,0,0,10"
        TabIndex="13"   Content="###,###"  />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Not Approved amount:"    HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="5" VerticalAlignment="Stretch" />
                <Label x:Name="NotApprovedAmount_txtBox"  Style="{DynamicResource statistic_lableStyle}" Grid.Column="1" Grid.Row="5" FontSize="12" Margin="0,0,0,10"
        TabIndex="13"   Content="###,###"  />


                <Label Style="{DynamicResource statistic_lableStyle}" Content="Remaining amount:"    HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="6" VerticalAlignment="Stretch" />
                <Label x:Name="RemainingAmount_txtBox"  Style="{DynamicResource statistic_lableStyle}"  Grid.Column="1" Grid.Row="6" FontSize="12" Margin="0,0,0,10"
                    TabIndex="13"   Content="###,###"  />


                <Label Grid.Column="0" Grid.Row="7" Style="{DynamicResource statistic_lableStyle}" Content="Unpaid:"   HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"  />
                <Label x:Name="UnpaidPaymentCount_txtBox" Grid.Column="1" Grid.Row="7"  Style="{DynamicResource statistic_lableStyle}" TabIndex="13" FontSize="12" Margin="0,0,0,10"
                      Content="###,###"   />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Incomplete:"   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="0" Grid.Row="8"  />
                <Label x:Name="InComplete_txtBox"  Style="{DynamicResource statistic_lableStyle}" TabIndex="13" FontSize="12" Margin="0,0,0,10"
                      Content="###,###" Grid.Column="1" Grid.Row="8"  />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Not approved"   HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="9" VerticalAlignment="Stretch"   />
                <Label x:Name="NotApprovedPaymentCont_txtBox" Grid.Column="1" Grid.Row="9" FontSize="12" Margin="0,0,0,10" Content="###,###"
    Style="{DynamicResource statistic_lableStyle}" TabIndex="13"   />
                <Label Style="{DynamicResource statistic_lableStyle}" Content="Late:"  HorizontalAlignment="Stretch" Grid.Column="0" Grid.Row="10" VerticalAlignment="Stretch"   />
                <Label x:Name="DelayedPaymentCont_txtBox" FontSize="12" Margin="0,0,0,10"
    Style="{DynamicResource statistic_lableStyle}" TabIndex="13"    Content="###,###" Grid.Column="1" Grid.Row="10" />

            </Grid>
        </Border>
        <Border Background="White"  CornerRadius="{StaticResource CornerRadius}" Padding="10"  Grid.Column="1" Grid.Row="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity=".3" Color="{StaticResource Color_DarkGray}" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="MircoProject_ID_lable" Grid.Column="0" Grid.Row="0" Style="{DynamicResource statistic_lableStyle}" Content="Project number:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"   />
                <Controls:AutoCompleteTextBoxUserControl TextBoxStyle="{StaticResource FloatingTextBoxStyle}"
                x:Name="MircoProject_ID_autoSuggestionUserControl" Grid.Row="0"
                Grid.Column="1" TabIndex="4" LostFocus="MircoProject_ID_autoSuggestionUserControl_LostFocus" />
                <Label x:Name="BeneficiaryName_lable" Grid.Column="0" Grid.Row="1" Style="{DynamicResource statistic_lableStyle}" Content="Beneficiary Name:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  />
                <Controls:AutoCompleteTextBoxUserControl  TextBoxStyle="{StaticResource FloatingTextBoxStyle}"
                x:Name="BeneficiaryName_autoSuggestionUserControl" 
                TabIndex="4" Grid.Column="1" Grid.Row="1"
                LostFocus="BeneficiaryName_autoSuggestionUserControl_LostFocus" />
                <Label x:Name="Amount_Label" Grid.Column="0" Style="{DynamicResource statistic_lableStyle}" Content="Payment amount:"  HorizontalAlignment="Stretch" Grid.Row="2"  />
                <TextBox x:Name="Amount_txtBox" Grid.Column="1" 
                Style="{DynamicResource FloatingTextBoxStyle}" 
                TabIndex="3"  LostFocus="Amount_txtBox_LostFocus"  Grid.Row="2"  />
                <Label x:Name="Notes_Label" Grid.Column="0" Grid.Row="3" Style="{DynamicResource statistic_lableStyle}" Content="Description:"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"   />
                <TextBox x:Name="Notes_txtBox" Grid.Row="3" TabIndex="7" Grid.Column="1"
                Style="{DynamicResource FloatingTextBoxStyle}" />
                <StackPanel Grid.Row="4" x:Name="CashAccount_panel" Orientation="Horizontal" Grid.Column="1">
                    <ComboBox x:Name="CashAccount_comboBox" TabIndex="6" Width="175"
                    DisplayMemberPath="Name" SelectedValuePath="ID" 
                    Style="{StaticResource FloatingComboboxStyle}"
                    VerticalContentAlignment="Center"/>
                    <Button x:Name="CashAccount_clear_btn" Style="{StaticResource DeleteButtonStyle}" Click="CashAccount_clear_btn_Click" Height="30" >
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
                <Label Grid.Column="0" Grid.Row="4" x:Name="CashAccount_lable" Style="{DynamicResource statistic_lableStyle}" Content="Cash till:"   VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  />
                <Label x:Name="Date_Label" Grid.Column="0" Grid.Row="5" Style="{DynamicResource statistic_lableStyle}" Content="Date:"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <DatePicker x:Name="Date_datepicker" Grid.Row="5" Grid.Column="1"  TabIndex="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="30" />
                <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource ButtonColoredStyle}" Content="Save" x:Name="Save2_btn" 
                TabIndex="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Click="Save2_btn_Click"/>

            </Grid>
        </Border>
        <syncfusion:SfDataGrid x:Name="payDataGrid" 
    Style="{DynamicResource SfDataGrid_body}"
    HeaderStyle="{DynamicResource SfDataGrid_header}"
    RowStyle="{DynamicResource SfDataGrid_RowStyle}"
    AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}" ShowGroupDropArea ="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Loaded="payDataGrid_Loaded"  Grid.Column="0" Grid.RowSpan="2" Grid.Row="1" Margin="2,35,20,5">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn MappingName="ID" HeaderText="#" 
            IsHidden="True" />
                <syncfusion:GridTextColumn MappingName="Num" HeaderText="Number of payment"/>
                <syncfusion:GridNumericColumn  HeaderText="Payment amount"  MappingName="Amount"
            NumberDecimalDigits="2"
            NumberDecimalSeparator="."
            NumberGroupSizes="3"
            NumberGroupSeparator=","/>
                <syncfusion:GridDateTimeColumn HeaderText= "Due date" MappingName="DueDate"
            CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"/>

                <syncfusion:GridTextColumn x:Name="Name_DataGridColumn" HeaderText="Payment status"  MappingName="payment_state" />
                <syncfusion:GridNumericColumn  HeaderText="Amount paid"  MappingName="Paid_Amount"
            NumberDecimalDigits="2"
            NumberDecimalSeparator="."
            NumberGroupSizes="3"
            NumberGroupSeparator=","/>
                <syncfusion:GridTextColumn HeaderText= "Payment date" MappingName="action_date"/>
                <syncfusion:GridTextColumn MappingName="Approved" HeaderText="Approved" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
        <Button TabIndex="5" Style="{DynamicResource Export_Style}" Grid.Row="1" x:Name="Export_btn2" Command="Helper:Commands.ExportToExcel" Height="25" Width="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,5,0,0" />
    </Grid>
</Window>

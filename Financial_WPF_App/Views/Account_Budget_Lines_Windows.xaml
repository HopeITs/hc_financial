<Window x:Class="Financial_WPF_App.Views.AllAccountBudgetLines_Windows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        mc:Ignorable="d"
        Title="Account_Lines_Windows" Height="615" Width="900" 
        FontFamily="Myriad Arabic" FontSize="18" WindowState="Maximized" WindowStartupLocation="CenterScreen">


    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100*"/>
        </Grid.RowDefinitions>
        <Grid >
            <Grid.ContextMenu>
                <ContextMenu Name="cm">
                    <MenuItem Header="Refresh Budget Lines" Click = "Refresh_Click" >
                        <MenuItem.Icon>
                            <Image Source="/Cashing;component/Images/refresh32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"></ColumnDefinition>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="62*"></ColumnDefinition>
                <ColumnDefinition Width="224*"></ColumnDefinition>
                <ColumnDefinition Width="205*"></ColumnDefinition>
                <ColumnDefinition Width="47*"></ColumnDefinition>
                <ColumnDefinition Width="156*"/>
                <ColumnDefinition Width="116*"></ColumnDefinition>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"></RowDefinition>


                <RowDefinition Height="40" />
                <RowDefinition/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="40.004" ></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="7"  Style="{DynamicResource lableStyle}" Content="Budget:" Margin="1,3,1,3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right" />

            <syncfusion:SfDataGrid Grid.ColumnSpan="8" FrozenColumnCount="3"
                      x:Name="myDataGrid"  
                      Style="{DynamicResource SfDataGrid_body}"
                      HeaderStyle="{DynamicResource SfDataGrid_header}"
                      RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                      AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                      TableSummaryRowStyle="{DynamicResource TableSummaryRowStyle}"   
                      GroupSummaryRowStyle="{DynamicResource GroupSummaryRowStyle}"
                                   AutoGenerateColumns="True"
                                   SelectionChanged="myDataGrid_SelectionChanged"
                                   NavigationMode="Cell"
                                   Loaded="myDataGrid_Loaded" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3,0,3,6" CurrentCellEndEdit="myDataGrid_CurrentCellEndEdit" AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" Grid.Row="2" ItemsSourceChanged="myDataGrid_ItemsSourceChanged" FilterChanged="myDataGrid_FilterChanged">
                <syncfusion:SfDataGrid.Columns>

                    <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                    <syncfusion:GridCheckBoxColumn x:Name="Selected_DataGridColumn" HeaderText="Select" MappingName="IsSelected" AllowEditing="True" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridCheckBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chkHeader" Loaded="chkHeader_Loaded" Click="chkHeader_Click"/>
                            </DataTemplate>
                        </syncfusion:GridCheckBoxColumn.HeaderTemplate>
                        <syncfusion:GridCheckBoxColumn.CellStyle>
                            <Style>
                                <Style.Resources>
                                    <Style TargetType="CheckBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="1">
                                                <Setter Property="Background" Value="Green" />
                                                <Setter Property="FlowDirection" Value="LeftToRight" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsSelected}" Value="0">
                                                <Setter Property="Background" Value="Transparent" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </syncfusion:GridCheckBoxColumn.CellStyle>
                    </syncfusion:GridCheckBoxColumn>

                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
            <Menu Name="ShowHideMenu" Margin="0,9,0,3" Grid.Column="1" HorizontalAlignment="Center" Width="32" >
                <Menu.Background>
                    <ImageBrush/>
                </Menu.Background>
                <MenuItem Header="" StaysOpenOnClick="True" Grid.Column="1" Width="32" Height="35" >
                    <MenuItem.Background>
                        <ImageBrush ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                    </MenuItem.Background>
                    <MenuItem Name="ShowMenu" Header="Show" StaysOpenOnClick="True" Background="White" />
                    <MenuItem Name="HideMenu" Header="Hide" StaysOpenOnClick="True" Background="White"/>
                    <Separator Background="Black"/>
                    <MenuItem Header="ShowAll" Click="ShowAll_MenuItem_Click" Background="White"/>
                </MenuItem>
            </Menu>
            <Button Style="{DynamicResource Export_Style}" x:Name="Export_btn"
                TabIndex="5" Command="local:Commands.ExportToExcel" Grid.Column="2" Height="NaN" Width="31" HorizontalAlignment="Left" Margin="4,14,0,13" VerticalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Grid.Row="4" FlowDirection="RightToLeft" Margin="1,5,3,5" Grid.ColumnSpan="5" Grid.Column="3" >
                <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" />
                <Border BorderThickness="1" CornerRadius="7" Padding="0" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" >
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                    </Border.Background>
                    <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"/>
                </Border>

                <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" />
                <Border BorderThickness="1" CornerRadius="7" Padding="0" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" >
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                    </Border.Background>
                    <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"  />
                </Border>
            </StackPanel>
            <Button Grid.Column="4"  Style="{DynamicResource SaveButton_Style}"
                    x:Name="Save_btn" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" Height="NaN" Width="NaN" Grid.Row="3" Margin="64,3,64,3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <StackPanel x:Name="Panel1" Orientation="Horizontal" FlowDirection="RightToLeft" Grid.ColumnSpan="8" Grid.Row="1" >
                <RadioButton x:Name="Total_RadioButton" Content="Show total" IsChecked="True" Style="{DynamicResource RadioButtonStyle}" Height="34" Width="126" HorizontalAlignment="Right" Checked="Total_RadioButton_Checked"/>
                <RadioButton x:Name="PerDonor_RadioButton" Content="Show per donor" Height="34" Width="150" Style="{DynamicResource RadioButtonStyle}" HorizontalAlignment="Right" Checked="PerDonor_RadioButton_Checked"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Column="4" Margin="1,1,0,1" >
                <Label x:Name="AddAllLines_Label"  Style="{DynamicResource lableStyle}" Content="Add missing lines:" Height="32" Width="159" HorizontalContentAlignment="Right" />
                <Button Style="{DynamicResource Add_Style}" 
                x:Name="AddAllLines_btn" TabIndex="15" Click="AddAllLines_btn_Click" Height="27" Width="23"  />
            </StackPanel>
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Column="3" Margin="1,1,1,1" >
                <Label x:Name="AddmultiLines_Label"  Style="{DynamicResource lableStyle}" Content="Add missing lines from excel:" Height="34" Width="190" />
                <Button Style="{DynamicResource Add_Style}" 
                    x:Name="AddMultiLines_btn" TabIndex="15" Height="26" Width="22" Click="AddMultiLines_btn_Click"  />
            </StackPanel>
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Column="5" Margin="1,1,1,1" Grid.ColumnSpan="2" >
                <ComboBox x:Name="Budgets_comboBox" TabIndex="3" 
                DisplayMemberPath="Name" SelectedValuePath="ID" 
                FlowDirection="RightToLeft" Width="150" MinWidth="130" FontSize="16"
                VerticalContentAlignment="Center" SelectionChanged="Budgets_comboBox_SelectionChanged" Height="30"/>
                <Button x:Name="Budget_clear_btn" BorderBrush="{x:Null}" Width="25" Click="Budget_clear_btn_Click" Height="25" >
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </StackPanel>
            <TextBlock x:Name="Delete_Selected" Margin="3,9,1,12" Grid.Row="3" TextWrapping="Wrap" Grid.ColumnSpan="4"><Hyperlink x:Name="Delete_Selected_TextBlock" Click="Delete_Selected_TextBlock_Click"><Run Text="Delete Selected"/></Hyperlink></TextBlock>
        </Grid>
    </Grid>
</Window>

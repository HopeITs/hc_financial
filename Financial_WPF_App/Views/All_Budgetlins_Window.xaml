<Window x:Class="Financial_WPF_App.Views.All_Budgetlins_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        mc:Ignorable="d"
        Title="All_Budgetlins_Window" Height="614" Width="1280"  
    FontFamily="Myriad Arabic"
    FontSize="18" 
    WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="tabItemStyle" TargetType="{x:Type TabItem}" >
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" >
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" >
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" >
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="16" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" >
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" >
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource Color_HopeYellow2}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontFamily" Value="Arial Bold" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" >
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource Color_HopeBlue3}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" >
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource Color_HopeYellow2}"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontFamily" Value="Arial Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.ContextMenu>
                <ContextMenu x:Name="cm">
                    <MenuItem Header="Refresh All" Click = "Refresh_Click" >
                        <MenuItem.Icon>
                            <Image Source="/Images/refresh32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>

            <TabControl x:Name="Main_tabControl" Grid.Column="0" Height="auto" Width="auto"
                FlowDirection="RightToLeft" TabStripPlacement="Top" 
                HorizontalContentAlignment="Stretch"  >
                <TabControl.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </TabControl.Background>
            </TabControl>
        </Grid>

    </Grid>
</Window>

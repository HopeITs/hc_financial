<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Financial_WPF_App.Controls"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.Approval_Sub_Pay_Window"
        mc:Ignorable="d"
        Title="Approval_Sub_Pay_Window" Width="1280" Height="620" FontFamily="Myriad Arabic" FontSize="18" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Helper:Approval_CustomRowStyleSelector x:Key="rowStyleSelector" />
        <Helper:Approval_CustomAlternatingRowStyleSelector x:Key="AlternatingrowStyleSelector" />
    </Window.Resources>
    <Grid  Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="233*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"/>
                </Border>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource MainBorderWrapPanelStyle}">
            <StackPanel Orientation="Horizontal">
                <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                <Border Style="{StaticResource BorderStackPanelStyle}">
                    <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged"/>
                </Border>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,5,0,0" Grid.ColumnSpan="2" >
            <DockPanel  LastChildFill="False" Background="{StaticResource LightGray1}" Height="40">
                <WrapPanel Orientation="Horizontal" Width="Auto">
                    <Menu x:Name="ShowHideMenu" Margin="5,2,5,2">
                        <Menu.Resources>
                            <!-- Custom Menu Style -->
                            <Style TargetType="Menu">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Menu">
                                            <Border Background="{TemplateBinding Background}" Padding="0">
                                                <ItemsPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Custom MenuItem Style -->
                            <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
                                <Setter Property="FontFamily" Value="Rubik"/>
                                <Setter Property="FontSize" Value="13.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource DarkGray}"/>
                                <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Grid>
                                                <!-- Main Item -->
                                                <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="10,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <!-- Arrow Column -->
                                                        </Grid.ColumnDefinitions>

                                                        <ContentPresenter Grid.Column="0" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Center" 
        ContentSource="Header"/>

                                                        <!-- Submenu Arrow -->
                                                        <Path x:Name="Arrow"
       Grid.Column="1"
       Data="M 0 0 L 6 4 L 0 8 Z" 
       Fill="{DynamicResource DarkGray}"
       VerticalAlignment="Center"
       Margin="5,0,0,0"
       Visibility="Collapsed"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Submenu Popup -->
                                                <Popup x:Name="Popup"
Placement="Bottom"
PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
IsOpen="{TemplateBinding IsSubmenuOpen}"
AllowsTransparency="True"
Focusable="False"
PopupAnimation="Fade">
                                                    <Border Background="White" CornerRadius="5" BorderBrush="{StaticResource LightGray1}" BorderThickness="1">
                                                        <StackPanel>
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Grid>

                                            <!-- Triggers -->
                                            <ControlTemplate.Triggers>
                                                <!-- Show Arrow Only if the MenuItem has sub-items (is a submenu) -->
                                                <Trigger Property="HasItems" Value="True">
                                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                                </Trigger>

                                                <!-- Submenu Hover Effect -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <!--<Setter TargetName="Border" Property="Background" Value="transparent"/>-->
                                                    <!--<Setter Property="Foreground" Value="{DynamicResource LightGray1}"/>-->
                                                </Trigger>

                                                <!-- Submenu Open Effect -->
                                                <Trigger Property="IsSubmenuOpen" Value="True">
                                                    <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
                                                </Trigger>

                                                <!-- Disabled Effect -->
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource MidGray}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </Menu.Resources>
                        <!-- MenuItems with Custom Style -->
                        <MenuItem Width="20" Height="20" StaysOpenOnClick="True" Header=""  Style="{StaticResource CustomMenuItemStyle}" Margin="6,9,0,0" ToolTip="Show/Hide Columns" ToolTipService.InitialShowDelay="100">
                            <MenuItem.Background>
                                <ImageBrush ImageSource="/Images/Buttons/showHide.png" Stretch="Uniform"/>
                            </MenuItem.Background>
                            <!-- Submenu Items (Will Keep Hover Effect) -->
                            <MenuItem StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                            <MenuItem StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                            <MenuItem Background="{StaticResource LightGray1}" Click="ShowAll_MenuItem_Click" Header="ShowAll" Style="{StaticResource CustomMenuItemStyle}"/>
                        </MenuItem>
                    </Menu>
                    <StackPanel x:Name="ExportToExcel_StackPanel" RenderTransformOrigin="0.5,0.5" Width="31">
                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                        <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" Command="local:Commands.ExportToExcel"  Width="30" Height="25" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,10,1,1">
                            <Button.Background>
                                <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png" Stretch="Uniform"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                    <Button  Style="{DynamicResource AddButtonStyle}"
                     x:Name="Restore_btn" FlowDirection="LeftToRight" HorizontalAlignment="Stretch" Grid.Column="1" VerticalAlignment="Stretch" Width="30" Height="22" Click="Restore_btn_Click" ToolTip="Restore" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,10,1,1">
                        <Button.Background>
                            <ImageBrush ImageSource="/Images/Buttons/restore.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </WrapPanel>
                <StackPanel x:Name="Panel1" Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,5,0">
                    <RadioButton Style="{StaticResource RadioButtonStyle}" x:Name="DeletedActions_RadioButton" Content="Show Deleted Actions" IsChecked="False" Margin="12,6,3,8" Grid.Column="2" Tag="False" Click="DeletedActions_RadioButton_Click"/>
                    <TextBox Style="{DynamicResource TextBoxActionStyle}" TextChanged="Search_txtBox_TextChanged" x:Name="Search_txtBox" TextWrapping="Wrap" TabIndex="10"/>
                </StackPanel>
                <controls:UC_MonthFilter x:Name="MonthFilter" DockPanel.Dock="Right"
                                         VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
        </Grid>
        <syncfusion:SfDataGrid x:Name="myDataGrid"  FrozenColumnCount="1"
             Style="{DynamicResource SfDataGrid_body}"
                             HeaderStyle="{DynamicResource SfDataGrid_header}"
                             RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                             AlternatingRowStyleSelector="{StaticResource AlternatingrowStyleSelector}"
                             RowStyleSelector="{StaticResource rowStyleSelector}"                            
                Loaded="myDataGrid_Loaded" SelectionChanged="myDataGrid_SelectionChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FilterChanged="myDataGrid_FilterChanged" Grid.Row="3" Margin="2,5,5,5">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridCheckBoxColumn x:Name="Selected_DataGridColumn" HeaderText="Select" MappingName="IsSelected" AllowEditing="True" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridCheckBoxColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="chkHeader" Loaded="chkHeader_Loaded" Click="chkHeader_Click"/>
                        </DataTemplate>
                    </syncfusion:GridCheckBoxColumn.HeaderTemplate>
                    <syncfusion:GridCheckBoxColumn.CellStyle>
                        <Style>
                            <Style.Resources>
                                <Style TargetType="CheckBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="1">
                                            <Setter Property="Background" Value="{StaticResource LightGray1}" />
                                            <Setter Property="FlowDirection" Value="LeftToRight" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsSelected}" Value="0">
                                            <Setter Property="Background" Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Style.Resources>
                        </Style>
                    </syncfusion:GridCheckBoxColumn.CellStyle>
                </syncfusion:GridCheckBoxColumn>

                <syncfusion:GridTextColumn x:Name="Subproject_DataGridColumn" MappingName="SubProjectName" HeaderText="Project"/>
                <syncfusion:GridTextColumn x:Name="Account_DataGridColumn" MappingName="AccountName" HeaderText="Account"/>
                <syncfusion:GridNumericColumn  HeaderText="Payment amount(SYR)" Width="200"  MappingName="Incomesyr"
                    NumberDecimalDigits="2"
                    NumberDecimalSeparator="."
                    NumberGroupSizes="3"
                    NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  HeaderText="Payment amount(USD)" Width="200"  MappingName="Incomeusd"
NumberDecimalDigits="2"
NumberDecimalSeparator="."
NumberGroupSizes="3"
NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  HeaderText="Returned amount(SYR)" Width="200"  MappingName="Outcomesyr"
NumberDecimalDigits="2"
NumberDecimalSeparator="."
NumberGroupSizes="3"
NumberGroupSeparator=","/>
                <syncfusion:GridNumericColumn  HeaderText="Returned amount(USD)" Width="200" MappingName="Outcomeusd"
NumberDecimalDigits="2"
NumberDecimalSeparator="."
NumberGroupSizes="3"
NumberGroupSeparator=","/>
                <syncfusion:GridTextColumn MappingName="MicroProject_ID" HeaderText="Micro Project number"/>
                <syncfusion:GridTextColumn MappingName="Name" HeaderText="Beneficiary Name"/>
                <syncfusion:GridTextColumn MappingName="beneficiary_ID" HeaderText="beneficiary_ID" IsHidden="True"/>
                <syncfusion:GridTextColumn MappingName="Payment_Num" HeaderText="Number of payment"/>
                <syncfusion:GridDateTimeColumn HeaderText="Payment date" MappingName="ActionDate"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                <syncfusion:GridTextColumn  MappingName="ActionMonth" HeaderText="Payment Month"/>
                <syncfusion:GridTextColumn  MappingName="ActionYear" HeaderText="Payment Year"/>

                <syncfusion:GridTextColumn MappingName="Note" HeaderText="Description"/>
                <syncfusion:GridTextColumn MappingName="beneficiary_Account_ID" HeaderText="beneficiary_Account_ID" IsHidden="True"/>
                <syncfusion:GridTextColumn MappingName="beneficiary_Account" HeaderText="Account"/>
                <syncfusion:GridTextColumn MappingName="cashaccount_name" HeaderText="Cash till"/>
                <syncfusion:GridTextColumn MappingName="beneficiaryDonor_ID" HeaderText="beneficiaryDonor_ID" IsHidden="True"/>
                <syncfusion:GridTextColumn MappingName="beneficiaryDonor_Name" HeaderText="Donor"/>
                <syncfusion:GridTextColumn x:Name="Created_by_DataGridColumn" MappingName="created_by" HeaderText="Created by"/>
                <syncfusion:GridDateTimeColumn HeaderText="Date created" MappingName="created_at"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                <syncfusion:GridTextColumn x:Name="Edited_by_DataGridColumn" MappingName="edited_by" HeaderText="Edited by"/>
                <syncfusion:GridDateTimeColumn HeaderText="Modification date" MappingName="updated_at"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />

                <syncfusion:GridTextColumn x:Name="Deleted_by_DataGridColumn" MappingName="deleted_by" HeaderText="Deleted By"/>

                <syncfusion:GridDateTimeColumn x:Name="Deleted_at_DataGridColumn" HeaderText="Date Deleted" MappingName="deleted_at"
                            CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />

            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <Grid Grid.Row="4" VerticalAlignment="Center">
            <Button   Style="{DynamicResource ButtonColoredStyle}"
             x:Name="Save_btn" Content="Approve" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" HorizontalAlignment="Left" Width="175" />
            <Label x:Name="Exchange_Note_lable" Style="{DynamicResource NoteStyle}" Content="Red-highlighted row refers to an edited action."/>
        </Grid>
    </Grid>
</Window>

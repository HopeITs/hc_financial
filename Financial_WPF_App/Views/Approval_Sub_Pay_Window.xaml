<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Helper="clr-namespace:Financial_WPF_App.Helper" x:Class="Financial_WPF_App.Views.Approval_Sub_Pay_Window"
        mc:Ignorable="d"
        Title="Approval_Sub_Pay_Window" Width="1280" Height="620" FontFamily="Myriad Arabic" FontSize="18" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Helper:Approval_CustomRowStyleSelector x:Key="rowStyleSelector" />
        <Helper:Approval_CustomAlternatingRowStyleSelector x:Key="AlternatingrowStyleSelector" />
    </Window.Resources>
    <Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="2" Margin="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="427*"/>
                    <ColumnDefinition Width="179*"/>
                    <ColumnDefinition Width="46*"/>
                    <ColumnDefinition Width="202*"/>
                    <ColumnDefinition Width="427*"/>
                </Grid.ColumnDefinitions>
                <Button  Style="{DynamicResource SaveButton_Style}"
                    x:Name="Save_btn" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" Height="NaN" Width="NaN" HorizontalAlignment="Stretch" Grid.Column="3" VerticalAlignment="Stretch" Margin="28,3,27,3" />
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="7,10,4,7" Grid.Column="4" >
                    <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" />
                    <Border Style="{StaticResource BorderStackPanelStyle}" >
                        <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True"/>
                    </Border>
                </StackPanel>
                <Label x:Name="Exchange_Note_lable" Style="{DynamicResource lableStyle}" Content="Red-highlighted row refers to an edited action." Margin="2,1,2,1" FontSize="18" Foreground="#FFBE121F" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" />
                <Button  Style="{DynamicResource RestoreButton_Style}"
                    x:Name="Restore_btn" TabIndex="4" FlowDirection="LeftToRight" Height="NaN" Width="NaN" HorizontalAlignment="Stretch" Grid.Column="1" VerticalAlignment="Stretch" Margin="27,3,11,3" Click="Restore_btn_Click" />
            </Grid>
            <Grid Margin="10,1,4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="420.788"/>
                    <ColumnDefinition Width="152.212"/>
                    <ColumnDefinition Width="233"/>
                    <ColumnDefinition Width="Auto" MinWidth="8" />
                    <ColumnDefinition Width="87" />
                    <ColumnDefinition Width="14*" />
                    <ColumnDefinition Width="251*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="6" Content="Search:" Style="{DynamicResource lableStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="3,4,3,6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                <Border Grid.Column="4" BorderThickness="1" CornerRadius="10" Padding="0" Width="auto" Margin="4,4,4,4" >
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource Color_HopeBlue4}"/>
                    </Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                    </Border.Background>
                    <TextBox x:Name="Search_txtBox" TabIndex="10" 
                        Style="{DynamicResource textBoxStyle}"
                        Width="auto" TextAlignment="Center" BorderThickness="0"
                        TextChanged="Search_txtBox_TextChanged" >
                        <TextBox.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                        </TextBox.BorderBrush>
                    </TextBox>
                </Border>
                <!--<CheckBox Unchecked="ExactSearch_checkBox_Unchecked" Style="{DynamicResource checkBoxStyle}" x:Name="ExactSearch_checkBox" Margin="9,4,1,4" HorizontalAlignment="Stretch" Content="Full match" Grid.Column="3" Checked="ExactSearch_checkBox_Checked" VerticalAlignment="Stretch"/>-->
                <Menu
                    x:Name="ShowHideMenu" Margin="2,1,1,2">
                    <Menu.Background>
                        <ImageBrush/>
                    </Menu.Background>
                    <MenuItem
                        Width="47" StaysOpenOnClick="True" Header="" Height="50">
                        <MenuItem.Background>
                            <ImageBrush
                                ImageSource="/Images/2072010 (100x100).png" Stretch="Uniform" TileMode="Tile"/>
                        </MenuItem.Background>
                        <MenuItem
                            StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="White"/>
                        <MenuItem
                            StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="White"/>
                        <Separator
                            Background="Black"/>
                        <MenuItem
                            Background="White" Click="ShowAll_MenuItem_Click" Header="ShowAll"/>
                    </MenuItem>
                </Menu>
                <Button
                    TabIndex="5" Style="{DynamicResource Export_Style}" x:Name="Export_btn" Grid.Column="1" Command="Helper:Commands.ExportToExcel" RenderTransformOrigin="0.536,0.355" Height="41" Width="34" HorizontalAlignment="Stretch" Margin="8,6,8,7" VerticalAlignment="Stretch"/>
                <RadioButton x:Name="DeletedActions_RadioButton" Content="Show Deleted Actions" IsChecked="False" Style="{DynamicResource RadioButtonStyle}" Margin="112,6,3,8" Grid.Column="2" Tag="False" Click="DeletedActions_RadioButton_Click"/>
            </Grid>
            <syncfusion:SfDataGrid x:Name="myDataGrid"  FrozenColumnCount="1"
             Style="{DynamicResource SfDataGrid_body}"
                             HeaderStyle="{DynamicResource SfDataGrid_header}"
                             RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                             AlternatingRowStyleSelector="{StaticResource AlternatingrowStyleSelector}"
                             RowStyleSelector="{StaticResource rowStyleSelector}"                            
                Loaded="myDataGrid_Loaded" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,1,2,1" FilterChanged="myDataGrid_FilterChanged" Grid.Row="1">

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridCheckBoxColumn x:Name="Selected_DataGridColumn" HeaderText="Select" MappingName="IsSelected" AllowEditing="True" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridCheckBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chkHeader" Loaded="chkHeader_Loaded" Click="chkHeader_Click"/>
                            </DataTemplate>
                        </syncfusion:GridCheckBoxColumn.HeaderTemplate>
                        <syncfusion:GridCheckBoxColumn.CellStyle>
                            <Style>
                                <Style.Resources>
                                    <Style TargetType="CheckBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="1">
                                                <Setter Property="Background" Value="Green" />
                                                <Setter Property="FlowDirection" Value="LeftToRight" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsSelected}" Value="0">
                                                <Setter Property="Background" Value="Transparent" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </syncfusion:GridCheckBoxColumn.CellStyle>
                    </syncfusion:GridCheckBoxColumn>

                    <syncfusion:GridTextColumn x:Name="Subproject_DataGridColumn" MappingName="SubProjectName" HeaderText="Subproject"/>
                    <syncfusion:GridTextColumn x:Name="Account_DataGridColumn" MappingName="AccountName" HeaderText="Account"/>
                    <syncfusion:GridNumericColumn  HeaderText="Payment amount"  MappingName="Income"
                        NumberDecimalDigits="2"
                        NumberDecimalSeparator="."
                        NumberGroupSizes="3"
                        NumberGroupSeparator=","/>
                    <syncfusion:GridTextColumn MappingName="MicroProject_ID" HeaderText="Project number"/>
                    <syncfusion:GridTextColumn MappingName="Name" HeaderText="Beneficiary Name"/>
                    <syncfusion:GridTextColumn MappingName="beneficiary_ID" HeaderText="beneficiary_ID" IsHidden="True"/>
                    <syncfusion:GridTextColumn MappingName="Payment_Num" HeaderText="Number of payment"/>
                    <syncfusion:GridDateTimeColumn HeaderText="Payment date" MappingName="ActionDate"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                    <syncfusion:GridTextColumn  MappingName="ActionMonth" HeaderText="Payment Month"/>
                    <syncfusion:GridTextColumn  MappingName="ActionYear" HeaderText="Payment Year"/>

                    <syncfusion:GridTextColumn MappingName="Note" HeaderText="Description"/>
                    <syncfusion:GridTextColumn MappingName="beneficiary_Account_ID" HeaderText="beneficiary_Account_ID" IsHidden="True"/>
                    <syncfusion:GridTextColumn MappingName="beneficiary_Account" HeaderText="Account"/>
                    <syncfusion:GridTextColumn MappingName="cashaccount_name" HeaderText="Cash till"/>
                    <syncfusion:GridTextColumn MappingName="beneficiaryDonor_ID" HeaderText="beneficiaryDonor_ID" IsHidden="True"/>
                    <syncfusion:GridTextColumn MappingName="beneficiaryDonor_Name" HeaderText="Donor"/>
                    <syncfusion:GridTextColumn x:Name="Created_by_DataGridColumn" MappingName="created_by" HeaderText="Created by"/>
                    <syncfusion:GridDateTimeColumn HeaderText="Date created" MappingName="created_at"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />
                    <syncfusion:GridTextColumn x:Name="Edited_by_DataGridColumn" MappingName="edited_by" HeaderText="Edited by"/>
                    <syncfusion:GridDateTimeColumn HeaderText="Modification date" MappingName="updated_at"
                        CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />

                    <syncfusion:GridTextColumn x:Name="Deleted_by_DataGridColumn" MappingName="deleted_by" HeaderText="Deleted By"/>

                    <syncfusion:GridDateTimeColumn x:Name="Deleted_at_DataGridColumn" HeaderText="Date Deleted" MappingName="deleted_at"
                            CustomPattern="dd/MM/yyyy" Pattern="CustomPattern"   />

                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Grid>

    </Grid>
</Window>

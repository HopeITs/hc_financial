<Window x:Class="Financial_WPF_App.Views.AddBudgetLines_Windows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:local="clr-namespace:Financial_WPF_App.Helper"
        mc:Ignorable="d"
        Title="Account_Lines_Windows" Height="619.6" Width="1280" 
        FontFamily="Myriad Arabic" FontSize="18" WindowState="Maximized" WindowStartupLocation="CenterScreen">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh Budgets" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="0,1,0,1">
        <Grid.ContextMenu>
            <ContextMenu Name="cm">
                <MenuItem Header="Refresh Budget" Click = "Refresh_Click" >
                    <MenuItem.Icon>
                        <Image Source="/Cashing;component/Images/refresh32.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300*"/>
            <ColumnDefinition x:Name="First_col" Width="150*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="Grid1" Margin="2,0,0,8" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="15"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="7*"/>

                <RowDefinition Height="0.7*"/>
            </Grid.RowDefinitions>
            <Label Style="{DynamicResource lableStyle}" Content="Name:" Grid.Column="3" Margin="0,8,0,8" Grid.Row="1" VerticalAlignment="Stretch" RenderTransformOrigin="0.486,0.136" Width="88" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"  />
            <TextBox  x:Name="Name_txtBox" Style="{DynamicResource textBoxStyle}" TabIndex="5"
                Margin="1,10,3,10" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5" Grid.Row="1" Grid.Column="2"   />
            <Label Grid.Column="3" Style="{DynamicResource lableStyle}" Content="Start date:" Grid.Row="2" VerticalAlignment="Stretch" Margin="1,2,1,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
            <DatePicker x:Name="beginDate_datepicker" TabIndex="1" Margin="1,2,3,2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" Grid.Column="2" />
            <Label Style="{DynamicResource lableStyle}" Content="End date:" Margin="1,2,1,2" Grid.Row="2" VerticalAlignment="Stretch" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
            <DatePicker x:Name="endDate_datepicker" TabIndex="2" Margin="3,2,3,2" VerticalAlignment="Stretch"  Grid.Row="2" HorizontalAlignment="Stretch"  />
            <Label  Style="{DynamicResource lableStyle}" Content="Currency:" Grid.Row="1" VerticalAlignment="Stretch" Margin="0,6,0,12" Width="87" Grid.Column="1" RenderTransformOrigin="0.484,0.414" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
            <ComboBox Style="{DynamicResource FloatingComboboxStyle}" x:Name="TillType_comboBox" DisplayMemberPath="Name" SelectedValuePath="ID"
                    FlowDirection="RightToLeft" TabIndex="1" FontSize="14" Margin="1,8,1,12" VerticalAlignment="Stretch" Grid.Row="1" />
            <Button  Style="{DynamicResource SaveButton_Style}"
                    x:Name="Save_btn" TabIndex="4" Click="Save_btn_Click" FlowDirection="LeftToRight" Height="NaN" Width="NaN" Grid.Row="6" Margin="44,1,63,2" Grid.ColumnSpan="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Grid Grid.Row="4" Margin="3,2,0,1" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="4"  Style="{DynamicResource lableStyle}" Content="Donor:" VerticalAlignment="Stretch" Margin="0,2,0,2" Width="88" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" />
                <ComboBox Style="{DynamicResource FloatingComboboxStyle}" x:Name="Donor_comboBox" TabIndex="3" 
                    DisplayMemberPath="Name" SelectedValuePath="ID" 
                    FlowDirection="RightToLeft" Width="auto" MinWidth="130" FontSize="16"
                    VerticalContentAlignment="Center" Grid.Column="3" Margin="1,2,2,2" VerticalAlignment="Stretch"/>
                <Label  Style="{DynamicResource lableStyle}" Content="%" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Column="1" FontSize="25"/>
                <Button Style="{DynamicResource Add_Style}" 
                    x:Name="AddDonor_btn" TabIndex="15" HorizontalAlignment="Stretch" Margin="6,0,5,5" VerticalAlignment="Stretch" Width="NaN" Click="AddDonor_btn_Click"  />
                <TextBox x:Name="Rate_TextBox" Margin="2,2,2,2" TextWrapping="Wrap" Style="{DynamicResource textBoxStyle}" VerticalAlignment="Stretch" Grid.Column="2" LostFocus="Rate_TextBox_LostFocus"/>
            </Grid>
            <TextBox x:Name="Exchange_Note_TextBox_Copy" Margin="3,3,3,3" Grid.Row="3" TextWrapping="Wrap" Style="{DynamicResource textBoxStyle}" Text="Please note that the budget's currency is the only currency allowed to be exchanged to Syrian pound." FontSize="20" Foreground="#FFBE121F" VerticalAlignment="Stretch" Grid.ColumnSpan="4" HorizontalContentAlignment="Left"/>
            <syncfusion:SfDataGrid x:Name="Budget_Dononrs_DataGrid" Margin="1,4,1,10" Grid.Row="5" Grid.ColumnSpan="4"
                       Style="{DynamicResource SfDataGrid_body}"
                      HeaderStyle="{DynamicResource SfDataGrid_header}"
                      RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                      AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"
                      AllowFiltering="False"  
                      ShowGroupDropArea ="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemsSourceChanged="Budget_Dononrs_DataGrid_ItemsSourceChanged">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn MappingName="Budget_Donor_ID" HeaderText="Budget_Donor_ID" 
                                               IsHidden="True" />
                    <syncfusion:GridTextColumn MappingName="Donor_ID" HeaderText="Donor_ID" 
                                               IsHidden="True" />
                    <syncfusion:GridTextColumn MappingName="Donor" HeaderText="Donor"/>
                    <syncfusion:GridNumericColumn  HeaderText="Percentage"  MappingName="Rate" 
                                                   NumberDecimalDigits="2"
                                                   NumberDecimalSeparator="."
                                                   NumberGroupSizes="3"
                                                   NumberGroupSeparator=","/>

                    <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Delete_Style}" Click="Donor_DeleteButton_Click"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>

            </syncfusion:SfDataGrid>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>

            <Grid  Grid.Column="0" Margin="10,0,10,0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="233*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource MainBorderWrapPanelStyle}" Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="All:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                        <Border Style="{StaticResource BorderStackPanelStyle}">
                            <TextBlock x:Name="All_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource MainBorderWrapPanelStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Selected:" Style="{DynamicResource statistic_lableStyle}" Width="73" />
                        <Border Style="{StaticResource BorderStackPanelStyle}">
                            <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}" OverridesDefaultStyle="True" SizeChanged="All_textBlock_SizeChanged" />
                        </Border>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2" Margin="0,5,0,0" Grid.ColumnSpan="2" >
                    <DockPanel  LastChildFill="True" Background="{StaticResource LightGray1}">
                        <WrapPanel Orientation="Horizontal" Width="Auto">
                            <Menu x:Name="ShowHideMenu" Margin="5,2,5,2">
                                <Menu.Resources>
                                    <!-- Custom Menu Style -->
                                    <Style TargetType="Menu">
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Menu">
                                                    <Border Background="{TemplateBinding Background}" Padding="0">
                                                        <ItemsPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <!-- Custom MenuItem Style -->
                                    <Style x:Key="CustomMenuItemStyle" TargetType="MenuItem">
                                        <Setter Property="FontFamily" Value="Rubik"/>
                                        <Setter Property="FontSize" Value="13.5"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DarkGray}"/>
                                        <Setter Property="Background" Value="{StaticResource LightGray1}"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Grid>
                                                        <!-- Main Item -->
                                                        <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="10,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <!-- Arrow Column -->
                                                                </Grid.ColumnDefinitions>

                                                                <ContentPresenter Grid.Column="0" 
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Center" 
                                           ContentSource="Header"/>

                                                                <!-- Submenu Arrow -->
                                                                <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Data="M 0 0 L 6 4 L 0 8 Z" 
                                          Fill="{DynamicResource DarkGray}"
                                          VerticalAlignment="Center"
                                          Margin="5,0,0,0"
                                          Visibility="Collapsed"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Submenu Popup -->
                                                        <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                                            <Border Background="White" CornerRadius="5" BorderBrush="{StaticResource LightGray1}" BorderThickness="1">
                                                                <StackPanel>
                                                                    <ItemsPresenter />
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>

                                                    <!-- Triggers -->
                                                    <ControlTemplate.Triggers>
                                                        <!-- Show Arrow Only if the MenuItem has sub-items (is a submenu) -->
                                                        <Trigger Property="HasItems" Value="True">
                                                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                                        </Trigger>

                                                        <!-- Submenu Hover Effect -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <!--<Setter TargetName="Border" Property="Background" Value="transparent"/>-->
                                                            <!--<Setter Property="Foreground" Value="{DynamicResource LightGray1}"/>-->
                                                        </Trigger>

                                                        <!-- Submenu Open Effect -->
                                                        <Trigger Property="IsSubmenuOpen" Value="True">
                                                            <Setter TargetName="Popup" Property="IsOpen" Value="True"/>
                                                        </Trigger>

                                                        <!-- Disabled Effect -->
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MidGray}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                </Menu.Resources>
                                <!-- MenuItems with Custom Style -->
                                <MenuItem Width="20" Height="20" StaysOpenOnClick="True" Header=""  Style="{StaticResource CustomMenuItemStyle}" Margin="6,9,0,0" ToolTip="Show/Hide Columns" ToolTipService.InitialShowDelay="100">
                                    <MenuItem.Background>
                                        <ImageBrush ImageSource="/Images/Buttons/showHide.png" Stretch="Uniform"/>
                                    </MenuItem.Background>
                                    <!-- Submenu Items (Will Keep Hover Effect) -->
                                    <MenuItem StaysOpenOnClick="True" x:Name="ShowMenu" Header="Show" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                                    <MenuItem StaysOpenOnClick="True" x:Name="HideMenu" Header="Hide" Background="{StaticResource LightGray1}" Style="{StaticResource CustomMenuItemStyle}"/>
                                    <MenuItem Background="{StaticResource LightGray1}" Click="ShowAll_MenuItem_Click" Header="ShowAll" Style="{StaticResource CustomMenuItemStyle}"/>
                                </MenuItem>
                            </Menu>
                            <StackPanel x:Name="ExportToExcel_StackPanel" RenderTransformOrigin="0.5,0.5" Width="31">
                                <StackPanel.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="-1"/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </StackPanel.RenderTransform>
                                <Button TabIndex="5" Style="{DynamicResource AddButtonStyle}" x:Name="Export_btn" Command="local:Commands.ExportToExcel"  Width="30" Height="25" ToolTip="Export to Excel" ToolTipService.InitialShowDelay="100" Padding="1,1,1,1" Margin="1,10,1,1">
                                    <Button.Background>
                                        <ImageBrush ImageSource="/Images/Buttons/DownloadExcel.png" Stretch="Uniform"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel x:Name="Panel1" Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,40,0">
                            <RadioButton x:Name="PerDonor_RadioButton" Content="Show Per Donor" IsChecked="False" Style="{DynamicResource RadioButtonStyle}" Checked="PerDonor_RadioButton_Checked" Tag="False" Margin="0,9,0,9"/>
                            <RadioButton x:Name="Total_RadioButton" Content="Show Total" IsChecked="True" Style="{DynamicResource RadioButtonStyle}" Checked="Total_RadioButton_Checked" Tag="False" Margin="0,9,0,9"/>
                            <TextBox Style="{DynamicResource TextBoxActionStyle}" TextChanged="Search_txtBox_TextChanged" x:Name="Search_txtBox" TextWrapping="Wrap" TabIndex="10"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
                <syncfusion:SfDataGrid FrozenColumnCount="2"
                      x:Name="myDataGrid"  
                      HeaderStyle="{DynamicResource SfDataGrid_header}"             
                      Style="{DynamicResource SfDataGrid_body}"
                      RowStyle="{DynamicResource SfDataGrid_RowStyle}"
                      AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"  
                                   AutoGenerateColumns="True"
                      SelectionChanged="myDataGrid_SelectionChanged" Loaded="myDataGrid_Loaded" Grid.Row="3" Margin="2,0,3,5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" AutoGeneratingColumn="myDataGrid_AutoGeneratingColumn" Grid.ColumnSpan="5" ItemsSourceChanged="myDataGrid_ItemsSourceChanged" FilterChanged="myDataGrid_FilterChanged" MouseDoubleClick="myDataGrid_MouseDoubleClick" >
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTemplateColumn HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>

                        <syncfusion:GridTemplateColumn HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>

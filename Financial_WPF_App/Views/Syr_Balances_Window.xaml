<Window x:Class="Financial_WPF_App.Views.Syr_Balances_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App.Views"
        mc:Ignorable="d"
        Title="Syr_Balances_Window" Height="614" Width="1280"  
    FontFamily="Myriad Arabic"
    FontSize="18" 
    WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid>
            <Grid.ContextMenu>
                <ContextMenu x:Name="cm">
                    <MenuItem Header="Refresh All" Click = "Refresh_Click" >
                        <MenuItem.Icon>
                            <Image Source="/Images/refresh32.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>

            <TabControl x:Name="Main_tabControl" Style="{StaticResource TabControlStyle}" ></TabControl>

        </Grid>

    </Grid>
</Window>

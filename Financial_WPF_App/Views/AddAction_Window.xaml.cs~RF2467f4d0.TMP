        private void Save_btn_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                if (Amount_txtBox.Text == "")
                    throw new Exception("الرجاء التأكد من وجود قيمة صادرة أو واردة");
                if (Type_comboBox.Text == "")
                    throw new Exception("الرجاء التأكد من اختيار نوع العملية");


                string amount_str, usdvalue_str, Date;
                amount = exchanged = rate = 0;
                string inserted_value = "", AType = "";
                amount_str = Amount_txtBox.Text.Replace(",", "");
                Double.TryParse(amount_str, out amount);

                if (Type_comboBox.SelectedItem.ToString().Contains("وارد"))
                {
                    inserted_value = "Income";
                }
                else if (Type_comboBox.SelectedItem.ToString().Contains("سلفة") //syr
                    || Type_comboBox.SelectedItem.ToString().Contains("تصريف")) //usd - eur
                {
                    inserted_value = "Outcome";
                    if (Rate_txtBox.Text == "")
                        throw new Exception("الرجاء التأكد من عدم وجود حجرات فارغة قبل عملية الحفظ");

                    Double.TryParse(Rate_txtBox.Text, out rate);
                }
                else if (Type_comboBox.SelectedItem.ToString().Contains("مرتجع"))
                {
                    inserted_value = "Returned";
                }
                else if (Type_comboBox.SelectedItem.ToString().Contains("صادر/مصروف"))
                {
                    inserted_value = "Exchanged";
                    if (Receipt_txtBox.Text == "")
                        throw new Exception("الرجاء التأكد من إدخال رقم الايصال او الفاتورة قبل عملية الحفظ");
                }

                Date = Date_datepicker.DisplayDate.ToString("yyyy/MM/dd");

                int IsReceipt = -1;
                if (IsReceipt_comboBox.SelectedIndex == -1)
                    IsReceipt = -1;
                else if (IsReceipt_comboBox.SelectedItem.ToString().Contains("فاتورة"))
                    IsReceipt = 1;
                else if (IsReceipt_comboBox.SelectedItem.ToString().Contains("إيصال"))
                    IsReceipt = 0;

                //if (MircoProject_ID_txtBox.Text != "")
                //    int.TryParse(MircoProject_ID_txtBox.Text, out MicroProject_ID);
                if (MircoProject_ID_autoSuggestionUserControl.autoTextBox.Text != "")
                    int.TryParse(MircoProject_ID_autoSuggestionUserControl.autoTextBox.Text, out MicroProject_ID);
                else MicroProject_ID = -1;

                /*
                if (USD_Value_TxtBox.Text != "")
                {
                    usdvalue_str = USD_Value_TxtBox.Text.Replace(",", "");
                    Double.TryParse(usdvalue_str, out USD_Value);
                }
                */
                //if (AvgRate_comboBox.SelectedIndex != -1) Rate_ID = Convert.ToInt32(AvgRate_comboBox.SelectedValue);
                //else Rate_ID = -1;

                int DestinationTill_ID = -1;
                string Destination_value = "";
                if (DestinationTill_comboBox.SelectedIndex != -1)
                    DestinationTill_ID = Convert.ToInt32(DestinationTill_comboBox.SelectedValue);

                if (Login.BuildConnection())
                {
                    if (Action_ID != -1)//Edit
                    {

                        if (DestinationTill_comboBox.SelectedIndex != -1 && inserted_value == "Outcome")
                        {
                            a.Update(Action_ID, -1, DestinationTill_ID, true, inserted_value.Substring(0, 1), amount, rate
           , Date, Notes_txtBox.Text, IsReceipt, Receipt_txtBox.Text
           , Rate_ID, MicroProject_ID, -1, -1, -1);
                        }
                        else
                        {
                            a.Update(Action_ID, -1, DestinationTill_ID, false, inserted_value.Substring(0, 1), amount, rate
           , Date, Notes_txtBox.Text, IsReceipt, Receipt_txtBox.Text
           , Rate_ID, MicroProject_ID, -1, -1, -1);
                        }

                        /*
                        a.Update(Action_ID, -1, DestinationTill_ID, "", inserted_value.Substring(0, 1), amount, rate
                            , Date, Notes_txtBox.Text, IsReceipt, Receipt_txtBox.Text
                            , Rate_ID, MicroProject_ID, -1, -1, -1);


                        // If there is outcome & rate & exchanged values =>
                        //      then update the row in destination till with the same ActionNumber //   
                        if (DestinationTill_comboBox.SelectedIndex != -1 && inserted_value == "Outcome")
                        {
                            if (inserted_value == "Outcome")
                                Destination_value = "I";

                            a.Update(-1, DestinationTill_ID, Till_ID, ActionNumber, Destination_value, 0, 0
                            , Date, Notes_txtBox.Text, -1, ""
                            , -1, -1, -1, -1, -1);

                        }
                        //}
                        */
                    }
                    else//Add new
                    {
                        if (DestinationTill_comboBox.SelectedIndex != -1 && inserted_value == "Outcome")
                        {
                            a.Insert(Till_ID, DestinationTill_ID, true, inserted_value.Substring(0, 1), amount, rate
                           , Date, Notes_txtBox.Text, IsReceipt, Receipt_txtBox.Text
                           , Rate_ID, MicroProject_ID, -1, -1, -1);


                            DataTable rate_dt = r.Select(Account_ID.ToString(), Date);
                            if (rate_dt.Rows.Count > 0)
                            {
                                for (int i = 0; i < rate_dt.Rows.Count; i++)
                                {
                                    int r_id = rate_dt.Rows[i].Field<int>("ID");
                                    string r_name = rate_dt.Rows[i].Field<string>("Name");
                                    string BeginDate = rate_dt.Rows[i].Field<DateTime>("BeginDate").ToString("yyyy/MM/dd");
                                    string EndDate = rate_dt.Rows[i].Field<DateTime>("EndDate").ToString("yyyy/MM/dd");
                                    Double value = r.Calculate_Value(Account_ID.ToString(), BeginDate, EndDate);
                                    r.Update(r_id, r_name, BeginDate, EndDate, value);

                                    //update usd_value of all actions with type 'E'
                                    //that have the updated AVG Rate r_id
                                    // a.Update_usdValues(r_id);
                                }
                            }
                        }
                        else
                        {
                            a.Insert(Till_ID, DestinationTill_ID, false, inserted_value.Substring(0, 1), amount, rate
                            , Date, Notes_txtBox.Text, IsReceipt, Receipt_txtBox.Text
                            , Rate_ID, MicroProject_ID, -1, -1, -1);
                        }



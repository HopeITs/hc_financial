        private void Clear_Boxes()
        {
            Amount_txtBox.Text = AvgRate_TxtBox.Text = USD_Value_TxtBox.Text =
                Rate_txtBox.Text = Exchanged_txtBox.Text =
                Notes_txtBox.Text = Receipt_txtBox.Text = BeneficiaryName_txtBox.Text =
                MircoProject_ID_autoSuggestionUserControl.autoTextBox.Text = "";

            IsReceipt_comboBox.SelectedIndex = DestinationTill_comboBox.SelectedIndex = -1;
            Action_ID = -1;

            CreatedAt_datepicker.SelectedDate = Date_datepicker.SelectedDate = DateTime.Today;

        }


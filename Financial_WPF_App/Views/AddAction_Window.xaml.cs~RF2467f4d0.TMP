        private void Date_datepicker_SelectedDateChanged(object sender, SelectionChangedEventArgs e)
        {
            Select_AvgRate();
        }

        private void Select_AvgRate()
        {
            try
            {
                // If Amount Type is صادر-مصروف
                // If IsReceipt is فاتورة
                // If Date selected and Not Empty

                // => find the Avg Rate in Account that : BeginDate >= Date & EndDate <= Date 
                // => Calculate USD_Value

                if (Type_comboBox.SelectedIndex == 3 && Amount_txtBox.Text != "") //فاتورة 
                {
                    string Date = Date_datepicker.DisplayDate.ToString("yyyy/MM/dd");
                    if (Login.BuildConnection())
                    {
                        Rate_ID = -1;
                        rate_dt = r.Select(Account_ID.ToString(), Date);
                        if (rate_dt.Rows.Count == 0)
                        {
                            AvgRate_TxtBox.Text = USD_Value_TxtBox.Text = "";
                            throw new Exception("لا يوجد قيمة مرتبطة بهذا الحساب وتضم تاريخ هذه العملية. الرجاء التأكد من وجود Avg Rate.");
                        }

                        Rate_ID = rate_dt.Rows[0].Field<int>("ID");
                        double avgRate = rate_dt.Rows[0].Field<double>("Value");
                        AvgRate_TxtBox.Text = avgRate.ToString("N3");

                        //Calculate USD Value//
                        if (Amount_txtBox.Text != "")
                        {
                            string expand = Amount_txtBox.Text.Replace(",", "");
                            Double.TryParse(expand, out expandature);
                            USD_Value = expandature / avgRate;
                            USD_Value_TxtBox.Text = USD_Value.ToString("N3");
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.Message);
            }
        }


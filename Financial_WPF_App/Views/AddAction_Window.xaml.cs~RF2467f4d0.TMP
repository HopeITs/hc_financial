        private void Load_Form()
        {
            try
            {
                b = new Beneficiary();
                t = new Till();
                a = new Models.Action();
                l = new Log();
                r = new Rate();
                u = new Users();

                AccountName_lable.Content = Account_Name;
                TillName_lable.Content = TillType;
                Show_Hide_Components();


                //Action_ID = -1;
                Date_datepicker.SelectedDate = DateTime.Today;
                CreatedAt_datepicker.SelectedDate = DateTime.Today;

                Fill_Beneficiaries();
                Fill_Tills();

                //select the Till//
                //Till_comboBox.SelectedValue = Till_ID;

                //UPDATE MODE//
                if (Action_ID > 0)
                    Fill_Action();

            }
            catch (Exception ex)
            { MessageBox.Show(ex.Message); }
        }


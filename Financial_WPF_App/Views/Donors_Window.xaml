<Window x:Name="DonorWindow" x:Class="Financial_WPF_App.NewDonor_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        mc:Ignorable="d"
        Title="DonorWindow" Height="550" Width="450" 
        WindowStartupLocation="CenterScreen" KeyDown="DonorWindow_KeyDown"  
        Closing="Donor_Window_Closing"
        FontFamily="Myriad Arabic" FontSize="18">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Window.Resources>

    </Window.Resources>
    <Grid>  
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>  
                <RowDefinition Height="90*" ></RowDefinition>
                <RowDefinition Height="10*" ></RowDefinition>
        </Grid.RowDefinitions>
 
        <DataGrid  x:Name="myDataGrid"  Grid.Column="0" Grid.Row="0"
                      ColumnHeaderStyle="{DynamicResource DataGrid_header}" 
                      Style="{DynamicResource DataGrid_body}"
                      AlternatingRowBackground="{DynamicResource HopeBlue1}" 
                   RowBackground="{DynamicResource HopeGrey}" AlternationCount="2" 
                   IsReadOnly="False" CellEditEnding="myDataGrid_CellEditEnding" 
                   SelectionChanged="myDataGrid_SelectionChanged"  >
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ID}" Header="#" Visibility="Hidden" />
                    <DataGridTextColumn Header="Donor"  Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Abbrivation" Binding="{Binding Abb_Name}"/>
                    <!--<DataGridTemplateColumn Header="Edit" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource Edit_Style}" Click="EditButton_Click" /> 
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->
                    <DataGridTemplateColumn Header="Delete" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource Delete_Style}" Click="DeleteButton_Click"> 
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns> 
            </DataGrid>

        <Grid Grid.Column="0" Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Style="{DynamicResource SaveButton_Style}" 
                    x:Name="Save_btn" TabIndex="3" Click="Save_btn_Click" />

            <Label Grid.Column="4" Content="All: " Style="{DynamicResource statistic_lableStyle}" />
            <Border Grid.Column="3" BorderThickness="1" CornerRadius="7" Padding="0" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock  x:Name="All_textBlock" 
                               Text="{Binding ElementName=myDataGrid, Path=Items.Count,StringFormat={}{0:N0}}"  
                               Style="{DynamicResource statistic_textBlockStyle}"
                               OverridesDefaultStyle="True"  />
            </Border>

            <Label Grid.Column="2" Content="Selected: " Style="{DynamicResource statistic_lableStyle}" />
            <Border Grid.Column="1" BorderThickness="1" CornerRadius="7" Padding="0" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch" Width="auto" >
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color_HopeDarkBlue2}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource Color_HopeGrey}"/>
                </Border.Background>
                <TextBlock x:Name="Selected_textBlock" Text="0" Style="{DynamicResource statistic_textBlockStyle}"
                               OverridesDefaultStyle="True"  />
            </Border>
        </Grid>
    </Grid>

</Window>

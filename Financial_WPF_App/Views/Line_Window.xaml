<Window x:Class="Financial_WPF_App.Views.Line_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Financial_WPF_App"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
        mc:Ignorable="d" Tag="Line Window"
        WindowStartupLocation="CenterScreen" KeyDown="ProjectWindow_KeyDown"
        Style="{StaticResource WindowPopupStyle}">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click = "Refresh_Click" >
                <MenuItem.Icon>
                    <Image Source="/Cashing;component/Images/refresh32.png" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Margin="10" >
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="97*" />
        </Grid.RowDefinitions>

        <DockPanel Background="{StaticResource LightGray1}" DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Grid.Row="0">
            <local:WindowControlBar_Popup x:Name="ControlBar"/>
        </DockPanel>
        <DockPanel LastChildFill="True" Background="{StaticResource LightGray1}" Height="40" Grid.Row="1">
            <WrapPanel Orientation="Horizontal" Width="Auto" VerticalAlignment="Center">
                <StackPanel  Orientation="Horizontal" Height="30">
                    <Label Style="{DynamicResource statistic_lableStyle}" Content="Name:"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Margin="10,0,2,0"/>
                    <TextBox x:Name="CategoryName_txtBox" Style="{DynamicResource CustomTextBoxActionStyle}" Width="175" TabIndex="2" HorizontalContentAlignment="Stretch"  />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="30">
                    <Label  Style="{DynamicResource statistic_lableStyle}" Content="Type:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Margin="10,0,2,0" />
                    <ComboBox x:Name="Type_comboBox" Style="{StaticResource ActionComboboxStyle}" DisplayMemberPath="Name" SelectedValuePath="ID"  Width="175"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="2"  Height="30" Margin="0,5,0,0">
                    <Label  Style="{DynamicResource statistic_lableStyle}" Content="Kind:" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Margin="10,0,2,0" />
                    <ComboBox x:Name="Kind_comboBox" Style="{StaticResource ActionComboboxStyle}" DisplayMemberPath="Name" SelectedValuePath="ID"  Width="175"/>
                </StackPanel>
                <Button  Style="{DynamicResource AddButtonStyle}" x:Name="categorySave_btn" Click="CategorySave_btn_Click" FlowDirection="LeftToRight" ToolTip="Save" ToolTipService.InitialShowDelay="100" HorizontalAlignment="Left" Margin="10,2,1,0" Width="22" Height="23">
                    <Button.Background>
                        <ImageBrush ImageSource="/Images/Buttons/newEntry.png" Stretch="Uniform"/>
                    </Button.Background>
                </Button>
            </WrapPanel>
        </DockPanel>
        

        <Grid Grid.Column="0" Grid.Row="1" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148*"></ColumnDefinition>
                <ColumnDefinition Width="167*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50*"></RowDefinition>
                <RowDefinition Height="50*"></RowDefinition>
            </Grid.RowDefinitions>

            <!--<DockPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="6,14,5,19" Width="156">
                <Border CornerRadius="6" BorderBrush="Gray" Background="{DynamicResource HopeYellow1}" BorderThickness="2" DockPanel.Dock="Top" Width="140">
                    <StackPanel  >
                        <CheckBox  x:Name="Fixed_checkBox" Content="Equipping the place" HorizontalAlignment="Right" Margin="3" FlowDirection="RightToLeft" Checked="Fixed_checkBox_Checked" Background="{DynamicResource HopeDarkBlue2}" BorderBrush="{DynamicResource HopeBlue1}" Width="121"/>
                        <CheckBox  x:Name="InFlow_checkBox" Content="Running cost" HorizontalAlignment="Right" Margin="3" VerticalAlignment="Center" FlowDirection="RightToLeft" Checked="InFlow_checkBox_Checked" Background="{DynamicResource HopeDarkBlue2}" BorderBrush="{DynamicResource HopeBlue1}"/>
                    </StackPanel>
                </Border>
            </DockPanel>
            <Border CornerRadius="6" BorderBrush="Gray" Background="{DynamicResource HopeBlue1}" BorderThickness="2" Margin="5,14,5,19" Grid.RowSpan="2">
                <StackPanel  Orientation="Horizontal" Margin="0,1,0,1" >
                    <CheckBox  x:Name="Profit_checkBox" Content="Profit" Margin="3" VerticalAlignment="Center" FlowDirection="RightToLeft" Checked="Profit_checkBox_Checked" Background="{DynamicResource HopeDarkBlue2}" BorderBrush="{DynamicResource HopeBlue1}" Width="60"/>
                    <CheckBox  x:Name="Budget_checkBox" Content="Budget" FlowDirection="RightToLeft" Checked="Budget_checkBox_Checked" Background="{DynamicResource HopeDarkBlue2}" BorderBrush="{DynamicResource HopeBlue1}"/>
                </StackPanel>
            </Border>-->
        </Grid>


        <syncfusion:SfDataGrid x:Name="categoryDataGrid" FrozenColumnCount="2"                                            
            Style="{DynamicResource SfDataGrid_body}"
            HeaderStyle="{DynamicResource SfDataGrid_header}"
            RowStyle="{DynamicResource SfDataGrid_RowStyle}"
            AlternatingRowStyle="{DynamicResource SfDataGrid_alternatingRowStyle}"      
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Grid.Row="3" MouseDoubleClick="myDataGrid_MouseDoubleClick" Margin="2,5,0,5">

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn x:Name="ID_DataGridColumn" HeaderText="#"  MappingName="ID" IsHidden="True"/>
                <syncfusion:GridTextColumn x:Name="Name_DataGridColumn" HeaderText="Name"  MappingName="Name" />
                <syncfusion:GridTextColumn x:Name="Type_DataGridColumn" HeaderText="Type"  MappingName="Type" />
                <syncfusion:GridTextColumn x:Name="Kind_DataGridColumn" HeaderText="Kind"  MappingName="Kind" />


                <syncfusion:GridTemplateColumn x:Name="Edit_DataGridColumn" HeaderText="Edit" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Edit_Style}" Click="EditButton_Click" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTemplateColumn x:Name="Delete_DataGridColumn" HeaderText="Delete" AllowSorting="False" AllowFiltering="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Delete_Style}" Click="DeleteButton_Click"/>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
        
        
    </Grid>

</Window>
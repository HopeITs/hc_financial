<UserControl x:Class="Financial_WPF_App.Controls.AutoCompleteTextBoxUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Financial_WPF_App.Controls"
             mc:Ignorable="d" Height="40" Width="200">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

            <!-- Text Box -->
            <TextBox x:Name="autoTextBox"     
                    MinWidth="100"
                    Background="White"     
                    TextChanged="AutoTextBox_TextChanged"  
                    Style="{DynamicResource textBoxStyle}" Text="" />
 
            <!-- Auto Suggestion box -->
            <Popup x:Name="autoListPopup"     
                   Visibility="Collapsed"                    
                   Height="200"    
                   StaysOpen="True"    
                   AllowsTransparency="True"  
                   Placement="Bottom" IsOpen="False">

                <ListBox x:Name="autoList"    
                         Visibility="Collapsed"    
                         Width="220" 
                         SelectionChanged="AutoList_SelectionChanged" Background="White"  />
            </Popup>
        </StackPanel>
    </Grid>
</UserControl>

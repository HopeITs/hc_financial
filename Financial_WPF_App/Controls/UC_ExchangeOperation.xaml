<UserControl x:Class="Financial_WPF_App.Controls.UC_ExchangeOperation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Financial_WPF_App"
             xmlns:uc ="clr-namespace:Financial_WPF_App.Controls"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:helper="clr-namespace:Financial_WPF_App.helper"
             mc:Ignorable="d" 
             d:DesignHeight="240" >

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="175"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="30"/>


        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Cash Till -->
        <Label Grid.Column="4" Grid.Row="0" x:Name="CashAccount_lable" Style="{DynamicResource statistic_lableStyle}" Content="Cash till:"  HorizontalContentAlignment="Left" />
        <Grid Height="30" Grid.Row="0" x:Name="CashAccount_panel"  Grid.Column="5" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- TextBox will stretch -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="CashAccount_comboBox" TabIndex="1"
             DisplayMemberPath="Name" SelectedValuePath="ID" Style="{StaticResource FloatingComboboxStyle}"
             VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" x:Name="CashAccount_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}"  Click="CashAccount_clear_btn_Click" Margin="5,0,0,0" >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </Grid>

        <!-- Original_AvgRate -->
        <Label Grid.Column="1" Grid.Row="0" x:Name="Original_AvgRate_lable" Style="{DynamicResource statistic_lableStyle}" Content="Origin Avg Rate:" HorizontalContentAlignment="Left"  />

        <Grid Grid.Column="2" Grid.Row="0" Height="30" x:Name="Line_panel_Copy">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- TextBox will stretch -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="Original_AvgRate_comboBox" TabIndex="2"  
           	DisplayMemberPath="Name" SelectedValuePath="ID" Style="{StaticResource FloatingComboboxStyle}"
           	VerticalContentAlignment="Center" SelectionChanged="Original_AvgRate_comboBox_SelectionChanged"/>
            <Button Grid.Column="1" x:Name="Original_AvgRate_clear_btn" Click="Avgrate_clear_btn_Click" Style="{StaticResource DeleteButtonStyle}" Margin="5,0,0,0">
            </Button>
        </Grid>

        <Button Grid.Row="0" Grid.Column="3" x:Name="Original_AvgRate_help" Width="25" Height="25" ToolTipService.InitialShowDelay="100" Margin="5,0,0,0" BorderBrush="{x:Null}" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
            <Button.Background>
                <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
            </Button.Background>
            <Button.ToolTip>
                <TextBlock>
               Avg Rate only appears if it includes the operation date implicitly or if there is a remainder in it.
               <LineBreak /> 
               In case of having a budget, Avg Rate only appears from the selected budget currency to the local currency (SYP).
                </TextBlock>
            </Button.ToolTip>
        </Button>

        <!-- Donor -->
        <Label Grid.Column="1" Grid.Row="1" x:Name="Donor_lable" Style="{DynamicResource statistic_lableStyle}" Content="Donor:" Margin="10,0,1,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Grid Height="30" Grid.Row="1" x:Name="Donor_panel"  Grid.Column="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- TextBox will stretch -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="Donor_comboBox" TabIndex="3" Style="{StaticResource FloatingComboboxStyle}"
             DisplayMemberPath="Name" SelectedValuePath="ID" 
             SelectionChanged="Donor_comboBox_SelectionChanged"/>
            <Button Grid.Column="1" x:Name="Donor_comboBox_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}" Click="Donor_comboBox_clear_btn_Click" Margin="5,0,0,0" >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </Grid>
        
        <!-- Rate -->
        <Label x:Name="Rate_lable" Grid.Column="4" Grid.Row="1" Style="{DynamicResource statistic_lableStyle}" Content="Rate:"  HorizontalContentAlignment="Left"   />
        <TextBox x:Name="Rate_txtBox" Style="{DynamicResource FloatingTextBoxStyle}" 
                Grid.Column="5" Grid.Row="1" TabIndex="4"   
                LostFocus="Rate_txtBox_LostFocus" Height="30"  />

        <!-- Corresponding till -->
        <Label Grid.Column="1" Grid.Row="2" x:Name="DestinationTill_lable" Style="{DynamicResource statistic_lableStyle}" Content="Corresponding till:" HorizontalContentAlignment="Left" />
        <Grid Grid.Column="2" Grid.Row="2" x:Name="DestinationTill_panel" Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- TextBox will stretch -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="DestinationTill_comboBox" TabIndex="5" Grid.Column="0" Style="{DynamicResource FloatingComboboxStyle}"
          DisplayMemberPath="Type" SelectedValuePath="ID" 
          SelectionChanged="DestinationTill_comboBox_SelectionChanged"/>
            <Button Grid.Column="1" x:Name="DestinationTill_clear_btn" HorizontalAlignment="Left" Style="{StaticResource DeleteButtonStyle}"
                Click="DestinationTill_clear_btn_Click" Margin="5,0,0,0" >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </Grid>
        
        <Button Grid.Row="2" Grid.Column="3" x:Name="DestinationTill_help" Width="25" Height="25" ToolTipService.InitialShowDelay="100" BorderBrush="{x:Null}" Margin="5,0,0,0" HorizontalAlignment="Left">
            <Button.Background>
                <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
            </Button.Background>
            <Button.ToolTip>
                <TextBlock><Run Text="The account only appears if it contains a till of the same currency."/><LineBreak /><Run Text="In foreign currency till, The account only appears if it contains a till of the same currency and the account has the selected donor"/></TextBlock>
            </Button.ToolTip>
        </Button>

        <!-- Corresponding cash till -->
        <Label Grid.Column="4" Grid.Row="2" x:Name="ObserveCashAccount_lable" Style="{DynamicResource statistic_lableStyle}" Content="Corresponding cash till:"  Margin="10,0,1,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Grid Grid.Row="2" Height="30" x:Name="ObserveCashAccount_panel" Grid.Column="5" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- TextBox will stretch -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="ObserveCashAccount_comboBox" TabIndex="6" Style="{StaticResource FloatingComboboxStyle}"
                DisplayMemberPath="Name" SelectedValuePath="ID" />
            <Button Grid.Column="1" x:Name="ObserveCashAccount_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center"  Click="ObserveCashAccount_clear_btn_Click" Style="{StaticResource DeleteButtonStyle}" Margin="5,0,0,0">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </Grid>

        <!-- Exchange account -->
        <Label Grid.Row="3" x:Name="ExchangeAcc_lable" Style="{DynamicResource statistic_lableStyle}" Content="Exchange account:"  Margin="10,0,1,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Grid.Column="1" />
        <Grid Grid.Row="3" Height="30" x:Name="ExchangeAcc_panel" Grid.Column="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- TextBox will stretch -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ExchangeAcc_comboBox" TabIndex="7" Grid.Column="0"
    DisplayMemberPath="Name" SelectedValuePath="id" Style="{StaticResource FloatingComboboxStyle}"
     SelectionChanged="ExchangeAcc_comboBox_SelectionChanged"/>
            <Button Grid.Column="1" x:Name="ExchangeAcc_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}" 
    Click="ExchangeTill_clear_btn_Click" Margin="5,0,0,0">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>

        </Grid>
        <Button Grid.Row="3" Grid.Column="3" x:Name="ExchangeAcc_help" ToolTipService.InitialShowDelay="100" Width="25" Height="25" Margin="5,0,0,0" BorderBrush="{x:Null}" HorizontalAlignment="Left">

            <Button.Background>
                <ImageBrush ImageSource="/Images/Icons/help.png" Stretch="Uniform"/>
            </Button.Background>
            <Button.ToolTip>
                <ToolTip Content="The exchange account only appears if it contains a till for both currencies (from/to))"/>
            </Button.ToolTip>
        </Button>
        <!-- Exchange Cash till -->
        <Label Grid.Column="4" Grid.Row="3" x:Name="ExchangeCash_lable" Style="{DynamicResource statistic_lableStyle}" Content="Exchange cash till:"  Margin="10,0,1,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Grid Height="30" Grid.Row="3" x:Name="ExchangeAcc_panel_Copy"  Grid.Column="5" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- TextBox will stretch -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="ExchangeCash_comboBox" TabIndex="8" Style="{DynamicResource  FloatingComboboxStyle}"
            DisplayMemberPath="Name" SelectedValuePath="ID" />
            <Button Grid.Column="1" x:Name="ExchangeCash_clear_btn" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource DeleteButtonStyle}" Click="ExchangeCash_clear_btn_Click" Margin="5,0,0,0" >
                <Button.Background>
                    <ImageBrush ImageSource="/Images/Buttons/delete.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </Grid>

        <!-- Value -->
        <Label Grid.Column="1" Grid.Row="6" x:Name="USD_Value_lable" Style="{DynamicResource statistic_lableStyle}" Content="Value:" HorizontalContentAlignment="Left"  />
        <Label x:Name="USD_Value_TxtBox"  Style="{DynamicResource statistic_lableStyle}" 
        Grid.Column="2" Grid.Row="6" TabIndex="100" Height="30"  />
        
        <!-- Exchanged -->
        <Label x:Name="Exchanged_lable" Grid.Column="4" Grid.Row="20" Style="{DynamicResource statistic_lableStyle}" Content="Exchanged:"  HorizontalContentAlignment="Left"   />
        <Label x:Name="Exchanged_txtBox" Style="{DynamicResource statistic_lableStyle}"
        Grid.Column="5" Grid.Row="20" TabIndex="101"   Height="30"  />


    </Grid>
</UserControl>

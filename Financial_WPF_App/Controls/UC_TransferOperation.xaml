<UserControl x:Class="Financial_WPF_App.Controls.UC_TransferOperation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Financial_WPF_App.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="700">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Label Content="Destination Till:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox x:Name="Combo_TransferDestTill" Grid.Row="0" Grid.Column="1" Margin="5" Height="30"/>

        <Label Content="Transfer Amount:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBox x:Name="Txt_TransferAmount" Grid.Row="0" Grid.Column="3" Margin="5" Height="30"/>
    </Grid>
</UserControl>
